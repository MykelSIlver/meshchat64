  6661                          ; ================================================================
  6662                          ; ED25519 SIGN CORE  (from signtest.asm; SHA_K/W/MLEN -> SHA5_*)
  6663                          ; ================================================================
  6664                          ; ================================================================
  6665                          ; ed25519test.asm  -  Edwards25519 point arithmetic (step 3 Ed25519 path)
  6666                          ; ----------------------------------------------------------------
  6667                          ; Builds on the verified Fp layer (mod p = 2^255-19) from step 2.
  6668                          ; Punt = extended twisted Edwards coords (X:Y:Z:T), a = -1.
  6669                          ;   x = X/Z , y = Y/Z , T = X*Y/Z .
  6670                          ; Elk coord = 32 bytes little-endian, canoniek in [0,p).
  6671                          ;
  6672                          ;   POINT_ADD  : (PR) = (PA) + (PB)        (HWCD add-2008-hwcd-3, a=-1)
  6673                          ;   POINT_DBL  : (PR) = 2*(PA)             (dbl-2008-hwcd, a=-1)
  6674                          ;   SCALAR_MUL : (PACC) = SCALAR * (PIN)   (double-and-add, MSB->LSB, 256 bits)
  6675                          ;
  6676                          ; A point lives in a 128-byte block: X(32) Y(32) Z(32) T(32).
  6677                          ; Pointers to such a block: PAP/PBP/PRP (24-bit not needed; coords lie
  6678                          ; contiguous, so block base + offset 0/32/64/96).
  6679                          ;
  6680                          ; Test wrappers (fixed blocks IN_P / IN_Q -> OUT_P, and SCALAR buffer):
  6681                          ;   T_PADD T_PDBL T_SMUL
  6682                          ; Getoetst byte-exact in py65 tegen ref_ed.py (Python).
  6683                          ; ================================================================
  6684                          
  6685                          ; --- zeropage pointers (Fp layer) ---
  6686                          FAP = $FB       ; arg A pointer (reused in FP_MUL as PROD pointer)
  6687                          FBP = $FD       ; arg B pointer
  6688                          FRP = $F7       ; result pointer
  6689                          ; SHA-512 zeropage aliases (same addresses; SHA and Fp never run at once)
  6690                          PA  = $FB
  6691                          PB  = $FD
  6692                          SRC = $F7
  6693                          BP  = $F9
  6694                          ; --- COPY_M (16-bit message copy) zeropage; $02-$05 free in this module ---
  6695                          ; Runs fully to completion before each SHA512 call, so no aliasing with SRC/PA/PB.
  6696                          CSRC = $02      ; copy source pointer
  6697                          CDST = $04      ; copy destination pointer
  6698                          
  6699                          
  6700                          ; ================================================================
  6701                          ; MACROS - call the Fp layer with absolute buffer labels
  6702                          ; ================================================================
  6703                          !macro fmul .r, .a, .b {
  6704                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6705                                  lda #<.b : sta FBP : lda #>.b : sta FBP+1
  6706                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6707                                  jsr FP_MUL
  6708                          }
  6709                          !macro fsq .r, .a {
  6710                                  +fmul .r, .a, .a
  6711                          }
  6712                          !macro fadd .r, .a, .b {
  6713                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6714                                  lda #<.b : sta FBP : lda #>.b : sta FBP+1
  6715                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6716                                  jsr FP_ADD
  6717                          }
  6718                          !macro fsub .r, .a, .b {
  6719                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6720                                  lda #<.b : sta FBP : lda #>.b : sta FBP+1
  6721                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6722                                  jsr FP_SUB
  6723                          }
  6724                          ; copy 32-byte field .src -> .dst
  6725                          !macro fcopy .dst, .src {
  6726                                  ldx #31
  6727                          .cl     lda .src,x
  6728                                  sta .dst,x
  6729                                  dex
  6730                                  bpl .cl
  6731                          }
  6732                          ; --- Fp macros for FP_INV (from fp25519test) ---
  6733                          !macro mul .r, .a, .b {
  6734                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6735                                  lda #<.b : sta FBP : lda #>.b : sta FBP+1
  6736                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6737                                  jsr FP_MUL
  6738                          }
  6739                          !macro sq .r, .a {
  6740                                  +mul .r, .a, .a
  6741                          }
  6742                          !macro sqn .buf, .n {
  6743                                  lda #<.buf : sta SQ_PTR : lda #>.buf : sta SQ_PTR+1
  6744                                  lda #.n    : sta SQN_CNT
  6745                                  jsr SQN
  6746                          }
  6747                          
  6748                          ; ================================================================
  6749                          ; POINT_ADD : (PR) = (PA) + (PB)
  6750                          ; PA = block at PA_X (X,Y,Z,T), same for PB, result PR.
  6751                          ; Fixed work blocks here: input in A-coords / B-coords; out in R-coords.
  6752                          ; We use named buffers (no indirect block pointers) to keep the
  6753                          ; formula readable; SCALAR_MUL copies in/out of these buffers.
  6754                          ;   A = (Y1-X1)*(Y2-X2)
  6755                          ;   B = (Y1+X1)*(Y2+X2)
  6756                          ;   C = T1 * (2d) * T2
  6757                          ;   D = Z1 * 2 * Z2
  6758                          ;   E = B-A ; F = D-C ; G = D+C ; H = B+A
  6759                          ;   X3=E*F ; Y3=G*H ; T3=E*H ; Z3=F*G
  6760                          ; ================================================================
  6761                          PA_X = AX
  6762                          PA_Y = AY
  6763                          PA_Z = AZ
  6764                          PA_T = AT
  6765                          PB_X = BX_
  6766                          PB_Y = BY_
  6767                          PB_Z = BZ_
  6768                          PB_T = BT_
  6769                          PR_X = RX
  6770                          PR_Y = RY
  6771                          PR_Z = RZ
  6772                          PR_T = RT
  6773                          
  6774                          POINT_ADD
  6775                                  ; tmpA = (Y1-X1)*(Y2-X2)
  6776  6d10 a93d85fba98985fc...        +fsub PT1, PA_Y, PA_X      ; PT1 = Y1-X1
  6777  6d2b a9bd85fba98985fc...        +fsub PT2, PB_Y, PB_X      ; PT2 = Y2-X2
  6778  6d46 a99d85fba98b85fc...        +fmul PvA, PT1, PT2        ; A
  6779                                  ; tmpB = (Y1+X1)*(Y2+X2)
  6780  6d61 a93d85fba98985fc...        +fadd PT1, PA_Y, PA_X      ; PT1 = Y1+X1
  6781  6d7c a9bd85fba98985fc...        +fadd PT2, PB_Y, PB_X      ; PT2 = Y2+X2
  6782  6d97 a99d85fba98b85fc...        +fmul PvB, PT1, PT2        ; B
  6783                                  ; C = T1 * 2d * T2  -> PT1 = T1*2d ; C = PT1*T2
  6784  6db2 a97d85fba98985fc...        +fmul PT1, PA_T, D2_CONST  ; T1*2d
  6785  6dcd a99d85fba98b85fc...        +fmul PvC, PT1, PB_T       ; C
  6786                                  ; D = Z1 * 2 * Z2 -> PT1 = Z1*Z2 ; D = PT1*2  (2 as field constant)
  6787  6de8 a95d85fba98985fc...        +fmul PT1, PA_Z, PB_Z      ; Z1*Z2
  6788  6e03 a99d85fba98b85fc...        +fadd PvD, PT1, PT1        ; D = 2*Z1*Z2
  6789                                  ; E=B-A ; H=B+A ; F=D-C ; G=D+C
  6790  6e1e a9bd85fba98a85fc...        +fsub PvE, PvB, PvA
  6791  6e39 a9bd85fba98a85fc...        +fadd PvH, PvB, PvA
  6792  6e54 a9fd85fba98a85fc...        +fsub PvF, PvD, PvC
  6793  6e6f a9fd85fba98a85fc...        +fadd PvG, PvD, PvC
  6794                                  ; X3=E*F ; Y3=G*H ; T3=E*H ; Z3=F*G
  6795  6e8a a91d85fba98b85fc...        +fmul PR_X, PvE, PvF
  6796  6ea5 a95d85fba98b85fc...        +fmul PR_Y, PvG, PvH
  6797  6ec0 a91d85fba98b85fc...        +fmul PR_T, PvE, PvH
  6798  6edb a93d85fba98b85fc...        +fmul PR_Z, PvF, PvG
  6799  6ef6 60                         RTS
  6800                          
  6801                          ; ================================================================
  6802                          ; POINT_DBL : (PR) = 2*(PA)
  6803                          ;   A = X1^2 ; B = Y1^2 ; C = 2*Z1^2 ; D = -A
  6804                          ;   E = (X1+Y1)^2 - A - B
  6805                          ;   G = D+B ; F = G-C ; H = D-B
  6806                          ;   X3=E*F ; Y3=G*H ; T3=E*H ; Z3=F*G
  6807                          ; ================================================================
  6808                          POINT_DBL
  6809  6ef7 a91d85fba98985fc...        +fsq  PvA, PA_X            ; A = X1^2
  6810  6f12 a93d85fba98985fc...        +fsq  PvB, PA_Y            ; B = Y1^2
  6811                                  ; C = 2*Z1^2 -> PT1=Z1^2 ; C=PT1+PT1
  6812  6f2d a95d85fba98985fc...        +fsq  PT1, PA_Z
  6813  6f48 a99d85fba98b85fc...        +fadd PvC, PT1, PT1
  6814                                  ; D = -A = 0 - A
  6815  6f63 a9fd85fba98c85fc...        +fsub PvD, ZERO_CONST, PvA
  6816                                  ; E = (X1+Y1)^2 - A - B
  6817  6f7e a91d85fba98985fc...        +fadd PT1, PA_X, PA_Y      ; X1+Y1
  6818  6f99 a99d85fba98b85fc...        +fsq  PT2, PT1             ; (X1+Y1)^2
  6819  6fb4 a9bd85fba98b85fc...        +fsub PT1, PT2, PvA        ; -A
  6820  6fcf a99d85fba98b85fc...        +fsub PvE, PT1, PvB        ; -B  -> E
  6821                                  ; G=D+B ; F=G-C ; H=D-B
  6822  6fea a9fd85fba98a85fc...        +fadd PvG, PvD, PvB
  6823  7005 a95d85fba98b85fc...        +fsub PvF, PvG, PvC
  6824  7020 a9fd85fba98a85fc...        +fsub PvH, PvD, PvB
  6825                                  ; X3=E*F ; Y3=G*H ; T3=E*H ; Z3=F*G
  6826  703b a91d85fba98b85fc...        +fmul PR_X, PvE, PvF
  6827  7056 a95d85fba98b85fc...        +fmul PR_Y, PvG, PvH
  6828  7071 a91d85fba98b85fc...        +fmul PR_T, PvE, PvH
  6829  708c a93d85fba98b85fc...        +fmul PR_Z, PvF, PvG
  6830  70a7 60                         RTS
  6831                          
  6832                          ; ================================================================
  6833                          ; SCALAR_MUL : ACC = SCALAR * PIN  (256-bit, MSB->LSB double-and-add)
  6834                          ; SCALAR = 32 bytes little-endian in SCALAR-buffer.
  6835                          ; PIN    = invoerpunt in PIN_X/Y/Z/T (extended coords).
  6836                          ; ACC    = accumulator in ACC_X/Y/Z/T.
  6837                          ; Method per bit (from bit 255 down to 0):
  6838                          ;   ACC = 2*ACC                 (POINT_DBL: A=ACC -> R=ACC)
  6839                          ;   if bit: ACC = ACC + PIN     (POINT_ADD: A=ACC, B=PIN -> R=ACC)
  6840                          ; ACC starts as the neutral element (0,1,1,0).
  6841                          ; ================================================================
  6842                          SCALAR_MUL
  6843                                  ; ACC = identity (0,1,1,0)
  6844  70a8 a21f                       ldx #31
  6845  70aa a900               SM_ID   lda #0
  6846  70ac 9ddd8b                     sta ACC_X,x
  6847  70af 9d3d8c                     sta ACC_T,x
  6848  70b2 9dfd8b                     sta ACC_Y,x
  6849  70b5 9d1d8c                     sta ACC_Z,x
  6850  70b8 ca                         dex
  6851  70b9 10ef                       bpl SM_ID
  6852  70bb a901                       lda #1
  6853  70bd 8dfd8b                     sta ACC_Y          ; Y = 1
  6854  70c0 8d1d8c                     sta ACC_Z          ; Z = 1
  6855                                  ; ascending counter SM_CNT = 0..255 ; bit to test = 255 - SM_CNT.
  6856                                  ; (Ascending counter, because 255 as start value is negative and breaks BPL.)
  6857  70c3 a900                       lda #0
  6858  70c5 8d1088                     sta SM_CNT
  6859                          SM_LOOP
  6860                                  ; SM_BIT = 255 - SM_CNT
  6861  70c8 a9ff                       lda #255
  6862  70ca 38                         sec
  6863  70cb ed1088                     sbc SM_CNT
  6864  70ce 8d0f88                     sta SM_BIT
  6865                                  ; --- ACC = 2*ACC ---  (copy ACC->A-coords, dbl, R->ACC)
  6866  70d1 a21fbddd8b9d1d89...        +fcopy AX, ACC_X
  6867  70dc a21fbdfd8b9d3d89...        +fcopy AY, ACC_Y
  6868  70e7 a21fbd1d8c9d5d89...        +fcopy AZ, ACC_Z
  6869  70f2 a21fbd3d8c9d7d89...        +fcopy AT, ACC_T
  6870  70fd 20f76e                     jsr POINT_DBL
  6871  7100 a21fbd1d8a9ddd8b...        +fcopy ACC_X, RX
  6872  710b a21fbd3d8a9dfd8b...        +fcopy ACC_Y, RY
  6873  7116 a21fbd5d8a9d1d8c...        +fcopy ACC_Z, RZ
  6874  7121 a21fbd7d8a9d3d8c...        +fcopy ACC_T, RT
  6875                                  ; --- test bit SM_BIT of SCALAR ---
  6876  712c 20de72                     jsr SM_TESTBIT     ; C = bit
  6877  712f b003                       bcs SM_DOADD       ; bit set -> conditional addition
  6878  7131 4cbb71                     jmp SM_NEXT        ; bit 0 -> skip (JMP due to distance)
  6879                          SM_DOADD
  6880                                  ; --- ACC = ACC + PIN --- (A=ACC, B=PIN, R->ACC)
  6881  7134 a21fbddd8b9d1d89...        +fcopy AX, ACC_X
  6882  713f a21fbdfd8b9d3d89...        +fcopy AY, ACC_Y
  6883  714a a21fbd1d8c9d5d89...        +fcopy AZ, ACC_Z
  6884  7155 a21fbd3d8c9d7d89...        +fcopy AT, ACC_T
  6885  7160 a21fbd5d8c9d9d89...        +fcopy BX_, PIN_X
  6886  716b a21fbd7d8c9dbd89...        +fcopy BY_, PIN_Y
  6887  7176 a21fbd9d8c9ddd89...        +fcopy BZ_, PIN_Z
  6888  7181 a21fbdbd8c9dfd89...        +fcopy BT_, PIN_T
  6889  718c 20106d                     jsr POINT_ADD
  6890  718f a21fbd1d8a9ddd8b...        +fcopy ACC_X, RX
  6891  719a a21fbd3d8a9dfd8b...        +fcopy ACC_Y, RY
  6892  71a5 a21fbd5d8a9d1d8c...        +fcopy ACC_Z, RZ
  6893  71b0 a21fbd7d8a9d3d8c...        +fcopy ACC_T, RT
  6894                          SM_NEXT
  6895  71bb ee1088                     inc SM_CNT
  6896  71be ad1088                     lda SM_CNT         ; set Z flag; after 256 iterations (0..255) wraps to 0
  6897  71c1 f003                       beq SM_DONE        ; done when all 256 bits processed
  6898  71c3 4cc870                     jmp SM_LOOP        ; else continue (JMP due to large loop body)
  6899                          SM_DONE
  6900  71c6 60                         RTS
  6901                          
  6902                          ; ================================================================
  6903                          ; SCALAR_MUL_N : like SCALAR_MUL but processes only the lowest
  6904                          ; SM_NBITS bits (from bit SM_NBITS-1 down to 0). Identical loop logic;
  6905                          ; meant to test double-and-add with multiple ADDs FAST in py65.
  6906                          ; ================================================================
  6907                          SCALAR_MUL_N
  6908  71c7 a21f                       ldx #31
  6909  71c9 a900               SN_ID   lda #0
  6910  71cb 9ddd8b                     sta ACC_X,x
  6911  71ce 9d3d8c                     sta ACC_T,x
  6912  71d1 9dfd8b                     sta ACC_Y,x
  6913  71d4 9d1d8c                     sta ACC_Z,x
  6914  71d7 ca                         dex
  6915  71d8 10ef                       bpl SN_ID
  6916  71da a901                       lda #1
  6917  71dc 8dfd8b                     sta ACC_Y
  6918  71df 8d1d8c                     sta ACC_Z
  6919                                  ; SM_BIT = SM_NBITS-1 (start), count down below 0
  6920  71e2 ad1188                     lda SM_NBITS
  6921  71e5 38                         sec
  6922  71e6 e901                       sbc #1
  6923  71e8 8d0f88                     sta SM_BIT
  6924                          SN_LOOP
  6925                                  ; ACC = 2*ACC
  6926  71eb a21fbddd8b9d1d89...        +fcopy AX, ACC_X
  6927  71f6 a21fbdfd8b9d3d89...        +fcopy AY, ACC_Y
  6928  7201 a21fbd1d8c9d5d89...        +fcopy AZ, ACC_Z
  6929  720c a21fbd3d8c9d7d89...        +fcopy AT, ACC_T
  6930  7217 20f76e                     jsr POINT_DBL
  6931  721a a21fbd1d8a9ddd8b...        +fcopy ACC_X, RX
  6932  7225 a21fbd3d8a9dfd8b...        +fcopy ACC_Y, RY
  6933  7230 a21fbd5d8a9d1d8c...        +fcopy ACC_Z, RZ
  6934  723b a21fbd7d8a9d3d8c...        +fcopy ACC_T, RT
  6935  7246 20de72                     jsr SM_TESTBIT
  6936  7249 b003                       bcs SN_DOADD
  6937  724b 4cd572                     jmp SN_NEXT
  6938                          SN_DOADD
  6939  724e a21fbddd8b9d1d89...        +fcopy AX, ACC_X
  6940  7259 a21fbdfd8b9d3d89...        +fcopy AY, ACC_Y
  6941  7264 a21fbd1d8c9d5d89...        +fcopy AZ, ACC_Z
  6942  726f a21fbd3d8c9d7d89...        +fcopy AT, ACC_T
  6943  727a a21fbd5d8c9d9d89...        +fcopy BX_, PIN_X
  6944  7285 a21fbd7d8c9dbd89...        +fcopy BY_, PIN_Y
  6945  7290 a21fbd9d8c9ddd89...        +fcopy BZ_, PIN_Z
  6946  729b a21fbdbd8c9dfd89...        +fcopy BT_, PIN_T
  6947  72a6 20106d                     jsr POINT_ADD
  6948  72a9 a21fbd1d8a9ddd8b...        +fcopy ACC_X, RX
  6949  72b4 a21fbd3d8a9dfd8b...        +fcopy ACC_Y, RY
  6950  72bf a21fbd5d8a9d1d8c...        +fcopy ACC_Z, RZ
  6951  72ca a21fbd7d8a9d3d8c...        +fcopy ACC_T, RT
  6952                          SN_NEXT
  6953  72d5 ce0f88                     dec SM_BIT
  6954  72d8 3003                       bmi SN_DONE        ; SM_BIT < 0 -> done (NBITS <= 128, no wrap risk)
  6955  72da 4ceb71                     jmp SN_LOOP
  6956                          SN_DONE
  6957  72dd 60                         RTS
  6958                          
  6959                          ; ----------------------------------------------------------------
  6960                          ; SM_TESTBIT : bit index in SM_BIT (0..255) of SCALAR -> carry
  6961                          ;   byte = SCALAR[SM_BIT>>3] ; bit = SM_BIT & 7
  6962                          ; ----------------------------------------------------------------
  6963                          SM_TESTBIT
  6964  72de ad0f88                     lda SM_BIT
  6965  72e1 4a                         lsr
  6966  72e2 4a                         lsr
  6967  72e3 4a                         lsr               ; A = byte index (0..31)
  6968  72e4 aa                         tax
  6969  72e5 bddd8c                     lda SCALAR,x
  6970  72e8 8d1288                     sta SM_TMP
  6971  72eb ad0f88                     lda SM_BIT
  6972  72ee 2907                       and #7
  6973  72f0 aa                         tax               ; X = bit within byte
  6974  72f1 ad1288                     lda SM_TMP
  6975  72f4 e000               SM_TB_S cpx #0
  6976  72f6 f005                       beq SM_TB_D
  6977  72f8 4a                         lsr
  6978  72f9 ca                         dex
  6979  72fa 4cf472                     jmp SM_TB_S
  6980  72fd 2901               SM_TB_D and #1
  6981  72ff c901                       cmp #1            ; C=1 if bit set
  6982  7301 60                         rts
