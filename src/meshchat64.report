  8618  861c 20f77f                     jsr MODL                   ; ROUT = S
  8619  861f a21f                       ldx #31
  8620  8621 bdc59b9d259bca10...MAS_C3  lda ROUT,x : sta SOUT,x : dex : bpl MAS_C3
