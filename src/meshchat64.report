; ******** Source: meshchat64_combsigned.inc
     1                          ; ================================================================
     2                          ; meshchat64_combsigned.inc  -  signed-comb h=6 helpers (free RAM $BE56)
     3                          ;   CB_RECODE     : SCALAR -> MPRIME = u = (m>>1)|bit257 ; m = SCALAR|+L (odd)
     4                          ;   CB_GETBIT     : bit CB_POS (16-bit, 0..257) of MPRIME -> A (0/1)
     5                          ;   COMB_LOADPT_S : PIN = signed COMB_TABLE[CB_IDX] (XY, Z=1, T=X*Y, negX if CB_NEG)
     6                          ;                   table @ COMB_TABLE (internal, 32 points x 64 B).
     7                          ; Algorithm validated byte-exact in Python vs n*B and in py65 (0 fails).
     8                          ; ================================================================
     9                          * = $BE56
    10                          
    11                          CB_RECODE
    12  be56 a21f                       ldx #31
    13  be58 bd878c9d51bfca10...CRC_C   lda SCALAR,x : sta MPRIME,x : dex : bpl CRC_C
    14  be61 a9008d71bf                 lda #0 : sta MPRIME+32
    15  be66 ad878c2901d01a             lda SCALAR : and #1 : bne CRC_ODD     ; odd -> no +L
    16  be6d 18                         clc
    17  be6e a200                       ldx #0
    18  be70 a020                       ldy #32                                ; DEY counter (CPX clobbers carry!)
    19  be72 bd51bf7d0f9b9d51...CRC_AD  lda MPRIME,x : adc LT,x : sta MPRIME,x
    20  be7b e888d0f3                   inx : dey : bne CRC_AD
    21  be7f ad71bf69008d71bf           lda MPRIME+32 : adc #0 : sta MPRIME+32
    22                          CRC_ODD
    23  be87 18                         clc                                    ; MPRIME >>= 1 (33 bytes)
    24  be88 a220                       ldx #32
    25  be8a 7e51bfca10fa       CRC_SH  ror MPRIME,x : dex : bpl CRC_SH
    26  be90 ad71bf09028d71bf           lda MPRIME+32 : ora #$02 : sta MPRIME+32   ; force bit257 (= NB-1)
    27  be98 60                         rts
    28                          
    29                          ; --- bit CB_POS (16-bit, 0..257) of MPRIME -> A=0/1 ---
    30                          CB_GETBIT
    31  be99 ad72bf8d76bf               lda CB_POS : sta CB_TMP
    32  be9f 4e76bf4e76bf4e76...        lsr CB_TMP : lsr CB_TMP : lsr CB_TMP      ; (low>>3) 0..31
    33  bea8 ad73bf                     lda CB_POS+1                              ; high byte (0 or 1)
    34  beab 0a0a0a0a0a                 asl : asl : asl : asl : asl               ; high<<5 (0 or 32)
    35  beb0 186d76bfaa                 clc : adc CB_TMP : tax                     ; byte index 0..32
    36  beb5 bd51bf8d76bf               lda MPRIME,x : sta CB_TMP
    37  bebb ad72bf2907aa               lda CB_POS : and #7 : tax
    38  bec1 e000               CBG_S   cpx #0
    39  bec3 f007                       beq CBG_D
    40  bec5 4e76bf                     lsr CB_TMP
    41  bec8 ca                         dex
    42  bec9 4cc1be                     jmp CBG_S
    43  becc ad76bf2901         CBG_D   lda CB_TMP : and #1
    44  bed1 60                         rts
    45                          
    46                          ; --- PIN = signed COMB_TABLE[CB_IDX]  (32 x 64 B internal, src = +idx*64) ---
    47                          COMB_LOADPT_S
    48  bed2 ada1a82903                 lda CB_IDX : and #3
    49  bed7 0a0a0a0a0a0a               asl : asl : asl : asl : asl : asl          ; (idx&3)*64
    50  bedd 8da3a8                     sta CB_LO
    51  bee0 ada1a84a4a8da2a8           lda CB_IDX : lsr : lsr : sta CB_HI          ; idx>>2
    52  bee8 18                         clc
    53  bee9 a9006da3a88dfcbe           lda #<COMB_TABLE : adc CB_LO : sta CBS_RD+1
    54  bef1 a9a96da2a88dfdbe           lda #>COMB_TABLE : adc CB_HI : sta CBS_RD+2
    55  bef9 a000                       ldy #0
    56  befb b900a9             CBS_RD  lda COMB_TABLE,y                            ; self-modified operand
    57  befe 99078c                     sta PIN_X,y                                ; PIN_X (0..31) + PIN_Y (32..63)
    58  bf01 c8                         iny
    59  bf02 c040                       cpy #64
    60  bf04 d0f5                       bne CBS_RD
    61  bf06 ad75bff01b                 lda CB_NEG : beq CBS_NN                     ; negate X if tooth0 sign -
    62  bf0b a9c785fba98c85fc...        +fsub PIN_X, P_CONST, PIN_X
    63                          CBS_NN
    64  bf26 a900                       lda #0                                      ; Z = 1
    65  bf28 a21f                       ldx #31
    66  bf2a 9d478cca10fa       CBS_ZC  sta PIN_Z,x : dex : bpl CBS_ZC
    67  bf30 a9018d478c                 lda #1 : sta PIN_Z
