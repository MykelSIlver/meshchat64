  7429                          ; --- SHR_TA: shift SHA_TA right by SHA_N bits (fills high with 0) ---
  7430  7986 ad009a             SHR_TA  LDA SHA_N
  7431  7989 4a                         LSR
  7432  798a 4a                         LSR
  7433  798b 4a                         LSR
  7434  798c 8d019a                     STA SHA_BK              ; bytes
  7435  798f f033                       BEQ SH_BIT
  7436                                  ; byte shift right (LE: out[i]=in[i+k] or 0): do k times a 1-byte shift
  7437  7991 a200               SH_BYL  LDX #0
  7438  7993 e007               SH_BY1  CPX #7
  7439  7995 f003                       BEQ SH_BYT
  7440  7997 bc1193                     LDY SHA_TA+1,X          ; placeholder (see below) -- replaced
  7441  799a ea                 SH_BYT  NOP
  7442                                  ; (simplified: byte shift via loop below)
  7443  799b 4c9e79                     JMP SH_BYDONE
  7444                          SH_BYDONE
  7445                                  ; simple byte shift: move elements down k times
  7446  799e ad019a                     LDA SHA_BK
  7447  79a1 8d039a                     STA SHA_BC2
  7448  79a4 ad039a             SH_KL   LDA SHA_BC2
  7449  79a7 f01b                       BEQ SH_BIT
  7450  79a9 a200                       LDX #0
  7451  79ab e007               SH_SL   CPX #7
  7452  79ad f00a                       BEQ SH_SLT
  7453  79af bd1193                     LDA SHA_TA+1,X
  7454  79b2 9d1093                     STA SHA_TA,X
  7455  79b5 e8                         INX
  7456  79b6 4cab79                     JMP SH_SL
  7457  79b9 a900               SH_SLT  LDA #0
  7458  79bb 8d1793                     STA SHA_TA+7
  7459  79be ce039a                     DEC SHA_BC2
  7460  79c1 4ca479                     JMP SH_KL
  7461  79c4 ad009a             SH_BIT  LDA SHA_N
  7462  79c7 2907                       AND #7
  7463  79c9 8d029a                     STA SHA_BC
  7464  79cc ad029a             SH_BBL  LDA SHA_BC
  7465  79cf f009                       BEQ SH_DN
  7466  79d1 203879                     JSR SHR1_TA
  7467  79d4 ce029a                     DEC SHA_BC
  7468  79d7 4ccc79                     JMP SH_BBL
  7469  79da 60                 SH_DN   RTS
