  9423                          ; ================================================================
  9424                          ; Mode dispatch (item 2): choose 128- or 256-bit routine on USE_256.
  9425                          ;   Identical calling convention (no args; read global state),
  9426                          ;   so the tail-JMP preserves the RTS semantics to the original caller.
  9427                          ; ================================================================
  9428                          WS_AUTH_DISPATCH
  9429  a2f1 ad6039                     LDA USE_256
  9430  a2f4 f003                       BEQ WAD_128
  9431  a2f6 4ca69e                     JMP WS_AUTH256
  9432  a2f9 4c9330             WAD_128 JMP WS_AUTH
  9433                          WS_SEND_DISPATCH
  9434  a2fc ad6039                     LDA USE_256
  9435  a2ff f003                       BEQ WSD_128
  9436  a301 4cb9a0                     JMP WS_SEND_MSG256
  9437  a304 4c9630             WSD_128 JMP WS_SEND_MSG
  9438                          
  9439                          ; ================================================================
  9440                          ; B64URL_ENCODE32 - 32 bytes (B64E_IN) -> 43 base64url chars (B64E_OUT)
  9441                          ;   10 groups of 3->4 chars (40) + last 2 bytes -> 3 chars (40,41,42).
  9442                          ;   6-bit value -> char via B64_TABLE (value = index). No padding.
  9443                          ; ================================================================
  9444                          B64URL_ENCODE32
  9445  a307 a900                       LDA #0
  9446  a309 8dad39                     STA B64E_GRP
  9447                          B64E_GLP
  9448  a30c adad39                     LDA B64E_GRP
  9449  a30f c90a                       CMP #10
  9450  a311 d003                       BNE B64E_GC
  9451  a313 4c8ca3                     JMP B64E_LAST
  9452                          B64E_GC
  9453                                  ; in-offset = GRP*3 -> load B0/B1/B2
  9454  a316 0a                         ASL
  9455  a317 18                         CLC
  9456  a318 6dad39                     ADC B64E_GRP
  9457  a31b aa                         TAX
  9458  a31c bd6139                     LDA B64E_IN,X
  9459  a31f 8dae39                     STA B64E_B0
  9460  a322 bd6239                     LDA B64E_IN+1,X
  9461  a325 8daf39                     STA B64E_B1
  9462  a328 bd6339                     LDA B64E_IN+2,X
  9463  a32b 8db039                     STA B64E_B2
  9464                                  ; out-offset = GRP*4
  9465  a32e adad39                     LDA B64E_GRP
  9466  a331 0a                         ASL
  9467  a332 0a                         ASL
  9468  a333 aa                         TAX
  9469                                  ; c0 = B0>>2
  9470  a334 adae39                     LDA B64E_B0
  9471  a337 4a                         LSR
  9472  a338 4a                         LSR
  9473  a339 a8                         TAY
  9474  a33a b9d06c                     LDA B64_TABLE,Y
  9475  a33d 9d8139                     STA B64E_OUT,X
  9476                                  ; c1 = ((B0 and 3)<<4) | (B1>>4)
  9477  a340 adae39                     LDA B64E_B0
  9478  a343 2903                       AND #$03
  9479  a345 0a                         ASL
  9480  a346 0a                         ASL
  9481  a347 0a                         ASL
  9482  a348 0a                         ASL
  9483  a349 8db139                     STA B64E_T
  9484  a34c adaf39                     LDA B64E_B1
  9485  a34f 4a                         LSR
  9486  a350 4a                         LSR
  9487  a351 4a                         LSR
  9488  a352 4a                         LSR
  9489  a353 0db139                     ORA B64E_T
  9490  a356 a8                         TAY
  9491  a357 b9d06c                     LDA B64_TABLE,Y
  9492  a35a 9d8239                     STA B64E_OUT+1,X
  9493                                  ; c2 = ((B1 and $0F)<<2) | (B2>>6)
  9494  a35d adaf39                     LDA B64E_B1
  9495  a360 290f                       AND #$0F
  9496  a362 0a                         ASL
  9497  a363 0a                         ASL
  9498  a364 8db139                     STA B64E_T
  9499  a367 adb039                     LDA B64E_B2
  9500  a36a 4a                         LSR
  9501  a36b 4a                         LSR
  9502  a36c 4a                         LSR
  9503  a36d 4a                         LSR
  9504  a36e 4a                         LSR
  9505  a36f 4a                         LSR
  9506  a370 0db139                     ORA B64E_T
  9507  a373 a8                         TAY
  9508  a374 b9d06c                     LDA B64_TABLE,Y
  9509  a377 9d8339                     STA B64E_OUT+2,X
  9510                                  ; c3 = B2 and $3F
  9511  a37a adb039                     LDA B64E_B2
  9512  a37d 293f                       AND #$3F
  9513  a37f a8                         TAY
  9514  a380 b9d06c                     LDA B64_TABLE,Y
  9515  a383 9d8439                     STA B64E_OUT+3,X
  9516  a386 eead39                     INC B64E_GRP
  9517  a389 4c0ca3                     JMP B64E_GLP
  9518                          B64E_LAST
  9519                                  ; last 2 bytes (in 30,31) -> 3 chars (out 40,41,42)
  9520  a38c ad7f39                     LDA B64E_IN+30
  9521  a38f 8dae39                     STA B64E_B0
  9522  a392 ad8039                     LDA B64E_IN+31
  9523  a395 8daf39                     STA B64E_B1
  9524                                  ; c0 = B0>>2
  9525  a398 adae39                     LDA B64E_B0
  9526  a39b 4a                         LSR
  9527  a39c 4a                         LSR
  9528  a39d a8                         TAY
  9529  a39e b9d06c                     LDA B64_TABLE,Y
  9530  a3a1 8da939                     STA B64E_OUT+40
  9531                                  ; c1 = ((B0 and 3)<<4) | (B1>>4)
  9532  a3a4 adae39                     LDA B64E_B0
  9533  a3a7 2903                       AND #$03
  9534  a3a9 0a                         ASL
  9535  a3aa 0a                         ASL
  9536  a3ab 0a                         ASL
  9537  a3ac 0a                         ASL
  9538  a3ad 8db139                     STA B64E_T
  9539  a3b0 adaf39                     LDA B64E_B1
  9540  a3b3 4a                         LSR
  9541  a3b4 4a                         LSR
  9542  a3b5 4a                         LSR
  9543  a3b6 4a                         LSR
  9544  a3b7 0db139                     ORA B64E_T
  9545  a3ba a8                         TAY
  9546  a3bb b9d06c                     LDA B64_TABLE,Y
  9547  a3be 8daa39                     STA B64E_OUT+41
  9548                                  ; c2 = (B1 and $0F)<<2
  9549  a3c1 adaf39                     LDA B64E_B1
  9550  a3c4 290f                       AND #$0F
  9551  a3c6 0a                         ASL
  9552  a3c7 0a                         ASL
  9553  a3c8 a8                         TAY
  9554  a3c9 b9d06c                     LDA B64_TABLE,Y
  9555  a3cc 8dab39                     STA B64E_OUT+42
  9556  a3cf 60                         RTS
  9557                          
  9558                          ; ================================================================
  9559                          ; COMPUTE_C64_ID256 - 256-bit publicId in C64_IDSTR (16 base64url chars)
  9560                          ;   = base64url( SHA-256(HKDF_OKM[0:32])[0:12] ).  One SHA-256 block
  9561                          ;   (32 data bytes + padding). Jumps to the shared digest/base64 tail.
  9562                          ; ================================================================
  9563                          COMPUTE_C64_ID256
  9564                                  ; encKey = HKDF_OKM[0:32] -> SHA_BLK[0:32]
  9565  a3d0 a21f                       LDX #31
  9566  a3d2 bde038             C256_CP LDA HKDF_OKM,X
  9567  a3d5 9da935                     STA SHA_BLK,X
  9568  a3d8 ca                         DEX
  9569  a3d9 10f7                       BPL C256_CP
  9570                                  ; clear SHA_BLK[32:64]
  9571  a3db a220                       LDX #32
  9572  a3dd a900               C256_CL LDA #$00
  9573  a3df 9da935                     STA SHA_BLK,X
  9574  a3e2 e8                         INX
  9575  a3e3 e040                       CPX #64
  9576  a3e5 d0f6                       BNE C256_CL
  9577                                  ; SHA-256 padding: $80 op pos 32; bitlengte = 256 = $0100
  9578  a3e7 a980                       LDA #$80
  9579  a3e9 8dc935                     STA SHA_BLK+32
  9580  a3ec a901                       LDA #$01            ; 256 bits high byte
  9581  a3ee 8de735                     STA SHA_BLK+62
  9582  a3f1 a900                       LDA #$00            ; 256 bits low byte
  9583  a3f3 8de835                     STA SHA_BLK+63
  9584  a3f6 208f17                     JSR SHA_INIT
  9585  a3f9 20ac16                     JSR SHA_EXPAND
  9586  a3fc 203018                     JSR SHA_COMPRESS
  9587  a3ff 4c4229                     JMP CC4_DIGEST_TAIL   ; gedeelde digest-copy + B64URL_12BYTES + RTS
  9588                          
  9589                          ; ================================================================
  9590                          ; SHAREABLE_BUILD256 - eigen shareable in SHARE_STR (nul-beeindigd):
  9591                          ;   base64url(HKDF_OKM[0:32]) '.' base64url(SK_PUB)
  9592                          ;   43 + 1 + 43 + null = 88 bytes. Requires SIGN_SETUP run (SK_PUB).
  9593                          ; ================================================================
  9594                          SHAREABLE_BUILD256
  9595                                  ; --- segment 1: encKey = HKDF_OKM[0:32] ---
  9596  a402 a21f                       LDX #31
  9597  a404 bde038             SB_C1   LDA HKDF_OKM,X
  9598  a407 9d6139                     STA B64E_IN,X
  9599  a40a ca                         DEX
  9600  a40b 10f7                       BPL SB_C1
  9601  a40d 2007a3                     JSR B64URL_ENCODE32
  9602  a410 a22a                       LDX #42
  9603  a412 bd8139             SB_O1   LDA B64E_OUT,X
  9604  a415 9db239                     STA SHARE_STR,X
  9605  a418 ca                         DEX
  9606  a419 10f7                       BPL SB_O1
  9607                                  ; scheider '.'
  9608  a41b a92e                       LDA #$2E
  9609  a41d 8ddd39                     STA SHARE_STR+43
  9610                                  ; --- segment 2: signPubkey = SK_PUB ---
  9611  a420 a21f                       LDX #31
  9612  a422 bde09d             SB_C2   LDA SK_PUB,X
  9613  a425 9d6139                     STA B64E_IN,X
  9614  a428 ca                         DEX
  9615  a429 10f7                       BPL SB_C2
  9616  a42b 2007a3                     JSR B64URL_ENCODE32
  9617  a42e a22a                       LDX #42
  9618  a430 bd8139             SB_O2   LDA B64E_OUT,X
  9619  a433 9dde39                     STA SHARE_STR+44,X
  9620  a436 ca                         DEX
  9621  a437 10f7                       BPL SB_O2
  9622                                  ; scheider '.' na segment 2
  9623  a439 a92e                       LDA #$2E
  9624  a43b 8d093a                     STA SHARE_STR+87
  9625                                  ; --- segment 3: relayWss = btoa(wssUrl), precomputed base64 ---
  9626  a43e a22b                       LDX #43
  9627  a440 bd523a             SB_O3   LDA STR_RELAY_B64,X
  9628  a443 9d0a3a                     STA SHARE_STR+88,X
  9629  a446 ca                         DEX
  9630  a447 10f7                       BPL SB_O3
  9631                                  ; null-terminator
  9632  a449 a900                       LDA #$00
  9633  a44b 8d363a                     STA SHARE_STR+132
  9634  a44e 60                         RTS
  9635                          
  9636                          ; ================================================================
  9637                          ; SHOW_SHAREABLE - show own shareable (only in 256-bit mode).
  9638                          ;   Builds SHARE_STR fresh (SHAREABLE_BUILD256) and prints label + string.
  9639                          ;   Requires HKDF_OKM[0:32] + SK_PUB filled (DERIVE_KEYPAIR + SIGN_SETUP).
  9640                          ; ================================================================
  9641                          SHOW_SHAREABLE
  9642  a44f ad6039                     LDA USE_256
  9643  a452 d001                       BNE SS_GO
  9644  a454 60                         RTS                 ; 128-bit: show nothing
  9645  a455 2002a4             SS_GO   JSR SHAREABLE_BUILD256
  9646  a458 a99e                       LDA #$9E            ; yellow
  9647  a45a 20ba0c                     JSR PRINT_CHR
  9648  a45d a97e                       LDA #<STR_SHARE_LBL
  9649  a45f 85fb                       STA $FB
  9650  a461 a93a                       LDA #>STR_SHARE_LBL
  9651  a463 85fc                       STA $FC
  9652  a465 20cf0c                     JSR PRINT_STR_FB
  9653  a468 a90d                       LDA #$0D
  9654  a46a 20ba0c                     JSR PRINT_CHR
  9655  a46d a905                       LDA #$05            ; wit
  9656  a46f 20ba0c                     JSR PRINT_CHR
  9657  a472 a9b2                       LDA #<SHARE_STR
  9658  a474 85fb                       STA $FB
  9659  a476 a939                       LDA #>SHARE_STR
  9660  a478 85fc                       STA $FC
  9661  a47a 20cf0c                     JSR PRINT_STR_FB
  9662  a47d a90d                       LDA #$0D
  9663  a47f 20ba0c                     JSR PRINT_CHR
  9664  a482 60                         RTS
  9665                          
  9666                          ; ================================================================
  9667                          ; MC_BOOT_MENU - choose identity path at boot.
  9668                          ;   '1' -> MC_SETUP (128-bit, paste)   '2' -> MC_LOGIN (256-bit, passphrase)
  9669                          ;   Tail-JMP to the chosen routine (which RTSes to the init).
  9670                          ; ================================================================
  9671                          ; ================================================================
  9672                          ; MC_BOOT_MENU REMOVED (AES128 cleanup) - never called,
  9673                          ; ACME itself flagged this as 'unused'. Stub + pin keeps RCV_DECRYPT_
  9674                          ; DISPATCH after this byte-identical.
  9675                          ; ================================================================
  9676                          MC_BOOT_MENU
  9677  a483 60                         RTS
  9678                          * = $A4B4                       ; pin: RCV_DECRYPT_DISPATCH at original address
  9679                          
  9680                          ; ================================================================
  9681                          ; RCV_DECRYPT_DISPATCH - decrypt received message per USE_256.
  9682                          ;   Call AFTER loading AES_NONCE (common). Input:
  9683                          ;     RCV_CT (ct||tag), RCV_PT_LEN (= CT_LEN-16, 16-bit), AES_NONCE.
  9684                          ;   Out: GCM_CTBUF = plaintext ; carry=1 on tag error (both paths).
  9685                          ; ================================================================
  9686                          RCV_DECRYPT_DISPATCH
  9687  a4b4 ad6039                     LDA USE_256
  9688  a4b7 d029                       BNE RDD_256
  9689                                  ; --- 128-bit: AES-128-GCM with KEY_SELF ---
  9690  a4b9 a20f                       LDX #15
  9691  a4bb bd2039             RDD_KL  LDA KEY_SELF,X
  9692  a4be 9ded52                     STA GCM_IN_KEY,X
  9693  a4c1 ca                         DEX
  9694  a4c2 10f7                       BPL RDD_KL
  9695  a4c4 a9de                       LDA #<RCV_CT
  9696  a4c6 8dfd52                     STA GCM_PT_PTR+0
  9697  a4c9 a95a                       LDA #>RCV_CT
  9698  a4cb 8dfe52                     STA GCM_PT_PTR+1
  9699  a4ce adbf5a                     LDA RCV_PT_LEN+0
  9700  a4d1 8dff52                     STA GCM_PT_LEN+0
  9701  a4d4 adc05a                     LDA RCV_PT_LEN+1
  9702  a4d7 8d0053                     STA GCM_PT_LEN+1
  9703  a4da a901                       LDA #1
  9704  a4dc 8d8152                     STA GCM_DO_VERIFY
  9705  a4df 4c2a2e                     JMP AES_GCM_DECRYPT     ; tail: set carry + GCM_CTBUF, RTSes to caller
  9706                          RDD_256
  9707                                  ; --- 256-bit: AES-256-GCM with HKDF_OKM[0:32] ---
  9708  a4e2 a21f                       LDX #31
  9709  a4e4 bde038             RDD_KS  LDA HKDF_OKM,X
  9710  a4e7 9dcf4a                     STA AES_KEY,X
  9711  a4ea ca                         DEX
  9712  a4eb 10f7                       BPL RDD_KS
  9713                                  ; CTBUF = RCV_CT[0:PT_LEN]
  9714  a4ed a9de8da09e                 LDA #<RCV_CT : STA MSG_PTR
  9715  a4f2 a95a8da19e                 LDA #>RCV_CT : STA MSG_PTR+1
  9716  a4f7 adbf5a8da29e               LDA RCV_PT_LEN+0 : STA MSG_LEN
  9717  a4fd adc05a8da39e               LDA RCV_PT_LEN+1 : STA MSG_LEN+1
  9718  a503 a9738504                   LDA #<CTBUF : STA CDST
  9719  a507 a94d8505                   LDA #>CTBUF : STA CDST+1
  9720  a50b 207087                     JSR COPY_M
  9721                                  ; GCM_RECV_TAG = RCV_CT[PT_LEN : PT_LEN+16]
  9722  a50e a9de186dbf5a8da0...        LDA #<RCV_CT : CLC : ADC RCV_PT_LEN+0 : STA MSG_PTR
  9723  a517 a95a6dc05a8da19e           LDA #>RCV_CT : ADC RCV_PT_LEN+1 : STA MSG_PTR+1
  9724  a51f a9108da29e                 LDA #16 : STA MSG_LEN
  9725  a524 a9008da39e                 LDA #0  : STA MSG_LEN+1
  9726  a529 a9718504                   LDA #<GCM_RECV_TAG : STA CDST
  9727  a52d a9528505                   LDA #>GCM_RECV_TAG : STA CDST+1
  9728  a531 207087                     JSR COPY_M
  9729                                  ; PTLEN = RCV_PT_LEN
  9730  a534 adbf5a8df14a               LDA RCV_PT_LEN+0 : STA PTLEN+0
  9731  a53a adc05a8df24a               LDA RCV_PT_LEN+1 : STA PTLEN+1
  9732  a540 206e48                     JSR AGD256              ; -> PTBUF ; VERIFY_FAIL
  9733                                  ; PTBUF -> GCM_CTBUF (so the existing parser works unchanged)
  9734  a543 a9f38da09e                 LDA #<PTBUF : STA MSG_PTR
  9735  a548 a94a8da19e                 LDA #>PTBUF : STA MSG_PTR+1
  9736  a54d adbf5a8da29e               LDA RCV_PT_LEN+0 : STA MSG_LEN
  9737  a553 adc05a8da39e               LDA RCV_PT_LEN+1 : STA MSG_LEN+1
  9738  a559 a9018504                   LDA #<GCM_CTBUF : STA CDST
  9739  a55d a9538505                   LDA #>GCM_CTBUF : STA CDST+1
  9740  a561 207087                     JSR COPY_M
  9741                                  ; carry from VERIFY_FAIL (1=error -> C=1)
  9742  a564 adf04a                     LDA VERIFY_FAIL
  9743  a567 f002                       BEQ RDD_OK
  9744  a569 38                         SEC
  9745  a56a 60                         RTS
  9746  a56b 18                 RDD_OK  CLC
  9747  a56c 60                         RTS
  9748                          
  9749                          ; ================================================================
  9750                          ; COMPUTE_PEER_ID256 - PEER_IDSTR = base64url(SHA-256(KEY_PEER256)[0:12]).
  9751                          ;   Standalone (does not touch C64_IDSTR). Reuses B64E_* scratch.
  9752                          ; ================================================================
  9753                          COMPUTE_PEER_ID256
  9754  a56d a21f                       LDX #31
  9755  a56f bd4039             CP2_CP  LDA KEY_PEER256,X
  9756  a572 9da935                     STA SHA_BLK,X
  9757  a575 ca                         DEX
  9758  a576 10f7                       BPL CP2_CP
  9759  a578 a220                       LDX #32
  9760  a57a a900               CP2_CL  LDA #$00
  9761  a57c 9da935                     STA SHA_BLK,X
  9762  a57f e8                         INX
  9763  a580 e040                       CPX #64
  9764  a582 d0f6                       BNE CP2_CL
  9765  a584 a980                       LDA #$80
  9766  a586 8dc935                     STA SHA_BLK+32
  9767  a589 a901                       LDA #$01
  9768  a58b 8de735                     STA SHA_BLK+62
  9769  a58e a900                       LDA #$00
  9770  a590 8de835                     STA SHA_BLK+63
  9771  a593 208f17                     JSR SHA_INIT
  9772  a596 20ac16                     JSR SHA_EXPAND
  9773  a599 203018                     JSR SHA_COMPRESS
  9774                                  ; digest 12 bytes (big-endian per word) -> PEER_IDBYTES
  9775  a59c ad7e358ddf3a               LDA SHA_H0+3 : STA PEER_IDBYTES+0
  9776  a5a2 ad7d358de03a               LDA SHA_H0+2 : STA PEER_IDBYTES+1
  9777  a5a8 ad7c358de13a               LDA SHA_H0+1 : STA PEER_IDBYTES+2
  9778  a5ae ad7b358de23a               LDA SHA_H0+0 : STA PEER_IDBYTES+3
  9779  a5b4 ad82358de33a               LDA SHA_H1+3 : STA PEER_IDBYTES+4
  9780  a5ba ad81358de43a               LDA SHA_H1+2 : STA PEER_IDBYTES+5
  9781  a5c0 ad80358de53a               LDA SHA_H1+1 : STA PEER_IDBYTES+6
  9782  a5c6 ad7f358de63a               LDA SHA_H1+0 : STA PEER_IDBYTES+7
  9783  a5cc ad86358de73a               LDA SHA_H2+3 : STA PEER_IDBYTES+8
  9784  a5d2 ad85358de83a               LDA SHA_H2+2 : STA PEER_IDBYTES+9
  9785  a5d8 ad84358de93a               LDA SHA_H2+1 : STA PEER_IDBYTES+10
  9786  a5de ad83358dea3a               LDA SHA_H2+0 : STA PEER_IDBYTES+11
  9787                                  ; base64url 12 bytes -> PEER_IDSTR[16] (4 groepen 3->4)
  9788  a5e4 a900                       LDA #0
  9789  a5e6 8dad39                     STA B64E_GRP
  9790  a5e9 adad39             CP2_GLP LDA B64E_GRP
  9791  a5ec c904                       CMP #4
  9792  a5ee d003                       BNE CP2_GC
  9793  a5f0 4c69a6                     JMP CP2_DONE
  9794  a5f3 0a                 CP2_GC  ASL
  9795  a5f4 18                         CLC
  9796  a5f5 6dad39                     ADC B64E_GRP
  9797  a5f8 aa                         TAX
  9798  a5f9 bddf3a                     LDA PEER_IDBYTES,X
  9799  a5fc 8dae39                     STA B64E_B0
  9800  a5ff bde03a                     LDA PEER_IDBYTES+1,X
  9801  a602 8daf39                     STA B64E_B1
  9802  a605 bde13a                     LDA PEER_IDBYTES+2,X
  9803  a608 8db039                     STA B64E_B2
  9804  a60b adad39                     LDA B64E_GRP
  9805  a60e 0a                         ASL
  9806  a60f 0a                         ASL
  9807  a610 aa                         TAX
  9808  a611 adae39                     LDA B64E_B0
  9809  a614 4a                         LSR
  9810  a615 4a                         LSR
  9811  a616 a8                         TAY
  9812  a617 b9d06c                     LDA B64_TABLE,Y
  9813  a61a 9d3c40                     STA PEER_IDSTR,X
  9814  a61d adae39                     LDA B64E_B0
  9815  a620 2903                       AND #$03
  9816  a622 0a                         ASL
  9817  a623 0a                         ASL
  9818  a624 0a                         ASL
  9819  a625 0a                         ASL
  9820  a626 8db139                     STA B64E_T
  9821  a629 adaf39                     LDA B64E_B1
  9822  a62c 4a                         LSR
  9823  a62d 4a                         LSR
  9824  a62e 4a                         LSR
  9825  a62f 4a                         LSR
  9826  a630 0db139                     ORA B64E_T
  9827  a633 a8                         TAY
  9828  a634 b9d06c                     LDA B64_TABLE,Y
  9829  a637 9d3d40                     STA PEER_IDSTR+1,X
  9830  a63a adaf39                     LDA B64E_B1
  9831  a63d 290f                       AND #$0F
  9832  a63f 0a                         ASL
  9833  a640 0a                         ASL
  9834  a641 8db139                     STA B64E_T
  9835  a644 adb039                     LDA B64E_B2
  9836  a647 4a                         LSR
  9837  a648 4a                         LSR
  9838  a649 4a                         LSR
  9839  a64a 4a                         LSR
  9840  a64b 4a                         LSR
  9841  a64c 4a                         LSR
  9842  a64d 0db139                     ORA B64E_T
  9843  a650 a8                         TAY
  9844  a651 b9d06c                     LDA B64_TABLE,Y
  9845  a654 9d3e40                     STA PEER_IDSTR+2,X
  9846  a657 adb039                     LDA B64E_B2
  9847  a65a 293f                       AND #$3F
  9848  a65c a8                         TAY
  9849  a65d b9d06c                     LDA B64_TABLE,Y
  9850  a660 9d3f40                     STA PEER_IDSTR+3,X
  9851  a663 eead39                     INC B64E_GRP
  9852  a666 4ce9a5                     JMP CP2_GLP
  9853                          CP2_DONE
  9854  a669 a900                       LDA #0
  9855  a66b 8d4c40                     STA PEER_IDSTR+16
  9856  a66e 60                         RTS
