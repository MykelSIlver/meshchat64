  7678  7b63 20ff7d                     JSR SET_PA_W
  7679  7b66 a900                       LDA #<SHA_T1
  7680  7b68 85fd                       STA PB
  7681  7b6a a993                       LDA #>SHA_T1
  7682  7b6c 85fe                       STA PB+1
  7683  7b6e 20f378                     JSR C64COPY
