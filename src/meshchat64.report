  7155  76ab a98a85fba98d85fc...        +mul t0, t0, z20_0     ; z^(2^40-1)
  7156  76c6 a98a85fba98d85fc...        +sq  t0, t0
  7157  76d9 a98a8d478da98d8d...        +sqn t0, 9             ; z^(2^50-2^10)
  7158  76eb a98a85fba98d85fc...        +mul z50_0, t0, z10_0  ; z^(2^50-1)
