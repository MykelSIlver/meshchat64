  7604                                  ; -- 80 rondes --
  7605  7b5b a900                       LDA #0
  7606  7b5d 8dae99                     STA SHA_J
  7607  7b60 a9aa                       LDA #<SHA5_K
  7608  7b62 8db599                     STA SHA_KP
  7609  7b65 a98f                       LDA #>SHA5_K
  7610  7b67 8db699                     STA SHA_KP+1
  7611  7b6a a900                       LDA #<SHA5_W
  7612  7b6c 8db799                     STA SHA_WP
  7613  7b6f a9c0                       LDA #>SHA5_W
  7614  7b71 8db899                     STA SHA_WP+1
  7615                          SB_RND
  7616                                  ; T1 = h
  7617  7b74 a9aa                       LDA #<SHA_T1
  7618  7b76 85fb                       STA PA
  7619  7b78 a992                       LDA #>SHA_T1
  7620  7b7a 85fc                       STA PA+1
  7621  7b7c a9a2                       LDA #<(SHA_AH+56)         ; h = word 7
  7622  7b7e 85fd                       STA PB
  7623  7b80 a992                       LDA #>(SHA_AH+56)
  7624  7b82 85fe                       STA PB+1
  7625  7b84 209d78                     JSR C64COPY
  7626                                  ; SHA_ACC = BIGSIG1(e)  (e = word 4)
  7627  7b87 a98a                       LDA #<(SHA_AH+32)
  7628  7b89 85fd                       STA PB
  7629  7b8b a992                       LDA #>(SHA_AH+32)
  7630  7b8d 85fe                       STA PB+1
  7631  7b8f 20d879                     JSR BIGSIG1
  7632                                  ; T1 += SHA_ACC
  7633  7b92 a9d2                       LDA #<SHA_ACC
  7634  7b94 85fd                       STA PB
  7635  7b96 a992                       LDA #>SHA_ACC
  7636  7b98 85fe                       STA PB+1
  7637  7b9a 20a978                     JSR C64ADD
  7638                                  ; SHA_ACC = Ch(e,f,g) = (e&f) ^ (~e & g)
  7639  7b9d 20b77c                     JSR CH_EFG
  7640                                  ; T1 += SHA_ACC
  7641  7ba0 a9d2                       LDA #<SHA_ACC
  7642  7ba2 85fd                       STA PB
  7643  7ba4 a992                       LDA #>SHA_ACC
  7644  7ba6 85fe                       STA PB+1
  7645  7ba8 20a978                     JSR C64ADD
  7646                                  ; T1 += K[i]   (SHA_KP)
  7647  7bab adb599                     LDA SHA_KP
  7648  7bae 85fd                       STA PB
  7649  7bb0 adb699                     LDA SHA_KP+1
  7650  7bb3 85fe                       STA PB+1
  7651  7bb5 20a978                     JSR C64ADD
  7652                                  ; T1 += W[i]   (SHA_WP)
  7653  7bb8 adb799                     LDA SHA_WP
  7654  7bbb 85fd                       STA PB
  7655  7bbd adb899                     LDA SHA_WP+1
  7656  7bc0 85fe                       STA PB+1
  7657  7bc2 20a978                     JSR C64ADD
  7658                                  ; T2 = BIGSIG0(a) + Maj(a,b,c)
  7659  7bc5 a96a                       LDA #<(SHA_AH+0)          ; a = word 0
  7660  7bc7 85fd                       STA PB
  7661  7bc9 a992                       LDA #>(SHA_AH+0)
  7662  7bcb 85fe                       STA PB+1
  7663  7bcd 20ad79                     JSR BIGSIG0
  7664                                  ; T2 = SHA_ACC
  7665  7bd0 a9b2                       LDA #<SHA_T2
  7666  7bd2 85fb                       STA PA
  7667  7bd4 a992                       LDA #>SHA_T2
  7668  7bd6 85fc                       STA PA+1
  7669  7bd8 a9d2                       LDA #<SHA_ACC
  7670  7bda 85fd                       STA PB
  7671  7bdc a992                       LDA #>SHA_ACC
  7672  7bde 85fe                       STA PB+1
  7673  7be0 209d78                     JSR C64COPY
  7674                                  ; SHA_ACC = Maj(a,b,c)
  7675  7be3 20e47c                     JSR MAJ_ABC
  7676                                  ; T2 += SHA_ACC
  7677  7be6 a9b2                       LDA #<SHA_T2
  7678  7be8 85fb                       STA PA
  7679  7bea a992                       LDA #>SHA_T2
  7680  7bec 85fc                       STA PA+1
  7681  7bee a9d2                       LDA #<SHA_ACC
  7682  7bf0 85fd                       STA PB
  7683  7bf2 a992                       LDA #>SHA_ACC
  7684  7bf4 85fe                       STA PB+1
  7685  7bf6 20a978                     JSR C64ADD
