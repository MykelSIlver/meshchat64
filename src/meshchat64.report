  7570                          ; ================================================================
  7571                          ; SHA_BLOCK  -  process 1 block of 128 bytes at (BP)
  7572                          ; ================================================================
  7573                          SHA_BLOCK
  7574                                  ; -- W[0..15] = big-endian words from block (reverse to LE) --
  7575  7aaf a900                       LDA #0
  7576  7ab1 8d049a                     STA SHA_J               ; word index 0..15
  7577  7ab4 ad049a             SB_LDW  LDA SHA_J
  7578  7ab7 0a                         ASL
  7579  7ab8 0a                         ASL
  7580  7ab9 0a                         ASL                     ; J*8 = byte offset within block
  7581  7aba 8d059a                     STA SHA_OFF
  7582                                  ; dest = SHA5_W + J*8 ; we fill LE: W[J].byte(b) = block[off + (7-b)]
  7583  7abd a200                       LDX #0                  ; b = 0..7
  7584  7abf 8a                 SB_BR   TXA                     ; b
  7585  7ac0 4907                       EOR #7                  ; 7-b
  7586  7ac2 18                         CLC
  7587  7ac3 6d059a                     ADC SHA_OFF
  7588  7ac6 a8                         TAY                     ; index in block
  7589  7ac7 b1f9                       LDA (BP),Y
  7590                                  ; dest index = J*8 + b
  7591  7ac9 8e069a                     STX SHA_BTMP
  7592  7acc ad049a                     LDA SHA_J
  7593  7acf 0a                         ASL
  7594  7ad0 0a                         ASL
  7595  7ad1 0a                         ASL
  7596  7ad2 18                         CLC
  7597  7ad3 6d069a                     ADC SHA_BTMP            ; J*8 + b
  7598  7ad6 a8                         TAY
  7599  7ad7 b1f9                       LDA (BP),Y              ; (wrong: should be source byte) -- see fix
  7600                                  ; --- correct approach below ---
  7601  7ad9 4cdc7a                     JMP SB_BR_FIX
  7602                          SB_BR_FIX
  7603                                  ; (block above is replaced; correct version:)
  7604  7adc a200                       LDX #0
  7605  7ade 8a                 SB_BR2  TXA
  7606  7adf 4907                       EOR #7
  7607  7ae1 18                         CLC
  7608  7ae2 6d059a                     ADC SHA_OFF
  7609  7ae5 a8                         TAY
  7610  7ae6 b1f9                       LDA (BP),Y              ; source byte = block[off + (7-b)]
  7611  7ae8 ac049a                     LDY SHA_J
  7612                                  ; store in W via pointer
  7613  7aeb 8d079a                     STA SHA_WBYTE
  7614                                  ; compute target address SHA5_W + J*8 + b in PA
  7615  7aee ad049a                     LDA SHA_J
  7616  7af1 0a                         ASL
  7617  7af2 0a                         ASL
  7618  7af3 0a                         ASL
  7619  7af4 18                         CLC
  7620  7af5 6900                       ADC #<SHA5_W
  7621  7af7 85fb                       STA PA
  7622  7af9 a9c0                       LDA #>SHA5_W
  7623  7afb 6900                       ADC #0
  7624  7afd 85fc                       STA PA+1
  7625  7aff 8a                         TXA
  7626  7b00 a8                         TAY                     ; Y = b
  7627  7b01 ad079a                     LDA SHA_WBYTE
  7628  7b04 91fb                       STA (PA),Y
  7629  7b06 e8                         INX
  7630  7b07 e008                       CPX #8
  7631  7b09 d0d3                       BNE SB_BR2
  7632  7b0b ee049a                     INC SHA_J
  7633  7b0e ad049a                     LDA SHA_J
  7634  7b11 c910                       CMP #16
  7635  7b13 d09f                       BNE SB_LDW
  7636                          
  7637                                  ; -- W[16..79] = SSIG1(W[i-2]) + W[i-7] + SSIG0(W[i-15]) + W[i-16] --
  7638  7b15 a910                       LDA #16
  7639  7b17 8d049a                     STA SHA_J
  7640                          SB_EXT  ; PB -> W[i-2]
  7641  7b1a ad049a                     LDA SHA_J
  7642  7b1d 38                         SEC
  7643  7b1e e902                       SBC #2
  7644  7b20 20d57d                     JSR SET_PB_W
  7645  7b23 20847a                     JSR SSIG1               ; SHA_ACC = ssig1(W[i-2])
  7646                                  ; T = SHA_ACC ; PA->SHA_T1 copy
  7647  7b26 20c97d                     JSR ACC_TO_T1
  7648                                  ; T1 += W[i-7]
  7649  7b29 a900                       LDA #<SHA_T1
  7650  7b2b 85fb                       STA PA
  7651  7b2d a993                       LDA #>SHA_T1
  7652  7b2f 85fc                       STA PA+1
  7653  7b31 ad049a                     LDA SHA_J
  7654  7b34 38                         SEC
  7655  7b35 e907                       SBC #7
  7656  7b37 20d57d                     JSR SET_PB_W
  7657  7b3a 20ff78                     JSR C64ADD
  7658                                  ; SHA_ACC = ssig0(W[i-15])
  7659  7b3d ad049a                     LDA SHA_J
  7660  7b40 38                         SEC
  7661  7b41 e90f                       SBC #15
  7662  7b43 20d57d                     JSR SET_PB_W
  7663  7b46 20597a                     JSR SSIG0
  7664                                  ; T1 += SHA_ACC
  7665  7b49 a928                       LDA #<SHA_ACC
  7666  7b4b 85fd                       STA PB
  7667  7b4d a993                       LDA #>SHA_ACC
  7668  7b4f 85fe                       STA PB+1
  7669  7b51 20ff78                     JSR C64ADD
  7670                                  ; T1 += W[i-16]
  7671  7b54 ad049a                     LDA SHA_J
  7672  7b57 38                         SEC
  7673  7b58 e910                       SBC #16
  7674  7b5a 20d57d                     JSR SET_PB_W
  7675  7b5d 20ff78                     JSR C64ADD
