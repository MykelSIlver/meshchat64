  8903                          ; ================================================================
  8904                          ; Item 2 — relay-auth challenge-response, 256-bit pad (Optie B)
  8905                          ; ----------------------------------------------------------------
  8906                          ; Parallel to the existing WS_AUTH (128-bit). Place WS_AUTH256
  8907                          ; next to WS_AUTH so the 128-bit fallback stays. Call WS_AUTH256
  8908                          ; instead of WS_AUTH when the identity is a 256-bit identity.
  8909                          ;
  8910                          ; Differences from WS_AUTH (all other logic reused identically):
  8911                          ;   step 1: bits:256 + 32-byte enc_key (HKDF_OKM[0:32]) instead of 16
  8912                          ;   step 3: AGD256 (AES-256-GCM-decrypt+verify) instead of AES_GCM_DECRYPT;
  8913                          ;           48-byte data gesplitst -> CTBUF[32] (nonce-CT) + GCM_RECV_TAG[16];
  8914                          ;           VERIFY_FAIL checked (bad tag -> auth failed)
  8915                          ;   step 4: nonce emitted from PTBUF (AGD256 output) instead of GCM_CTBUF
  8916                          ;
  8917                          ; VOORWAARDEN (item 5 / item 4):
  8918                          ;   - AES-256 layer merged in: AGD256, AES_KEY[32], CTBUF/PTBUF,
  8919                          ;     GCM_RECV_TAG[16], VERIFY_FAIL, PTLEN exist (from aes256test.asm).
  8920                          ;   - HKDF_OKM[0:32] = eigen 256-bit encKey (DERIVE_KEYPAIR of paste).
  8921                          ;   - Challenge-nonce is 32 bytes -> data = 48 (32 CT + 16 tag): zelfde
  8922                          ;     length check as 128-bit. (nonce/tag length equal for both paths)
  8923                          ;
  8924                          ; Reason codes from the relay (bad_init/bad_key_length/proof_invalid/
  8925                          ; timeout) are handled generically as auth_fail in WA2_FAIL.
  8926                          ; ================================================================
  8927                          WS_AUTH256
  8928  9ea6 a99e                       LDA #$9E            ; yellow
  8929  9ea8 20ba0c                     JSR PRINT_CHR
  8930  9eab a9ca                       LDA #<STR_AUTH_BUSY
  8931  9ead 85fb                       STA $FB
  8932  9eaf a940                       LDA #>STR_AUTH_BUSY
  8933  9eb1 85fc                       STA $FC
  8934  9eb3 20cf0c                     JSR PRINT_STR_FB
  8935  9eb6 a90d                       LDA #$0D
  8936  9eb8 20ba0c                     JSR PRINT_CHR
  8937  9ebb a905                       LDA #$05            ; wit
  8938  9ebd 20ba0c                     JSR PRINT_CHR
  8939                          
  8940                                  ; -- step 1: auth_init (bits:256, 32-byte enc_key) --
  8941  9ec0 20be26                     JSR JOUT_INIT
  8942  9ec3 a98a                       LDA #<STR_AUTH1_256
  8943  9ec5 85fb                       STA $FB
  8944  9ec7 a9a0                       LDA #>STR_AUTH1_256
  8945  9ec9 85fc                       STA $FC
  8946  9ecb 20f226                     JSR JOUT_EMIT_STR
  8947  9ece a200                       LDX #0
  8948  9ed0 bde038             WA2_KL  LDA HKDF_OKM,X         ; eigen 256-bit encKey = HKDF_OKM[0:32]
  8949  9ed3 8ea65a                     STX BGB_XTMP           ; BYTE_TO_DEC clobbers X
  8950  9ed6 200527                     JSR BYTE_TO_DEC
  8951  9ed9 aea65a                     LDX BGB_XTMP
  8952  9edc e8                         INX
  8953  9edd e020                       CPX #32                ; 32 key bytes instead of 16
  8954  9edf f008                       BEQ WA2_KLD
  8955  9ee1 a92c                       LDA #$2C               ; ','
  8956  9ee3 20d126                     JSR JOUT_EMIT
  8957  9ee6 4cd09e                     JMP WA2_KL
  8958  9ee9 a95d               WA2_KLD LDA #$5D               ; ']'
  8959  9eeb 20d126                     JSR JOUT_EMIT
  8960  9eee a97d                       LDA #$7D               ; '}'
  8961  9ef0 20d126                     JSR JOUT_EMIT
  8962  9ef3 200730                     JSR WS_SEND_EXT
  8963                          
  8964                                  ; -- step 2: wait for challenge frame (max 8) -- (identical to WS_AUTH)
  8965  9ef6 a908                       LDA #8
  8966  9ef8 8d6440                     STA WA_TRY
  8967  9efb 20d529             WA2_W1  JSR WS_RECV_FRAME
  8968  9efe 9008                       BCC WA2_G1
  8969  9f00 ce6440                     DEC WA_TRY
  8970  9f03 d0f6                       BNE WA2_W1
  8971  9f05 4c6ea0                     JMP WA2_FAIL
  8972  9f08 a99e               WA2_G1  LDA #<RCV_BUF
  8973  9f0a 85fb                       STA $FB
  8974  9f0c a95f                       LDA #>RCV_BUF
  8975  9f0e 85fc                       STA $FC
  8976  9f10 a904                       LDA #<JSC_CHAL
  8977  9f12 8db15a                     STA JSC_PAT_LO
  8978  9f15 a96c                       LDA #>JSC_CHAL
  8979  9f17 8db25a                     STA JSC_PAT_HI
  8980  9f1a 20182d                     JSR JSON_SCAN
  8981  9f1d 9008                       BCC WA2_CH
  8982  9f1f ce6440                     DEC WA_TRY
  8983  9f22 d0d7                       BNE WA2_W1
  8984  9f24 4c6ea0                     JMP WA2_FAIL
  8985                          WA2_CH
  8986                                  ; iv parsen (12 bytes)
  8987  9f27 a9eb                       LDA #<JSC_IV
  8988  9f29 8db15a                     STA JSC_PAT_LO
  8989  9f2c a96b                       LDA #>JSC_IV
  8990  9f2e 8db25a                     STA JSC_PAT_HI
  8991  9f31 20182d                     JSR JSON_SCAN
  8992  9f34 9003                       BCC *+5
  8993  9f36 4c6ea0                     JMP WA2_FAIL
  8994  9f39 a9d2                       LDA #<RCV_IV
  8995  9f3b 85fd                       STA $FD
  8996  9f3d a95a                       LDA #>RCV_IV
  8997  9f3f 85fe                       STA $FE
  8998  9f41 a90c                       LDA #12
  8999  9f43 8db85a                     STA PRM_CNT
  9000  9f46 a900                       LDA #0
  9001  9f48 8dbd5a                     STA RCV_CT_LEN
  9002  9f4b 8dbe5a                     STA RCV_CT_LEN+1
  9003  9f4e 20c92d                     JSR JSON_PARSE_ARR
  9004  9f51 9003                       BCC *+5
  9005  9f53 4c6ea0                     JMP WA2_FAIL
  9006                                  ; parse data (must be 48 = 32 nonce-CT + 16 tag)
  9007  9f56 a9f2                       LDA #<JSC_DATA
  9008  9f58 8db15a                     STA JSC_PAT_LO
  9009  9f5b a96b                       LDA #>JSC_DATA
  9010  9f5d 8db25a                     STA JSC_PAT_HI
  9011  9f60 20182d                     JSR JSON_SCAN
  9012  9f63 9003                       BCC *+5
  9013  9f65 4c6ea0                     JMP WA2_FAIL
  9014  9f68 a9de                       LDA #<RCV_CT
  9015  9f6a 85fd                       STA $FD
  9016  9f6c a95a                       LDA #>RCV_CT
  9017  9f6e 85fe                       STA $FE
  9018  9f70 a900                       LDA #0
  9019  9f72 8db85a                     STA PRM_CNT            ; 0 = variable length
  9020  9f75 8dbd5a                     STA RCV_CT_LEN
  9021  9f78 8dbe5a                     STA RCV_CT_LEN+1
  9022  9f7b 8dae5a                     STA RCV_TOOLONG
  9023  9f7e 20c92d                     JSR JSON_PARSE_ARR
  9024  9f81 9003                       BCC *+5
  9025  9f83 4c6ea0                     JMP WA2_FAIL
  9026  9f86 adbd5a                     LDA RCV_CT_LEN
  9027  9f89 c930                       CMP #48
  9028  9f8b f003                       BEQ *+5
  9029  9f8d 4c6ea0                     JMP WA2_FAIL
  9030                          
  9031                                  ; -- step 3: decrypt challenge with AGD256 (AES-256-GCM) --
  9032                                  ; iv -> AES_NONCE (12)
  9033  9f90 a20b                       LDX #11
  9034  9f92 bdd25a             WA2_IV  LDA RCV_IV,X
  9035  9f95 9d2252                     STA AES_NONCE,X
  9036  9f98 ca                         DEX
  9037  9f99 10f7                       BPL WA2_IV
  9038                                  ; eigen encKey -> AES_KEY (32)
  9039  9f9b a21f                       LDX #31
  9040  9f9d bde038             WA2_KS  LDA HKDF_OKM,X
  9041  9fa0 9dcf4a                     STA AES_KEY,X
  9042  9fa3 ca                         DEX
  9043  9fa4 10f7                       BPL WA2_KS
  9044                                  ; data[0:32] -> CTBUF  (nonce-ciphertext)
  9045  9fa6 a21f                       LDX #31
  9046  9fa8 bdde5a             WA2_CT  LDA RCV_CT,X
  9047  9fab 9d734d                     STA CTBUF,X
  9048  9fae ca                         DEX
  9049  9faf 10f7                       BPL WA2_CT
  9050                                  ; data[32:48] -> GCM_RECV_TAG  (16-byte tag)
  9051  9fb1 a20f                       LDX #15
  9052  9fb3 bdfe5a             WA2_TG  LDA RCV_CT+32,X
  9053  9fb6 9d7152                     STA GCM_RECV_TAG,X
  9054  9fb9 ca                         DEX
  9055  9fba 10f7                       BPL WA2_TG
  9056                                  ; PTLEN = 32
  9057  9fbc a920                       LDA #32
  9058  9fbe 8df14a                     STA PTLEN+0
  9059  9fc1 a900                       LDA #0
  9060  9fc3 8df24a                     STA PTLEN+1
  9061  9fc6 206e48                     JSR AGD256             ; -> PTBUF[0..31] = nonce ; VERIFY_FAIL
  9062  9fc9 adf04a                     LDA VERIFY_FAIL
  9063  9fcc f003                       BEQ WA2_DEC_OK
  9064  9fce 4c6ea0                     JMP WA2_FAIL           ; tag verification failed
  9065                          WA2_DEC_OK
  9066                          
  9067                                  ; -- step 4: auth_proof (nonce from PTBUF) --
  9068  9fd1 20be26                     JSR JOUT_INIT
  9069  9fd4 a954                       LDA #<STR_AUTH2
  9070  9fd6 85fb                       STA $FB
  9071  9fd8 a96c                       LDA #>STR_AUTH2
  9072  9fda 85fc                       STA $FC
  9073  9fdc 20f226                     JSR JOUT_EMIT_STR
  9074  9fdf a200                       LDX #0
  9075  9fe1 bdf34a             WA2_NL  LDA PTBUF,X            ; AGD256 output instead of GCM_CTBUF
  9076  9fe4 8ea65a                     STX BGB_XTMP
  9077  9fe7 200527                     JSR BYTE_TO_DEC
  9078  9fea aea65a                     LDX BGB_XTMP
  9079  9fed e8                         INX
  9080  9fee e020                       CPX #32
  9081  9ff0 f008                       BEQ WA2_NLD
  9082  9ff2 a92c                       LDA #$2C               ; ','
  9083  9ff4 20d126                     JSR JOUT_EMIT
  9084  9ff7 4ce19f                     JMP WA2_NL
  9085  9ffa a95d               WA2_NLD LDA #$5D               ; ']'
  9086  9ffc 20d126                     JSR JOUT_EMIT
  9087  9fff a97d                       LDA #$7D               ; '}'
  9088  a001 20d126                     JSR JOUT_EMIT
  9089  a004 200730                     JSR WS_SEND_EXT
  9090                          
