   227                          ; ================================================================
   228                          ; MC_SETUP - paste-encKey setup screen (login model level 2)
   229                          ; asks for two base64url encKeys (22 chars; '_' = left-arrow key):
   230                          ;   1) own encKey -> KEY_SELF (decrypt incoming + identity)
   231                          ;   2) peer encKey  -> KEY_PEER (encrypt outgoing + 'to')
   232                          ; derives: C64_IDSTR (own publicId), PEER_IDSTR ('to' field),
   233                          ; KDFIN_NAME (prompt label = first 8 chars of own publicId).
   234                          ; ================================================================
   235                          ; ================================================================
   236                          ; 128-bit MC_SETUP (paste path) + B64URL_DECODE22 22-char decode loop
   237                          ; REMOVED (AES128 cleanup). Only reachable via the removed
   238                          ; MC_BOOT_MENU -> dead. NOTE: the shared helpers B64D_ERR/B64D_CHAR
   239                          ; (below) STAY - the live 256-bit shareable decoder uses them.
   240                          ; Stub + pin keeps B64D_ERR (and MC_CHAT_SCREEN + watchdog hook after it)
   241                          ; byte-identical.
   242                          ; ================================================================
   243                          MC_SETUP
   244  0969 60                         RTS
   245                          * = $0B86                       ; pin: B64D_ERR at original address
   246                          B64D_ERR
   247  0b86 38                         SEC
   248  0b87 60                         RTS
   249                          
   250                          ; B64D_CHAR - look up ASCII char A in B64_TABLE -> 6-bit value
   251                          ; C=0 + A=value; C=1 = invalid char. Clobbers Y.
   252                          B64D_CHAR
   253  0b88 a000                       LDY #0
   254  0b8a d9d06c             B64C_LP CMP B64_TABLE,Y
   255  0b8d f007                       BEQ B64C_HIT
   256  0b8f c8                         INY
   257  0b90 c040                       CPY #64
   258  0b92 d0f6                       BNE B64C_LP
   259  0b94 38                         SEC
   260  0b95 60                         RTS
   261                          B64C_HIT
   262  0b96 98                         TYA
   263  0b97 18                         CLC
   264  0b98 60                         RTS
   265                          
   266                          ; ================================================================
   267                          ; MC_CHAT_SCREEN - show chat screen after login
   268                          ; ================================================================
   269                          MC_CHAT_SCREEN
   270  0b99 206d08                     JSR MC_HEADER
   271                          
   272                                  ; show ID
   273  0b9c a99e                       LDA #$9E        ; yellow
   274  0b9e 20ba0c                     JSR PRINT_CHR
   275  0ba1 a99c                       LDA #<STR_ID_LBL
   276  0ba3 85fb                       STA $FB
   277  0ba5 a942                       LDA #>STR_ID_LBL
   278  0ba7 85fc                       STA $FC
   279  0ba9 20cf0c                     JSR PRINT_STR_FB
   280  0bac a905                       LDA #$05        ; wit
   281  0bae 20ba0c                     JSR PRINT_CHR
   282                          
   283                                  ; own publicId (16 base64url chars)
   284  0bb1 a993                       LDA #<C64_IDSTR
   285  0bb3 85fb                       STA $FB
   286  0bb5 a95a                       LDA #>C64_IDSTR
   287  0bb7 85fc                       STA $FC
   288  0bb9 20cf0c                     JSR PRINT_STR_FB
   289  0bbc a90d                       LDA #$0D
   290  0bbe 20ba0c                     JSR PRINT_CHR
   291                          
   292  0bc1 204fa4                     JSR SHOW_SHAREABLE  ; show own shareable (256-bit only)
   293                          
   294                                  ; divider
   295  0bc4 a9a1                       LDA #<STR_DIV
   296  0bc6 85fb                       STA $FB
   297  0bc8 a942                       LDA #>STR_DIV
   298  0bca 85fc                       STA $FC
   299  0bcc 20cf0c                     JSR PRINT_STR_FB
   300  0bcf a90d                       LDA #$0D
   301  0bd1 20ba0c                     JSR PRINT_CHR
   302  0bd4 a90d                       LDA #$0D
   303  0bd6 20ba0c                     JSR PRINT_CHR
   304  0bd9 60                         RTS
