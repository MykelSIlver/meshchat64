  9276                          ; ================================================================
  9277                          ; WS_SEND_MSG256 - 256-bit bericht: AES-256-GCM + Ed25519-sig (Optie B)
  9278                          ;   {"type":"app:message","from":..,"to":..,"blob":{iv,data},"sig":[64]}
  9279                          ; Requires: KEY_PEER256[32]=peer encKey ; SIGN_SETUP run once
  9280                          ;          (SK_A/SK_PREFIX/SK_PUB cached with the HKDF signing seed).
  9281                          ; Input : INP_BUF/INP_LEN (like the 128-bit path).
  9282                          ; ================================================================
  9283                          WS_SEND_MSG256
  9284                                  ; -- peer 32-byte encKey -> AES_KEY --
  9285  a0b9 a21f                       LDX #31
  9286  a0bb bd4039             WSM2_K  LDA KEY_PEER256,X
  9287  a0be 9dcf4a                     STA AES_KEY,X
  9288  a0c1 ca                         DEX
  9289  a0c2 10f7                       BPL WSM2_K
  9290                          
  9291                                  ; -- inner JSON -> MSG_INNER_BUF ; GCM_PT_PTR/LEN set --
  9292  a0c4 20222f                     JSR BUILD_INNER_JSON
  9293                          
  9294                                  ; -- inner plaintext -> PTBUF (AGE256 reads PTBUF) ; PTLEN --
  9295  a0c7 adfd528da09e               LDA GCM_PT_PTR+0 : STA MSG_PTR+0
  9296  a0cd adfe528da19e               LDA GCM_PT_PTR+1 : STA MSG_PTR+1
  9297  a0d3 adff528da29e               LDA GCM_PT_LEN+0 : STA MSG_LEN+0
  9298  a0d9 ad00538da39e               LDA GCM_PT_LEN+1 : STA MSG_LEN+1
  9299  a0df a9f38504                   LDA #<PTBUF : STA CDST
  9300  a0e3 a94a8505                   LDA #>PTBUF : STA CDST+1
  9301  a0e7 20c687                     JSR COPY_M
  9302  a0ea adff528df14a               LDA GCM_PT_LEN+0 : STA PTLEN+0
  9303  a0f0 ad00538df24a               LDA GCM_PT_LEN+1 : STA PTLEN+1
  9304                          
  9305                                  ; -- verse nonce + AES-256-GCM encrypt --
  9306  a0f6 206127                     JSR GCM_NONCE_GEN
  9307  a0f9 202b48                     JSR AGE256             ; -> CTBUF, GCM_TAG
  9308                          
  9309                                  ; -- CTBUF -> GCM_CTBUF (BUILD_GCM_BLOB reads GCM_CTBUF) --
  9310  a0fc a9738da09e                 LDA #<CTBUF : STA MSG_PTR+0
  9311  a101 a94d8da19e                 LDA #>CTBUF : STA MSG_PTR+1
  9312  a106 adff528da29e               LDA GCM_PT_LEN+0 : STA MSG_LEN+0
  9313  a10c ad00538da39e               LDA GCM_PT_LEN+1 : STA MSG_LEN+1
  9314  a112 a9018504                   LDA #<GCM_CTBUF : STA CDST
  9315  a116 a9538505                   LDA #>GCM_CTBUF : STA CDST+1
  9316  a11a 20c687                     JSR COPY_M
  9317                          
  9318                                  ; -- buitenste header: {"type":..,"from":"<id>","to":"<peer>","blob": --
  9319  a11d 20be26                     JSR JOUT_INIT
  9320  a120 a99e85fb                   LDA #<STR_MSG_HDR1 : STA $FB
  9321  a124 a96c85fc                   LDA #>STR_MSG_HDR1 : STA $FC
  9322  a128 20f226                     JSR JOUT_EMIT_STR
  9323  a12b a200                       LDX #0
  9324  a12d bd935a             WSM2_ID LDA C64_IDSTR,X
  9325  a130 f007                       BEQ WSM2_IDE
  9326  a132 20d126                     JSR JOUT_EMIT
  9327  a135 e8                         INX
  9328  a136 4c2da1                     JMP WSM2_ID
  9329                          WSM2_IDE
  9330  a139 a9bd85fb                   LDA #<STR_MSG_TO : STA $FB
  9331  a13d a96c85fc                   LDA #>STR_MSG_TO : STA $FC
  9332  a141 20f226                     JSR JOUT_EMIT_STR
  9333  a144 a200                       LDX #0
  9334  a146 bd3c40             WSM2_TO LDA PEER_IDSTR,X
  9335  a149 f007                       BEQ WSM2_TOE
  9336  a14b 20d126                     JSR JOUT_EMIT
  9337  a14e e8                         INX
  9338  a14f 4c46a1                     JMP WSM2_TO
  9339                          WSM2_TOE
  9340  a152 a9c685fb                   LDA #<STR_MSG_BLOB : STA $FB
  9341  a156 a96c85fc                   LDA #>STR_MSG_BLOB : STA $FC
  9342  a15a 20f226                     JSR JOUT_EMIT_STR
  9343                          
  9344                                  ; -- record blob start for the sig --
  9345  a15d ad835a8d263b               LDA JOUT_LO : STA BLOB_PTR+0
  9346  a163 ad845a8d273b               LDA JOUT_HI : STA BLOB_PTR+1
  9347  a169 ad855a8d283b               LDA JOUT_LEN+0 : STA BLOB_LEN0+0
  9348  a16f ad865a8d293b               LDA JOUT_LEN+1 : STA BLOB_LEN0+1
  9349                          
  9350  a175 208f2f                     JSR BUILD_GCM_BLOB     ; {"iv":[AES_NONCE],"data":[GCM_CTBUF..GCM_TAG]}
  9351                          
  9352                                  ; -- MAC_LEN = JOUT_LEN - BLOB_LEN0 (16-bit; no CPX between SBCs) --
  9353  a178 38                         SEC
  9354  a179 ad855aed283b8d2a...        LDA JOUT_LEN+0 : SBC BLOB_LEN0+0 : STA MAC_LEN+0
  9355  a182 ad865aed293b8d2b...        LDA JOUT_LEN+1 : SBC BLOB_LEN0+1 : STA MAC_LEN+1
  9356                          
  9357                                  ; -- sig = Ed25519 over the blob bytes (step C) --
  9358  a18b ad263b8da09e               LDA BLOB_PTR+0 : STA MSG_PTR+0
  9359  a191 ad273b8da19e               LDA BLOB_PTR+1 : STA MSG_PTR+1
  9360  a197 ad2a3b8da29e               LDA MAC_LEN+0 : STA MSG_LEN+0
  9361  a19d ad2b3b8da39e               LDA MAC_LEN+1 : STA MSG_LEN+1
  9362  a1a3 20e086                     JSR SIGN               ; -> SIG_OUT[0..63]
  9363                          
  9364                                  ; -- ,"sig":[ 64 decimalen ] --
  9365  a1a6 a9c485fb                   LDA #<STR_SIGHDR : STA $FB
  9366  a1aa a96b85fc                   LDA #>STR_SIGHDR : STA $FC
  9367  a1ae 20f226                     JSR JOUT_EMIT_STR
  9368  a1b1 a200                       LDX #0
  9369  a1b3 bd609e             WSM2_SG LDA SIG_OUT,X
  9370  a1b6 8ea65a                     STX BGB_XTMP
  9371  a1b9 200527                     JSR BYTE_TO_DEC
  9372  a1bc aea65a                     LDX BGB_XTMP
  9373  a1bf e8                         INX
  9374  a1c0 e040                       CPX #64
  9375  a1c2 f008                       BEQ WSM2_SGD
  9376  a1c4 a92c20d126                 LDA #$2C : JSR JOUT_EMIT
  9377  a1c9 4cb3a1                     JMP WSM2_SG
  9378                          WSM2_SGD
  9379  a1cc a95d20d126                 LDA #$5D : JSR JOUT_EMIT
  9380  a1d1 a97d20d126                 LDA #$7D : JSR JOUT_EMIT
  9381  a1d6 20bdb5                     JSR MSG_SEND_GATE
  9382  a1d9 60                         RTS
