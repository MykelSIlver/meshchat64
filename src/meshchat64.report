  9153                          ; {"type":"sig:auth_init","bits":256,"enc_key":[
  9154                          STR_AUTH1_256
  9155  a08a 7b2274797065223a...        !byte $7B,$22,$74,$79,$70,$65,$22,$3A,$22,$73,$69,$67,$3A
  9156  a097 617574685f696e69...        !byte $61,$75,$74,$68,$5F,$69,$6E,$69,$74,$22,$2C,$22,$62
  9157  a0a4 697473223a323536...        !byte $69,$74,$73,$22,$3A,$32,$35,$36,$2C,$22,$65,$6E,$63   ; "bits":256
