  7563  7b0d 20a97d                     JSR SET_PA_W
  7564  7b10 a9aa                       LDA #<SHA_T1
  7565  7b12 85fd                       STA PB
  7566  7b14 a992                       LDA #>SHA_T1
  7567  7b16 85fe                       STA PB+1
  7568  7b18 209d78                     JSR C64COPY
  7569  7b1b eeae99                     INC SHA_J
  7570  7b1e adae99                     LDA SHA_J
  7571  7b21 c950                       CMP #80
  7572  7b23 d09f                       BNE SB_EXT
