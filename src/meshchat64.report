  3066                          ; ----------------------------------------------------------------
  3067                          ; CIA2_WAIT_10MS - wait A x 10ms via CIA2 Timer A
  3068                          ;
  3069                          ; CIA2 Timer A always runs at PHI2 = 1MHz, regardless of CPU speed.
  3070                          ; Works correctly in both 1MHz and 64MHz turbo mode.
  3071                          ; 10ms = 10000 cycles @ 1MHz = $2710
  3072                          ; Input: A = count × 10ms (1..255), max = 2.55s
  3073                          ; Bug 6 fix: replaces all cpu-count loops with clock-free timing
  3074                          ; ----------------------------------------------------------------
  3075                          CIA2_WAIT_10MS
  3076  248d 8de343                     STA CIA_MSCTR
  3077  2490 a910               CWM_LP  LDA #$10                ; $2710 lo byte (10000 & $FF)
  3078  2492 8d04dd                     STA $DD04               ; CIA2 Timer A lo latch
  3079  2495 a927                       LDA #$27                ; $2710 hi byte (10000 >> 8)
  3080  2497 8d05dd                     STA $DD05               ; CIA2 Timer A hi latch
  3081  249a a919                       LDA #$19                ; load latch + one-shot + start
  3082  249c 8d0edd                     STA $DD0E               ; CIA2 Control A
  3083  249f ad0ddd             CWM_WT  LDA $DD0D               ; read CIA2 ICR (reading clears flags)
  3084  24a2 2901                       AND #$01                ; bit 0 = Timer A underflow?
  3085  24a4 d003                       BNE CWM_NXT
  3086  24a6 4c9f24                     JMP CWM_WT
  3087  24a9 cee343             CWM_NXT DEC CIA_MSCTR
  3088  24ac d0e2                       BNE CWM_LP
  3089  24ae 60                         RTS
  3090                          
  3091                          ; ----------------------------------------------------------------
  3092                          ; FPGA_SETTLE - 50ms real via CIA2 Timer A (Bug 3 fix)
  3093                          ; Clock-speed independent: works at 1MHz and 64MHz
  3094                          ; ----------------------------------------------------------------
  3095                          FPGA_SETTLE
  3096  24af a905                       LDA #5
  3097  24b1 208d24                     JSR CIA2_WAIT_10MS      ; 5 × 10ms = 50ms real
  3098  24b4 60                         RTS
  3099                          
  3100                          ; ----------------------------------------------------------------
  3101                          ; LONG_DELAY - 100ms real via CIA2 Timer A (Bug 5 fix)
  3102                          ; Clock-speed independent: works at 1MHz and 64MHz
  3103                          ; ----------------------------------------------------------------
  3104                          LONG_DELAY
  3105  24b5 a90a                       LDA #10
  3106  24b7 208d24                     JSR CIA2_WAIT_10MS      ; 10 × 10ms = 100ms real
  3107  24ba 60                         RTS
  3108                          
  3109                          ; ----------------------------------------------------------------
  3110                          ; ACIA_SEND - send byte in A
  3111                          ; ----------------------------------------------------------------
  3112                          ACIA_SEND
  3113  24bb 48                         PHA             ; save A (byte to send)
  3114  24bc 8a                         TXA
  3115  24bd 48                         PHA             ; save X
  3116  24be 98                         TYA
  3117  24bf 48                         PHA             ; save Y
  3118                          
  3119  24c0 a240                       LDX #$40        ; Bug 6 fix: raised from $10->$40 for 64MHz margin
  3120  24c2 a000               ACS_OT  LDY #0
  3121  24c4 ad01de             ACS_IN  LDA $DE01
  3122  24c7 2910                       AND #$10
  3123  24c9 d00c                       BNE ACS_RDY     ; TDRE=1 -> send
  3124  24cb 88                         DEY
  3125  24cc d0f6                       BNE ACS_IN
  3126  24ce ca                         DEX
  3127  24cf d0f1                       BNE ACS_OT
  3128                          
  3129                                  ; timeout - recover and drop byte
  3130  24d1 68                         PLA
  3131  24d2 a8                         TAY
  3132  24d3 68                         PLA
  3133  24d4 aa                         TAX
  3134  24d5 68                         PLA
  3135  24d6 60                         RTS
  3136                          
  3137                          ACS_RDY
  3138                                  ; TDRE=1 - recover and send byte
  3139  24d7 68                         PLA
  3140  24d8 a8                         TAY
  3141  24d9 68                         PLA
  3142  24da aa                         TAX
  3143  24db 68                         PLA
  3144  24dc 8d00de                     STA $DE00
  3145  24df 60                         RTS
  3146                          
  3147                          ; ----------------------------------------------------------------
  3148                          ; ACIA_RECV - wait for byte, return in A (blocking)
  3149                          ; ----------------------------------------------------------------
  3150                          ACIA_RECV
  3151  24e0 ad01de                     LDA $DE01
  3152  24e3 2908                       AND #$08        ; bit3 = RDRF (byte available)
  3153  24e5 f0f9                       BEQ ACIA_RECV
  3154  24e7 ad00de                     LDA $DE00
  3155  24ea 60                         RTS
  3156                          
  3157                          ; ----------------------------------------------------------------
  3158                          ; ACIA_SEND_STR - send null-terminated string via $FB/$FC
  3159                          ; ----------------------------------------------------------------
  3160                          ACIA_SEND_STR
  3161  24eb a000                       LDY #0
  3162  24ed b1fb               ASS_LP  LDA ($FB),Y
  3163  24ef f006                       BEQ ASS_DN
  3164  24f1 20bb24                     JSR ACIA_SEND
  3165  24f4 c8                         INY
  3166  24f5 d0f6                       BNE ASS_LP
  3167  24f7 60                 ASS_DN  RTS
  3168                          
  3169                          ; ----------------------------------------------------------------
  3170                          ; ACIA_RECV_TO - receive byte with CIA2-based timeout
  3171                          ; Bug 6 fix: replaces cpu-count loop that was too short at 64MHz.
  3172                          ;   cpu-count loop: ~0.64ms @ 64MHz but ~41ms @ 1MHz
  3173                          ;   TCP RTT on LAN: 1-5ms -> at 64MHz timed out before CONNECT
  3174                          ;   CIA2 Timer A: always 10ms real, regardless of CPU clock
  3175                          ; C=0 + A=byte received / C=1 = timeout
  3176                          ; ----------------------------------------------------------------
  3177                          ACIA_RECV_TO
  3178                                  ; CIA2 Timer A: 10ms = 10000 cycles @ 1MHz = $2710
  3179  24f8 a910                       LDA #$10                ; $2710 lo byte
  3180  24fa 8d04dd                     STA $DD04               ; CIA2 Timer A lo latch
  3181  24fd a927                       LDA #$27                ; $2710 hi byte
  3182  24ff 8d05dd                     STA $DD05               ; CIA2 Timer A hi latch
  3183  2502 a919                       LDA #$19                ; load latch + one-shot + start
  3184  2504 8d0edd                     STA $DD0E               ; CIA2 Control A
  3185  2507 ad01de             ACRT_W  LDA $DE01
  3186  250a 2908                       AND #$08                ; RDRF bit
  3187  250c d00a                       BNE ACRT_OK             ; byte available
  3188  250e ad0ddd                     LDA $DD0D               ; read CIA2 ICR (clears flags)
  3189  2511 2901                       AND #$01                ; Timer A underflow?
  3190  2513 d008                       BNE ACRT_TO             ; timeout
  3191  2515 4c0725                     JMP ACRT_W
  3192  2518 ad00de             ACRT_OK LDA $DE00
  3193  251b 18                         CLC
  3194  251c 60                         RTS
  3195  251d 38                 ACRT_TO SEC
  3196  251e 60                         RTS
  3197                          
  3198                          ; ----------------------------------------------------------------
  3199                          ; NMI-DRIVEN RECEIVER (SwiftLink/ACIA on /NMI)
  3200                          ; ----------------------------------------------------------------
  3201                          ; The U64 FPGA modem delivers RX bytes in bursts (TCP bridge), not
  3202                          ; clocked at the configured baud. At 1MHz a polling read loop
  3203                          ; can't keep up -> overrun of the 1-byte ACIA buffer -> frame lost.
  3204                          ; Solution: the ACIA already asserts /NMI on every RX byte ($DE02=$09,
  3205                          ; bit1=0). We hook the NMI vector ($0318/$0319) and drain the ACIA
  3206                          ; in the ISR into a 256-byte ring buffer. The main code reads from
  3207                          ; the ring via RING_GET_TO (drop-in for ACIA_RECV_TO).
  3208                          ;
  3209                          ; Single-producer (ISR -> RING_HEAD) / single-consumer
  3210                          ; (main code -> RING_TAIL), lock-free. CIA2 Timer A is NOT
  3211                          ; touched by the ISR; the timeout in RING_GET_TO keeps working.
  3212                          ; $DD0D is NOT read by the ISR (no race with underflow).
  3213                          ;
  3214                          ; Important: the ISR FULLY drains the ACIA per NMI (drain loop),
  3215                          ; so the NMI overhead is spread across a whole burst.
  3216                          ; ----------------------------------------------------------------
  3217                          
  3218                          ; RX_NMI - NMI handler, hooked on $0318. KERNAL $FE43 only does
  3219                          ; SEI + JMP ($0318): A/X/Y are NOT saved yet. We save A and
  3220                          ; X ourselves and return with RTI.
  3221                          RX_NMI
  3222  251f 48                         PHA
  3223  2520 8a                         TXA
  3224  2521 48                         PHA
  3225  2522 ad01de                     LDA $DE01
  3226  2525 2908                       AND #$08            ; RDRF? (our byte?)
  3227  2527 f019                       BEQ RXN_EXIT        ; no (e.g. RESTORE key): do nothing
  3228                          RXN_LP
  3229  2529 ad00de                     LDA $DE00           ; read byte (clears RDRF, de-asserts /NMI)
  3230  252c ae9e6a                     LDX RING_HEAD
  3231  252f 9d9e69                     STA RING_BUF,X
  3232  2532 e8                         INX
  3233  2533 ec9f6a                     CPX RING_TAIL       ; would HEAD catch up to TAIL? -> full
  3234  2536 f00e                       BEQ RXN_FULL
  3235  2538 8e9e6a                     STX RING_HEAD       ; commit byte
  3236                          RXN_NX
  3237  253b ad01de                     LDA $DE01
  3238  253e 2908                       AND #$08
  3239  2540 d0e7                       BNE RXN_LP          ; another byte ready -> keep draining
  3240                          RXN_EXIT
  3241  2542 68                         PLA
  3242  2543 aa                         TAX
  3243  2544 68                         PLA
  3244  2545 40                         RTI
  3245                          RXN_FULL
  3246  2546 a901                       LDA #$01
  3247  2548 8da06a                     STA RING_OVF        ; mark overflow (diagnostic); byte is dropped
  3248  254b 4c3b25                     JMP RXN_NX          ; ACIA already drained (byte read) -> continue
  3249                          
  3250                          ; INSTALL_RX_NMI - hook RX_NMI on $0318/$0319. ACIA RX-IRQ briefly off
  3251                          ; during the vector swap so no NMI grabs a half-written vector;
  3252                          ; then RX-IRQ back on ($DE02=$09).
  3253                          INSTALL_RX_NMI
  3254  254e 78                         SEI
  3255  254f a900                       LDA #$00
  3256  2551 8d9e6a                     STA RING_HEAD
  3257  2554 8d9f6a                     STA RING_TAIL
  3258  2557 8da06a                     STA RING_OVF
  3259  255a a90b                       LDA #$0B            ; %0000_1011: DTR on, RX-IRQ OFF, RTS low
  3260  255c 8d02de                     STA $DE02
  3261  255f a91f                       LDA #<RX_NMI
  3262  2561 8d1803                     STA $0318
  3263  2564 a925                       LDA #>RX_NMI
  3264  2566 8d1903                     STA $0319
  3265  2569 a909                       LDA #$09            ; %0000_1001: DTR on, RX-IRQ ON
  3266  256b 8d02de                     STA $DE02
  3267  256e 58                         CLI
  3268  256f 60                         RTS
  3269                          
  3270                          ; RING_GET_TO - drop-in for ACIA_RECV_TO in the RECEIVE loop.
  3271                          ; C=0 + A=byte, or C=1 = timeout (10ms via CIA2 Timer A). Reads
  3272                          ; first from the ring; if the ring is empty, as a fallback also the live
  3273                          ; ACIA (race with IRQ-clear during simultaneous send). CLOBBERS X
  3274                          ; (MC_RECV_POLL already preserves the input index, so that's fine here).
  3275                          RING_GET_TO
  3276  2570 a932                       LDA #50             ; ~50 x 20ms = ~1s total timeout (large frame
  3277  2572 8da16a                     STA RGT_RETRY       ;  of 300+ bytes may stream in slowly)
  3278                          RGT_ARM
  3279  2575 a920                       LDA #$20            ; $4E20 = 20000 cycli = 20ms @1MHz
  3280  2577 8d04dd                     STA $DD04
  3281  257a a94e                       LDA #$4E
  3282  257c 8d05dd                     STA $DD05
  3283  257f a919                       LDA #$19            ; load latch + one-shot + start
  3284  2581 8d0edd                     STA $DD0E
  3285                          RGT_W
  3286  2584 ae9f6a                     LDX RING_TAIL
  3287  2587 ec9e6a                     CPX RING_HEAD
  3288  258a d00e                       BNE RGT_GET         ; ring not empty -> byte available
  3289  258c ad0ddd                     LDA $DD0D
  3290  258f 2901                       AND #$01
  3291  2591 f0f1                       BEQ RGT_W           ; no underflow yet -> keep waiting
  3292  2593 cea16a                     DEC RGT_RETRY
  3293  2596 d0dd                       BNE RGT_ARM         ; more retries -> restart 20ms timer
  3294  2598 f008                       BEQ RGT_TO          ; retries exhausted -> real timeout
  3295                          RGT_GET
  3296  259a bd9e69                     LDA RING_BUF,X
  3297  259d ee9f6a                     INC RING_TAIL       ; wrap bij 256 (byte)
  3298  25a0 18                         CLC
  3299  25a1 60                         RTS
  3300                          RGT_TO
  3301  25a2 38                         SEC
  3302  25a3 60                         RTS
  3303                          
  3304                          
  3305                          
  3306                          ; ----------------------------------------------------------------
  3307                          ; MODEM_DIAL - send ATDT, wait for CONNECT
  3308                          ; Bug 5 fix: AT wake-up primer added.
  3309                          ;   After ACIA_INIT the U64 FPGA modem refuses to process ATDT
  3310                          ;   without a preceding AT\r. Symptom: CRs echoed but no
  3311                          ;   CONNECT and no TCP connection. Proven on hardware v3.
  3312                          ; C=0 = connected / C=1 = failed or timeout
  3313                          ; ----------------------------------------------------------------
  3314                          MODEM_DIAL
  3315                                  ; Step 1: AT wake-up primer (Bug 5 fix)
  3316  25a4 a9ce                       LDA #<STR_AT
  3317  25a6 85fb                       STA $FB
  3318  25a8 a943                       LDA #>STR_AT
  3319  25aa 85fc                       STA $FC
  3320  25ac 20eb24                     JSR ACIA_SEND_STR       ; send AT\r
  3321                          
  3322                                  ; Flush AT respons (max 20 bytes, weggooien)
  3323  25af a214                       LDX #20
  3324  25b1 20f824             MDW_FL  JSR ACIA_RECV_TO
  3325  25b4 b003                       BCS MDW_DN              ; timeout = done
  3326  25b6 ca                         DEX
  3327  25b7 d0f8                       BNE MDW_FL
  3328                          MDW_DN
  3329                          
  3330                                  ; ~100ms wait: modem fully processes wake-up
  3331  25b9 20b524                     JSR LONG_DELAY
  3332                          
  3333                                  ; Step 2: ATDT dial
  3334  25bc a9e4                       LDA #<STR_ATDT
  3335  25be 85fb                       STA $FB
  3336  25c0 a943                       LDA #>STR_ATDT
  3337  25c2 85fc                       STA $FC
  3338  25c4 20eb24                     JSR ACIA_SEND_STR
  3339                          
  3340  25c7 a240                       LDX #64
  3341  25c9 20f824             MD_RD   JSR ACIA_RECV_TO
  3342  25cc b003                       BCS MD_OK
  3343  25ce ca                         DEX
  3344  25cf d0f8                       BNE MD_RD
  3345  25d1 18                 MD_OK   CLC
  3346  25d2 60                         RTS
  3347                          
  3348                          ATDT_TEST
  3349  25d3 a9e4                       LDA #<STR_ATDT
  3350  25d5 85fb                       STA $FB
  3351  25d7 a943                       LDA #>STR_ATDT
  3352  25d9 85fc                       STA $FC
  3353  25db 20eb24                     JSR ACIA_SEND_STR   ; send "ATDT192.168.1.100:8889\r"
  3354                          
  3355                                  ; read buffer first, only then print
  3356  25de a200                       LDX #0
  3357  25e0 20f824             ADT_RD  JSR ACIA_RECV_TO
  3358  25e3 b008                       BCS ADT_PR
  3359  25e5 9dd243                     STA AT_BUF,X
  3360  25e8 e8                         INX
  3361  25e9 e018                       CPX #24
  3362  25eb d0f3                       BNE ADT_RD
  3363  25ed 8ee243             ADT_PR  STX AT_CNT
  3364  25f0 a200                       LDX #0
  3365  25f2 ece243             ADT_PL  CPX AT_CNT
  3366  25f5 f00f                       BEQ ADT_DN
  3367  25f7 bdd243                     LDA AT_BUF,X
  3368  25fa 20fa0c                     JSR PRINT_HEX_PET
  3369  25fd a920                       LDA #$20
  3370  25ff 20ba0c                     JSR PRINT_CHR
  3371  2602 e8                         INX
  3372  2603 4cf225                     JMP ADT_PL
  3373  2606 a90d               ADT_DN  LDA #$0D
  3374  2608 20ba0c                     JSR PRINT_CHR
  3375  260b 60                         RTS          
  3376                                    
  3377                          
  3378  260c 00                 MD_TRIES !byte 0
  3379                          
  3380                          
  3381                          ; ================================================================
  3382                          ; WS_HANDSHAKE - send HTTP upgrade + wait fixed time + BOUNDED 101 drain
  3383                          ; On the U64 RDRF can "stick"; so we drain the 101 response
  3384                          ; bounded (max 16 read attempts OR until timeout). C=0 always.
  3385                          ; ================================================================
  3386                          WS_HANDSHAKE
  3387  260d a9fe                       LDA #<STR_WS_HDR
  3388  260f 85fb                       STA $FB
  3389  2611 a943                       LDA #>STR_WS_HDR
  3390  2613 85fc                       STA $FC
  3391  2615 20eb24                     JSR ACIA_SEND_STR   ; send HTTP upgrade
  3392                          
  3393                                  ; 1000ms real via CIA2 — clock-speed-independent (Bug 6 fix)
  3394                                  ; Previously cpu-count loops: ~1s @ 64MHz but ~64s @ 1MHz!
  3395  2618 a964                       LDA #100
  3396  261a 208d24                     JSR CIA2_WAIT_10MS  ; 100 × 10ms = 1000ms real
  3397                          
  3398                                  ; Item 11B: read and discard the HTTP 101 response - BOUNDED,
  3399                                  ; like recvtest64. Otherwise the HTTP headers stay in the
  3400                                  ; ACIA buffer and WS_RECV_FRAME reads them later as an (invalid)
  3401                                  ; frame. Unbounded could hang forever if RDRF sticks on the U64;
  3402                                  ; so: drain until timeout (buffer truly empty). nginx' 101 response
  3403                                  ; is ~188 bytes; the old limit of 16 left ~172 bytes of HTTP header
  3404                                  ; which WS_AUTH then read as a junk frame. Limit 255 = safety brake.
  3405  261d a2ff                       LDX #255
  3406  261f 20f824             WSH_DRN JSR ACIA_RECV_TO
  3407  2622 b003                       BCS WSH_DN          ; timeout = buffer empty, response consumed
  3408  2624 ca                         DEX
  3409  2625 d0f8                       BNE WSH_DRN         ; max 255 bytes
  3410  2627 18                 WSH_DN  CLC
  3411  2628 60                         RTS
  3412                          
  3413                          
  3414                          ; ================================================================
  3415                          ; WS_SEND - send null-terminated string as a WebSocket text frame
  3416                          ; $FB/$FC = pointer to string
  3417                          ; ================================================================
  3418                          WS_SEND
  3419  2629 a000                       LDY #0
  3420  262b b1fb               WSLEN   LDA ($FB),Y
  3421  262d f005                       BEQ WSLEN_DN
  3422  262f c8                         INY
  3423  2630 c07d                       CPY #125
  3424  2632 d0f7                       BNE WSLEN
  3425  2634 8c7726             WSLEN_DN STY WS_MLEN
  3426                          
  3427  2637 a981                       LDA #$81        ; FIN + text opcode
  3428  2639 20bb24                     JSR ACIA_SEND
  3429  263c ad7726                     LDA WS_MLEN
  3430  263f 0980                       ORA #$80        ; mask bit aan
  3431  2641 20bb24                     JSR ACIA_SEND
  3432  2644 a937                       LDA #$37        ; masking key byte 0
  3433  2646 20bb24                     JSR ACIA_SEND
  3434  2649 a9fa                       LDA #$FA        ; masking key byte 1
  3435  264b 20bb24                     JSR ACIA_SEND
  3436  264e a921                       LDA #$21        ; masking key byte 2
  3437  2650 20bb24                     JSR ACIA_SEND
  3438  2653 a93d                       LDA #$3D        ; masking key byte 3
  3439  2655 20bb24                     JSR ACIA_SEND
  3440                          
  3441  2658 a000                       LDY #0
  3442  265a cc7726             WSPL    CPY WS_MLEN
  3443  265d f016                       BEQ WSPL_DN
  3444  265f 8c7826                     STY WS_YT
  3445  2662 98                         TYA
  3446  2663 2903                       AND #$03
  3447  2665 aa                         TAX
  3448  2666 bd7926                     LDA WS_MASK,X
  3449  2669 ac7826                     LDY WS_YT
  3450  266c 51fb                       EOR ($FB),Y     ; mask XOR payload byte
  3451  266e 20bb24                     JSR ACIA_SEND
  3452  2671 c8                         INY
  3453  2672 4c5a26                     JMP WSPL
  3454  2675 60                 WSPL_DN RTS
  3455                          
  3456  2676 00                 WS_HS_ST !byte 0
  3457  2677 00                 WS_MLEN  !byte 0
  3458  2678 00                 WS_YT    !byte 0
  3459  2679 37fa213d           WS_MASK  !byte $37,$FA,$21,$3D
  3460                          
  3461                          ; ----------------------------------------------------------------
  3462                          ; AT_TEST - send AT\r, buffer response, only then print
  3463                          ; ----------------------------------------------------------------
  3464                          AT_TEST
  3465  267d 207d24                     JSR ACIA_INIT
  3466                          
  3467                                  ; small pause after init
  3468  2680 a200                       LDX #0
  3469  2682 ca                 ATT_DL  DEX
  3470  2683 d0fd                       BNE ATT_DL
  3471                          
  3472  2685 a9ce                       LDA #<STR_AT
  3473  2687 85fb                       STA $FB
  3474  2689 a943                       LDA #>STR_AT
  3475  268b 85fc                       STA $FC
  3476  268d 20eb24                     JSR ACIA_SEND_STR
  3477                          
  3478                                  ; read up to 16 bytes into buffer (NO print while reading)
  3479  2690 a200                       LDX #0
  3480  2692 20f824             ATT_RD  JSR ACIA_RECV_TO
  3481  2695 b008                       BCS ATT_PR      ; timeout = done
  3482  2697 9dd243                     STA AT_BUF,X
  3483  269a e8                         INX
  3484  269b e010                       CPX #16
  3485  269d d0f3                       BNE ATT_RD
  3486                          
  3487  269f 8ee243             ATT_PR  STX AT_CNT
  3488  26a2 a200                       LDX #0
  3489  26a4 ece243             ATT_PL  CPX AT_CNT
  3490  26a7 f00f                       BEQ ATT_DN
  3491  26a9 bdd243                     LDA AT_BUF,X
  3492  26ac 20fa0c                     JSR PRINT_HEX_PET
  3493  26af a920                       LDA #$20
  3494  26b1 20ba0c                     JSR PRINT_CHR
  3495  26b4 e8                         INX
  3496  26b5 4ca426                     JMP ATT_PL
  3497  26b8 a90d               ATT_DN  LDA #$0D
  3498  26ba 20ba0c                     JSR PRINT_CHR
  3499  26bd 60                         RTS
  3500                          
  3501                          
  3502                          ; ================================================================
  3503                          ; GCM COMBINATIE: NONCE-GENERATOR + AES_GCM_ENCRYPT + JSON-BUILDER
  3504                          ; + WS_SEND_EXT (uitgebreide WebSocket-frame) + WS_SEND_MSG
  3505                          ; ================================================================
  3506                          
  3507                          ; ================================================================
  3508                          ; JOUT_INIT  -  reset JSON-uitvoerbuffer
  3509                          ; ================================================================
  3510                          JOUT_INIT
  3511  26be a983                       LDA #<JOUT_BUF
  3512  26c0 8d835a                     STA JOUT_LO
  3513  26c3 a955                       LDA #>JOUT_BUF
  3514  26c5 8d845a                     STA JOUT_HI
  3515  26c8 a900                       LDA #0
  3516  26ca 8d855a                     STA JOUT_LEN+0
  3517  26cd 8d865a                     STA JOUT_LEN+1
  3518  26d0 60                         RTS
  3519                          
  3520                          ; ================================================================
  3521                          ; JOUT_EMIT  -  write byte A to JOUT_BUF, advance write pointer
  3522                          ; ================================================================
  3523                          JOUT_EMIT
  3524                                  ; STA (addr),Y requires a zero-page address for addr.
  3525                                  ; JOUT_LO/HI are outside zero-page, so copy to $FD/$FE first.
  3526  26d1 48                         PHA                 ; save byte to write
  3527  26d2 ad835a                     LDA JOUT_LO
  3528  26d5 85fd                       STA $FD             ; zero-page write pointer lo
  3529  26d7 ad845a                     LDA JOUT_HI
  3530  26da 85fe                       STA $FE             ; zero-page write pointer hi
  3531  26dc 68                         PLA                 ; restore byte
  3532  26dd a000                       LDY #0
  3533  26df 91fd                       STA ($FD),Y         ; indirect write via zero-page pointer
  3534  26e1 ee835a                     INC JOUT_LO
  3535  26e4 d003                       BNE JOE_D
  3536  26e6 ee845a                     INC JOUT_HI
  3537  26e9 ee855a             JOE_D   INC JOUT_LEN+0
  3538  26ec d003                       BNE JOE_N
  3539  26ee ee865a                     INC JOUT_LEN+1
  3540  26f1 60                 JOE_N   RTS
  3541                          
  3542                          ; ================================================================
  3543                          ; JOUT_EMIT_STR  -  write null-terminated string via $FB/$FC
  3544                          ; Fix: increment $FB/$FC pointer instead of Y-index; JOUT_EMIT may Y
  3545                          ; clobber (LDY #0 internally) without breaking the loop.
  3546                          ; ================================================================
  3547                          JOUT_EMIT_STR
  3548  26f2 a000               JES_LP  LDY #0
  3549  26f4 b1fb                       LDA ($FB),Y         ; read current char (Y always 0)
  3550  26f6 f00c                       BEQ JES_DN
  3551  26f8 20d126                     JSR JOUT_EMIT       ; may clobber Y - no problem
  3552  26fb e6fb                       INC $FB             ; advance $FB/$FC one char
  3553  26fd d0f3                       BNE JES_LP
  3554  26ff e6fc                       INC $FC
  3555  2701 4cf226                     JMP JES_LP
  3556  2704 60                 JES_DN  RTS
  3557                          
  3558                          ; ================================================================
  3559                          ; BYTE_TO_DEC  -  emit byte A as 1-3 decimal chars to JOUT
  3560                          ; ================================================================
  3561                          BYTE_TO_DEC
  3562  2705 8da45a                     STA BTD_VAL
  3563  2708 a900                       LDA #0
  3564  270a 8da55a                     STA BTD_NZ          ; 0 = no non-zero char seen yet
  3565                          
  3566                                  ; ---- honderdtallen ----
  3567  270d a200                       LDX #0
  3568  270f ada45a             BTD_H1  LDA BTD_VAL
  3569  2712 c964                       CMP #100
  3570  2714 9009                       BCC BTD_H2
  3571  2716 e964                       SBC #100            ; carry already set by CMP (A>=100)
  3572  2718 8da45a                     STA BTD_VAL
  3573  271b e8                         INX
  3574  271c 4c0f27                     JMP BTD_H1
  3575  271f 8a                 BTD_H2  TXA
  3576  2720 f00a                       BEQ BTD_T1          ; 0 hundreds -> skip
  3577  2722 0930                       ORA #$30
  3578  2724 20d126                     JSR JOUT_EMIT
  3579  2727 a901                       LDA #1
  3580  2729 8da55a                     STA BTD_NZ
  3581                          
  3582                                  ; ---- tens ----
  3583  272c a200               BTD_T1  LDX #0
  3584  272e ada45a             BTD_T2  LDA BTD_VAL
  3585  2731 c90a                       CMP #10
  3586  2733 9009                       BCC BTD_T3
  3587  2735 e90a                       SBC #10
  3588  2737 8da45a                     STA BTD_VAL
  3589  273a e8                         INX
  3590  273b 4c2e27                     JMP BTD_T2
  3591  273e 8a                 BTD_T3  TXA
  3592  273f f00d                       BEQ BTD_TZ          ; 0 tens - check flag
  3593  2741 0930                       ORA #$30
  3594  2743 20d126                     JSR JOUT_EMIT
  3595  2746 a901                       LDA #1
  3596  2748 8da55a                     STA BTD_NZ
  3597  274b 4c5827                     JMP BTD_U1
  3598  274e ada55a             BTD_TZ  LDA BTD_NZ          ; write '0' only if hundreds digit was written
  3599  2751 f005                       BEQ BTD_U1
  3600  2753 a930                       LDA #$30
  3601  2755 20d126                     JSR JOUT_EMIT
  3602                          
  3603                                  ; ---- units (always write) ----
  3604  2758 ada45a             BTD_U1  LDA BTD_VAL
  3605  275b 0930                       ORA #$30
  3606  275d 20d126                     JSR JOUT_EMIT
  3607  2760 60                         RTS
  3608                          
  3609                          ; ================================================================
  3610                          ; GCM_NONCE_GEN  -  generate 12-byte nonce via CIA timers + counter
  3611                          ; ================================================================
  3612                          ; CIA1: $DC04/$DC05 = Timer-A lo/hi,  $DC06/$DC07 = Timer-B lo/hi
  3613                          ; CIA2: $DD04/$DD05 = Timer-A lo/hi,  $DD06/$DD07 = Timer-B lo/hi
  3614                          ; Bytes 8-9   : message counter GCM_MSG_CTR (ensures uniqueness)
  3615                          ; Bytes 10-11 : CIA1-A re-read XOR counter (extra entropy)
  3616                          ; Output     : AES_NONCE[0..11] filled
  3617                          ; ================================================================
  3618                          GCM_NONCE_GEN
  3619  2761 ad04dc                     LDA $DC04           ; CIA1 Timer-A low
  3620  2764 8d2252                     STA AES_NONCE+0
  3621  2767 ad05dc                     LDA $DC05           ; CIA1 Timer-A high
  3622  276a 8d2352                     STA AES_NONCE+1
  3623  276d ad06dc                     LDA $DC06           ; CIA1 Timer-B low
  3624  2770 8d2452                     STA AES_NONCE+2
  3625  2773 ad07dc                     LDA $DC07           ; CIA1 Timer-B high
  3626  2776 8d2552                     STA AES_NONCE+3
  3627  2779 ad04dd                     LDA $DD04           ; CIA2 Timer-A low
  3628  277c 8d2652                     STA AES_NONCE+4
  3629  277f ad05dd                     LDA $DD05           ; CIA2 Timer-A high
  3630  2782 8d2752                     STA AES_NONCE+5
  3631  2785 ad06dd                     LDA $DD06           ; CIA2 Timer-B low
  3632  2788 8d2852                     STA AES_NONCE+6
  3633  278b ad07dd                     LDA $DD07           ; CIA2 Timer-B high
  3634  278e 8d2952                     STA AES_NONCE+7
  3635                                  ; message counter gives guaranteed uniqueness per message
  3636  2791 ad8155                     LDA GCM_MSG_CTR+0
  3637  2794 8d2a52                     STA AES_NONCE+8
  3638  2797 ad8255                     LDA GCM_MSG_CTR+1
  3639  279a 8d2b52                     STA AES_NONCE+9
  3640                                  ; re-read after some delay XOR counter
  3641  279d ad04dc                     LDA $DC04
  3642  27a0 4d8155                     EOR GCM_MSG_CTR+0
  3643  27a3 8d2c52                     STA AES_NONCE+10
  3644  27a6 ad05dc                     LDA $DC05
  3645  27a9 4d8255                     EOR GCM_MSG_CTR+1
  3646  27ac 8d2d52                     STA AES_NONCE+11
  3647                                  ; increment 16-bit counter
  3648  27af ee8155                     INC GCM_MSG_CTR+0
  3649  27b2 d003                       BNE GNG_DN
  3650  27b4 ee8255                     INC GCM_MSG_CTR+1
  3651  27b7 60                 GNG_DN  RTS
  3652                          
  3653                          ; ================================================================
  3654                          ; AES_GCM_ENCRYPT  -  full AES-128-GCM: CTR mode + GHASH tag
  3655                          ; ================================================================
  3656                          ; Input:
  3657                          ;   GCM_IN_KEY[0..15]  16-byte AES-128 key
  3658                          ;   GCM_PT_PTR[0..1]   lo/hi address of plaintext buffer
  3659                          ;   GCM_PT_LEN         plaintext length in bytes (1..239)
  3660                          ; Output:
  3661                          ;   AES_NONCE[0..11]   fresh nonce (generated by GCM_NONCE_GEN)
  3662                          ;   GCM_CTBUF[0..n-1]  ciphertext (n = GCM_PT_LEN bytes)
  3663                          ;   GCM_TAG[0..15]     16-byte GHASH authentication tag
  3664                          ; Clobbers : AES_KEY, AES_RK, AES_BLOCK, AES_STATE, GCM_H, GCM_EK0
  3665                          ;            GCM_Y, GCM_BLK, GCM_GX/GY/GZ/VBUF, AES_CTR_*
  3666                          ; ================================================================
  3667                          AES_GCM_ENCRYPT
  3668                                  ; -- load key and compute round keys --
  3669  27b8 a20f                       LDX #15
  3670  27ba bded52             AGE_K   LDA GCM_IN_KEY,X
  3671  27bd 9dcf4a                     STA AES_KEY,X
  3672  27c0 ca                         DEX
  3673  27c1 10f7                       BPL AGE_K
  3674  27c3 201446                     JSR AES_SETKEY
  3675                          
  3676                                  ; -- generate fresh 12-byte nonce --
  3677  27c6 206127                     JSR GCM_NONCE_GEN
  3678                          
  3679                                  ; -- compute GCM hash subkey H and tag block EK0 --
  3680                                  ;    GCM_INIT expects AES_RK filled and AES_NONCE[0..11] set
  3681  27c9 203233                     JSR GCM_INIT
  3682                          
  3683                                  ; -- CTR-modus encryptie: plaintext -> GCM_CTBUF --
  3684                                  ;    counter starts at $00000002 (per GCM spec; J0 reserved)
  3685  27cc adfd52                     LDA GCM_PT_PTR+0
  3686  27cf 8d2e52                     STA AES_CTR_IN+0
  3687  27d2 adfe52                     LDA GCM_PT_PTR+1
  3688  27d5 8d2f52                     STA AES_CTR_IN+1
  3689  27d8 a901                       LDA #<GCM_CTBUF
  3690  27da 8d3052                     STA AES_CTR_OUT+0
  3691  27dd a953                       LDA #>GCM_CTBUF
  3692  27df 8d3152                     STA AES_CTR_OUT+1
  3693  27e2 adff52                     LDA GCM_PT_LEN+0
  3694  27e5 8d3252                     STA AES_CTR_LEN+0
  3695  27e8 ad0053                     LDA GCM_PT_LEN+1
  3696  27eb 8d3352                     STA AES_CTR_LEN+1
  3697  27ee 20f449                     JSR AES_CTR_CRYPT
  3698                          
  3699                                  ; -- GHASH authentication tag over ciphertext --
  3700                                  ;    GCM_AUTH: empty AAD; GHASH over CT blocks + length block; XOR EK0
  3701  27f1 a901                       LDA #<GCM_CTBUF
  3702  27f3 8d3d52                     STA GCM_CT_PTR+0
  3703  27f6 a953                       LDA #>GCM_CTBUF
  3704  27f8 8d3e52                     STA GCM_CT_PTR+1
  3705  27fb adff52                     LDA GCM_PT_LEN+0
  3706  27fe 8d3f52                     STA GCM_CT_LEN+0
  3707  2801 ad0053                     LDA GCM_PT_LEN+1
  3708  2804 8d4052                     STA GCM_CT_LEN+1
  3709  2807 207433                     JSR GCM_AUTH        ; -> GCM_TAG[0..15]
  3710  280a 60                         RTS
  3711                          
  3712                          ; ================================================================
  3713                          ; GCM_TAG_MAC  -  AES-128-GCM auth tag as MAC (web client signBlob128)
  3714                          ; ================================================================
  3715                          ; Reproduceert: AES-128-GCM(key, IV=12x00, plaintext).slice(-16)
  3716                          ; Input:
  3717                          ;   KEY_SIGN_SELF[0..15]  16-byte MAC key (own signKey128)
  3718                          ;   BLOB_PTR[0..1]        lo/hi address of the blob bytes (in JOUT_BUF)
  3719                          ;   MAC_LEN[0..1]         16-bit length of the blob bytes
  3720                          ; Output:
  3721                          ;   GCM_TAG[0..15]        16-byte tag (= sig)
  3722                          ; Difference from AES_GCM_ENCRYPT: NO GCM_NONCE_GEN; fixed zero IV.
  3723                          ; Writes ciphertext to MAC_CTBUF (not GCM_CTBUF -> message intact).
  3724                          ; ================================================================
  3725                          GCM_TAG_MAC
  3726                                  ; key = KEY_SIGN_SELF -> AES_KEY, round keys --
  3727  280b a20f                       LDX #15
  3728  280d bd163b             GTM_K   LDA KEY_SIGN_SELF,X
  3729  2810 9dcf4a                     STA AES_KEY,X
  3730  2813 ca                         DEX
  3731  2814 10f7                       BPL GTM_K
  3732  2816 201446                     JSR AES_SETKEY
  3733                          
  3734                                  ; -- fixed zero-IV: AES_NONCE[0..11] = 0 --
  3735  2819 a900                       LDA #$00
  3736  281b a20b                       LDX #11
  3737  281d 9d2252             GTM_N   STA AES_NONCE,X
  3738  2820 ca                         DEX
  3739  2821 10fa                       BPL GTM_N
  3740                          
  3741                                  ; H and EK0 (J0 = zero-IV || $00000001) --
  3742  2823 203233                     JSR GCM_INIT
  3743                          
  3744                                  ; -- CTR-encrypt blob-bytes -> MAC_CTBUF --
  3745  2826 ad263b                     LDA BLOB_PTR+0
  3746  2829 8d2e52                     STA AES_CTR_IN+0
  3747  282c ad273b                     LDA BLOB_PTR+1
  3748  282f 8d2f52                     STA AES_CTR_IN+1
  3749  2832 a92c                       LDA #<MAC_CTBUF
  3750  2834 8d3052                     STA AES_CTR_OUT+0
  3751  2837 a93b                       LDA #>MAC_CTBUF
  3752  2839 8d3152                     STA AES_CTR_OUT+1
  3753  283c ad2a3b                     LDA MAC_LEN+0
  3754  283f 8d3252                     STA AES_CTR_LEN+0
  3755  2842 ad2b3b                     LDA MAC_LEN+1
  3756  2845 8d3352                     STA AES_CTR_LEN+1
  3757  2848 20f449                     JSR AES_CTR_CRYPT
  3758                          
  3759                                  ; -- GHASH over ciphertext -> GCM_TAG --
  3760  284b a92c                       LDA #<MAC_CTBUF
  3761  284d 8d3d52                     STA GCM_CT_PTR+0
  3762  2850 a93b                       LDA #>MAC_CTBUF
  3763  2852 8d3e52                     STA GCM_CT_PTR+1
  3764  2855 ad2a3b                     LDA MAC_LEN+0
  3765  2858 8d3f52                     STA GCM_CT_LEN+0
  3766  285b ad2b3b                     LDA MAC_LEN+1
  3767  285e 8d4052                     STA GCM_CT_LEN+1
  3768  2861 207433                     JSR GCM_AUTH        ; -> GCM_TAG[0..15]
  3769  2864 60                         RTS
  3770                          
  3771                          ; ================================================================
  3772                          ; B64URL_12BYTES  -  base64url-codering: C64_IDBYTES[0..11] -> C64_IDSTR[0..15]
  3773                          ; ================================================================
  3774                          ; 4 groups of 3 bytes -> 4 chars each  (no padding: 12 bytes = 16 chars)
  3775                          ; URL-veilig alfabet: index 62 = '-', index 63 = '_'
  3776                          ; ================================================================
  3777                          B64URL_12BYTES
  3778  2865 a900                       LDA #0
  3779  2867 8dab6b                     STA B64_GRPIDX          ; groepsindex 0..3
  3780  286a adab6b             B64_GLP LDA B64_GRPIDX
  3781  286d c904                       CMP #4
  3782                                  ; BEQ B64_GDN would jump 147 bytes - outside +-127 range.
  3783                                  ; Solution: invert to BNE-skip + absolute JMP.
  3784  286f d003                       BNE B64_GC
  3785  2871 4c0729                     JMP B64_GDN         ; 3-byte absolute jump, no distance limit
  3786                          B64_GC
  3787                          
  3788                                  ; byte-offset = GRPIDX * 3 = (GRPIDX<<1) + GRPIDX
  3789  2874 adab6b                     LDA B64_GRPIDX
  3790  2877 0a                         ASL
  3791  2878 8dac6b                     STA B64_BOFF
  3792  287b 18                         CLC
  3793  287c 6dab6b                     ADC B64_GRPIDX
  3794  287f 8dac6b                     STA B64_BOFF            ; B64_BOFF = GRPIDX * 3
  3795                          
  3796                                  ; load 3 input bytes
  3797  2882 aa                         TAX
  3798  2883 bd875a                     LDA C64_IDBYTES+0,X
  3799  2886 8da76b                     STA B64_B0
  3800  2889 bd885a                     LDA C64_IDBYTES+1,X
  3801  288c 8da86b                     STA B64_B1
  3802  288f bd895a                     LDA C64_IDBYTES+2,X
  3803  2892 8da96b                     STA B64_B2
  3804                          
  3805                                  ; output offset = GRPIDX * 4
  3806  2895 adab6b                     LDA B64_GRPIDX
  3807  2898 0a                         ASL
  3808  2899 0a                         ASL
  3809  289a 8dad6b                     STA B64_OIDX            ; B64_OIDX = GRPIDX * 4
  3810                          
  3811                                  ; char 0: B0[7..2] = B0 >> 2
  3812  289d ada76b                     LDA B64_B0
  3813  28a0 4a                         LSR
  3814  28a1 4a                         LSR
  3815  28a2 aa                         TAX
  3816  28a3 bdd06c                     LDA B64_TABLE,X
  3817  28a6 acad6b                     LDY B64_OIDX
  3818  28a9 99935a                     STA C64_IDSTR,Y
  3819                          
  3820                                  ; char 1: (B0[1..0] << 4) | (B1[7..4])
  3821  28ac ada76b                     LDA B64_B0
  3822  28af 2903                       AND #$03
  3823  28b1 0a                         ASL
  3824  28b2 0a                         ASL
  3825  28b3 0a                         ASL
  3826  28b4 0a                         ASL
  3827  28b5 8daa6b                     STA B64_T
  3828  28b8 ada86b                     LDA B64_B1
  3829  28bb 4a                         LSR
  3830  28bc 4a                         LSR
  3831  28bd 4a                         LSR
  3832  28be 4a                         LSR
  3833  28bf 0daa6b                     ORA B64_T
  3834  28c2 aa                         TAX
  3835  28c3 bdd06c                     LDA B64_TABLE,X
  3836  28c6 acad6b                     LDY B64_OIDX
  3837  28c9 c8                         INY
  3838  28ca 99935a                     STA C64_IDSTR,Y
  3839                          
  3840                                  ; char 2: (B1[3..0] << 2) | (B2[7..6])
  3841  28cd ada86b                     LDA B64_B1
  3842  28d0 290f                       AND #$0F
  3843  28d2 0a                         ASL
  3844  28d3 0a                         ASL
  3845  28d4 8daa6b                     STA B64_T
  3846  28d7 ada96b                     LDA B64_B2
  3847  28da 4a                         LSR
  3848  28db 4a                         LSR
  3849  28dc 4a                         LSR
  3850  28dd 4a                         LSR
  3851  28de 4a                         LSR
  3852  28df 4a                         LSR
  3853  28e0 0daa6b                     ORA B64_T
  3854  28e3 aa                         TAX
  3855  28e4 bdd06c                     LDA B64_TABLE,X
  3856  28e7 acad6b                     LDY B64_OIDX
  3857  28ea c8                         INY
  3858  28eb c8                         INY
  3859  28ec 99935a                     STA C64_IDSTR,Y
  3860                          
  3861                                  ; char 3: B2[5..0]
  3862  28ef ada96b                     LDA B64_B2
  3863  28f2 293f                       AND #$3F
  3864  28f4 aa                         TAX
  3865  28f5 bdd06c                     LDA B64_TABLE,X
  3866  28f8 acad6b                     LDY B64_OIDX
  3867  28fb c8                         INY
  3868  28fc c8                         INY
  3869  28fd c8                         INY
  3870  28fe 99935a                     STA C64_IDSTR,Y
  3871                          
  3872  2901 eeab6b                     INC B64_GRPIDX
  3873  2904 4c6a28                     JMP B64_GLP
  3874  2907 60                 B64_GDN RTS
  3875                          
  3876                          ; ================================================================
  3877                          ; COMPUTE_C64_ID  -  compute C64 publicId: base64url(SHA256(encKey)[0..11])
  3878                          ; ================================================================
  3879                          ; publicId = base64url( SHA-256(HKDF_OKM[0..15])[0..11] )
  3880                          ; Identiek aan JS: derivePublicId(keys.encryptionKey)
  3881                          ; Output: C64_IDSTR[0..15] = 16 ASCII chars + null terminator
  3882                          ; ================================================================
  3883                          COMPUTE_C64_ID
  3884                                  ; OPTION A: SHA-256 of the 16-byte AES key
  3885                                  ; Identiek aan JS: derivePublicId(keys.encryptionKey.slice(0,16))
  3886  2908 a20f                       LDX #15
  3887  290a bd2039             CC4_SK  LDA KEY_SELF,X         ; own key -> staging
  3888  290d 9d2c40                     STA ID_KEY_IN,X
  3889  2910 ca                         DEX
  3890  2911 10f7                       BPL CC4_SK
  3891                          COMPUTE_ID_CORE
  3892  2913 a20f                       LDX #15
  3893  2915 bd2c40             CC4_CP  LDA ID_KEY_IN,X        ; staging buffer (self or peer)
  3894  2918 9da935                     STA SHA_BLK,X
  3895  291b ca                         DEX
  3896  291c 10f7                       BPL CC4_CP
  3897                          
  3898                                  ; clear the rest of the SHA block
  3899  291e a210                       LDX #16
  3900  2920 a900               CC4_CL  LDA #$00
  3901  2922 9da935                     STA SHA_BLK,X
  3902  2925 e8                         INX
  3903  2926 e040                       CPX #64
  3904  2928 d0f6                       BNE CC4_CL
  3905                          
  3906                                  ; SHA-256 padding: $80 op positie 16; bitlengte = 128 bits = $0080
  3907  292a a980                       LDA #$80
  3908  292c 8db935                     STA SHA_BLK+16
  3909  292f a900                       LDA #$00            ; 128 bits high byte
  3910  2931 8de735                     STA SHA_BLK+62
  3911  2934 a980                       LDA #$80            ; 128 bits low byte
  3912  2936 8de835                     STA SHA_BLK+63
  3913                          
  3914  2939 208f17                     JSR SHA_INIT
  3915  293c 20ac16                     JSR SHA_EXPAND
  3916  293f 203018                     JSR SHA_COMPRESS
  3917                          
  3918                                  ; copy first 12 bytes of SHA output (big-endian per word)
  3919                                  ; -> C64_IDBYTES[0..11]
  3920                          CC4_DIGEST_TAIL
  3921  2942 ad7e35                     LDA SHA_H0+3
  3922  2945 8d875a                     STA C64_IDBYTES+0
  3923  2948 ad7d35                     LDA SHA_H0+2
  3924  294b 8d885a                     STA C64_IDBYTES+1
  3925  294e ad7c35                     LDA SHA_H0+1
  3926  2951 8d895a                     STA C64_IDBYTES+2
  3927  2954 ad7b35                     LDA SHA_H0+0
  3928  2957 8d8a5a                     STA C64_IDBYTES+3
  3929  295a ad8235                     LDA SHA_H1+3
  3930  295d 8d8b5a                     STA C64_IDBYTES+4
  3931  2960 ad8135                     LDA SHA_H1+2
  3932  2963 8d8c5a                     STA C64_IDBYTES+5
  3933  2966 ad8035                     LDA SHA_H1+1
  3934  2969 8d8d5a                     STA C64_IDBYTES+6
  3935  296c ad7f35                     LDA SHA_H1+0
  3936  296f 8d8e5a                     STA C64_IDBYTES+7
  3937  2972 ad8635                     LDA SHA_H2+3
  3938  2975 8d8f5a                     STA C64_IDBYTES+8
  3939  2978 ad8535                     LDA SHA_H2+2
  3940  297b 8d905a                     STA C64_IDBYTES+9
  3941  297e ad8435                     LDA SHA_H2+1
  3942  2981 8d915a                     STA C64_IDBYTES+10
  3943  2984 ad8335                     LDA SHA_H2+0
  3944  2987 8d925a                     STA C64_IDBYTES+11
  3945                          
  3946                                  ; base64url encoding of 12 bytes -> 16 chars
  3947  298a 206528                     JSR B64URL_12BYTES
  3948                          
  3949                                  ; null-terminator
  3950  298d a900                       LDA #0
  3951  298f 8da35a                     STA C64_IDSTR+16
  3952  2992 60                         RTS
  3953                          
  3954                          ; ================================================================
  3955                          ; COMPUTE_PEER_ID - publicId of KEY_PEER -> PEER_IDSTR ('to' field)
  3956                          ; Uses COMPUTE_ID_CORE; clobbers C64_IDSTR (afterwards
  3957                          ; call COMPUTE_C64_ID for the own id).
  3958                          ; ================================================================
  3959                          COMPUTE_PEER_ID
  3960  2993 a20f                       LDX #15
  3961  2995 bd3039             CPI_CK  LDA KEY_PEER,X
  3962  2998 9d2c40                     STA ID_KEY_IN,X
  3963  299b ca                         DEX
  3964  299c 10f7                       BPL CPI_CK
  3965  299e 201329                     JSR COMPUTE_ID_CORE
  3966  29a1 a200                       LDX #0
  3967  29a3 bd935a             CPI_CP  LDA C64_IDSTR,X
  3968  29a6 9d3c40                     STA PEER_IDSTR,X
  3969  29a9 e8                         INX
  3970  29aa e011                       CPX #17
  3971  29ac d0f5                       BNE CPI_CP
  3972  29ae 60                         RTS
  3973                          
  3974                          ; ================================================================
  3975                          ; INNER_EMIT  -  write byte A to MSG_INNER_BUF
  3976                          ; Uses MIJ_LO/HI as write pointer (via $FD/$FE).
  3977                          ; Increments MSG_INNER_LEN. Preserves A; clobbers Y.
  3978                          ; ================================================================
  3979                          ; MC_RECV_POLL  -  poll ACIA, process incoming WS message
  3980                          ; Called from INPUT_LINE when no key.
  3981                          ; Preserves X (input buffer index). Clobbers A, Y.
  3982                          ; ================================================================
  3983                          MC_RECV_POLL
  3984  29af 8a                         TXA
  3985  29b0 48                         PHA                     ; save X (= typed chars)
  3986  29b1 a900                       LDA #0
  3987  29b3 8da26a                     STA MSG_SHOWN
  3988  29b6 ad9f6a                     LDA RING_TAIL
  3989  29b9 cd9e6a                     CMP RING_HEAD
  3990  29bc f014                       BEQ MRP_DONE            ; ring empty -> nothing to do
  3991  29be 20d529                     JSR WS_RECV_FRAME
  3992  29c1 b00f                       BCS MRP_DONE            ; error/non-text frame -> show nothing
  3993  29c3 20232b                     JSR PROC_RECV_MSG       ; shows only real message frames
  3994  29c6 ada26a                     LDA MSG_SHOWN
  3995  29c9 f007                       BEQ MRP_DONE            ; nothing shown -> do not redraw
  3996  29cb 68                         PLA
  3997  29cc aa                         TAX                     ; X = saved number of typed chars
  3998  29cd 20df2c                     JSR REDRAW_INPUT        ; redraw prompt + typed text
  3999  29d0 8a                         TXA
  4000  29d1 48                         PHA                     ; store again for restore
  4001                          MRP_DONE
  4002  29d2 68                         PLA
  4003  29d3 aa                         TAX                     ; restore X
  4004  29d4 60                         RTS
  4005                          
  4006                          ; ================================================================
  4007                          ; WS_RECV_FRAME  -  read 1 WebSocket text frame into RCV_BUF
  4008                          ; Server does not mask; we read unmasked payload.
  4009                          ; Carry clear = success, carry set = error or non-text frame.
  4010                          ; ================================================================
  4011                          WS_RECV_FRAME
  4012  29d5 ada06a                     LDA RING_OVF            ; A2: overflow = backup-flood/desync
  4013  29d8 f00c                       BEQ WRF_NOOVF
  4014                          WRF_RESYNC
  4015  29da 207025                     JSR RING_GET_TO         ; drain the ring until timeout (flush flood)
  4016  29dd 90fb                       BCC WRF_RESYNC
  4017  29df a900                       LDA #$00
  4018  29e1 8da06a                     STA RING_OVF
  4019  29e4 38                         SEC                     ; no frame this time; next is aligned
  4020  29e5 60                         RTS
  4021                          WRF_NOOVF
  4022  29e6 a900                       LDA #$00
  4023  29e8 8da06a                     STA RING_OVF            ; clear per-frame overflow flag
  4024  29eb 8dad5a                     STA RCV_TOOBIG          ; clear per-frame too-big flag
  4025  29ee 207025                     JSR RING_GET_TO
  4026  29f1 b009                       BCS WRFE_TR
  4027  29f3 290f                       AND #$0F                ; mask FIN/RSV: opcode
  4028  29f5 c909                       CMP #$09                ; ping frame (keepalive)?
  4029  29f7 d00c                       BNE WRF_NOTPING
  4030  29f9 4c982a                     JMP WRF_PING            ; -> pong back, reset keepalive
  4031  29fc 4c962a             WRFE_TR JMP WRF_ERR             ; trampoline (branches within +-127)
  4032  29ff 4c8f2a             WRFS_TR JMP WRF_SKIP            ; trampoline
  4033  2a02 4ce72a             WRFO_TR JMP WRF_OVERSIZE        ; trampoline (too-big -> reconnect)
  4034                          WRF_NOTPING
  4035  2a05 c908                       CMP #$08                ; A: close frame? relay closes -> reconnect
  4036  2a07 d003                       BNE WRF_NOTCLOSE
  4037  2a09 4c012b                     JMP MC_RECONNECT
  4038                          WRF_NOTCLOSE
  4039  2a0c c901                       CMP #$01                ; text frame?
  4040  2a0e d0ef                       BNE WRFS_TR
  4041                                  ; read length byte
  4042  2a10 207025                     JSR RING_GET_TO
  4043  2a13 b0e7                       BCS WRFE_TR
  4044  2a15 c97e                       CMP #126
  4045  2a17 b00b                       BCS WRF_EXT             ; >= 126 = extended length
  4046  2a19 8dab5a                     STA RCV_LEN_LO
  4047  2a1c a900                       LDA #0
  4048  2a1e 8dac5a                     STA RCV_LEN_HI
  4049  2a21 4c362a                     JMP WRF_DO_READ
  4050                          WRF_EXT
  4051  2a24 d0d9                       BNE WRFS_TR             ; 127 = 64-bit length: skip (drain until timeout)
  4052  2a26 207025                     JSR RING_GET_TO        ; high byte
  4053  2a29 b0d1                       BCS WRFE_TR
  4054  2a2b 8dac5a                     STA RCV_LEN_HI
  4055  2a2e 207025                     JSR RING_GET_TO        ; low byte
  4056  2a31 b0c9                       BCS WRFE_TR
  4057  2a33 8dab5a                     STA RCV_LEN_LO
  4058                          WRF_DO_READ
  4059                                  ; (no more reconnect on large frames) The read loop below
  4060                                  ; drains EVERY 16-bit-length frame: store up to RCV_BUF_END,
  4061                                  ; discard the rest and set RCV_TOOBIG. PROC_RECV_MSG then shows
  4062                                  ; the non-reconnecting warning and the connection stays.
  4063                                  ; (web client periodically sends large backup_push frames; they
  4064                                  ;  are swallowed cleanly instead of an endless reconnect loop.)
  4065  2a36 a99e                       LDA #<RCV_BUF
  4066  2a38 85fb                       STA $FB
  4067  2a3a a95f                       LDA #>RCV_BUF
  4068  2a3c 85fc                       STA $FC
  4069  2a3e adac5a                     LDA RCV_LEN_HI
  4070  2a41 8da85a                     STA WRF_CTR_HI
  4071  2a44 adab5a                     LDA RCV_LEN_LO
  4072  2a47 8da75a                     STA WRF_CTR_LO
  4073  2a4a 0da85a                     ORA WRF_CTR_HI
  4074  2a4d f038                       BEQ WRF_RDONE           ; length zero
  4075                          WRF_RLOP
  4076  2a4f 207025                     JSR RING_GET_TO
  4077  2a52 b042                       BCS WRF_ERR
  4078  2a54 a6fc                       LDX $FC                 ; grens-check: pointer < RCV_BUF_END?
  4079  2a56 e069                       CPX #>RCV_BUF_END
  4080  2a58 9010                       BCC WRF_STORE
  4081  2a5a d006                       BNE WRF_NOSTORE
  4082  2a5c a6fb                       LDX $FB
  4083  2a5e e09d                       CPX #<RCV_BUF_END
  4084  2a60 9008                       BCC WRF_STORE
  4085                          WRF_NOSTORE
  4086  2a62 a201                       LDX #1
  4087  2a64 8ead5a                     STX RCV_TOOBIG
  4088  2a67 4c742a                     JMP WRF_DEC
  4089                          WRF_STORE
  4090  2a6a a000                       LDY #0
  4091  2a6c 91fb                       STA ($FB),Y
  4092  2a6e e6fb                       INC $FB
  4093  2a70 d002                       BNE WRF_DEC
  4094  2a72 e6fc                       INC $FC
  4095                          WRF_DEC
  4096  2a74 ada75a                     LDA WRF_CTR_LO
  4097  2a77 d003                       BNE WRF_DHI
  4098  2a79 cea85a                     DEC WRF_CTR_HI
  4099  2a7c cea75a             WRF_DHI DEC WRF_CTR_LO
  4100  2a7f ada75a                     LDA WRF_CTR_LO
  4101  2a82 0da85a                     ORA WRF_CTR_HI
  4102  2a85 d0c8                       BNE WRF_RLOP
  4103                          WRF_RDONE
  4104  2a87 a000                       LDY #0
  4105  2a89 a900                       LDA #0
  4106  2a8b 91fb                       STA ($FB),Y             ; null-terminate
  4107  2a8d 18                         CLC
  4108  2a8e 60                         RTS
  4109                          WRF_SKIP                        ; non-text frame: drain until timeout
  4110  2a8f 207025             WRF_DRN JSR RING_GET_TO
  4111  2a92 90fb                       BCC WRF_DRN
  4112  2a94 38                         SEC
  4113  2a95 60                         RTS
  4114  2a96 38                 WRF_ERR SEC
  4115  2a97 60                         RTS
  4116                          
  4117                          ; ----------------------------------------------------------------
  4118                          ; WRF_PING - answer WebSocket ping (opcode 0x9) with pong (0xA)
  4119                          ;   The websockets lib sends a keepalive ping every ~20s with 4
  4120                          ;   random payload bytes; without a pong with the SAME payload
  4121                          ;   the relay drops after ping_timeout (keepalive ping timeout).
  4122                          ;   We read the payload from the ring and send it back masked
  4123                          ;   as a pong. Client always masks (RFC 6455) -> WS_MASK.
  4124                          ;   Return: carry set -> caller treats this as a non-text frame.
  4125                          ; ----------------------------------------------------------------
  4126                          WRF_PING
  4127  2a98 207025                     JSR RING_GET_TO         ; length byte (control frame <=125)
  4128  2a9b b048                       BCS WRF_PERR
  4129  2a9d 297f                       AND #$7F                ; mask-bit defensief weg
  4130  2a9f 8da95a                     STA PING_LEN
  4131                                  ; -- pong-header --
  4132  2aa2 a98a                       LDA #$8A                ; FIN + pong opcode (0x0A)
  4133  2aa4 20bb24                     JSR ACIA_SEND
  4134  2aa7 ada95a                     LDA PING_LEN
  4135  2aaa 0980                       ORA #$80                ; mask bit (client always masks)
  4136  2aac 20bb24                     JSR ACIA_SEND
  4137  2aaf a937                       LDA #$37                ; masking key byte 0
  4138  2ab1 20bb24                     JSR ACIA_SEND
  4139  2ab4 a9fa                       LDA #$FA                ; masking key byte 1
  4140  2ab6 20bb24                     JSR ACIA_SEND
  4141  2ab9 a921                       LDA #$21                ; masking key byte 2
  4142  2abb 20bb24                     JSR ACIA_SEND
  4143  2abe a93d                       LDA #$3D                ; masking key byte 3
  4144  2ac0 20bb24                     JSR ACIA_SEND
  4145                                  ; -- payload: read from ring, mask with WS_MASK[Y&3], send --
  4146  2ac3 a000                       LDY #0
  4147  2ac5 cca95a             WRP_LP  CPY PING_LEN
  4148  2ac8 f019                       BEQ WRP_DN
  4149  2aca 207025                     JSR RING_GET_TO         ; payload byte (leaves Y intact)
  4150  2acd b016                       BCS WRF_PERR
  4151  2acf 8daa5a                     STA PING_TMP
  4152  2ad2 98                         TYA
  4153  2ad3 2903                       AND #$03
  4154  2ad5 aa                         TAX
  4155  2ad6 bd7926                     LDA WS_MASK,X           ; mask byte for this position
  4156  2ad9 4daa5a                     EOR PING_TMP
  4157  2adc 20bb24                     JSR ACIA_SEND           ; preserves A/X/Y
  4158  2adf c8                         INY
  4159  2ae0 4cc52a                     JMP WRP_LP
  4160  2ae3 38                 WRP_DN  SEC                     ; no text frame -> caller shows nothing
  4161  2ae4 60                         RTS
  4162  2ae5 38                 WRF_PERR SEC
  4163  2ae6 60                         RTS
  4164                          WRF_OVERSIZE
  4165                                  ; frame too big to drain safely -> reset connection
  4166  2ae7 a90d                       LDA #$0D
  4167  2ae9 20ba0c                     JSR PRINT_CHR
  4168  2aec a91c                       LDA #$1C            ; red
  4169  2aee 20ba0c                     JSR PRINT_CHR
  4170  2af1 a974                       LDA #<STR_TOOBIGRC
  4171  2af3 85fb                       STA $FB
  4172  2af5 a941                       LDA #>STR_TOOBIGRC
  4173  2af7 85fc                       STA $FC
  4174  2af9 20cf0c                     JSR PRINT_STR_FB
  4175  2afc a90d                       LDA #$0D
  4176  2afe 20ba0c                     JSR PRINT_CHR
  4177                                  ; fall through to MC_RECONNECT
  4178                          MC_RECONNECT
  4179  2b01 a2ff                       LDX #$FF                ; reset stack (jump out of deep call stack)
  4180  2b03 9a                         TXS
  4181  2b04 a902                       LDA #2
  4182  2b06 8d20d0                     STA $D020               ; red border during reconnect
  4183  2b09 207d24                     JSR ACIA_INIT
  4184  2b0c 20af24                     JSR FPGA_SETTLE
  4185  2b0f 20a425                     JSR MODEM_DIAL
  4186  2b12 200d26                     JSR WS_HANDSHAKE
  4187                                  ; A3: do NOT clear screen on reconnect -> chat history stays
  4188  2b15 204e25                     JSR INSTALL_RX_NMI
  4189  2b18 20f1a2                     JSR WS_AUTH_DISPATCH
  4190  2b1b a905                       LDA #5
  4191  2b1d 8d20d0                     STA $D020
  4192  2b20 4cda0b                     JMP MC_CHAT_LOOP
  4193                          
  4194                          
  4195                          ; ================================================================
  4196                          ; PROC_RECV_MSG  -  process received JSON: parse, decrypt, show
  4197                          ; Works on RCV_BUF (filled by WS_RECV_FRAME).
  4198                          ; ================================================================
  4199                          PROC_RECV_MSG
  4200  2b23 adad5a                     LDA RCV_TOOBIG
  4201  2b26 f003                       BEQ PRM_NOTBIG
  4202  2b28 4c7b2c                     JMP PRM_TOOBIG
  4203                          PRM_NOTBIG
  4204  2b2b a99e                       LDA #<RCV_BUF
  4205  2b2d 85fb                       STA $FB
  4206  2b2f a95f                       LDA #>RCV_BUF
  4207  2b31 85fc                       STA $FC
  4208                                  ; 1) check type=message
  4209  2b33 a9cd                       LDA #<JSC_TYPE_MSG
  4210  2b35 8db15a                     STA JSC_PAT_LO
  4211  2b38 a96b                       LDA #>JSC_TYPE_MSG
  4212  2b3a 8db25a                     STA JSC_PAT_HI
  4213  2b3d 20182d                     JSR JSON_SCAN
  4214  2b40 9003                       BCC *+5
  4215  2b42 4cde2c                     JMP PRM_DONE
  4216                                  ; 2) read from-ID (16 chars)
  4217  2b45 a9e2                       LDA #<JSC_FROM
  4218  2b47 8db15a                     STA JSC_PAT_LO
  4219  2b4a a96b                       LDA #>JSC_FROM
  4220  2b4c 8db25a                     STA JSC_PAT_HI
  4221  2b4f 20182d                     JSR JSON_SCAN
  4222  2b52 9003                       BCC *+5
  4223  2b54 4cde2c                     JMP PRM_DONE
  4224  2b57 a200                       LDX #0
  4225  2b59 a000               PRM_FLP LDY #0
  4226  2b5b b1fb                       LDA ($FB),Y
  4227  2b5d f012                       BEQ PRM_FEND
  4228  2b5f c922                       CMP #$22            ; sluitende '"'
  4229  2b61 f00e                       BEQ PRM_FEND
  4230  2b63 9dc15a                     STA RCV_FROM,X
  4231  2b66 e8                         INX
  4232  2b67 e6fb                       INC $FB
  4233  2b69 d002                       BNE PRM_FNX
  4234  2b6b e6fc                       INC $FC
  4235  2b6d e010               PRM_FNX CPX #16
  4236  2b6f d0e8                       BNE PRM_FLP
  4237                          PRM_FEND
  4238  2b71 a900                       LDA #0
  4239  2b73 9dc15a                     STA RCV_FROM,X
  4240                                  ; 3) Parse IV-array (12 bytes)
  4241  2b76 a9eb                       LDA #<JSC_IV
  4242  2b78 8db15a                     STA JSC_PAT_LO
  4243  2b7b a96b                       LDA #>JSC_IV
  4244  2b7d 8db25a                     STA JSC_PAT_HI
  4245  2b80 20182d                     JSR JSON_SCAN
  4246  2b83 9003                       BCC *+5
  4247  2b85 4cde2c                     JMP PRM_DONE
  4248  2b88 a9d2                       LDA #<RCV_IV
  4249  2b8a 85fd                       STA $FD
  4250  2b8c a95a                       LDA #>RCV_IV
  4251  2b8e 85fe                       STA $FE
  4252  2b90 a90c                       LDA #12
  4253  2b92 8db85a                     STA PRM_CNT
  4254  2b95 a900                       LDA #0
  4255  2b97 8dbd5a                     STA RCV_CT_LEN
  4256  2b9a 8dbe5a                     STA RCV_CT_LEN+1
  4257  2b9d 20c92d                     JSR JSON_PARSE_ARR
  4258  2ba0 9003                       BCC *+5
  4259  2ba2 4cde2c                     JMP PRM_DONE
  4260                                  ; 4) parse data array (CT + tag, variable length)
  4261  2ba5 a9f2                       LDA #<JSC_DATA
  4262  2ba7 8db15a                     STA JSC_PAT_LO
  4263  2baa a96b                       LDA #>JSC_DATA
  4264  2bac 8db25a                     STA JSC_PAT_HI
  4265  2baf 20182d                     JSR JSON_SCAN
  4266  2bb2 9003                       BCC *+5
  4267  2bb4 4cde2c                     JMP PRM_DONE
  4268  2bb7 a9de                       LDA #<RCV_CT
  4269  2bb9 85fd                       STA $FD
  4270  2bbb a95a                       LDA #>RCV_CT
  4271  2bbd 85fe                       STA $FE
  4272  2bbf a900                       LDA #0
  4273  2bc1 8db85a                     STA PRM_CNT         ; 0 = variable length
  4274  2bc4 8dbd5a                     STA RCV_CT_LEN
  4275  2bc7 8dbe5a                     STA RCV_CT_LEN+1
  4276  2bca 8dae5a                     STA RCV_TOOLONG
  4277  2bcd 20c92d                     JSR JSON_PARSE_ARR
  4278  2bd0 9003                       BCC *+5
  4279  2bd2 4cde2c                     JMP PRM_DONE
  4280  2bd5 adae5a                     LDA RCV_TOOLONG
  4281  2bd8 f003                       BEQ PRM_NTL
  4282  2bda 4c7e2c                     JMP PRM_TOOLONG
  4283                          PRM_NTL
  4284  2bdd adbe5a                     LDA RCV_CT_LEN+1        ; CT_LEN >= 17 ? (16-bit)
  4285  2be0 d00a                       BNE PRM_LOK
  4286  2be2 adbd5a                     LDA RCV_CT_LEN+0
  4287  2be5 c911                       CMP #17
  4288  2be7 b003                       BCS PRM_LOK
  4289  2be9 4cde2c                     JMP PRM_DONE        ; too short
  4290                          PRM_LOK
  4291  2bec adbd5a                     LDA RCV_CT_LEN+0        ; PT_LEN(16) = CT_LEN(16) - 16
  4292  2bef 38                         SEC
  4293  2bf0 e910                       SBC #16
  4294  2bf2 8dbf5a                     STA RCV_PT_LEN+0
  4295  2bf5 adbe5a                     LDA RCV_CT_LEN+1
  4296  2bf8 e900                       SBC #0
  4297  2bfa 8dc05a                     STA RCV_PT_LEN+1
  4298                                  ; 5) load IV and key, decrypt
  4299  2bfd a20b                       LDX #11
  4300  2bff bdd25a             PRM_IVL LDA RCV_IV,X
  4301  2c02 9d2252                     STA AES_NONCE,X
  4302  2c05 ca                         DEX
  4303  2c06 10f7                       BPL PRM_IVL
  4304  2c08 20b4a4                     JSR RCV_DECRYPT_DISPATCH  ; 128:AES-128/KEY_SELF  256:AGD256/HKDF_OKM -> GCM_CTBUF
  4305  2c0b 9003                       BCC *+5                 ; tag valid -> continue
  4306  2c0d 4ca52c                     JMP PRM_BADTAG          ; tag invalid -> reject
  4307                                  ; 6) find 'text' in decrypted inner JSON (GCM_CTBUF)
  4308  2c10 a901                       LDA #<GCM_CTBUF
  4309  2c12 85fb                       STA $FB
  4310  2c14 a953                       LDA #>GCM_CTBUF
  4311  2c16 85fc                       STA $FC
  4312  2c18 a9fb                       LDA #<JSC_TEXT
  4313  2c1a 8db15a                     STA JSC_PAT_LO
  4314  2c1d a96b                       LDA #>JSC_TEXT
  4315  2c1f 8db25a                     STA JSC_PAT_HI
  4316  2c22 20182d                     JSR JSON_SCAN
  4317  2c25 9003                       BCC *+5
  4318  2c27 4cde2c                     JMP PRM_DONE
  4319  2c2a a95e                       LDA #<RCV_TEXT
  4320  2c2c 85fd                       STA $FD
  4321  2c2e a95d                       LDA #>RCV_TEXT
  4322  2c30 85fe                       STA $FE
  4323  2c32 a900                       LDA #0
  4324  2c34 8daf5a                     STA PRM_TCNT+0
  4325  2c37 8db05a                     STA PRM_TCNT+1
  4326  2c3a a000               PRM_TLP LDY #0
  4327  2c3c b1fb                       LDA ($FB),Y
  4328  2c3e f02a                       BEQ PRM_TEND
  4329  2c40 c922                       CMP #$22
  4330  2c42 f026                       BEQ PRM_TEND
  4331  2c44 91fd                       STA ($FD),Y
  4332  2c46 e6fb                       INC $FB
  4333  2c48 d002                       BNE PRM_TS1
  4334  2c4a e6fc                       INC $FC
  4335  2c4c e6fd               PRM_TS1 INC $FD
  4336  2c4e d002                       BNE PRM_TS2
  4337  2c50 e6fe                       INC $FE
  4338  2c52 eeaf5a             PRM_TS2 INC PRM_TCNT+0
  4339  2c55 d003                       BNE PRM_TCK
  4340  2c57 eeb05a                     INC PRM_TCNT+1
  4341  2c5a adb05a             PRM_TCK LDA PRM_TCNT+1
  4342  2c5d c902                       CMP #>560
  4343  2c5f 90d9                       BCC PRM_TLP
  4344  2c61 d007                       BNE PRM_TEND
  4345  2c63 adaf5a                     LDA PRM_TCNT+0
  4346  2c66 c930                       CMP #<560
  4347  2c68 90d0                       BCC PRM_TLP
  4348                          PRM_TEND
  4349  2c6a a000                       LDY #0
  4350  2c6c a900                       LDA #0
  4351  2c6e 91fd                       STA ($FD),Y
  4352                                  ; 7) show on screen
  4353  2c70 a901                       LDA #1
  4354  2c72 8da26a                     STA MSG_SHOWN
  4355  2c75 20a52e                     JSR SHOW_RECV_MSG
  4356  2c78 4cde2c                     JMP PRM_DONE
  4357                          PRM_TOOBIG
  4358                                  ; B-fix: backup/oversize frame already drained -> silently ignore
  4359  2c7b 4cde2c                     JMP PRM_DONE
  4360                          PRM_TOOLONG
  4361                                  ; data array > RCV_CT: message too long for the C64
  4362  2c7e a90d                       LDA #$0D
  4363  2c80 20ba0c                     JSR PRINT_CHR
  4364  2c83 a91c                       LDA #$1C            ; red
  4365  2c85 20ba0c                     JSR PRINT_CHR
  4366  2c88 a94f                       LDA #<STR_TOOLONG
  4367  2c8a 85fb                       STA $FB
  4368  2c8c a941                       LDA #>STR_TOOLONG
  4369  2c8e 85fc                       STA $FC
  4370  2c90 20cf0c                     JSR PRINT_STR_FB
  4371  2c93 a90d                       LDA #$0D
  4372  2c95 20ba0c                     JSR PRINT_CHR
  4373  2c98 a905                       LDA #$05            ; wit
  4374  2c9a 20ba0c                     JSR PRINT_CHR
  4375  2c9d a901                       LDA #1
  4376  2c9f 8da26a                     STA MSG_SHOWN
  4377  2ca2 4cde2c                     JMP PRM_DONE
  4378                          PRM_BADTAG
  4379                                  ; tag verification failed: red warning, message rejected
  4380  2ca5 a90d                       LDA #$0D
  4381  2ca7 20ba0c                     JSR PRINT_CHR
  4382  2caa a91c                       LDA #$1C            ; red
  4383  2cac 20ba0c                     JSR PRINT_CHR
  4384  2caf a9f9                       LDA #<STR_BADTAG
  4385  2cb1 85fb                       STA $FB
  4386  2cb3 a940                       LDA #>STR_BADTAG
  4387  2cb5 85fc                       STA $FC
  4388  2cb7 20cf0c                     JSR PRINT_STR_FB
  4389  2cba ada06a                     LDA RING_OVF        ; ring overflow during this frame?
  4390  2cbd f010                       BEQ PRM_BT_NOVF
  4391  2cbf a90d                       LDA #$0D
  4392  2cc1 20ba0c                     JSR PRINT_CHR
  4393  2cc4 a91d                       LDA #<STR_RXOVF
  4394  2cc6 85fb                       STA $FB
  4395  2cc8 a941                       LDA #>STR_RXOVF
  4396  2cca 85fc                       STA $FC
  4397  2ccc 20cf0c                     JSR PRINT_STR_FB
  4398                          PRM_BT_NOVF
  4399  2ccf a90d                       LDA #$0D
  4400  2cd1 20ba0c                     JSR PRINT_CHR
  4401  2cd4 a905                       LDA #$05            ; wit
  4402  2cd6 20ba0c                     JSR PRINT_CHR
  4403  2cd9 a901                       LDA #1
  4404  2cdb 8da26a                     STA MSG_SHOWN       ; redraw trigger (warning is on screen)
  4405                          PRM_DONE
  4406  2cde 60                         RTS
  4407                          
  4408                          ; ================================================================
  4409                          ; REDRAW_INPUT - redraw "NAME> " prompt + already-typed chars.
  4410                          ; In : X = number of typed chars (INP_BUF[0..X-1]). Preserves X.
  4411                          ; Called after showing an incoming message, so the
  4412                          ; in-progress input line reappears neatly below the message.
  4413                          ; ================================================================
  4414                          REDRAW_INPUT
  4415  2cdf 8ea36a                     STX RDI_CNT
  4416  2ce2 a91e                       LDA #$1E            ; green
  4417  2ce4 20ba0c                     JSR PRINT_CHR
  4418  2ce7 a200                       LDX #0
  4419  2ce9 bd9541             RDI_NM  LDA KDFIN_NAME,X
  4420  2cec f006                       BEQ RDI_NME
  4421  2cee 20ba0c                     JSR PRINT_CHR
  4422  2cf1 e8                         INX
  4423  2cf2 d0f5                       BNE RDI_NM
  4424                          RDI_NME
  4425  2cf4 a9ca                       LDA #<STR_PFX
  4426  2cf6 85fb                       STA $FB
  4427  2cf8 a942                       LDA #>STR_PFX
  4428  2cfa 85fc                       STA $FC
  4429  2cfc 20cf0c                     JSR PRINT_STR_FB
  4430  2cff a905                       LDA #$05            ; wit
  4431  2d01 20ba0c                     JSR PRINT_CHR
  4432  2d04 a200                       LDX #0
  4433  2d06 eca36a             RDI_TL  CPX RDI_CNT
  4434  2d09 f009                       BEQ RDI_DN
  4435  2d0b bdcd42                     LDA INP_BUF,X
  4436  2d0e 20ba0c                     JSR PRINT_CHR
  4437  2d11 e8                         INX
  4438  2d12 d0f2                       BNE RDI_TL
  4439  2d14 aea36a             RDI_DN  LDX RDI_CNT         ; restore X = count
  4440  2d17 60                         RTS
  4441                          
  4442                          
  4443                          ; ================================================================
  4444                          ; JSON_SCAN  -  find null-terminated pattern in buffer
  4445                          ; In:  $FB/$FC = current scan position in buffer
  4446                          ;      JSC_PAT_LO/HI = pattern address
  4447                          ; Out: $FB/$FC = position AFTER matched pattern, carry clear
  4448                          ;      carry set = not found (buffer end reached)
  4449                          ; Clobbers: A, Y. Preserves X.
  4450                          ; ================================================================
  4451                          JSON_SCAN
  4452  2d18 a000               JSC_OUT LDY #0
  4453  2d1a b1fb                       LDA ($FB),Y
  4454  2d1c f062                       BEQ JSC_FAIL        ; end of buffer
  4455                                  ; save current position for the comparison attempt
  4456  2d1e a5fb                       LDA $FB
  4457  2d20 8db35a                     STA JSC_MPOS_LO
  4458  2d23 a5fc                       LDA $FC
  4459  2d25 8db45a                     STA JSC_MPOS_HI
  4460  2d28 adb15a                     LDA JSC_PAT_LO
  4461  2d2b 8db55a                     STA JSC_CPOS_LO
  4462  2d2e adb25a                     LDA JSC_PAT_HI
  4463  2d31 8db65a                     STA JSC_CPOS_HI
  4464                          JSC_INN ; read pattern byte via ($FD/$FE = JSC_CPOS)
  4465  2d34 adb55a                     LDA JSC_CPOS_LO
  4466  2d37 85fd                       STA $FD
  4467  2d39 adb65a                     LDA JSC_CPOS_HI
  4468  2d3c 85fe                       STA $FE
  4469  2d3e a000                       LDY #0
  4470  2d40 b1fd                       LDA ($FD),Y
  4471  2d42 f027                       BEQ JSC_HIT         ; pattern fully matched
  4472  2d44 8db75a                     STA JSC_PB          ; save pattern byte
  4473                                  ; read buffer byte via ($FD/$FE = JSC_MPOS)
  4474  2d47 adb35a                     LDA JSC_MPOS_LO
  4475  2d4a 85fd                       STA $FD
  4476  2d4c adb45a                     LDA JSC_MPOS_HI
  4477  2d4f 85fe                       STA $FE
  4478  2d51 b1fd                       LDA ($FD),Y         ; Y=0
  4479  2d53 cdb75a                     CMP JSC_PB
  4480  2d56 d01f                       BNE JSC_NEXT        ; no match, try next position
  4481                                  ; match: both pointers advance one step
  4482  2d58 eeb35a                     INC JSC_MPOS_LO
  4483  2d5b d003                       BNE JSC_IPA
  4484  2d5d eeb45a                     INC JSC_MPOS_HI
  4485  2d60 eeb55a             JSC_IPA INC JSC_CPOS_LO
  4486  2d63 d0cf                       BNE JSC_INN
  4487  2d65 eeb65a                     INC JSC_CPOS_HI
  4488  2d68 4c342d                     JMP JSC_INN
  4489  2d6b adb35a             JSC_HIT LDA JSC_MPOS_LO
  4490  2d6e 85fb                       STA $FB
  4491  2d70 adb45a                     LDA JSC_MPOS_HI
  4492  2d73 85fc                       STA $FC
  4493  2d75 18                         CLC
  4494  2d76 60                         RTS
  4495                          JSC_NEXT
  4496  2d77 e6fb                       INC $FB
  4497  2d79 d09d                       BNE JSC_OUT
  4498  2d7b e6fc                       INC $FC
  4499  2d7d 4c182d                     JMP JSC_OUT
  4500                          JSC_FAIL
  4501  2d80 38                         SEC
  4502  2d81 60                         RTS
  4503                          
  4504                          ; ================================================================
  4505                          ; JSON_PARSE_INT  -  parse decimaal getal op ($FB/$FC)
  4506                          ; Out: A = value 0..255, $FB/$FC past the digits
  4507                          ;      carry set = no digit found
  4508                          ; ================================================================
  4509                          JSON_PARSE_INT
  4510  2d82 a000                       LDY #0
  4511  2d84 b1fb                       LDA ($FB),Y
  4512  2d86 c930                       CMP #$30            ; < '0'?
  4513  2d88 903d                       BCC JPI_ERR
  4514  2d8a c93a                       CMP #$3A            ; >= ':'?
  4515  2d8c b039                       BCS JPI_ERR
  4516  2d8e a900                       LDA #0
  4517  2d90 8dba5a                     STA JPI_VAL
  4518  2d93 a000               JPI_LP  LDY #0
  4519  2d95 b1fb                       LDA ($FB),Y
  4520  2d97 c930                       CMP #$30
  4521  2d99 9027                       BCC JPI_DONE
  4522  2d9b c93a                       CMP #$3A
  4523  2d9d b023                       BCS JPI_DONE
  4524  2d9f 38                         SEC
  4525  2da0 e930                       SBC #$30
  4526  2da2 8dbc5a                     STA JPI_DIG
  4527  2da5 adba5a                     LDA JPI_VAL
  4528  2da8 0a                         ASL                 ; val*2
  4529  2da9 8dbb5a                     STA JPI_TMP
  4530  2dac 0a                         ASL                 ; val*4
  4531  2dad 0a                         ASL                 ; val*8
  4532  2dae 18                         CLC
  4533  2daf 6dbb5a                     ADC JPI_TMP         ; val*10
  4534  2db2 18                         CLC
  4535  2db3 6dbc5a                     ADC JPI_DIG
  4536  2db6 8dba5a                     STA JPI_VAL
  4537  2db9 e6fb                       INC $FB
  4538  2dbb d0d6                       BNE JPI_LP
  4539  2dbd e6fc                       INC $FC
  4540  2dbf 4c932d                     JMP JPI_LP
  4541                          JPI_DONE
  4542  2dc2 adba5a                     LDA JPI_VAL
  4543  2dc5 18                         CLC
  4544  2dc6 60                         RTS
  4545  2dc7 38                 JPI_ERR SEC
  4546  2dc8 60                         RTS
  4547                          
  4548                          ; ================================================================
  4549                          ; JSON_PARSE_ARR  -  parse komma-gescheiden decimale byte-array
  4550                          ; $FB/$FC: scanpositie NA '['
  4551                          ; $FD/$FE: write target (set by caller)
  4552                          ; PRM_CNT: expected count (0 = variable, counts via RCV_CT_LEN)
  4553                          ; RCV_CT_LEN: MUST be 0 on entry; is incremented per byte.
  4554                          ; ================================================================
  4555                          JSON_PARSE_ARR
  4556  2dc9 adb85a                     LDA PRM_CNT
  4557  2dcc 8db95a                     STA JPA_REM
  4558  2dcf a000               JPA_LP  LDY #0
  4559  2dd1 b1fb                       LDA ($FB),Y
  4560  2dd3 f053                       BEQ JPA_ERR
  4561  2dd5 c95d                       CMP #$5D            ; ']' = end
  4562  2dd7 f047                       BEQ JPA_ENDB
  4563  2dd9 c92c                       CMP #$2C            ; skip ','
  4564  2ddb d009                       BNE JPA_NUM
  4565  2ddd e6fb                       INC $FB
  4566  2ddf d0ee                       BNE JPA_LP
  4567  2de1 e6fc                       INC $FC
  4568  2de3 4ccf2d                     JMP JPA_LP
  4569  2de6 20822d             JPA_NUM JSR JSON_PARSE_INT
  4570  2de9 b03d                       BCS JPA_ERR
  4571  2deb a000                       LDY #0
  4572  2ded 91fd                       STA ($FD),Y
  4573  2def e6fd                       INC $FD
  4574  2df1 d002                       BNE JPA_INC
  4575  2df3 e6fe                       INC $FE
  4576  2df5 eebd5a             JPA_INC INC RCV_CT_LEN+0
  4577  2df8 d003                       BNE JPA_RC
  4578  2dfa eebe5a                     INC RCV_CT_LEN+1
  4579  2dfd adb95a             JPA_RC  LDA JPA_REM
  4580  2e00 f007                       BEQ JPA_UNL         ; 0 = onbeperkt -> grens-check
  4581  2e02 ceb95a                     DEC JPA_REM
  4582  2e05 d0c8                       BNE JPA_LP
  4583  2e07 18                         CLC
  4584  2e08 60                         RTS
  4585  2e09 adbe5a             JPA_UNL LDA RCV_CT_LEN+1     ; RCV_CT_LEN >= 640 ? (RCV_CT capaciteit)
  4586  2e0c c902                       CMP #>640
  4587  2e0e 90bf                       BCC JPA_LP
  4588  2e10 d007                       BNE JPA_TL
  4589  2e12 adbd5a                     LDA RCV_CT_LEN+0
  4590  2e15 c980                       CMP #<640
  4591  2e17 90b6                       BCC JPA_LP
  4592  2e19 a901               JPA_TL  LDA #1
  4593  2e1b 8dae5a                     STA RCV_TOOLONG
  4594  2e1e 18                         CLC
  4595  2e1f 60                         RTS
  4596                          JPA_ENDB
  4597  2e20 e6fb                       INC $FB
  4598  2e22 d002                       BNE JPA_OK
  4599  2e24 e6fc                       INC $FC
  4600  2e26 18                 JPA_OK  CLC
  4601  2e27 60                         RTS
  4602  2e28 38                 JPA_ERR SEC
  4603  2e29 60                         RTS
  4604                          
  4605                          ; ================================================================
  4606                          ; AES_GCM_DECRYPT  -  decrypt received message (CTR mode)
  4607                          ; Requires: AES_NONCE = received IV (12 bytes)
  4608                          ;          GCM_IN_KEY, GCM_PT_PTR/LEN set
  4609                          ; Output: GCM_CTBUF = plaintext
  4610                          ; Tag verification skipped (v1).
  4611                          ; ================================================================
  4612                          AES_GCM_DECRYPT
  4613  2e2a a20f                       LDX #15
  4614  2e2c bded52             AGD_K   LDA GCM_IN_KEY,X
  4615  2e2f 9dcf4a                     STA AES_KEY,X
  4616  2e32 ca                         DEX
  4617  2e33 10f7                       BPL AGD_K
  4618  2e35 201446                     JSR AES_SETKEY
  4619                                  ; AES_NONCE already set to received IV
  4620  2e38 203233                     JSR GCM_INIT
  4621  2e3b adfd52                     LDA GCM_PT_PTR+0
  4622  2e3e 8d2e52                     STA AES_CTR_IN+0
  4623  2e41 adfe52                     LDA GCM_PT_PTR+1
  4624  2e44 8d2f52                     STA AES_CTR_IN+1
  4625  2e47 a901                       LDA #<GCM_CTBUF
  4626  2e49 8d3052                     STA AES_CTR_OUT+0
  4627  2e4c a953                       LDA #>GCM_CTBUF
  4628  2e4e 8d3152                     STA AES_CTR_OUT+1
  4629  2e51 adff52                     LDA GCM_PT_LEN+0
  4630  2e54 8d3252                     STA AES_CTR_LEN+0
  4631  2e57 ad0053                     LDA GCM_PT_LEN+1
  4632  2e5a 8d3352                     STA AES_CTR_LEN+1
  4633  2e5d 20f449                     JSR AES_CTR_CRYPT
  4634                                  ; -- optional GCM tag verification (one-shot via GCM_DO_VERIFY) --
  4635  2e60 ad8152                     LDA GCM_DO_VERIFY
  4636  2e63 d002                       BNE AGD_VRF
  4637  2e65 18                         CLC                     ; verify off -> always 'valid'
  4638  2e66 60                         RTS
  4639                          AGD_VRF
  4640  2e67 a900                       LDA #0
  4641  2e69 8d8152                     STA GCM_DO_VERIFY       ; one-shot: off again immediately
  4642  2e6c adfd52                     LDA GCM_PT_PTR+0
  4643  2e6f 8d3d52                     STA GCM_CT_PTR+0
  4644  2e72 adfe52                     LDA GCM_PT_PTR+1
  4645  2e75 8d3e52                     STA GCM_CT_PTR+1
  4646  2e78 adff52                     LDA GCM_PT_LEN+0
  4647  2e7b 8d3f52                     STA GCM_CT_LEN+0
  4648  2e7e ad0053                     LDA GCM_PT_LEN+1
  4649  2e81 8d4052                     STA GCM_CT_LEN+1
  4650  2e84 207433                     JSR GCM_AUTH            ; expected tag -> GCM_TAG (H/EK0 from GCM_INIT)
  4651                                  ; received tag = 16 bytes at (GCM_PT_PTR + GCM_PT_LEN)
  4652  2e87 18                         CLC
  4653  2e88 adfd52                     LDA GCM_PT_PTR+0
  4654  2e8b 6dff52                     ADC GCM_PT_LEN+0
  4655  2e8e 85fd                       STA $FD
  4656  2e90 adfe52                     LDA GCM_PT_PTR+1
  4657  2e93 6d0053                     ADC GCM_PT_LEN+1
  4658  2e96 85fe                       STA $FE
  4659  2e98 a00f                       LDY #15
  4660  2e9a b1fd               AGD_CT  LDA ($FD),Y
  4661  2e9c 997152                     STA GCM_RECV_TAG,Y
  4662  2e9f 88                         DEY
  4663  2ea0 10f8                       BPL AGD_CT
  4664  2ea2 4c8634                     JMP GCM_VERIFY          ; C=0 valid / C=1 invalid -> to caller
  4665                          
  4666                          ; ================================================================
  4667                          ; SHOW_RECV_MSG  -  show received message in cyan on screen
  4668                          ; RCV_FROM: sender ID, RCV_TEXT: decrypted text
  4669                          ; ================================================================
  4670                          SHOW_RECV_MSG
  4671  2ea5 a90d                       LDA #$0D
  4672  2ea7 20ba0c                     JSR PRINT_CHR
  4673  2eaa a99f                       LDA #$9F            ; cyan
  4674  2eac 20ba0c                     JSR PRINT_CHR
  4675  2eaf a200                       LDX #0
  4676  2eb1 bdc15a             SRM_LP  LDA RCV_FROM,X
  4677  2eb4 f008                       BEQ SRM_E
  4678  2eb6 20ba0c                     JSR PRINT_CHR
  4679  2eb9 e8                         INX
  4680  2eba e008                       CPX #8
  4681  2ebc d0f3                       BNE SRM_LP
  4682  2ebe a93e               SRM_E   LDA #$3E            ; '>'
  4683  2ec0 20ba0c                     JSR PRINT_CHR
  4684  2ec3 a920                       LDA #$20
  4685  2ec5 20ba0c                     JSR PRINT_CHR
  4686  2ec8 a95e                       LDA #<RCV_TEXT
  4687  2eca 85fb                       STA $FB
  4688  2ecc a95d                       LDA #>RCV_TEXT
  4689  2ece 85fc                       STA $FC
  4690  2ed0 20dc0c                     JSR PRINT_STR16
  4691  2ed3 a90d                       LDA #$0D
  4692  2ed5 20ba0c                     JSR PRINT_CHR
  4693  2ed8 a905                       LDA #$05            ; back to white
  4694  2eda 20ba0c                     JSR PRINT_CHR
  4695  2edd 60                         RTS
  4696                          
  4697                          ; ================================================================
  4698                          INNER_EMIT
  4699  2ede 48                         PHA
  4700  2edf ada46a                     LDA MIJ_LO
  4701  2ee2 85fd                       STA $FD
  4702  2ee4 ada56a                     LDA MIJ_HI
  4703  2ee7 85fe                       STA $FE
  4704  2ee9 68                         PLA
  4705  2eea a000                       LDY #0
  4706  2eec 91fd                       STA ($FD),Y
  4707  2eee eea46a                     INC MIJ_LO
  4708  2ef1 d003                       BNE INEM_D
  4709  2ef3 eea56a                     INC MIJ_HI
  4710  2ef6 eea66a             INEM_D  INC MSG_INNER_LEN
  4711  2ef9 60                         RTS
  4712                          
  4713                          ; ================================================================
  4714                          ; INNER_EMIT_STR  -  write null-terminated string via $FB/$FC
  4715                          ; Increments $FB/$FC per char (safe if INNER_EMIT clobbers Y).
  4716                          ; ================================================================
  4717                          INNER_EMIT_STR
  4718  2efa a000               INES_LP LDY #0
  4719  2efc b1fb                       LDA ($FB),Y
  4720  2efe f00c                       BEQ INES_DN
  4721  2f00 20de2e                     JSR INNER_EMIT
  4722  2f03 e6fb                       INC $FB
  4723  2f05 d0f3                       BNE INES_LP
  4724  2f07 e6fc                       INC $FC
  4725  2f09 4cfa2e                     JMP INES_LP
  4726  2f0c 60                 INES_DN RTS
  4727                          
  4728                          ; ================================================================
  4729                          ; INNER_HEX  -  emit byte A as 2 hex-ASCII chars to INNER_BUF
  4730                          ; Uses existing NIBBLE_TO_SCR. Preserves A. Clobbers no X.
  4731                          ; ================================================================
  4732                          INNER_HEX
  4733  2f0d 48                         PHA
  4734  2f0e 4a                         LSR
  4735  2f0f 4a                         LSR
  4736  2f10 4a                         LSR
  4737  2f11 4a                         LSR
  4738  2f12 208f23                     JSR NIBBLE_TO_SCR
  4739  2f15 20de2e                     JSR INNER_EMIT
  4740  2f18 68                         PLA
  4741  2f19 290f                       AND #$0F
  4742  2f1b 208f23                     JSR NIBBLE_TO_SCR
  4743  2f1e 20de2e                     JSR INNER_EMIT
  4744  2f21 60                         RTS
  4745                          
  4746                          ; ================================================================
  4747                          ; BUILD_INNER_JSON
  4748                          ; Builds the plaintext for AES-GCM encryption:
  4749                          ;   {"id":"<C64_IDSTR>-<GCM_MSG_CTR as 4 hex>","text":"<INP_BUF>","ts":0}
  4750                          ; Voorbeeld: {"id":"oMiBr6h3K7BsgnwJ-0000","text":"test","ts":0}
  4751                          ;
  4752                          ; Na afloop: GCM_PT_PTR -> MSG_INNER_BUF, GCM_PT_LEN = MSG_INNER_LEN
  4753                          ; Clobbers: A, Y, $FB/$FC, $FD/$FE, MIJ_LO/HI, MSG_INNER_LEN
  4754                          ; ================================================================
  4755                          BUILD_INNER_JSON
  4756                                  ; reset write pointer and byte counter
  4757  2f22 a9a7                       LDA #<MSG_INNER_BUF
  4758  2f24 8da46a                     STA MIJ_LO
  4759  2f27 a96a                       LDA #>MSG_INNER_BUF
  4760  2f29 8da56a                     STA MIJ_HI
  4761  2f2c a900                       LDA #0
  4762  2f2e 8da66a                     STA MSG_INNER_LEN
  4763                          
  4764                                  ; {"id":"
  4765  2f31 a981                       LDA #<STR_INNER_IDHDR
  4766  2f33 85fb                       STA $FB
  4767  2f35 a96c                       LDA #>STR_INNER_IDHDR
  4768  2f37 85fc                       STA $FC
  4769  2f39 20fa2e                     JSR INNER_EMIT_STR
  4770                          
  4771                                  ; publicId: C64_IDSTR (16 ASCII chars, null-terminated)
  4772  2f3c a993                       LDA #<C64_IDSTR
  4773  2f3e 85fb                       STA $FB
  4774  2f40 a95a                       LDA #>C64_IDSTR
  4775  2f42 85fc                       STA $FC
  4776  2f44 20fa2e                     JSR INNER_EMIT_STR
  4777                          
  4778                                  ; hyphen '-'
  4779  2f47 a92d                       LDA #$2D
  4780  2f49 20de2e                     JSR INNER_EMIT
  4781                          
  4782                                  ; message-unique: GCM_MSG_CTR hi+lo as 4 hex chars
  4783                                  ; Gives unique IDs per message: 0000 .. FFFF
  4784  2f4c ad8255                     LDA GCM_MSG_CTR+1
  4785  2f4f 200d2f                     JSR INNER_HEX
  4786  2f52 ad8155                     LDA GCM_MSG_CTR+0
  4787  2f55 200d2f                     JSR INNER_HEX
  4788                          
  4789                                  ; ","text":"
  4790  2f58 a989                       LDA #<STR_INNER_TXTHDR
  4791  2f5a 85fb                       STA $FB
  4792  2f5c a96c                       LDA #>STR_INNER_TXTHDR
  4793  2f5e 85fc                       STA $FC
  4794  2f60 20fa2e                     JSR INNER_EMIT_STR
  4795                          
  4796                                  ; message text from INP_BUF (null-terminated)
  4797  2f63 a9cd                       LDA #<INP_BUF
  4798  2f65 85fb                       STA $FB
  4799  2f67 a942                       LDA #>INP_BUF
  4800  2f69 85fc                       STA $FC
  4801  2f6b 20fa2e                     JSR INNER_EMIT_STR
  4802                          
  4803                                  ; ","ts":0}
  4804  2f6e a994                       LDA #<STR_INNER_TS
  4805  2f70 85fb                       STA $FB
  4806  2f72 a96c                       LDA #>STR_INNER_TS
  4807  2f74 85fc                       STA $FC
  4808  2f76 20fa2e                     JSR INNER_EMIT_STR
  4809                          
  4810                                  ; set AES_GCM_ENCRYPT input to the built inner JSON
  4811  2f79 a9a7                       LDA #<MSG_INNER_BUF
  4812  2f7b 8dfd52                     STA GCM_PT_PTR+0
  4813  2f7e a96a                       LDA #>MSG_INNER_BUF
  4814  2f80 8dfe52                     STA GCM_PT_PTR+1
  4815  2f83 ada66a                     LDA MSG_INNER_LEN
  4816  2f86 8dff52                     STA GCM_PT_LEN+0
  4817  2f89 a900                       LDA #0
  4818  2f8b 8d0053                     STA GCM_PT_LEN+1
  4819  2f8e 60                         RTS
  4820                          
  4821                          ; ================================================================
  4822                          ; BUILD_GCM_BLOB  -  emitteer {"iv":[...],"data":[...CT...TAG...]}
  4823                          ; ================================================================
  4824                          ; Requires: AES_GCM_ENCRYPT called earlier
  4825                          ;          GCM_PT_LEN = ciphertext length (= plaintext length)
  4826                          ; Writes directly to current JOUT position (no JOUT_INIT call).
  4827                          ; ================================================================
  4828                          BUILD_GCM_BLOB
  4829                                  ; {"iv":[
  4830  2f8f a9b1                       LDA #<STR_IVHDR
  4831  2f91 85fb                       STA $FB
  4832  2f93 a96b                       LDA #>STR_IVHDR
  4833  2f95 85fc                       STA $FC
  4834  2f97 20f226                     JSR JOUT_EMIT_STR
  4835                          
  4836                                  ; 12 nonce bytes as comma-separated decimal numbers
  4837                                  ; Fix: BYTE_TO_DEC clobbers X (internal LDX #0 tens loop).
  4838                                  ; X after return = tens digit (0..9) -- never >= 12 or 16.
  4839                                  ; Solution: STX/LDX BGB_XTMP around each BYTE_TO_DEC call.
  4840  2f9a a200                       LDX #0
  4841  2f9c bd2252             BGB_IV  LDA AES_NONCE,X
  4842  2f9f 8ea65a                     STX BGB_XTMP        ; save loop counter before BYTE_TO_DEC
  4843  2fa2 200527                     JSR BYTE_TO_DEC
  4844  2fa5 aea65a                     LDX BGB_XTMP        ; restore loop counter after BYTE_TO_DEC
  4845  2fa8 e8                         INX
  4846  2fa9 e00c                       CPX #12
  4847  2fab f008                       BEQ BGB_IVD
  4848  2fad a92c                       LDA #$2C            ; ','
  4849  2faf 20d126                     JSR JOUT_EMIT
  4850  2fb2 4c9c2f                     JMP BGB_IV
  4851                          BGB_IVD
  4852                          
  4853                                  ; ],"data":[
  4854  2fb5 a9b9                       LDA #<STR_DATAHDR
  4855  2fb7 85fb                       STA $FB
  4856  2fb9 a96b                       LDA #>STR_DATAHDR
  4857  2fbb 85fc                       STA $FC
  4858  2fbd 20f226                     JSR JOUT_EMIT_STR
  4859                          
  4860                                  ; ciphertext-bytes (GCM_PT_LEN bytes)
  4861  2fc0 a200                       LDX #0
  4862  2fc2 bd0153             BGB_CT  LDA GCM_CTBUF,X
  4863  2fc5 8ea65a                     STX BGB_XTMP        ; save loop counter
  4864  2fc8 200527                     JSR BYTE_TO_DEC
  4865  2fcb aea65a                     LDX BGB_XTMP        ; restore loop counter
  4866  2fce e8                         INX
  4867  2fcf ecff52                     CPX GCM_PT_LEN
  4868  2fd2 f008                       BEQ BGB_CTD
  4869  2fd4 a92c                       LDA #$2C
  4870  2fd6 20d126                     JSR JOUT_EMIT
  4871  2fd9 4cc22f                     JMP BGB_CT
  4872                          BGB_CTD
  4873                          
  4874                                  ; comma before tag block
  4875  2fdc a92c                       LDA #$2C
  4876  2fde 20d126                     JSR JOUT_EMIT
  4877                          
  4878                                  ; 16 GHASH authentication tag bytes
  4879  2fe1 a200                       LDX #0
  4880  2fe3 bd6152             BGB_TG  LDA GCM_TAG,X
  4881  2fe6 8ea65a                     STX BGB_XTMP        ; save loop counter
  4882  2fe9 200527                     JSR BYTE_TO_DEC
  4883  2fec aea65a                     LDX BGB_XTMP        ; restore loop counter
  4884  2fef e8                         INX
  4885  2ff0 e010                       CPX #16
  4886  2ff2 f008                       BEQ BGB_TGD
  4887  2ff4 a92c                       LDA #$2C
  4888  2ff6 20d126                     JSR JOUT_EMIT
  4889  2ff9 4ce32f                     JMP BGB_TG
  4890                          BGB_TGD
  4891                          
  4892                                  ; ]}
  4893  2ffc a95d                       LDA #$5D            ; ']'
  4894  2ffe 20d126                     JSR JOUT_EMIT
  4895  3001 a97d                       LDA #$7D            ; '}'
  4896  3003 20d126                     JSR JOUT_EMIT
  4897  3006 60                         RTS
