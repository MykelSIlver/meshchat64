   523                          DBG_SHOW
   524  0d0f 20ba0c                     JSR PRINT_CHR           ; print label char (A = char from caller, e.g. 'N')
   525  0d12 a5fb                       LDA $FB             ; store only now - still intact after $FFD2
   526  0d14 8d1b42                     STA DBG_LO
   527  0d17 a5fc                       LDA $FC
