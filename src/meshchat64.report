  8182                          !macro mov32 .d, .s {
  8183                                  lda .s:sta .d : lda .s+1:sta .d+1 : lda .s+2:sta .d+2 : lda .s+3:sta .d+3
  8184                          }
  8185                          !macro zero32 .d {
  8186                                  lda #0:sta .d:sta .d+1:sta .d+2:sta .d+3
  8187                          }
  8188                          !macro add32 .d, .s {
  8189                                  clc : lda .d:adc .s:sta .d : lda .d+1:adc .s+1:sta .d+1 : lda .d+2:adc .s+2:sta .d+2 : lda .d+3:adc .s+3:sta .d+3
  8190                          }
  8191                          !macro sub32 .d, .s {
  8192                                  sec : lda .d:sbc .s:sta .d : lda .d+1:sbc .s+1:sta .d+1 : lda .d+2:sbc .s+2:sta .d+2 : lda .d+3:sbc .s+3:sta .d+3
  8193                          }
