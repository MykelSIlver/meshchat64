   531  0d21 a920                       LDA #$20
   532  0d23 20ba0c                     JSR PRINT_CHR           ; ' '
   533  0d26 a900                       LDA #$00
   534  0d28 8d1d42                     STA DBG_IDX
   535  0d2b ad1b42             DBG_LP  LDA DBG_LO
   536  0d2e 85fb                       STA $FB
   537  0d30 ad1c42                     LDA DBG_HI
   538  0d33 85fc                       STA $FC
   539  0d35 ac1d42                     LDY DBG_IDX
   540  0d38 b1fb                       LDA ($FB),Y
