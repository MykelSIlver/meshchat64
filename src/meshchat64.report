  7455                          ; ================================================================
  7456                          ; SHA_BLOCK  -  process 1 block of 128 bytes at (BP)
  7457                          ; ================================================================
  7458                          SHA_BLOCK
  7459                                  ; -- W[0..15] = big-endian words from block (reverse to LE) --
  7460  7a59 a900                       LDA #0
  7461  7a5b 8dae99                     STA SHA_J               ; word index 0..15
  7462  7a5e adae99             SB_LDW  LDA SHA_J
  7463  7a61 0a                         ASL
  7464  7a62 0a                         ASL
  7465  7a63 0a                         ASL                     ; J*8 = byte offset within block
  7466  7a64 8daf99                     STA SHA_OFF
  7467                                  ; dest = SHA5_W + J*8 ; we fill LE: W[J].byte(b) = block[off + (7-b)]
  7468  7a67 a200                       LDX #0                  ; b = 0..7
  7469  7a69 8a                 SB_BR   TXA                     ; b
  7470  7a6a 4907                       EOR #7                  ; 7-b
  7471  7a6c 18                         CLC
  7472  7a6d 6daf99                     ADC SHA_OFF
  7473  7a70 a8                         TAY                     ; index in block
  7474  7a71 b1f9                       LDA (BP),Y
  7475                                  ; dest index = J*8 + b
  7476  7a73 8eb099                     STX SHA_BTMP
  7477  7a76 adae99                     LDA SHA_J
  7478  7a79 0a                         ASL
  7479  7a7a 0a                         ASL
  7480  7a7b 0a                         ASL
  7481  7a7c 18                         CLC
  7482  7a7d 6db099                     ADC SHA_BTMP            ; J*8 + b
  7483  7a80 a8                         TAY
  7484  7a81 b1f9                       LDA (BP),Y              ; (wrong: should be source byte) -- see fix
  7485                                  ; --- correct approach below ---
  7486  7a83 4c867a                     JMP SB_BR_FIX
  7487                          SB_BR_FIX
  7488                                  ; (block above is replaced; correct version:)
  7489  7a86 a200                       LDX #0
  7490  7a88 8a                 SB_BR2  TXA
  7491  7a89 4907                       EOR #7
  7492  7a8b 18                         CLC
  7493  7a8c 6daf99                     ADC SHA_OFF
  7494  7a8f a8                         TAY
  7495  7a90 b1f9                       LDA (BP),Y              ; source byte = block[off + (7-b)]
  7496  7a92 acae99                     LDY SHA_J
  7497                                  ; store in W via pointer
  7498  7a95 8db199                     STA SHA_WBYTE
  7499                                  ; compute target address SHA5_W + J*8 + b in PA
  7500  7a98 adae99                     LDA SHA_J
  7501  7a9b 0a                         ASL
  7502  7a9c 0a                         ASL
  7503  7a9d 0a                         ASL
  7504  7a9e 18                         CLC
  7505  7a9f 6900                       ADC #<SHA5_W
  7506  7aa1 85fb                       STA PA
  7507  7aa3 a9c0                       LDA #>SHA5_W
  7508  7aa5 6900                       ADC #0
  7509  7aa7 85fc                       STA PA+1
  7510  7aa9 8a                         TXA
  7511  7aaa a8                         TAY                     ; Y = b
  7512  7aab adb199                     LDA SHA_WBYTE
  7513  7aae 91fb                       STA (PA),Y
  7514  7ab0 e8                         INX
  7515  7ab1 e008                       CPX #8
  7516  7ab3 d0d3                       BNE SB_BR2
  7517  7ab5 eeae99                     INC SHA_J
  7518  7ab8 adae99                     LDA SHA_J
  7519  7abb c910                       CMP #16
  7520  7abd d09f                       BNE SB_LDW
  7521                          
  7522                                  ; -- W[16..79] = SSIG1(W[i-2]) + W[i-7] + SSIG0(W[i-15]) + W[i-16] --
  7523  7abf a910                       LDA #16
  7524  7ac1 8dae99                     STA SHA_J
  7525                          SB_EXT  ; PB -> W[i-2]
  7526  7ac4 adae99                     LDA SHA_J
  7527  7ac7 38                         SEC
  7528  7ac8 e902                       SBC #2
  7529  7aca 207f7d                     JSR SET_PB_W
  7530  7acd 202e7a                     JSR SSIG1               ; SHA_ACC = ssig1(W[i-2])
  7531                                  ; T = SHA_ACC ; PA->SHA_T1 copy
  7532  7ad0 20737d                     JSR ACC_TO_T1
  7533                                  ; T1 += W[i-7]
  7534  7ad3 a9aa                       LDA #<SHA_T1
  7535  7ad5 85fb                       STA PA
  7536  7ad7 a992                       LDA #>SHA_T1
  7537  7ad9 85fc                       STA PA+1
  7538  7adb adae99                     LDA SHA_J
  7539  7ade 38                         SEC
  7540  7adf e907                       SBC #7
  7541  7ae1 207f7d                     JSR SET_PB_W
  7542  7ae4 20a978                     JSR C64ADD
  7543                                  ; SHA_ACC = ssig0(W[i-15])
  7544  7ae7 adae99                     LDA SHA_J
  7545  7aea 38                         SEC
  7546  7aeb e90f                       SBC #15
  7547  7aed 207f7d                     JSR SET_PB_W
  7548  7af0 20037a                     JSR SSIG0
  7549                                  ; T1 += SHA_ACC
  7550  7af3 a9d2                       LDA #<SHA_ACC
  7551  7af5 85fd                       STA PB
  7552  7af7 a992                       LDA #>SHA_ACC
  7553  7af9 85fe                       STA PB+1
  7554  7afb 20a978                     JSR C64ADD
  7555                                  ; T1 += W[i-16]
  7556  7afe adae99                     LDA SHA_J
  7557  7b01 38                         SEC
  7558  7b02 e910                       SBC #16
  7559  7b04 207f7d                     JSR SET_PB_W
  7560  7b07 20a978                     JSR C64ADD
  7561                                  ; W[i] = T1
