
; ******** Source: meshchat64.asm
     1                          ; ================================================================
     2                          ; MeshChat64 - key derivation library
     3                          ; PBKDF2-HMAC-SHA256 + HKDF on the Commodore 64
     4                          ; ACME 0.97 assembler format
     5                          ; ================================================================
     6                          
     7                          * = $0801
     8                          
     9  0801 0c080a009e323036...        !byte $0C,$08,$0A,$00,$9E,$32,$30,$36,$31,$00,$00,$00  ; SYS 2061 stub (instead of !basic)
    10                          
    11                          ; ================================================================
    12                          ; MAIN PROGRAM
    13                          ; ================================================================
    14                          
    15                                  ; disable CIA2 NMI - CIA2 Timer A is used for timing
    16                                  ; writing $DD0D with bit 7=0 clears all CIA2 interrupt masks
    17                                  ; --- bank out BASIC ROM: KERNAL+I/O stay, RAM up to $BFFF ---
    18                                  ; (app uses no BASIC; $00/$01 not touched anywhere else)
    19  080d a936                       LDA #$36
    20  080f 8501                       STA $01
    21                          
    22  0811 a97f                       LDA #$7F
    23  0813 8d0ddd                     STA $DD0D               ; Bug 6 fix: no unwanted NMI from CIA2
    24                          
    25                                  ; --- U64 turbo ON: full CPU speed (48/64 MHz) -------
    26                                  ; $D031 = speed index, $0F = max. Only effective if
    27                                  ; the U64 menu is in register-controlled turbo mode;
    28                                  ; otherwise a harmless no-op. Once set, the speed
    29                                  ; stays latched, even if I/O is banked out later.
    30  0816 a90f                       LDA #$0F
    31  0818 8d31d0                     STA $D031
    32                                  ; --- lock lower/upper-case charset (mode 2) ---
    33  081b ad18d0                     LDA $D018
    34  081e 0902                       ORA #$02
    35  0820 8d18d0                     STA $D018               ; select lowercase char ROM
    36  0823 a980                       LDA #$80
    37  0825 8d9102                     STA $0291               ; block C= +SHIFT charset toggle
    38                          
    39                          
    40                                  ; init ACIA FIRST (FPGA modem emulation requires this)
    41  0828 a903                       LDA #3
    42  082a 8d20d0                     STA $D020
    43  082d 207d24                     JSR ACIA_INIT
    44  0830 20af24                     JSR FPGA_SETTLE         ; Bug 3 fix: 50ms real-time via CIA2
    45                          
    46                                  ; 128-bit path removed: boot straight to 256-bit login.
    47  0833 209208                     JSR MC_LOGIN
    48                          
    49                                  ; initialise message counter for GCM nonce uniqueness
    50  0836 a900                       LDA #0
    51  0838 8d8155                     STA GCM_MSG_CTR+0
    52  083b 8d8255                     STA GCM_MSG_CTR+1
    53                          
    54                                  ; connect AFTER key derivation
    55                                  ; extra ACIA_INIT to refresh FPGA state after long computation
    56  083e a905                       LDA #5
    57  0840 8d20d0                     STA $D020
    58  0843 207d24                     JSR ACIA_INIT           ; <- extra reset (Bug 4 fix)
    59  0846 20af24                     JSR FPGA_SETTLE         ; Bug 3 fix: ~51ms settle after ACIA_INIT
    60  0849 20a425                     JSR MODEM_DIAL          ; Bug 5 fix: AT wake-up is now inside MODEM_DIAL
    61  084c a907                       LDA #7
    62  084e 8d20d0                     STA $D020
    63  0851 200d26                     JSR WS_HANDSHAKE
    64  0854 a901                       LDA #1
    65  0856 8d20d0                     STA $D020
    66                          
    67                                  ; draw the chat screen BEFORE connecting, so polling
    68                                  ; starts right after connect (like recvtest64). Otherwise
    69                                  ; the seen frames arrive during the slow screen draw
    70                                  ; and the ACIA (1-byte buffer) overflows -> RX breaks.
    71  0859 20990b                     JSR MC_CHAT_SCREEN
    72                          
    73                                  ; install NMI-RX FIRST: the auth handshake must receive frames
    74  085c 204e25                     JSR INSTALL_RX_NMI
    75                          
    76                                  ; new relay protocol (server.py HEAD): challenge-response auth
    77                                  ; instead of {"type":"connect"}. See WS_AUTH.
    78  085f 20f1a2                     JSR WS_AUTH_DISPATCH
    79                          
    80  0862 a905                       LDA #5
    81  0864 8d20d0                     STA $D020
    82                          
    83                                  ; polling starts right after connect (screen already drawn)
    84  0867 20da0b                     JSR MC_CHAT_LOOP
    85  086a 4c6a08                     JMP *
    86                          
    87                          ; ================================================================
    88                          ; MC_HEADER - show title bar (40 chars, inverse)
    89                          ; ================================================================
    90                          MC_HEADER
    91  086d a993                       LDA #$93        ; clear screen
    92  086f 20ba0c                     JSR PRINT_CHR
    93  0872 a99f                       LDA #$9F        ; cyan
    94  0874 20ba0c                     JSR PRINT_CHR
    95  0877 a912                       LDA #$12        ; inverse on
    96  0879 20ba0c                     JSR PRINT_CHR
    97  087c a91e                       LDA #<STR_TITLE
    98  087e 85fb                       STA $FB
    99  0880 a942                       LDA #>STR_TITLE
   100  0882 85fc                       STA $FC
   101  0884 20cf0c                     JSR PRINT_STR_FB
   102  0887 a992                       LDA #$92        ; inverse off
   103  0889 20ba0c                     JSR PRINT_CHR
   104  088c a90d                       LDA #$0D
   105  088e 20ba0c                     JSR PRINT_CHR
   106  0891 60                         RTS
   107                          
   108                          ; ================================================================
   109                          ; MC_LOGIN - input screen: name + passphrase + key derivation
   110                          ; ================================================================
   111                          MC_LOGIN
   112  0892 206d08                     JSR MC_HEADER
   113  0895 a90d                       LDA #$0D
   114  0897 20ba0c                     JSR PRINT_CHR
   115  089a a90d                       LDA #$0D
   116  089c 20ba0c                     JSR PRINT_CHR
   117                          
   118                                  ; name input
   119  089f a99e                       LDA #$9E        ; yellow
   120  08a1 20ba0c                     JSR PRINT_CHR
   121  08a4 a932                       LDA #<STR_NAAM_P
   122  08a6 85fb                       STA $FB
   123  08a8 a942                       LDA #>STR_NAAM_P
   124  08aa 85fc                       STA $FC
   125  08ac 20cf0c                     JSR PRINT_STR_FB
   126  08af a905                       LDA #$05        ; white
   127  08b1 20ba0c                     JSR PRINT_CHR
   128  08b4 20140c                     JSR INPUT_LINE
   129                          
   130                                  ; copy to KDFIN_NAME
   131  08b7 a200                       LDX #0
   132  08b9 bdcd42             ML_CN   LDA INP_BUF,X
   133  08bc 9d9541                     STA KDFIN_NAME,X
   134  08bf f005                       BEQ ML_CNE
   135  08c1 e8                         INX
   136  08c2 e020                       CPX #32
   137  08c4 d0f3                       BNE ML_CN
   138  08c6 8eb541             ML_CNE  STX KDFIN_NAMELEN
   139  08c9 a90d                       LDA #$0D
   140  08cb 20ba0c                     JSR PRINT_CHR
   141                          
   142                                  ; passphrase input
   143  08ce a99e                       LDA #$9E        ; yellow
   144  08d0 20ba0c                     JSR PRINT_CHR
   145  08d3 a93e                       LDA #<STR_PASS_P
   146  08d5 85fb                       STA $FB
   147  08d7 a942                       LDA #>STR_PASS_P
   148  08d9 85fc                       STA $FC
   149  08db 20cf0c                     JSR PRINT_STR_FB
   150  08de a905                       LDA #$05        ; White
   151  08e0 20ba0c                     JSR PRINT_CHR
   152  08e3 20560c                     JSR INPUT_PASS
   153                          
   154                                  ; copy to KDFIN_PASS
   155  08e6 a200                       LDX #0
   156  08e8 bdcd42             ML_CP   LDA INP_BUF,X
   157  08eb 9db641                     STA KDFIN_PASS,X
   158  08ee f005                       BEQ ML_CPE
   159  08f0 e8                         INX
   160  08f1 e040                       CPX #64
   161  08f3 d0f3                       BNE ML_CP
   162  08f5 8ef641             ML_CPE  STX KDFIN_PASSLEN
   163  08f8 a90d                       LDA #$0D
   164  08fa 20ba0c                     JSR PRINT_CHR
   165  08fd a90d                       LDA #$0D
   166  08ff 20ba0c                     JSR PRINT_CHR
   167                          
   168                                  ; progress message
   169  0902 a91c                       LDA #$1C        ; red
   170  0904 20ba0c                     JSR PRINT_CHR
   171  0907 a94a                       LDA #<STR_BEZIG
   172  0909 85fb                       STA $FB
   173  090b a942                       LDA #>STR_BEZIG
   174  090d 85fc                       STA $FC
   175  090f 20cf0c                     JSR PRINT_STR_FB
   176  0912 a90d                       LDA #$0D
   177  0914 20ba0c                     JSR PRINT_CHR
   178  0917 a964                       LDA #<STR_WACHT
   179  0919 85fb                       STA $FB
   180  091b a942                       LDA #>STR_WACHT
   181  091d 85fc                       STA $FC
   182  091f 20cf0c                     JSR PRINT_STR_FB
   183  0922 a90d                       LDA #$0D
   184  0924 20ba0c                     JSR PRINT_CHR
   185                          
   186                                  ; border red = busy
   187  0927 a902                       LDA #2
   188  0929 8d20d0                     STA $D020
   189                          
   190                                  ; key derivation
   191  092c 202021                     JSR DERIVE_KEYPAIR
   192                                  ; -- 256-bit identity: mode flag + cache signing seed --
   193  092f a901                       LDA #1
   194  0931 8d6039                     STA USE_256
   195  0934 20daa1                     JSR SETUP_SIGN_ID256
   196                          
   197                                  ; border green = done
   198  0937 a905                       LDA #5
   199  0939 8d20d0                     STA $D020
   200                          
   201                                  ; compute user ID
   202  093c 20bc23                     JSR COMPUTE_USER_ID
   203  093f 20d0a3                     JSR COMPUTE_C64_ID256  ; 256-bit publicId: SHA-256(encKey32)[0:12]
   204  0942 206fa6                     JSR MC_PEER_SETUP256   ; contact shareable -> KEY_PEER256 + PEER_IDSTR (empty=self)
   205                          
   206                          
   207                                  ; done message
   208  0945 a90d                       LDA #$0D
   209  0947 20ba0c                     JSR PRINT_CHR
   210  094a a91e                       LDA #$1E        ; green
   211  094c 20ba0c                     JSR PRINT_CHR
   212  094f a97a                       LDA #<STR_KLAAR
   213  0951 85fb                       STA $FB
   214  0953 a942                       LDA #>STR_KLAAR
   215  0955 85fc                       STA $FC
   216  0957 20cf0c                     JSR PRINT_STR_FB
   217  095a a90d                       LDA #$0D
   218  095c 20ba0c                     JSR PRINT_CHR
   219                          
   220                                  ; wait for space
   221  095f 20e4ff             ML_SPC  JSR $FFE4
   222  0962 f0fb                       BEQ ML_SPC
   223  0964 c920                       CMP #$20
   224  0966 d0f7                       BNE ML_SPC
   225  0968 60                         RTS
