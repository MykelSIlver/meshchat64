  7863  7cc1 8d0d9a                     STA SHA_WP
  7864  7cc4 9003                       BCC SB_R2
  7865  7cc6 ee0e9a                     INC SHA_WP+1
  7866  7cc9 ee049a             SB_R2   INC SHA_J
  7867  7ccc ad049a                     LDA SHA_J
  7868  7ccf c950                       CMP #80
  7869  7cd1 f003                       BEQ SB_RDN
  7870  7cd3 4cca7b                     JMP SB_RND
  7871                          SB_RDN
  7872                          
  7873                                  ; -- H[i] += werkvar[i] --
  7874  7cd6 a980                       LDA #<SHA_H
  7875  7cd8 85fb                       STA PA
  7876  7cda a992                       LDA #>SHA_H
  7877  7cdc 85fc                       STA PA+1
  7878  7cde a9c0                       LDA #<SHA_AH
  7879  7ce0 85fd                       STA PB
  7880  7ce2 a992                       LDA #>SHA_AH
  7881  7ce4 85fe                       STA PB+1
  7882  7ce6 a200                       LDX #0
  7883  7ce8 8e069a             SB_UH   STX SHA_BTMP
  7884  7ceb 20ff78                     JSR C64ADD
  7885  7cee a5fb                       LDA PA
  7886  7cf0 18                         CLC
  7887  7cf1 6908                       ADC #8
  7888  7cf3 85fb                       STA PA
  7889  7cf5 9002                       BCC SB_UH1
  7890  7cf7 e6fc                       INC PA+1
  7891  7cf9 a5fd               SB_UH1  LDA PB
  7892  7cfb 18                         CLC
  7893  7cfc 6908                       ADC #8
  7894  7cfe 85fd                       STA PB
  7895  7d00 9002                       BCC SB_UH2
  7896  7d02 e6fe                       INC PB+1
  7897  7d04 ae069a             SB_UH2  LDX SHA_BTMP
  7898  7d07 e8                         INX
  7899  7d08 e008                       CPX #8
  7900  7d0a d0dc                       BNE SB_UH
  7901  7d0c 60                         RTS
  7902                          
  7903                          ; --- Ch(e,f,g) = (e & f) ^ (~e & g) -> SHA_ACC ---
  7904                          CH_EFG  ; SHA_ACC = e & f
  7905  7d0d a207                       LDX #7
  7906  7d0f bde092             CH_CE   LDA SHA_AH+32,X        ; e
  7907  7d12 3de892                     AND SHA_AH+40,X        ; f
  7908  7d15 9d2893                     STA SHA_ACC,X
  7909  7d18 ca                         DEX
  7910  7d19 10f4                       BPL CH_CE
  7911                                  ; SHA_TC = (~e) & g
  7912  7d1b a207                       LDX #7
  7913  7d1d bde092             CH_NE   LDA SHA_AH+32,X        ; e
  7914  7d20 49ff                       EOR #$FF               ; ~e
  7915  7d22 3df092                     AND SHA_AH+48,X        ; g
  7916  7d25 9d2093                     STA SHA_TC,X
  7917  7d28 ca                         DEX
  7918  7d29 10f2                       BPL CH_NE
  7919                                  ; SHA_ACC ^= SHA_TC
  7920  7d2b a207                       LDX #7
  7921  7d2d bd2893             CH_XR   LDA SHA_ACC,X
  7922  7d30 5d2093                     EOR SHA_TC,X
  7923  7d33 9d2893                     STA SHA_ACC,X
  7924  7d36 ca                         DEX
  7925  7d37 10f4                       BPL CH_XR
  7926  7d39 60                         RTS
  7927                          
  7928                          ; --- Maj(a,b,c) = (a&b)^(a&c)^(b&c) -> SHA_ACC ---
  7929  7d3a a207               MAJ_ABC LDX #7
  7930  7d3c bdc092             MJ_AB   LDA SHA_AH+0,X         ; a
  7931  7d3f 3dc892                     AND SHA_AH+8,X         ; b
  7932  7d42 9d2893                     STA SHA_ACC,X
  7933  7d45 ca                         DEX
  7934  7d46 10f4                       BPL MJ_AB
  7935  7d48 a207                       LDX #7
  7936  7d4a bdc092             MJ_AC   LDA SHA_AH+0,X         ; a
  7937  7d4d 3dd092                     AND SHA_AH+16,X        ; c
  7938  7d50 9d2093                     STA SHA_TC,X
  7939  7d53 ca                         DEX
  7940  7d54 10f4                       BPL MJ_AC
  7941  7d56 a207                       LDX #7
  7942  7d58 bd2893             MJ_X1   LDA SHA_ACC,X
  7943  7d5b 5d2093                     EOR SHA_TC,X
  7944  7d5e 9d2893                     STA SHA_ACC,X
  7945  7d61 ca                         DEX
  7946  7d62 10f4                       BPL MJ_X1
  7947  7d64 a207                       LDX #7
  7948  7d66 bdc892             MJ_BC   LDA SHA_AH+8,X         ; b
  7949  7d69 3dd092                     AND SHA_AH+16,X        ; c
  7950  7d6c 9d2093                     STA SHA_TC,X
  7951  7d6f ca                         DEX
  7952  7d70 10f4                       BPL MJ_BC
  7953  7d72 a207                       LDX #7
  7954  7d74 bd2893             MJ_X2   LDA SHA_ACC,X
  7955  7d77 5d2093                     EOR SHA_TC,X
  7956  7d7a 9d2893                     STA SHA_ACC,X
  7957  7d7d ca                         DEX
  7958  7d7e 10f4                       BPL MJ_X2
  7959  7d80 60                         RTS
  7960                          
  7961                          ; --- word-copy helpers within SHA_AH (from source to target) ---
  7962  7d81 a207               CP_W6_W7 LDX #7
  7963  7d83 bdf092             C67     LDA SHA_AH+48,X
  7964  7d86 9df892                     STA SHA_AH+56,X
  7965  7d89 ca                         DEX
  7966  7d8a 10f7                       BPL C67
  7967  7d8c 60                         RTS
  7968  7d8d a207               CP_W5_W6 LDX #7
  7969  7d8f bde892             C56     LDA SHA_AH+40,X
  7970  7d92 9df092                     STA SHA_AH+48,X
  7971  7d95 ca                         DEX
  7972  7d96 10f7                       BPL C56
  7973  7d98 60                         RTS
  7974  7d99 a207               CP_W4_W5 LDX #7
  7975  7d9b bde092             C45     LDA SHA_AH+32,X
  7976  7d9e 9de892                     STA SHA_AH+40,X
  7977  7da1 ca                         DEX
  7978  7da2 10f7                       BPL C45
  7979  7da4 60                         RTS
  7980  7da5 a207               CP_W2_W3 LDX #7
  7981  7da7 bdd092             C23     LDA SHA_AH+16,X
  7982  7daa 9dd892                     STA SHA_AH+24,X
  7983  7dad ca                         DEX
  7984  7dae 10f7                       BPL C23
  7985  7db0 60                         RTS
  7986  7db1 a207               CP_W1_W2 LDX #7
  7987  7db3 bdc892             C12     LDA SHA_AH+8,X
  7988  7db6 9dd092                     STA SHA_AH+16,X
  7989  7db9 ca                         DEX
  7990  7dba 10f7                       BPL C12
  7991  7dbc 60                         RTS
  7992  7dbd a207               CP_W0_W1 LDX #7
  7993  7dbf bdc092             C01     LDA SHA_AH+0,X
  7994  7dc2 9dc892                     STA SHA_AH+8,X
  7995  7dc5 ca                         DEX
  7996  7dc6 10f7                       BPL C01
  7997  7dc8 60                         RTS
  7998                          
  7999                          ; --- SHA_ACC -> SHA_T1 ---
  8000  7dc9 a207               ACC_TO_T1 LDX #7
  8001  7dcb bd2893             AT_L    LDA SHA_ACC,X
  8002  7dce 9d0093                     STA SHA_T1,X
  8003  7dd1 ca                         DEX
  8004  7dd2 10f7                       BPL AT_L
  8005  7dd4 60                         RTS
  8006                          
  8007                          ; --- set PB = SHA5_W + A*8 ; set PA = SHA5_W + A*8 ---
  8008  7dd5 8d099a             SET_PB_W STA SHA_TMPI           ; A = word index (0..79)
  8009  7dd8 a900                       LDA #0
  8010  7dda 8d0a9a                     STA SHA_TMPH
  8011  7ddd 0e099a                     ASL SHA_TMPI            ; index*8 as 16-bit (else overflow at index>=32)
  8012  7de0 2e0a9a                     ROL SHA_TMPH
  8013  7de3 0e099a                     ASL SHA_TMPI
  8014  7de6 2e0a9a                     ROL SHA_TMPH
  8015  7de9 0e099a                     ASL SHA_TMPI
  8016  7dec 2e0a9a                     ROL SHA_TMPH
  8017  7def a900                       LDA #<SHA5_W
  8018  7df1 18                         CLC
  8019  7df2 6d099a                     ADC SHA_TMPI
  8020  7df5 85fd                       STA PB
  8021  7df7 a9c0                       LDA #>SHA5_W
  8022  7df9 6d0a9a                     ADC SHA_TMPH
  8023  7dfc 85fe                       STA PB+1
  8024  7dfe 60                         RTS
  8025  7dff 8d099a             SET_PA_W STA SHA_TMPI           ; A = word index (0..79)
  8026  7e02 a900                       LDA #0
  8027  7e04 8d0a9a                     STA SHA_TMPH
  8028  7e07 0e099a                     ASL SHA_TMPI
  8029  7e0a 2e0a9a                     ROL SHA_TMPH
  8030  7e0d 0e099a                     ASL SHA_TMPI
  8031  7e10 2e0a9a                     ROL SHA_TMPH
  8032  7e13 0e099a                     ASL SHA_TMPI
  8033  7e16 2e0a9a                     ROL SHA_TMPH
  8034  7e19 a900                       LDA #<SHA5_W
  8035  7e1b 18                         CLC
  8036  7e1c 6d099a                     ADC SHA_TMPI
  8037  7e1f 85fb                       STA PA
  8038  7e21 a9c0                       LDA #>SHA5_W
  8039  7e23 6d0a9a                     ADC SHA_TMPH
  8040  7e26 85fc                       STA PA+1
  8041  7e28 60                         RTS
  8042                          
  8043                          ; ================================================================
  8044                          ; SHA512  -  main routine: pad + loop over blocks
  8045                          ; ================================================================
  8046                          SHA512
  8047                                  ; -- H = IV --
  8048  7e29 a23f                       LDX #63
  8049  7e2b bdc08f             SH_IV   LDA SHA_IV,X
  8050  7e2e 9d8092                     STA SHA_H,X
  8051  7e31 ca                         DEX
  8052  7e32 10f7                       BPL SH_IV
  8053                          
  8054                                  ; -- build padded message in SHA_PAD --
  8055                                  ; copy SRC[0..MLEN-1] -> SHA_PAD
  8056  7e34 a5f7                       LDA SRC
  8057  7e36 85fd                       STA PB
  8058  7e38 a5f8                       LDA SRC+1
  8059  7e3a 85fe                       STA PB+1
  8060  7e3c a970                       LDA #<SHA_PAD
  8061  7e3e 85fb                       STA PA
  8062  7e40 a993                       LDA #>SHA_PAD
  8063  7e42 85fc                       STA PA+1
  8064                                  ; 16-bit copy of SHA5_MLEN bytes
  8065  7e44 adf099                     LDA SHA5_MLEN
  8066  7e47 8df699                     STA SHA_CNT
  8067  7e4a adf199                     LDA SHA5_MLEN+1
  8068  7e4d 8df799                     STA SHA_CNT+1
  8069  7e50 adf699             SH_CP   LDA SHA_CNT
  8070  7e53 0df799                     ORA SHA_CNT+1
  8071  7e56 f020                       BEQ SH_CPD
  8072  7e58 a000                       LDY #0
  8073  7e5a b1fd                       LDA (PB),Y
  8074  7e5c 91fb                       STA (PA),Y
  8075  7e5e e6fd                       INC PB
  8076  7e60 d002                       BNE SH_CP1
  8077  7e62 e6fe                       INC PB+1
  8078  7e64 e6fb               SH_CP1  INC PA
  8079  7e66 d002                       BNE SH_CP2
  8080  7e68 e6fc                       INC PA+1
  8081  7e6a adf699             SH_CP2  LDA SHA_CNT
  8082  7e6d d003                       BNE SH_CP3
  8083  7e6f cef799                     DEC SHA_CNT+1
  8084  7e72 cef699             SH_CP3  DEC SHA_CNT
  8085  7e75 4c507e                     JMP SH_CP
  8086                          SH_CPD
  8087                                  ; PA now points to SHA_PAD+MLEN ; write 0x80
  8088  7e78 a980                       LDA #$80
  8089  7e7a a000                       LDY #0
  8090  7e7c 91fb                       STA (PA),Y
  8091                                  ; compute total padded length (16-bit):
  8092                                  ;   m1 = MLEN+1 ; zeros so that (m1+zeros) % 128 == 112 ; +16
  8093                                  ; we keep it simple: fill from MLEN+1 with 0 until we reach a 128-multiple-112,
  8094                                  ; then 16 length bytes. Compute total first.
  8095                                  ; m1 = MLEN+1
  8096  7e7e adf099                     LDA SHA5_MLEN
  8097  7e81 18                         CLC
  8098  7e82 6901                       ADC #1
  8099  7e84 8df299                     STA SHA_M1
  8100  7e87 adf199                     LDA SHA5_MLEN+1
  8101  7e8a 6900                       ADC #0
  8102  7e8c 8df399                     STA SHA_M1+1
  8103                                  ; r = m1 mod 128 = m1 & 127 (only low byte relevant since 128 divides 256)
  8104  7e8f adf299                     LDA SHA_M1
  8105  7e92 297f                       AND #127
  8106  7e94 8dfe99                     STA SHA_R
  8107                                  ; zeros = (112 - r) mod 128
  8108  7e97 a970                       LDA #112
  8109  7e99 38                         SEC
  8110  7e9a edfe99                     SBC SHA_R
  8111  7e9d 297f                       AND #127
  8112  7e9f 8dff99                     STA SHA_ZEROS
  8113                                  ; total = m1 + zeros + 16
  8114  7ea2 adf299                     LDA SHA_M1
  8115  7ea5 18                         CLC
  8116  7ea6 6dff99                     ADC SHA_ZEROS
  8117  7ea9 8df499                     STA SHA_TOTAL
  8118  7eac adf399                     LDA SHA_M1+1
  8119  7eaf 6900                       ADC #0
  8120  7eb1 8df599                     STA SHA_TOTAL+1
  8121  7eb4 adf499                     LDA SHA_TOTAL
  8122  7eb7 18                         CLC
  8123  7eb8 6910                       ADC #16
  8124  7eba 8df499                     STA SHA_TOTAL
  8125  7ebd adf599                     LDA SHA_TOTAL+1
  8126  7ec0 6900                       ADC #0
  8127  7ec2 8df599                     STA SHA_TOTAL+1
  8128                                  ; fill SHA_PAD[m1 .. total-1] with 0 (we overwrite the length bytes later)
  8129                                  ; pointer PA = SHA_PAD + m1
  8130  7ec5 a970                       LDA #<SHA_PAD
  8131  7ec7 18                         CLC
  8132  7ec8 6df299                     ADC SHA_M1
  8133  7ecb 85fb                       STA PA
  8134  7ecd a993                       LDA #>SHA_PAD
  8135  7ecf 6df399                     ADC SHA_M1+1
  8136  7ed2 85fc                       STA PA+1
  8137                                  ; count = total - m1
  8138  7ed4 adf499                     LDA SHA_TOTAL
  8139  7ed7 38                         SEC
  8140  7ed8 edf299                     SBC SHA_M1
  8141  7edb 8df699                     STA SHA_CNT
  8142  7ede adf599                     LDA SHA_TOTAL+1
  8143  7ee1 edf399                     SBC SHA_M1+1
  8144  7ee4 8df799                     STA SHA_CNT+1
  8145  7ee7 adf699             SH_ZL   LDA SHA_CNT
  8146  7eea 0df799                     ORA SHA_CNT+1
  8147  7eed f01a                       BEQ SH_ZD
  8148  7eef a900                       LDA #0
  8149  7ef1 a000                       LDY #0
  8150  7ef3 91fb                       STA (PA),Y
  8151  7ef5 e6fb                       INC PA
  8152  7ef7 d002                       BNE SH_Z1
  8153  7ef9 e6fc                       INC PA+1
  8154  7efb adf699             SH_Z1   LDA SHA_CNT
  8155  7efe d003                       BNE SH_Z2
  8156  7f00 cef799                     DEC SHA_CNT+1
  8157  7f03 cef699             SH_Z2   DEC SHA_CNT
  8158  7f06 4ce77e                     JMP SH_ZL
  8159                          SH_ZD
  8160                                  ; write bit length (MLEN*8) big-endian in the last 16 bytes:
  8161                                  ;   total-1 = LSB, total-2 = next, ...  (only 16-bit bitlen supported)
  8162                                  ; bitlen16 = MLEN << 3 (16-bit)
  8163  7f09 adf099                     LDA SHA5_MLEN
  8164  7f0c 8dfc99                     STA SHA_BL
  8165  7f0f adf199                     LDA SHA5_MLEN+1
  8166  7f12 8dfd99                     STA SHA_BL+1
  8167  7f15 a202                       LDX #2                  ; 3 shifts (X=2..0) = MLEN<<3 (bytes->bits)
  8168  7f17 0efc99             SH_SHL  ASL SHA_BL
  8169  7f1a 2efd99                     ROL SHA_BL+1
  8170  7f1d ca                         DEX
  8171  7f1e 10f7                       BPL SH_SHL
  8172                                  ; SHA_PAD[total-1] = SHA_BL (lo) ; SHA_PAD[total-2] = SHA_BL+1 (hi)
  8173  7f20 a970                       LDA #<SHA_PAD
  8174  7f22 18                         CLC
  8175  7f23 6df499                     ADC SHA_TOTAL
  8176  7f26 85fb                       STA PA
  8177  7f28 a993                       LDA #>SHA_PAD
  8178  7f2a 6df599                     ADC SHA_TOTAL+1
  8179  7f2d 85fc                       STA PA+1                ; PA = SHA_PAD + total
  8180  7f2f a000                       LDY #0
  8181                                  ; index total-1
  8182  7f31 38                         SEC
  8183  7f32 a5fb                       LDA PA
  8184  7f34 e901                       SBC #1
  8185  7f36 85fb                       STA PA
  8186  7f38 b002                       BCS SH_B1
  8187  7f3a c6fc                       DEC PA+1
  8188  7f3c adfc99             SH_B1   LDA SHA_BL
  8189  7f3f 91fb                       STA (PA),Y             ; LSB
  8190  7f41 38                         SEC
  8191  7f42 a5fb                       LDA PA
  8192  7f44 e901                       SBC #1
  8193  7f46 85fb                       STA PA
  8194  7f48 b002                       BCS SH_B2
  8195  7f4a c6fc                       DEC PA+1
  8196  7f4c adfd99             SH_B2   LDA SHA_BL+1
  8197  7f4f 91fb                       STA (PA),Y             ; next byte
  8198                          
  8199                                  ; -- number of blocks = total / 128 --
  8200                                  ; nblk16 = total >> 7
  8201  7f51 adf599                     LDA SHA_TOTAL+1
  8202  7f54 8df999                     STA SHA_NBLK+1
  8203  7f57 adf499                     LDA SHA_TOTAL
  8204  7f5a 8df899                     STA SHA_NBLK
  8205                                  ; >>7 : 7x LSR over 16-bit
  8206  7f5d a206                       LDX #6                  ; 7 shifts (X=6..0), total/128
  8207  7f5f 4ef999             SH_NBL  LSR SHA_NBLK+1
  8208  7f62 6ef899                     ROR SHA_NBLK
  8209  7f65 ca                         DEX
  8210  7f66 10f7                       BPL SH_NBL
  8211                          
  8212                                  ; -- loop blocks --
  8213  7f68 a970                       LDA #<SHA_PAD
  8214  7f6a 85f9                       STA BP
  8215  7f6c a993                       LDA #>SHA_PAD
  8216  7f6e 85fa                       STA BP+1
  8217  7f70 a900                       LDA #0
  8218  7f72 8dfa99                     STA SHA_BI
  8219  7f75 8dfb99                     STA SHA_BI+1
  8220                          SH_BLKL
  8221                                  ; done?  SHA_BI == SHA_NBLK ?
  8222  7f78 adfa99                     LDA SHA_BI
  8223  7f7b cdf899                     CMP SHA_NBLK
  8224  7f7e d00b                       BNE SH_DOB
  8225  7f80 adfb99                     LDA SHA_BI+1
  8226  7f83 cdf999                     CMP SHA_NBLK+1
  8227  7f86 d003                       BNE SH_DOB
  8228  7f88 4ca47f                     JMP SH_FIN
  8229                          SH_DOB
  8230  7f8b 20a7b5                     JSR PW_SHA
  8231                                  ; BP += 128
  8232  7f8e a5f9                       LDA BP
  8233  7f90 18                         CLC
  8234  7f91 6980                       ADC #128
  8235  7f93 85f9                       STA BP
  8236  7f95 9002                       BCC SH_BI1
  8237  7f97 e6fa                       INC BP+1
  8238  7f99 eefa99             SH_BI1  INC SHA_BI
  8239  7f9c d003                       BNE SH_BI2
  8240  7f9e eefb99                     INC SHA_BI+1
  8241  7fa1 4c787f             SH_BI2  JMP SH_BLKL
  8242                          SH_FIN
  8243                                  ; -- digest = H big-endian --
  8244  7fa4 a900                       LDA #0
  8245  7fa6 8d049a                     STA SHA_J               ; word 0..7
  8246  7fa9 ad049a             SH_DW   LDA SHA_J
  8247  7fac 0a                         ASL
  8248  7fad 0a                         ASL
  8249  7fae 0a                         ASL
  8250  7faf 8d059a                     STA SHA_OFF             ; J*8
  8251  7fb2 a200                       LDX #0                  ; b
  8252                          SH_DB   ; DIGEST[J*8 + b] = H[J].byte(7-b)
  8253  7fb4 8a                         TXA
  8254  7fb5 4907                       EOR #7
  8255  7fb7 18                         CLC
  8256  7fb8 6d059a                     ADC SHA_OFF             ; source index in SHA_H
  8257  7fbb a8                         TAY
  8258  7fbc b98092                     LDA SHA_H,Y
  8259                                  ; dest = SHA_DIGEST + J*8 + b
  8260  7fbf 8a                         TXA
  8261  7fc0 18                         CLC
  8262  7fc1 6d059a                     ADC SHA_OFF
  8263  7fc4 a8                         TAY
  8264  7fc5 993093                     STA SHA_DIGEST,Y        ; (A still = byte? no) -- fix below
  8265  7fc8 4ccb7f                     JMP SH_DB_FIX
  8266                          SH_DB_FIX
  8267                                  ; correcte versie:
  8268  7fcb a200                       LDX #0
  8269  7fcd 8a                 SH_DB2  TXA
  8270  7fce 4907                       EOR #7
  8271  7fd0 18                         CLC
  8272  7fd1 6d059a                     ADC SHA_OFF
  8273  7fd4 a8                         TAY
  8274  7fd5 b98092                     LDA SHA_H,Y             ; byte
  8275  7fd8 8d089a                     STA SHA_DBYTE
  8276  7fdb 8a                         TXA
  8277  7fdc 18                         CLC
  8278  7fdd 6d059a                     ADC SHA_OFF
  8279  7fe0 a8                         TAY
  8280  7fe1 ad089a                     LDA SHA_DBYTE
  8281  7fe4 993093                     STA SHA_DIGEST,Y
  8282  7fe7 e8                         INX
  8283  7fe8 e008                       CPX #8
  8284  7fea d0e1                       BNE SH_DB2
  8285  7fec ee049a                     INC SHA_J
  8286  7fef ad049a                     LDA SHA_J
  8287  7ff2 c908                       CMP #8
  8288  7ff4 d0b3                       BNE SH_DW
  8289  7ff6 60                         RTS
  8290                          
  8291                          
  8292                          ; ================================================================
  8293                          ; ==================  modL (from step 4, ML_ prefix)  ===========
  8294                          ; ================================================================
  8295                          
  8296                          
  8297                          !macro mov32 .d, .s {
  8298                                  lda .s:sta .d : lda .s+1:sta .d+1 : lda .s+2:sta .d+2 : lda .s+3:sta .d+3
  8299                          }
  8300                          !macro zero32 .d {
  8301                                  lda #0:sta .d:sta .d+1:sta .d+2:sta .d+3
  8302                          }
  8303                          !macro add32 .d, .s {
