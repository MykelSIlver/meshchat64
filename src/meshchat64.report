  7687                                  ; -- shift werkvars: h=g,g=f,f=e,e=d+T1,d=c,c=b,b=a,a=T1+T2 --
  7688                                  ; do back to front: word7<-6,6<-5,5<-4 ; e(4)=d(3)+T1 ; 3<-2,2<-1,1<-0 ; a(0)=T1+T2
  7689                                  ; h<-g
  7690  7bf9 202b7d                     JSR CP_W6_W7
  7691                                  ; g<-f
  7692  7bfc 20377d                     JSR CP_W5_W6
  7693                                  ; f<-e
  7694  7bff 20437d                     JSR CP_W4_W5
  7695                                  ; e = d + T1  -> copy d(3) to e(4), then += T1
  7696  7c02 a98a                       LDA #<(SHA_AH+32)
  7697  7c04 85fb                       STA PA
  7698  7c06 a992                       LDA #>(SHA_AH+32)
  7699  7c08 85fc                       STA PA+1
  7700  7c0a a982                       LDA #<(SHA_AH+24)
  7701  7c0c 85fd                       STA PB
  7702  7c0e a992                       LDA #>(SHA_AH+24)
  7703  7c10 85fe                       STA PB+1
  7704  7c12 209d78                     JSR C64COPY
  7705  7c15 a98a                       LDA #<(SHA_AH+32)
  7706  7c17 85fb                       STA PA
  7707  7c19 a992                       LDA #>(SHA_AH+32)
  7708  7c1b 85fc                       STA PA+1
  7709  7c1d a9aa                       LDA #<SHA_T1
  7710  7c1f 85fd                       STA PB
  7711  7c21 a992                       LDA #>SHA_T1
  7712  7c23 85fe                       STA PB+1
  7713  7c25 20a978                     JSR C64ADD
  7714                                  ; d<-c, c<-b, b<-a
  7715  7c28 204f7d                     JSR CP_W2_W3
