  9858                          ; ================================================================
  9859                          ; MC_PEER_SETUP256 - ask for contact shareable; empty = to yourself.
  9860                          ;   Fills KEY_PEER256 (encrypt outgoing) + PEER_IDSTR ('to' field).
  9861                          ; ================================================================
  9862                          MC_PEER_SETUP256
  9863  a66f a90d                       LDA #$0D
  9864  a671 20ba0c                     JSR PRINT_CHR
  9865  a674 a99e                       LDA #$9E            ; yellow
  9866  a676 20ba0c                     JSR PRINT_CHR
  9867  a679 a9eb                       LDA #<STR_PEER_P
  9868  a67b 85fb                       STA $FB
  9869  a67d a93a                       LDA #>STR_PEER_P
  9870  a67f 85fc                       STA $FC
  9871  a681 20cf0c                     JSR PRINT_STR_FB
  9872  a684 a905                       LDA #$05            ; wit
  9873  a686 20ba0c                     JSR PRINT_CHR
  9874  a689 20140c                     JSR INPUT_LINE      ; -> INP_BUF, INP_LEN
  9875  a68c adcd43                     LDA INP_LEN
  9876  a68f d017                       BNE MPS_PEER
  9877                                  ; --- empty: self ---
  9878  a691 a21f                       LDX #31
  9879  a693 bde038             MPS_SK  LDA HKDF_OKM,X
  9880  a696 9d4039                     STA KEY_PEER256,X
  9881  a699 ca                         DEX
  9882  a69a 10f7                       BPL MPS_SK
  9883  a69c a210                       LDX #16
  9884  a69e bd935a             MPS_SI  LDA C64_IDSTR,X
  9885  a6a1 9d3c40                     STA PEER_IDSTR,X
  9886  a6a4 ca                         DEX
  9887  a6a5 10f7                       BPL MPS_SI
  9888  a6a7 60                         RTS
  9889                          MPS_PEER
  9890                                  ; isolate 1st segment (up to '.') -> INP_LEN
  9891  a6a8 a200                       LDX #0
