  9018                          ; ================================================================
  9019                          ; Item 2 — relay-auth challenge-response, 256-bit pad (Optie B)
  9020                          ; ----------------------------------------------------------------
  9021                          ; Parallel to the existing WS_AUTH (128-bit). Place WS_AUTH256
  9022                          ; next to WS_AUTH so the 128-bit fallback stays. Call WS_AUTH256
  9023                          ; instead of WS_AUTH when the identity is a 256-bit identity.
  9024                          ;
  9025                          ; Differences from WS_AUTH (all other logic reused identically):
  9026                          ;   step 1: bits:256 + 32-byte enc_key (HKDF_OKM[0:32]) instead of 16
  9027                          ;   step 3: AGD256 (AES-256-GCM-decrypt+verify) instead of AES_GCM_DECRYPT;
  9028                          ;           48-byte data gesplitst -> CTBUF[32] (nonce-CT) + GCM_RECV_TAG[16];
  9029                          ;           VERIFY_FAIL checked (bad tag -> auth failed)
  9030                          ;   step 4: nonce emitted from PTBUF (AGD256 output) instead of GCM_CTBUF
  9031                          ;
  9032                          ; VOORWAARDEN (item 5 / item 4):
  9033                          ;   - AES-256 layer merged in: AGD256, AES_KEY[32], CTBUF/PTBUF,
  9034                          ;     GCM_RECV_TAG[16], VERIFY_FAIL, PTLEN exist (from aes256test.asm).
  9035                          ;   - HKDF_OKM[0:32] = eigen 256-bit encKey (DERIVE_KEYPAIR of paste).
  9036                          ;   - Challenge-nonce is 32 bytes -> data = 48 (32 CT + 16 tag): zelfde
  9037                          ;     length check as 128-bit. (nonce/tag length equal for both paths)
  9038                          ;
  9039                          ; Reason codes from the relay (bad_init/bad_key_length/proof_invalid/
  9040                          ; timeout) are handled generically as auth_fail in WA2_FAIL.
  9041                          ; ================================================================
  9042                          WS_AUTH256
  9043  9ea6 a99e                       LDA #$9E            ; yellow
  9044  9ea8 20ba0c                     JSR PRINT_CHR
  9045  9eab a9ca                       LDA #<STR_AUTH_BUSY
  9046  9ead 85fb                       STA $FB
  9047  9eaf a940                       LDA #>STR_AUTH_BUSY
  9048  9eb1 85fc                       STA $FC
  9049  9eb3 20cf0c                     JSR PRINT_STR_FB
  9050  9eb6 a90d                       LDA #$0D
  9051  9eb8 20ba0c                     JSR PRINT_CHR
  9052  9ebb a905                       LDA #$05            ; White
  9053  9ebd 20ba0c                     JSR PRINT_CHR
  9054                          
  9055                                  ; -- step 1: auth_init (bits:256, 32-byte enc_key) --
  9056  9ec0 20be26                     JSR JOUT_INIT
  9057  9ec3 a98a                       LDA #<STR_AUTH1_256
  9058  9ec5 85fb                       STA $FB
  9059  9ec7 a9a0                       LDA #>STR_AUTH1_256
  9060  9ec9 85fc                       STA $FC
  9061  9ecb 20f226                     JSR JOUT_EMIT_STR
  9062  9ece a200                       LDX #0
  9063  9ed0 bde038             WA2_KL  LDA HKDF_OKM,X         ; eigen 256-bit encKey = HKDF_OKM[0:32]
  9064  9ed3 8ea65a                     STX BGB_XTMP           ; BYTE_TO_DEC clobbers X
  9065  9ed6 200527                     JSR BYTE_TO_DEC
  9066  9ed9 aea65a                     LDX BGB_XTMP
  9067  9edc e8                         INX
  9068  9edd e020                       CPX #32                ; 32 key bytes instead of 16
  9069  9edf f008                       BEQ WA2_KLD
  9070  9ee1 a92c                       LDA #$2C               ; ','
  9071  9ee3 20d126                     JSR JOUT_EMIT
  9072  9ee6 4cd09e                     JMP WA2_KL
  9073  9ee9 a95d               WA2_KLD LDA #$5D               ; ']'
  9074  9eeb 20d126                     JSR JOUT_EMIT
  9075  9eee a97d                       LDA #$7D               ; '}'
  9076  9ef0 20d126                     JSR JOUT_EMIT
  9077  9ef3 200730                     JSR WS_SEND_EXT
  9078                          
  9079                                  ; -- step 2: wait for challenge frame (max 8) -- (identical to WS_AUTH)
  9080  9ef6 a908                       LDA #8
  9081  9ef8 8d6440                     STA WA_TRY
  9082  9efb 20d529             WA2_W1  JSR WS_RECV_FRAME
  9083  9efe 9008                       BCC WA2_G1
  9084  9f00 ce6440                     DEC WA_TRY
  9085  9f03 d0f6                       BNE WA2_W1
  9086  9f05 4c6ea0                     JMP WA2_FAIL
  9087  9f08 a99e               WA2_G1  LDA #<RCV_BUF
  9088  9f0a 85fb                       STA $FB
  9089  9f0c a95f                       LDA #>RCV_BUF
  9090  9f0e 85fc                       STA $FC
  9091  9f10 a904                       LDA #<JSC_CHAL
  9092  9f12 8db15a                     STA JSC_PAT_LO
  9093  9f15 a96c                       LDA #>JSC_CHAL
  9094  9f17 8db25a                     STA JSC_PAT_HI
  9095  9f1a 20182d                     JSR JSON_SCAN
  9096  9f1d 9008                       BCC WA2_CH
  9097  9f1f ce6440                     DEC WA_TRY
  9098  9f22 d0d7                       BNE WA2_W1
  9099  9f24 4c6ea0                     JMP WA2_FAIL
  9100                          WA2_CH
  9101                                  ; iv parsen (12 bytes)
  9102  9f27 a9eb                       LDA #<JSC_IV
  9103  9f29 8db15a                     STA JSC_PAT_LO
  9104  9f2c a96b                       LDA #>JSC_IV
  9105  9f2e 8db25a                     STA JSC_PAT_HI
  9106  9f31 20182d                     JSR JSON_SCAN
  9107  9f34 9003                       BCC *+5
  9108  9f36 4c6ea0                     JMP WA2_FAIL
  9109  9f39 a9d2                       LDA #<RCV_IV
  9110  9f3b 85fd                       STA $FD
  9111  9f3d a95a                       LDA #>RCV_IV
  9112  9f3f 85fe                       STA $FE
  9113  9f41 a90c                       LDA #12
  9114  9f43 8db85a                     STA PRM_CNT
  9115  9f46 a900                       LDA #0
  9116  9f48 8dbd5a                     STA RCV_CT_LEN
  9117  9f4b 8dbe5a                     STA RCV_CT_LEN+1
  9118  9f4e 20c92d                     JSR JSON_PARSE_ARR
  9119  9f51 9003                       BCC *+5
  9120  9f53 4c6ea0                     JMP WA2_FAIL
  9121                                  ; parse data (must be 48 = 32 nonce-CT + 16 tag)
  9122  9f56 a9f2                       LDA #<JSC_DATA
  9123  9f58 8db15a                     STA JSC_PAT_LO
  9124  9f5b a96b                       LDA #>JSC_DATA
  9125  9f5d 8db25a                     STA JSC_PAT_HI
  9126  9f60 20182d                     JSR JSON_SCAN
  9127  9f63 9003                       BCC *+5
  9128  9f65 4c6ea0                     JMP WA2_FAIL
  9129  9f68 a9de                       LDA #<RCV_CT
  9130  9f6a 85fd                       STA $FD
  9131  9f6c a95a                       LDA #>RCV_CT
  9132  9f6e 85fe                       STA $FE
  9133  9f70 a900                       LDA #0
  9134  9f72 8db85a                     STA PRM_CNT            ; 0 = variable length
  9135  9f75 8dbd5a                     STA RCV_CT_LEN
  9136  9f78 8dbe5a                     STA RCV_CT_LEN+1
  9137  9f7b 8dae5a                     STA RCV_TOOLONG
  9138  9f7e 20c92d                     JSR JSON_PARSE_ARR
  9139  9f81 9003                       BCC *+5
  9140  9f83 4c6ea0                     JMP WA2_FAIL
  9141  9f86 adbd5a                     LDA RCV_CT_LEN
  9142  9f89 c930                       CMP #48
  9143  9f8b f003                       BEQ *+5
  9144  9f8d 4c6ea0                     JMP WA2_FAIL
  9145                          
  9146                                  ; -- step 3: decrypt challenge with AGD256 (AES-256-GCM) --
  9147                                  ; iv -> AES_NONCE (12)
  9148  9f90 a20b                       LDX #11
  9149  9f92 bdd25a             WA2_IV  LDA RCV_IV,X
  9150  9f95 9d2252                     STA AES_NONCE,X
  9151  9f98 ca                         DEX
  9152  9f99 10f7                       BPL WA2_IV
  9153                                  ; eigen encKey -> AES_KEY (32)
  9154  9f9b a21f                       LDX #31
  9155  9f9d bde038             WA2_KS  LDA HKDF_OKM,X
  9156  9fa0 9dcf4a                     STA AES_KEY,X
  9157  9fa3 ca                         DEX
  9158  9fa4 10f7                       BPL WA2_KS
  9159                                  ; data[0:32] -> CTBUF  (nonce-ciphertext)
  9160  9fa6 a21f                       LDX #31
  9161  9fa8 bdde5a             WA2_CT  LDA RCV_CT,X
  9162  9fab 9d734d                     STA CTBUF,X
  9163  9fae ca                         DEX
  9164  9faf 10f7                       BPL WA2_CT
  9165                                  ; data[32:48] -> GCM_RECV_TAG  (16-byte tag)
  9166  9fb1 a20f                       LDX #15
  9167  9fb3 bdfe5a             WA2_TG  LDA RCV_CT+32,X
  9168  9fb6 9d7152                     STA GCM_RECV_TAG,X
  9169  9fb9 ca                         DEX
  9170  9fba 10f7                       BPL WA2_TG
  9171                                  ; PTLEN = 32
  9172  9fbc a920                       LDA #32
  9173  9fbe 8df14a                     STA PTLEN+0
  9174  9fc1 a900                       LDA #0
  9175  9fc3 8df24a                     STA PTLEN+1
  9176  9fc6 206e48                     JSR AGD256             ; -> PTBUF[0..31] = nonce ; VERIFY_FAIL
  9177  9fc9 adf04a                     LDA VERIFY_FAIL
  9178  9fcc f003                       BEQ WA2_DEC_OK
  9179  9fce 4c6ea0                     JMP WA2_FAIL           ; tag verification failed
  9180                          WA2_DEC_OK
  9181                          
  9182                                  ; -- step 4: auth_proof (nonce from PTBUF) --
  9183  9fd1 20be26                     JSR JOUT_INIT
  9184  9fd4 a954                       LDA #<STR_AUTH2
  9185  9fd6 85fb                       STA $FB
  9186  9fd8 a96c                       LDA #>STR_AUTH2
  9187  9fda 85fc                       STA $FC
  9188  9fdc 20f226                     JSR JOUT_EMIT_STR
  9189  9fdf a200                       LDX #0
  9190  9fe1 bdf34a             WA2_NL  LDA PTBUF,X            ; AGD256 output instead of GCM_CTBUF
  9191  9fe4 8ea65a                     STX BGB_XTMP
  9192  9fe7 200527                     JSR BYTE_TO_DEC
  9193  9fea aea65a                     LDX BGB_XTMP
  9194  9fed e8                         INX
  9195  9fee e020                       CPX #32
  9196  9ff0 f008                       BEQ WA2_NLD
  9197  9ff2 a92c                       LDA #$2C               ; ','
  9198  9ff4 20d126                     JSR JOUT_EMIT
  9199  9ff7 4ce19f                     JMP WA2_NL
  9200  9ffa a95d               WA2_NLD LDA #$5D               ; ']'
  9201  9ffc 20d126                     JSR JOUT_EMIT
  9202  9fff a97d                       LDA #$7D               ; '}'
  9203  a001 20d126                     JSR JOUT_EMIT
  9204  a004 200730                     JSR WS_SEND_EXT
  9205                          
  9206                                  ; -- step 5: wait for auth_ok / auth_fail -- (identical to WS_AUTH)
  9207  a007 a908                       LDA #8
  9208  a009 8d6440                     STA WA_TRY
  9209  a00c 20d529             WA2_W2  JSR WS_RECV_FRAME
  9210  a00f 9008                       BCC WA2_G2
  9211  a011 ce6440                     DEC WA_TRY
  9212  a014 d0f6                       BNE WA2_W2
  9213  a016 4c6ea0                     JMP WA2_FAIL
  9214  a019 a99e               WA2_G2  LDA #<RCV_BUF
  9215  a01b 85fb                       STA $FB
  9216  a01d a95f                       LDA #>RCV_BUF
  9217  a01f 85fc                       STA $FC
  9218  a021 a913                       LDA #<JSC_AOK
  9219  a023 8db15a                     STA JSC_PAT_LO
  9220  a026 a96c                       LDA #>JSC_AOK
  9221  a028 8db25a                     STA JSC_PAT_HI
  9222  a02b 20182d                     JSR JSON_SCAN
  9223  a02e 9022                       BCC WA2_OK
  9224  a030 a99e                       LDA #<RCV_BUF
  9225  a032 85fb                       STA $FB
  9226  a034 a95f                       LDA #>RCV_BUF
  9227  a036 85fc                       STA $FC
  9228  a038 a91b                       LDA #<JSC_AFAIL
  9229  a03a 8db15a                     STA JSC_PAT_LO
  9230  a03d a96c                       LDA #>JSC_AFAIL
