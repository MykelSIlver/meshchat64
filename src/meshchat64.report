  7138                          ; ================================================================
  7139                          FP_INV
  7140  7569 a90785fba98d85fc...        +sq  z2, ZIN            ; z^2
  7141  757c a94a85fba98d85fc...        +sq  t1, z2             ; z^4
  7142  758f a96a85fba98d85fc...        +sq  t0, t1            ; z^8
  7143  75a2 a98a85fba98d85fc...        +mul z9, t0, ZIN       ; z^9
  7144  75bd a9aa85fba98d85fc...        +mul z11, z9, z2       ; z^11
  7145  75d8 a9ca85fba98d85fc...        +sq  t0, z11           ; z^22
