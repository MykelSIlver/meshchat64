  5687                          
  5688                          ; ================================================================
  5689                          ; AES_SETKEY  -  key expansion
  5690                          ;
  5691                          ;   Input : AES_KEY[0..15]
  5692                          ;   Output: AES_RK[0..175]   (W[0]..W[43], each word = 4 bytes)
  5693                          ;
  5694                          ;   AES_WOFF = write offset in bytes (runs from 16 to 172 in steps of 4)
  5695                          ;
  5696                          ;   For i >= 4:
  5697                          ;     if i mod 4 = 0 : SubWord( RotWord( W[i-1] ) )  XOR  Rcon[i/4-1]
  5698                          ;     anders          : W[i-1]
  5699                          ;   result XOR W[i-4]  ->  W[i]
  5700                          ;
  5701                          ;   Trick for offset calculation:
  5702                          ;     LDA AES_RK-4,X  =  LDA  (address of AES_RK - 4) + X
  5703                          ;     Valid 6502 absolute,X - the assembler computes the base address.
  5704                          ; ================================================================
  5705                          AES_SETKEY
  5706  4614 a90a                       LDA #10            ; AES-128: 10 ronden
  5707  4616 8def4a                     STA AES_NR
  5708                                  ; copy key bytes directly to RK[0..15]
  5709  4619 a20f                       LDX #15
  5710  461b bdcf4a             ASKS_CP LDA AES_KEY,X
  5711  461e 9d1350                     STA AES_RK,X
  5712  4621 ca                         DEX
  5713  4622 10f7                       BPL ASKS_CP
  5714                          
  5715  4624 a910                       LDA #16
  5716  4626 8d0351                     STA AES_WOFF            ; start bij W[4] (byte-offset 16)
  5717                          
  5718  4629 ad0351             ASKS_LP LDA AES_WOFF
  5719  462c c9b0                       CMP #176
  5720  462e d003                       BNE ASKS_CONT
  5721  4630 4cf446                     JMP ASKS_DN
  5722                          ASKS_CONT
  5723                          
  5724                                  ; --- load W[i-1] = AES_RK[ WOFF-4 .. WOFF-1 ] into AES_T4 ---
  5725  4633 ae0351                     LDX AES_WOFF
  5726  4636 bd0f50                     LDA AES_RK-4,X          ; W[i-1] byte 0
  5727  4639 8d0451                     STA AES_T4+0
  5728  463c bd1050                     LDA AES_RK-3,X          ; W[i-1] byte 1
  5729  463f 8d0551                     STA AES_T4+1
  5730  4642 bd1150                     LDA AES_RK-2,X          ; W[i-1] byte 2
  5731  4645 8d0651                     STA AES_T4+2
  5732  4648 bd1250                     LDA AES_RK-1,X          ; W[i-1] byte 3
  5733  464b 8d0751                     STA AES_T4+3
  5734                          
  5735                                  ; only transform if WOFF is a multiple of 16 (i mod 4 = 0)
  5736  464e ad0351                     LDA AES_WOFF
  5737  4651 290f                       AND #$0F
  5738  4653 d054                       BNE ASKS_XOR            ; not a multiple -> skip RotSub
  5739                          
  5740                                  ; ---- RotWord: [a0,a1,a2,a3] -> [a1,a2,a3,a0] -----------
  5741  4655 ad0451                     LDA AES_T4+0
  5742  4658 48                         PHA                     ; save a0
  5743  4659 ad0551                     LDA AES_T4+1
  5744  465c 8d0451                     STA AES_T4+0
  5745  465f ad0651                     LDA AES_T4+2
  5746  4662 8d0551                     STA AES_T4+1
  5747  4665 ad0751                     LDA AES_T4+3
  5748  4668 8d0651                     STA AES_T4+2
  5749  466b 68                         PLA
  5750  466c 8d0751                     STA AES_T4+3
  5751                          
  5752                                  ; ---- SubWord via S-box ----------------------------------
  5753  466f ad0451                     LDA AES_T4+0
  5754  4672 aa                         TAX
  5755  4673 bd2251                     LDA AES_SBOX,X
  5756  4676 8d0451                     STA AES_T4+0
  5757  4679 ad0551                     LDA AES_T4+1
  5758  467c aa                         TAX
  5759  467d bd2251                     LDA AES_SBOX,X
  5760  4680 8d0551                     STA AES_T4+1
  5761  4683 ad0651                     LDA AES_T4+2
  5762  4686 aa                         TAX
  5763  4687 bd2251                     LDA AES_SBOX,X
  5764  468a 8d0651                     STA AES_T4+2
  5765  468d ad0751                     LDA AES_T4+3
  5766  4690 aa                         TAX
  5767  4691 bd2251                     LDA AES_SBOX,X
  5768  4694 8d0751                     STA AES_T4+3
  5769                          
  5770                                  ; ---- XOR T4[0] with Rcon[ WOFF/16 - 1 ] -----------------
  5771  4697 ad0351                     LDA AES_WOFF
  5772  469a 4a                         LSR
  5773  469b 4a                         LSR
  5774  469c 4a                         LSR
  5775  469d 4a                         LSR                     ; = WOFF / 16  (gives 1..10)
  5776  469e aa                         TAX
  5777  469f ca                         DEX                     ; 0-based index into AES_RCON
  5778  46a0 bd1851                     LDA AES_RCON,X
  5779  46a3 4d0451                     EOR AES_T4+0
  5780  46a6 8d0451                     STA AES_T4+0
  5781                          
  5782                          ASKS_XOR
  5783                                  ; XOR T4 with W[i-4] = AES_RK[ WOFF-16 .. WOFF-13 ]
  5784  46a9 ae0351                     LDX AES_WOFF
  5785  46ac ad0451                     LDA AES_T4+0
  5786  46af 5d0350                     EOR AES_RK-16,X
  5787  46b2 8d0451                     STA AES_T4+0
  5788  46b5 ad0551                     LDA AES_T4+1
  5789  46b8 5d0450                     EOR AES_RK-15,X
  5790  46bb 8d0551                     STA AES_T4+1
  5791  46be ad0651                     LDA AES_T4+2
  5792  46c1 5d0550                     EOR AES_RK-14,X
  5793  46c4 8d0651                     STA AES_T4+2
  5794  46c7 ad0751                     LDA AES_T4+3
  5795  46ca 5d0650                     EOR AES_RK-13,X
  5796  46cd 8d0751                     STA AES_T4+3
  5797                          
  5798                                  ; store W[i] in AES_RK[ WOFF .. WOFF+3 ]
  5799                                  ; X = AES_WOFF  (still valid after the read/store sequence above)
  5800  46d0 ad0451                     LDA AES_T4+0
  5801  46d3 9d1350                     STA AES_RK+0,X
  5802  46d6 ad0551                     LDA AES_T4+1
  5803  46d9 9d1450                     STA AES_RK+1,X
  5804  46dc ad0651                     LDA AES_T4+2
  5805  46df 9d1550                     STA AES_RK+2,X
  5806  46e2 ad0751                     LDA AES_T4+3
  5807  46e5 9d1650                     STA AES_RK+3,X
  5808                          
  5809  46e8 ad0351                     LDA AES_WOFF
  5810  46eb 18                         CLC
  5811  46ec 6904                       ADC #4
  5812  46ee 8d0351                     STA AES_WOFF
  5813  46f1 4c2946                     JMP ASKS_LP
  5814                          
  5815  46f4 60                 ASKS_DN RTS
  5816                          
  5817                          ; ================================================================
  5818                          ; AES_ENCRYPT_BLOCK  -  encrypt AES_BLOCK in-place
  5819                          ;
  5820                          ;   Requires: AES_RK is filled by AES_SETKEY.
  5821                          ;
  5822                          ;   Ronden:
  5823                          ;     0       : only AddRoundKey
  5824                          ;     1..9    : SubBytes + ShiftRows + MixColumns + AddRoundKey
  5825                          ;    10 (fin) : SubBytes + ShiftRows + AddRoundKey  (no Mix)
  5826                          ; ================================================================
  5827                          AES_ENCRYPT_BLOCK
  5828                                  ; copy plaintext to work state
  5829  46f5 a20f                       LDX #15
  5830  46f7 bdf34f             AESB_CI LDA AES_BLOCK,X
  5831  46fa 9d0350                     STA AES_STATE,X
  5832  46fd ca                         DEX
  5833  46fe 10f7                       BPL AESB_CI
  5834                          
  5835                                  ; Ronde 0 - AddRoundKey
  5836  4700 a900                       LDA #0
  5837  4702 8d0951                     STA AES_RNDOFF
  5838  4705 20bd48                     JSR AES_ARK
  5839                          
  5840  4708 a901                       LDA #1
  5841  470a 8d0851                     STA AES_RNDCNT
  5842                          
  5843  470d ad0851             AESB_RL LDA AES_RNDCNT
  5844  4710 cdef4a                     CMP AES_NR              ; 10 (AES-128) / 14 (AES-256)
  5845  4713 f01c                       BEQ AESB_FN
  5846                          
  5847  4715 20d248                     JSR AES_SUBBYTES
  5848  4718 20e248                     JSR AES_SHIFTROWS
  5849  471b 203b49                     JSR AES_MIXCOLS
  5850                          
  5851  471e ad0851                     LDA AES_RNDCNT
  5852  4721 0a                         ASL
  5853  4722 0a                         ASL
  5854  4723 0a                         ASL
  5855  4724 0a                         ASL                     ; ronde x 16 = byte-offset in AES_RK
  5856  4725 8d0951                     STA AES_RNDOFF
  5857  4728 20bd48                     JSR AES_ARK
  5858                          
  5859  472b ee0851                     INC AES_RNDCNT
  5860  472e 4c0d47                     JMP AESB_RL
  5861                          
  5862                          AESB_FN ; round 10 - no MixColumns
  5863  4731 20d248                     JSR AES_SUBBYTES
  5864  4734 20e248                     JSR AES_SHIFTROWS
  5865  4737 adef4a                     LDA AES_NR              ; Nr*16 (160 / 224)
  5866  473a 0a                         ASL
  5867  473b 0a                         ASL
  5868  473c 0a                         ASL
  5869  473d 0a                         ASL
  5870  473e 8d0951                     STA AES_RNDOFF
  5871  4741 20bd48                     JSR AES_ARK
  5872                          
  5873                                  ; write result back to AES_BLOCK
  5874  4744 a20f                       LDX #15
  5875  4746 bd0350             AESB_CO LDA AES_STATE,X
  5876  4749 9df34f                     STA AES_BLOCK,X
  5877  474c ca                         DEX
  5878  474d 10f7                       BPL AESB_CO
  5879  474f 60                         RTS
  5880                          
  5881                          ; ================================================================
  5882                          ; AES-256: key schedule + GCM entries (from aes256test.asm,
  5883                          ;   byte-exact getoetst). AES_SETKEY->AES256_SETKEY hernoemd.
  5884                          ; ================================================================
  5885                          AES256_SETKEY
  5886  4750 a90e                       LDA #14            ; AES-256: 14 ronden
  5887  4752 8def4a                     STA AES_NR
  5888  4755 a21f                       LDX #31                 ; copy 32 key bytes to RK[0..31]
  5889  4757 bdcf4a             SK2_CP  LDA AES_KEY,X
  5890  475a 9d1350                     STA AES_RK,X
  5891  475d ca                         DEX
  5892  475e 10f7                       BPL SK2_CP
  5893                          
  5894  4760 a920                       LDA #32
  5895  4762 8d0351                     STA AES_WOFF            ; start W[8] (byte-offset 32)
  5896                          
  5897  4765 ad0351             SK2_LP  LDA AES_WOFF
  5898  4768 c9f0                       CMP #240
  5899  476a d003                       BNE SK2_CONT
  5900  476c 4c0148                     JMP SK2_DN
  5901                          SK2_CONT
  5902                                  ; --- load W[i-1] = AES_RK[woff-4 .. woff-1] into AES_T4 ---
  5903  476f ae0351                     LDX AES_WOFF
  5904  4772 bd0f50                     LDA AES_RK-4,X
  5905  4775 8d0451                     STA AES_T4+0
  5906  4778 bd1050                     LDA AES_RK-3,X
  5907  477b 8d0551                     STA AES_T4+1
  5908  477e bd1150                     LDA AES_RK-2,X
  5909  4781 8d0651                     STA AES_T4+2
  5910  4784 bd1250                     LDA AES_RK-1,X
  5911  4787 8d0751                     STA AES_T4+3
  5912                          
  5913                                  ; --- transform choice based on woff mod 32 ---
  5914  478a ad0351                     LDA AES_WOFF
  5915  478d 291f                       AND #$1F
  5916  478f f007                       BEQ SK2_FULL            ; mod 32 == 0
  5917  4791 c910                       CMP #16
  5918  4793 f036                       BEQ SK2_SUBONLY         ; mod 32 == 16
  5919  4795 4cce47                     JMP SK2_XOR             ; anders: temp = W[i-1] ongewijzigd
  5920                          
  5921                          SK2_FULL
  5922                                  ; RotWord: [a0,a1,a2,a3] -> [a1,a2,a3,a0]
  5923  4798 ad0451                     LDA AES_T4+0
  5924  479b 48                         PHA
  5925  479c ad0551                     LDA AES_T4+1
  5926  479f 8d0451                     STA AES_T4+0
  5927  47a2 ad0651                     LDA AES_T4+2
  5928  47a5 8d0551                     STA AES_T4+1
  5929  47a8 ad0751                     LDA AES_T4+3
  5930  47ab 8d0651                     STA AES_T4+2
  5931  47ae 68                         PLA
  5932  47af 8d0751                     STA AES_T4+3
  5933  47b2 200248                     JSR SK2_SUBWORD
  5934                                  ; XOR Rcon[woff/32 - 1]
  5935  47b5 ad0351                     LDA AES_WOFF
  5936  47b8 4a                         LSR
  5937  47b9 4a                         LSR
  5938  47ba 4a                         LSR
  5939  47bb 4a                         LSR
  5940  47bc 4a                         LSR                     ; / 32  -> 1..7
  5941  47bd aa                         TAX
  5942  47be ca                         DEX                     ; 0..6
  5943  47bf bd1851                     LDA AES_RCON,X
  5944  47c2 4d0451                     EOR AES_T4+0
  5945  47c5 8d0451                     STA AES_T4+0
  5946  47c8 4cce47                     JMP SK2_XOR
  5947                          
  5948                          SK2_SUBONLY
  5949  47cb 200248                     JSR SK2_SUBWORD
  5950                          
  5951                          SK2_XOR
  5952                                  ; W[i] = W[i-8] XOR temp ; W[i-8] = AES_RK[woff-32 .. woff-29]
  5953  47ce ae0351                     LDX AES_WOFF
  5954  47d1 ad0451                     LDA AES_T4+0
  5955  47d4 5df34f                     EOR AES_RK-32,X
  5956  47d7 9d1350                     STA AES_RK+0,X
  5957  47da ad0551                     LDA AES_T4+1
  5958  47dd 5df44f                     EOR AES_RK-31,X
  5959  47e0 9d1450                     STA AES_RK+1,X
  5960  47e3 ad0651                     LDA AES_T4+2
  5961  47e6 5df54f                     EOR AES_RK-30,X
  5962  47e9 9d1550                     STA AES_RK+2,X
  5963  47ec ad0751                     LDA AES_T4+3
  5964  47ef 5df64f                     EOR AES_RK-29,X
  5965  47f2 9d1650                     STA AES_RK+3,X
  5966                          
  5967  47f5 ad0351                     LDA AES_WOFF
  5968  47f8 18                         CLC
  5969  47f9 6904                       ADC #4
  5970  47fb 8d0351                     STA AES_WOFF
  5971  47fe 4c6547                     JMP SK2_LP
  5972                          
  5973  4801 60                 SK2_DN  RTS
  5974                          
  5975                          ; SubWord: replace each of 4 bytes via S-box
  5976                          SK2_SUBWORD
  5977  4802 ad0451                     LDA AES_T4+0
  5978  4805 aa                         TAX
  5979  4806 bd2251                     LDA AES_SBOX,X
  5980  4809 8d0451                     STA AES_T4+0
  5981  480c ad0551                     LDA AES_T4+1
  5982  480f aa                         TAX
  5983  4810 bd2251                     LDA AES_SBOX,X
  5984  4813 8d0551                     STA AES_T4+1
  5985  4816 ad0651                     LDA AES_T4+2
  5986  4819 aa                         TAX
  5987  481a bd2251                     LDA AES_SBOX,X
  5988  481d 8d0651                     STA AES_T4+2
  5989  4820 ad0751                     LDA AES_T4+3
  5990  4823 aa                         TAX
  5991  4824 bd2251                     LDA AES_SBOX,X
  5992  4827 8d0751                     STA AES_T4+3
  5993  482a 60                         RTS
  5994                          
  5995                          ; ================================================================
  5996                          ; AGE256 - AES-256-GCM encrypt (fixed nonce set by the caller)
  5997                          ;   in : AES_KEY[32], AES_NONCE[12], PTBUF, PTLEN(16b)
  5998                          ;   out: CTBUF[0..PTLEN-1], GCM_TAG[0..15]
  5999                          ; ================================================================
  6000                          AGE256
  6001  482b 205047                     JSR AES256_SETKEY
  6002  482e 203233                     JSR GCM_INIT                ; H + EK0 (uses AES_NONCE)
  6003  4831 a9f3                       LDA #<PTBUF
  6004  4833 8d2e52                     STA AES_CTR_IN+0
  6005  4836 a94a                       LDA #>PTBUF
  6006  4838 8d2f52                     STA AES_CTR_IN+1
  6007  483b a973                       LDA #<CTBUF
  6008  483d 8d3052                     STA AES_CTR_OUT+0
  6009  4840 a94d                       LDA #>CTBUF
  6010  4842 8d3152                     STA AES_CTR_OUT+1
  6011  4845 adf14a                     LDA PTLEN+0
  6012  4848 8d3252                     STA AES_CTR_LEN+0
  6013  484b adf24a                     LDA PTLEN+1
  6014  484e 8d3352                     STA AES_CTR_LEN+1
  6015  4851 20f449                     JSR AES_CTR_CRYPT
  6016  4854 a973                       LDA #<CTBUF
  6017  4856 8d3d52                     STA GCM_CT_PTR+0
  6018  4859 a94d                       LDA #>CTBUF
  6019  485b 8d3e52                     STA GCM_CT_PTR+1
  6020  485e adf14a                     LDA PTLEN+0
  6021  4861 8d3f52                     STA GCM_CT_LEN+0
  6022  4864 adf24a                     LDA PTLEN+1
  6023  4867 8d4052                     STA GCM_CT_LEN+1
  6024  486a 207433                     JSR GCM_AUTH                ; -> GCM_TAG
  6025  486d 60                         RTS
  6026                          
  6027                          ; ================================================================
  6028                          ; AGD256 - AES-256-GCM decrypt + tagverificatie
  6029                          ;   in : AES_KEY[32], AES_NONCE[12], CTBUF (received CT), PTLEN(16b),
  6030                          ;        GCM_RECV_TAG[16]
  6031                          ;   out: PTBUF (restored), GCM_TAG[16] (recomputed), VERIFY_FAIL (0=ok,1=error)
  6032                          ; ================================================================
  6033                          AGD256
  6034  486e 205047                     JSR AES256_SETKEY
  6035  4871 203233                     JSR GCM_INIT
  6036                                  ; tag over RECEIVED ciphertext (beforehand, CT is in CTBUF)
  6037  4874 a973                       LDA #<CTBUF
  6038  4876 8d3d52                     STA GCM_CT_PTR+0
  6039  4879 a94d                       LDA #>CTBUF
  6040  487b 8d3e52                     STA GCM_CT_PTR+1
  6041  487e adf14a                     LDA PTLEN+0
  6042  4881 8d3f52                     STA GCM_CT_LEN+0
  6043  4884 adf24a                     LDA PTLEN+1
  6044  4887 8d4052                     STA GCM_CT_LEN+1
  6045  488a 207433                     JSR GCM_AUTH                ; verwachte tag -> GCM_TAG
  6046  488d 208634                     JSR GCM_VERIFY              ; C=0 ok / C=1 error
  6047  4890 a900                       LDA #0
  6048  4892 9002                       BCC AGD_OK
  6049  4894 a901                       LDA #1
  6050  4896 8df04a             AGD_OK  STA VERIFY_FAIL
  6051                                  ; CTR-decrypt CTBUF -> PTBUF (symmetrisch)
  6052  4899 a973                       LDA #<CTBUF
  6053  489b 8d2e52                     STA AES_CTR_IN+0
  6054  489e a94d                       LDA #>CTBUF
  6055  48a0 8d2f52                     STA AES_CTR_IN+1
  6056  48a3 a9f3                       LDA #<PTBUF
  6057  48a5 8d3052                     STA AES_CTR_OUT+0
  6058  48a8 a94a                       LDA #>PTBUF
  6059  48aa 8d3152                     STA AES_CTR_OUT+1
  6060  48ad adf14a                     LDA PTLEN+0
  6061  48b0 8d3252                     STA AES_CTR_LEN+0
  6062  48b3 adf24a                     LDA PTLEN+1
  6063  48b6 8d3352                     STA AES_CTR_LEN+1
  6064  48b9 20f449                     JSR AES_CTR_CRYPT
  6065  48bc 60                         RTS
  6066                          
  6067                          
  6068                          ; ================================================================
  6069                          ; AES_ARK  -  AddRoundKey
  6070                          ;   state[i]  ^=  AES_RK[ AES_RNDOFF + i ]   for i = 0..15
  6071                          ;   Uses X as state index (0..15) and Y as key index.
  6072                          ; ================================================================
  6073                          AES_ARK
  6074  48bd a200                       LDX #0
  6075  48bf ac0951                     LDY AES_RNDOFF
  6076  48c2 bd0350             ARK_LP  LDA AES_STATE,X
  6077  48c5 591350                     EOR AES_RK,Y            ; AES_RK,Y  = absolute,Y  (NO zero-page)
  6078  48c8 9d0350                     STA AES_STATE,X
  6079  48cb e8                         INX
  6080  48cc c8                         INY
  6081  48cd e010                       CPX #16
  6082  48cf d0f1                       BNE ARK_LP
  6083  48d1 60                         RTS
  6084                          
  6085                          ; ================================================================
  6086                          ; AES_SUBBYTES  -  replace each state byte with its S-box value
  6087                          ;   Uses X as index (15..0) and Y as S-box index register.
  6088                          ; ================================================================
  6089                          AES_SUBBYTES
  6090  48d2 a20f                       LDX #15
  6091  48d4 bd0350             ASUB_LP LDA AES_STATE,X
  6092  48d7 a8                         TAY
  6093  48d8 b92251                     LDA AES_SBOX,Y          ; AES_SBOX,Y  = absolute,Y
  6094  48db 9d0350                     STA AES_STATE,X
  6095  48de ca                         DEX
  6096  48df 10f3                       BPL ASUB_LP
  6097  48e1 60                         RTS
  6098                          
  6099                          ; ================================================================
  6100                          ; AES_SHIFTROWS  -  rotate rows of the 4x4 state in-place
  6101                          ;
  6102                          ;   Column-major storage:  AES_STATE[c*4 + r]  =  s[r][c]
  6103                          ;   So the rows are at the following indices:
  6104                          ;     row 0  (idx  0,  4,  8, 12)  : shift 0 - unchanged
  6105                          ;     row 1  (idx  1,  5,  9, 13)  : rotate left 1
  6106                          ;     row 2  (idx  2,  6, 10, 14)  : rotate left 2 (= swap pairs)
  6107                          ;     row 3  (idx  3,  7, 11, 15)  : rotate left 3 (= rotate right 1)
  6108                          ; ================================================================
  6109                          AES_SHIFTROWS
  6110                                  ; -- Row 1: [s10,s11,s12,s13] -> [s11,s12,s13,s10] ------
  6111  48e2 ad0450                     LDA AES_STATE+1
  6112  48e5 48                         PHA                     ; save s10
  6113  48e6 ad0850                     LDA AES_STATE+5
  6114  48e9 8d0450                     STA AES_STATE+1
  6115  48ec ad0c50                     LDA AES_STATE+9
  6116  48ef 8d0850                     STA AES_STATE+5
  6117  48f2 ad1050                     LDA AES_STATE+13
  6118  48f5 8d0c50                     STA AES_STATE+9
  6119  48f8 68                         PLA
  6120  48f9 8d1050                     STA AES_STATE+13
  6121                          
  6122                                  ; -- Row 2: [s20,s21,s22,s23] -> [s22,s23,s20,s21] ------
  6123                                  ;           (swap diagonal pairs)
  6124  48fc ad0550                     LDA AES_STATE+2
  6125  48ff 8d0b51                     STA AES_TMP
  6126  4902 ad0d50                     LDA AES_STATE+10
  6127  4905 8d0550                     STA AES_STATE+2
