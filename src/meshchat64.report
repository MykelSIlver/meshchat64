  6984                          ; ================================================================
  6985                          ; TEST-WRAPPERS
  6986                          ; ================================================================
  6987                          ; T_PADD : load IN_P -> A-coords, IN_Q -> B-coords, POINT_ADD, R->OUT_P
  6988                          
  6989                          ; ================================================================
  6990                          ; ====================  Fp LAYER (from step 2)  ====================
  6991                          ; ================================================================
  6992                          MUL8
  6993                                  ; M-fix: quarter-square table mul (preserves Y, clobbers A,X)
  6994  7302 ad0588                     LDA MUL_A
  6995  7305 18                         CLC
