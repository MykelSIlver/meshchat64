; ******** Source: meshchat64.asm
 10028                          
 10029                          
 10030                          ; ================================================================
 10031                          ; WATCHDOG - connection self-heal (free RAM @ $B500)
 10032                          ; NET-ZERO: low segment byte-identical to A3BM1 (only JSR target
 10033                          ; changed at line 613). MRP_WD wraps MC_RECV_POLL.
 10034                          ; WD_ON only becomes 1 at the FIRST received frame (after connect);
 10035                          ; during login no frames arrive -> watchdog sleeps.
 10036                          ; Relay pings every ~20s; >~43s silence = dead -> MC_RECONNECT.
 10037                          ; ================================================================
 10038                          * = $B500
 10039  b500 0000               LAST_RX  !byte $00,$00
 10040  b502 00                 WD_ON    !byte $00            ; 0 = sleeps until first frame after connect
 10041                          MRP_WD
 10042  b503 ad9f6a                     LDA RING_TAIL
 10043  b506 cd9e6a                     CMP RING_HEAD
 10044  b509 f006                       BEQ MRPW_EMPTY          ; ring empty -> watchdog check
 10045  b50b 2015b5                     JSR WD_RESET            ; data in -> arm + counter reset
 10046  b50e 4caf29                     JMP MC_RECV_POLL        ; process frame (tail-call, X stays)
 10047                          MRPW_EMPTY
 10048  b511 2025b5                     JSR WD_CHECK
 10049  b514 60                         RTS
 10050                          WD_RESET
 10051  b515 a901                       LDA #1
 10052  b517 8d02b5                     STA WD_ON               ; arm bij eerste frame na connect
 10053  b51a a5a2                       LDA $A2
 10054  b51c 8d00b5                     STA LAST_RX+0
 10055  b51f a5a1                       LDA $A1
 10056  b521 8d01b5                     STA LAST_RX+1
 10057  b524 60                         RTS
 10058                          WD_CHECK
 10059  b525 ad02b5                     LDA WD_ON
 10060  b528 f00f                       BEQ WDC_OFF             ; no frame yet -> sleeps
 10061  b52a 38                         SEC
 10062  b52b a5a2                       LDA $A2
 10063  b52d ed00b5                     SBC LAST_RX+0
 10064  b530 a5a1                       LDA $A1
 10065  b532 ed01b5                     SBC LAST_RX+1
 10066  b535 c90a                       CMP #$0A                ; delta-high >= 10 -> ~43s
 10067  b537 b001                       BCS WDC_RECON
 10068  b539 60                 WDC_OFF RTS
 10069                          WDC_RECON
 10070                                  ; FIX (reconnect loop): re-arm the watchdog and take a FRESH
 10071                                  ; LAST_RX snapshot BEFORE redialing. Without this, WD_ON=1 stayed
 10072                                  ; with a stale LAST_RX, so WD_CHECK fired again right
 10073                                  ; after every successful reconnect -> endless
 10074                                  ; CONNECTING/CONNECTED loop (red border). WD_RESET sets WD_ON=1 and
 10075                                  ; LAST_RX=$A2/$A1 (now) -> fresh ~43s window after the (re)connect.
 10076  b53a 2015b5                     JSR WD_RESET
 10077  b53d 4c012b                     JMP MC_RECONNECT
 10078                          
 10079                          ; ================================================================
 10080                          ; PD_WRAP - keepalive-pong ingeweven in COMB_SCALAR_MUL (vrije RAM @ $B540)
 10081                          ; The comb loop (CB_LOOP) calls this 64x instead of POINT_DBL. On each
 10082                          ; iteration (~1-3s on a 1MHz C64) we send an UNSOLICITED empty
 10083                          ; masked WebSocket pong (8A 80 + key) so the relay keepalive does not
 10084                          ; expire during the long Ed25519 signing. RFC6455 explicitly allows
 10085                          ; unsolicited pongs as a heartbeat.
 10086                          ; Gated on WD_ON: only send when connected (at SIGN_SETUP during
 10087                          ; login WD_ON=0 -> no modem bytes before connect).
 10088                          ; ACIA_SEND preserves A/X/Y and touches NO signing zeropage; PD_WRAP does a
 10089                          ; tail-call (JMP) to POINT_DBL -> stack balanced and the scalar mult
 10090                          ; (and thus the signature) stays byte-identical.
 10091                          ; ================================================================
 10092                          * = $B540
 10093                          PD_WRAP
 10094  b540 ad02b5                     LDA WD_ON
 10095  b543 f01e                       BEQ PDW_GO              ; not connected -> skip pong
 10096  b545 a98a20bb24                 LDA #$8A : JSR ACIA_SEND   ; FIN + pong-opcode (0x0A)
 10097  b54a a98020bb24                 LDA #$80 : JSR ACIA_SEND   ; mask bit on, payload length 0
 10098  b54f a93720bb24                 LDA #$37 : JSR ACIA_SEND   ; masking key (same 4 bytes as WS_SEND)
 10099  b554 a9fa20bb24                 LDA #$FA : JSR ACIA_SEND
 10100  b559 a92120bb24                 LDA #$21 : JSR ACIA_SEND
 10101  b55e a93d20bb24                 LDA #$3D : JSR ACIA_SEND
 10102                          PDW_GO
 10103  b563 4cf76e                     JMP POINT_DBL           ; original comb step (tail-call)
 10104                          

; ******** Source: meshchat64_sendfix.inc
     1                          ; ================================================================
     2                          ; meshchat64_sendfix.inc  -  1 MHz send-timeout fix (briefing section 9)
     3                          ; ----------------------------------------------------------------
     4                          ; Combined, all net-zero (only existing JSR operands are redirected;
     5                          ; no inline bytes inserted in the main segment):
     6                          ;
     7                          ;   PART A  - weave unsolicited pongs through SIGN's SHA-512 / MODL gaps
     8                          ;             so the relay keepalive never expires during a 1 MHz sign.
     9                          ;   PART B  - pre-send liveness GATE: ping-probe the link right before
    10                          ;             the frame goes out; optional self-calibrating DCD fast
    11                          ;             path; if dead, SAVE the already-signed frame, reconnect,
    12                          ;             and AUTO-RESEND it (no re-sign, no silent loss).
    13                          ;
    14                          ; Redirects applied by patch_sendfix.py:
    15                          ;   JSR SHA_BLOCK            (SHA512 block loop)        -> PW_SHA   (A)
    16                          ;   ldx IOFF : jsr LDCELL    (MODL LOOP1)               -> PW_LDC   (A)
    17                          ;   JSR WS_SEND_EXT          (WS_SEND_MSG256 send site) -> MSG_SEND_GATE (B)
    18                          ;
    19                          ; Why safe mid-signature (briefing section 7): ACIA_SEND only polls TDRE
    20                          ; and writes $DE00 (no IRQ/NMI - SIGN disables those), preserves A/X/Y,
    21                          ; touches no signing zeropage. The pong/ping senders change only A, so X
    22                          ; (=IOFF for LDCELL) and Y survive -> no PHA/PLA, crypto bit-identical.
    23                          ; The liveness probe consumes NOTHING from the RX ring (it snapshots
    24                          ; RING_HEAD and watches it advance), so WS_RECV_FRAME stays in sync.
    25                          ;
    26                          ; Depends on existing labels: ACIA_SEND, WD_ON, SHA_BLOCK, LDCELL,
    27                          ;   WS_SEND_EXT, MC_CHAT_LOOP, PRINT_CHR, PRINT_STR_FB, RING_HEAD,
    28                          ;   JOUT_BUF, JOUT_LEN, ACIA_INIT, FPGA_SETTLE, MODEM_DIAL,
    29                          ;   WS_HANDSHAKE, INSTALL_RX_NMI, WS_AUTH_DISPATCH.
    30                          ;
    31                          ; ----------------------------------------------------------------
    32                          ; PLACEMENT  (confirmed against the current build, baseline md5
    33                          ;   f61567509681c4ba7d3a6eba419f8e35):
    34                          ;   watchdog $B500-$B53F, PD_WRAP $B540-$B565. This block sits at $B580
    35                          ;   (code ~$B580..$B6F0), then a 1280-byte frame-save buffer follows it
    36                          ;   (ends well below the $C000 SHA tables). All under the banked-out
    37                          ;   BASIC ROM where the watchdog/PD_WRAP already live. The patch appends
    38                          ;   the !source at END of meshchat64.asm so this absolute segment comes
    39                          ;   after the $B540 block and disturbs nothing.
    40                          ; ================================================================
    41                          
    42                          ; ---- build switches -------------------------------------------------
    43                          USE_DCD     = 1            ; 1 = self-calibrating DCD fast path in LINK_ALIVE
    44                                                    ;     (records $DE01 bit5 when known-alive; a later
    45                                                    ;      change => fast "dead". If the FPGA holds bit5
    46                                                    ;      constant it never triggers -> identical to the
    47                                                    ;      probe-only path. Set 0 if you see false drops.)
    48                          DCD_BIT     = $20         ; $DE01 bit to watch (real 6551: bit5 = /DCD carrier)
    49                          LA_TICKS    = 15          ; probe timeout = LA_TICKS x 20 ms (15 = ~300 ms)
    50                          
    51                          KSG_BASE    = $B580
    52                                  * = KSG_BASE
    53                          
    54                          ; ====================================================================
    55                          ; PART A  -  keepalive pongs through the signing gaps
    56                          ; ====================================================================
    57                          
    58                          ; ---- shared control-frame sender: A = opcode ($89 ping / $8A pong) --
    59                          ; emits opcode + $80 (mask-bit, len 0) + WS_MASK. clobbers A; keeps X,Y.
    60                          CTRL_TX
    61  b580 20bb24                     JSR ACIA_SEND               ; opcode (caller preloaded A)
    62  b583 a98020bb24                 LDA #$80 : JSR ACIA_SEND    ; mask-bit set, payload length 0
    63  b588 a93720bb24                 LDA #$37 : JSR ACIA_SEND    ; WS_MASK 0
    64  b58d a9fa20bb24                 LDA #$FA : JSR ACIA_SEND    ; WS_MASK 1
    65  b592 a92120bb24                 LDA #$21 : JSR ACIA_SEND    ; WS_MASK 2
    66  b597 a93d20bb24                 LDA #$3D : JSR ACIA_SEND    ; WS_MASK 3
    67  b59c 60                         RTS
    68                          
    69  b59d a98a4c80b5         PONG_TX LDA #$8A : JMP CTRL_TX      ; unsolicited pong (FIN+pong 0x0A)
    70  b5a2 a9894c80b5         PING_TX LDA #$89 : JMP CTRL_TX      ; ping (FIN+ping 0x09) -> relay pongs back
    71                          
    72                          ; ---- redirect of: JSR SHA_BLOCK (covers both SHA-512 phases) --------
    73                          PW_SHA
    74  b5a7 ad02b5                     LDA WD_ON
    75  b5aa f003                       BEQ PWS_GO
    76  b5ac 209db5                     JSR PONG_TX                 ; X/Y preserved; SHA_BLOCK needs neither
    77                          PWS_GO
    78  b5af 4caf7a                     JMP SHA_BLOCK               ; tail-call: its RTS returns to caller
    79                          
    80                          ; ---- redirect of: ldx IOFF : jsr LDCELL (MODL LOOP1, the bulk) ------
    81                          PW_LDC
    82  b5b2 ad02b5                     LDA WD_ON
    83  b5b5 f003                       BEQ PWL_GO
    84  b5b7 209db5                     JSR PONG_TX                 ; X (=IOFF) survives PONG_TX
    85                          PWL_GO
    86  b5ba 4c9983                     JMP LDCELL
    87                          
    88                          ; ====================================================================
    89                          ; PART B  -  pre-send liveness gate + auto-resend
    90                          ; ====================================================================
    91                          
    92                          ; ---- redirect of: JSR WS_SEND_EXT (WS_SEND_MSG256 send site) --------
    93                          MSG_SEND_GATE
    94  b5bd ad02b5                     LDA WD_ON
    95  b5c0 f00e                       BEQ MSG_SEND_NOW           ; pre-connect/not armed -> just send
    96  b5c2 20d3b5                     JSR LINK_ALIVE             ; C=0 alive, C=1 dead
    97  b5c5 9009                       BCC MSG_SEND_NOW           ; alive -> send the frame
    98                                  ; --- dead: keep the signed frame, warn, reconnect, resend ---
    99  b5c7 2028b6                     JSR SAVE_FRAME             ; JOUT_BUF/LEN -> SAVE_BUF/LEN
   100  b5ca 20a8b6                     JSR PRINT_LINKLOST
   101  b5cd 4c7bb6                     JMP RECON_RESEND
   102                          MSG_SEND_NOW
   103  b5d0 4c0730                     JMP WS_SEND_EXT            ; reads JOUT_BUF / JOUT_LEN
   104                          
   105                          ; ---- LINK_ALIVE : is the ws link still up? -------------------------
   106                          ; Optional DCD fast path, then a ping + ~300 ms ring-watch (consumes
   107                          ; nothing). Clock-independent (CIA2), same timer discipline as
   108                          ; RING_GET_TO. C=0 alive / C=1 dead.
   109                          LINK_ALIVE
   110                          !if USE_DCD = 1 {
   111  b5d3 adf0b6                     LDA DCD_VALID
   112  b5d6 f00c                       BEQ LA_PROBE               ; not calibrated yet -> probe & calibrate
   113  b5d8 ad01de                     LDA $DE01
   114  b5db 2920                       AND #DCD_BIT
   115  b5dd cdefb6                     CMP DCD_REF
   116  b5e0 f002                       BEQ LA_PROBE               ; carrier unchanged -> confirm via probe
   117  b5e2 38                         SEC                        ; carrier changed vs known-alive -> dead
   118  b5e3 60                         RTS
   119                          LA_PROBE
   120                          }
   121  b5e4 ad9e6a8dedb6               LDA RING_HEAD : STA LA_SNAP ; snapshot producer index
   122  b5ea a9892080b5                 LDA #$89 : JSR CTRL_TX     ; send ping (relay should pong)
   123  b5ef a90f8deeb6                 LDA #LA_TICKS : STA LA_RETRY
   124  b5f4 a9208d04dd         LA_ARM  LDA #$20 : STA $DD04       ; 20 ms = $4E20 cycles @1MHz (mirror ring)
   125  b5f9 a94e8d05dd                 LDA #$4E : STA $DD05
   126  b5fe a9198d0edd                 LDA #$19 : STA $DD0E       ; load latch + one-shot + start
   127  b603 ad9e6a             LA_W    LDA RING_HEAD
   128  b606 cdedb6                     CMP LA_SNAP
   129  b609 d00e                       BNE LA_ALIVE               ; head moved -> RX arrived -> alive
   130  b60b ad0ddd                     LDA $DD0D                  ; CIA2 ICR (clears flags; ISR never reads it)
   131  b60e 2901                       AND #$01                   ; Timer A underflow?
   132  b610 f0f1                       BEQ LA_W                   ; no -> keep waiting this 20 ms slot
   133  b612 ceeeb6                     DEC LA_RETRY
   134  b615 d0dd                       BNE LA_ARM                 ; more slots -> re-arm
   135  b617 38                         SEC                        ; out of slots, no RX -> dead
   136  b618 60                         RTS
   137                          LA_ALIVE
   138                          !if USE_DCD = 1 {
   139  b619 ad01de                     LDA $DE01                  ; calibrate: record alive carrier value
   140  b61c 2920                       AND #DCD_BIT
   141  b61e 8defb6                     STA DCD_REF
   142  b621 a9018df0b6                 LDA #1 : STA DCD_VALID
   143                          }
   144  b626 18                         CLC
   145  b627 60                         RTS
   146                          
   147                          ; ---- SAVE / RESTORE the already-built+signed outgoing frame --------
   148                          ; The frame survives reconnect in SAVE_BUF; WS_AUTH rebuilds JOUT_BUF
   149                          ; during re-auth, so we copy it out first and back in afterwards.
   150                          SAVE_FRAME
   151  b628 a98385fb                   LDA #<JOUT_BUF : STA $FB
   152  b62c a95585fc                   LDA #>JOUT_BUF : STA $FC
   153  b630 a9f385fd                   LDA #<SAVE_BUF : STA $FD
   154  b634 a9b685fe                   LDA #>SAVE_BUF : STA $FE
   155  b638 2068b6                     JSR CP1280
   156  b63b ad855a8df1b6               LDA JOUT_LEN+0 : STA SAVE_LEN+0
   157  b641 ad865a8df2b6               LDA JOUT_LEN+1 : STA SAVE_LEN+1
   158  b647 60                         RTS
   159                          RESTORE_FRAME
   160  b648 a9f385fb                   LDA #<SAVE_BUF : STA $FB
   161  b64c a9b685fc                   LDA #>SAVE_BUF : STA $FC
   162  b650 a98385fd                   LDA #<JOUT_BUF : STA $FD
   163  b654 a95585fe                   LDA #>JOUT_BUF : STA $FE
   164  b658 2068b6                     JSR CP1280
   165  b65b adf1b68d855a               LDA SAVE_LEN+0 : STA JOUT_LEN+0
   166  b661 adf2b68d865a               LDA SAVE_LEN+1 : STA JOUT_LEN+1
   167  b667 60                         RTS
   168                          ; copy 1280 bytes ($FB/$FC) -> ($FD/$FE) ; clobbers A,X,Y + the pointers
   169                          CP1280
   170  b668 a205                       LDX #5                     ; 5 x 256 = 1280 (= JOUT_BUF size, exact)
   171  b66a a000               CP_PG   LDY #0
   172  b66c b1fb               CP_BY   LDA ($FB),Y
   173  b66e 91fd                       STA ($FD),Y
   174  b670 c8                         INY
   175  b671 d0f9                       BNE CP_BY
   176  b673 e6fc                       INC $FC
   177  b675 e6fe                       INC $FE
   178  b677 ca                         DEX
   179  b678 d0f0                       BNE CP_PG
   180  b67a 60                         RTS
   181                          
   182                          ; ---- redial + re-auth, then restore the saved frame and resend -----
   183                          ; Mirrors MC_RECONNECT (no clear-screen) but resends the signed frame.
   184                          RECON_RESEND
   185  b67b a2ff9a                     LDX #$FF : TXS             ; reset stack (jump out of deep call stack)
   186  b67e a9008df0b6                 LDA #0 : STA DCD_VALID     ; recalibrate carrier after the new connect
   187  b683 a9028d20d0                 LDA #2 : STA $D020         ; red border during reconnect
   188  b688 207d24                     JSR ACIA_INIT
   189  b68b 20af24                     JSR FPGA_SETTLE
   190  b68e 20a425                     JSR MODEM_DIAL
   191  b691 200d26                     JSR WS_HANDSHAKE
   192  b694 204e25                     JSR INSTALL_RX_NMI
   193  b697 20f1a2                     JSR WS_AUTH_DISPATCH       ; (auth receives frames -> WD_ON back to 1)
   194  b69a 2048b6                     JSR RESTORE_FRAME          ; SAVE_BUF -> JOUT_BUF + JOUT_LEN
   195  b69d 200730                     JSR WS_SEND_EXT            ; resend the original signed frame
   196  b6a0 a9058d20d0                 LDA #5 : STA $D020
   197  b6a5 4cda0b                     JMP MC_CHAT_LOOP
   198                          
   199                          ; ---- clear, unmistakable "link lost" notice ------------------------
   200                          PRINT_LINKLOST
   201  b6a8 a90d20ba0c                 LDA #$0D : JSR PRINT_CHR
   202  b6ad a91c20ba0c                 LDA #$1C : JSR PRINT_CHR    ; red
   203  b6b2 a9c885fb                   LDA #<STR_LINKLOST : STA $FB
   204  b6b6 a9b685fc                   LDA #>STR_LINKLOST : STA $FC
   205  b6ba 20cf0c                     JSR PRINT_STR_FB
   206  b6bd a90d20ba0c                 LDA #$0D : JSR PRINT_CHR
   207  b6c2 a90520ba0c                 LDA #$05 : JSR PRINT_CHR    ; back to white
   208  b6c7 60                         RTS
   209                          
   210                          STR_LINKLOST
   211  b6c8 4c494e4b204c4f53...        !text "LINK LOST - RECONNECTING + RESENDING"
   212  b6ec 00                         !byte 0
   213                          
   214                          ; ---- free-RAM scratch + frame-save buffer --------------------------
   215  b6ed 00                 LA_SNAP   !byte 0
   216  b6ee 00                 LA_RETRY  !byte 0
   217  b6ef 00                 DCD_REF   !byte 0
   218  b6f0 00                 DCD_VALID !byte 0
   219  b6f1 0000               SAVE_LEN  !byte 0,0
   220                          SAVE_BUF  = *               ; 1280-byte hold buffer (not emitted; runtime RAM)
   221                                                      ; lives just above this code, below $C000.
   222                          
   223                          ; ====================================================================
   224                          ; OPTIONAL: hard-disable the DCD fast path by setting USE_DCD = 0 above.
   225                          ; It is self-calibrating, so it cannot cause a false "dead" UNLESS the
   226                          ; FPGA actually toggles $DE01 bit5 while the link is still up. If you
   227                          ; observe spurious reconnects right after a send, set USE_DCD = 0 and
   228                          ; the probe-only path remains as the safety net.
   229                          ; ====================================================================

; ******** Source: meshchat64.asm
 10105                          
