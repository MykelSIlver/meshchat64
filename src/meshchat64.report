  8647                          ; ACC (extended) -> PX/PY/PZ (for ENCODE)
  8648                          ACC_TO_PXYZ
  8649  865c a21f                       LDX #31
  8650  865e bddd8b9de08e       AP_L    LDA ACC_X,X : STA PX,X
  8651  8664 bdfd8b9d008f               LDA ACC_Y,X : STA PY,X
  8652  866a bd1d8c9d208f               LDA ACC_Z,X : STA PZ,X
  8653  8670 ca                         DEX
  8654  8671 10eb                       BPL AP_L
  8655  8673 60                         RTS
  8656                          
  8657                          ; ----------------------------------------------------------------
  8658                          ; SIGN_SETUP : SEED(32) -> SK_A (geklemde scalar a), SK_PREFIX, SK_PUB(A)
  8659                          ;   h = SHA512(seed) ; a = CLAMP(h[0:32]) ; prefix = h[32:64]
  8660                          ;   A = ENCODE(a*B)   (1 scalar mult, the expensive step)
  8661                          ; ----------------------------------------------------------------
  8662                          SIGN_SETUP
  8663  8674 08                         PHP
  8664  8675 78                         SEI         ; IRQ off during scalar mult
  8665                                  ; --- NMI sources OFF during scalar mult --------------------
  8666                                  ; SIGN_SETUP runs BEFORE INSTALL_RX_NMI; $0318 here still points
  8667                                  ; to the KERNAL default NMI handler, which on an ACIA-NMI does
  8668                                  ; RS232 processing and clobbers zeropage $F7-$FA (the scalar-mult
  8669                                  ; pointers). SEI does not mask NMI -> turn the sources off themselves.
  8670  8676 a90b8d02de                 LDA #$0B : STA $DE02        ; ACIA: RX-IRQ OFF
  8671  867b a97f8d0ddd                 LDA #$7F : STA $DD0D        ; CIA2: clear all NMI enables
  8672  8680 ad0ddd                     LDA $DD0D                   ; clear pending CIA2-NMI
  8673  8683 ad01de                     LDA $DE01                   ; ACIA-status lezen
  8674  8686 ad00de                     LDA $DE00                   ; ACIA-data lezen -> RDRF/NMI weg
  8675  8689 a98085f7                   LDA #<SEED : STA SRC
  8676  868d a99d85f8                   LDA #>SEED : STA SRC+1
  8677  8691 a9208df099                 LDA #32 : STA SHA5_MLEN
  8678  8696 a9008df199                 LDA #0  : STA SHA5_MLEN+1
  8679  869b 20297e                     JSR SHA512
  8680                                  ; a = CLAMP(h[0:32])
  8681  869e a21f                       LDX #31
  8682  86a0 bd30939d459bca10...SS_CA   LDA SHA_DIGEST,X : STA CLBUF,X : DEX : BPL SS_CA
  8683  86a9 202b86                     JSR CLAMP
  8684  86ac a21f                       LDX #31
  8685  86ae bd459b9da09d9ddd...SS_CB   LDA CLBUF,X : STA SK_A,X : STA SCALAR,X : DEX : BPL SS_CB
  8686                                  ; prefix = h[32:64]
  8687  86ba a21f                       LDX #31
  8688  86bc bd50939dc09dca10...SS_CP   LDA SHA_DIGEST+32,X : STA SK_PREFIX,X : DEX : BPL SS_CP
  8689                                  ; A = encode(a*B)
  8690  86c5 20d4a6                     JSR COMB_SCALAR_MUL     ; B: fixed-base comb (was LOAD_B+SCALAR_MUL)
  8691  86c8 205c86                     JSR ACC_TO_PXYZ
  8692  86cb 208078                     JSR ENCODE
  8693  86ce a21f                       LDX #31
  8694  86d0 bda08f9de09dca10...SS_CK   LDA ENC,X : STA SK_PUB,X : DEX : BPL SS_CK
  8695  86d9 a9098d02de                 LDA #$09 : STA $DE02        ; ACIA: RX-IRQ weer AAN
  8696  86de 28                         PLP         ; restore I flag
  8697  86df 60                         RTS
  8698                          
  8699                          ; ----------------------------------------------------------------
  8700                          ; SIGN : signs (MSG_PTR)[0..MSG_LEN-1] with cached SK_A/SK_PREFIX/SK_PUB
  8701                          ;   r = MODL(SHA512(prefix||M)) ; R = encode(r*B)
  8702                          ;   k = MODL(SHA512(R||A||M))   ; S = (r + k*a) mod L ; sig = R||S
  8703                          ; MSG_LEN is 16-bit (lo,hi); M up to 1280 bytes (wire blob ~1KB).
  8704                          ; M read via MSG_PTR; standalone test sets MSG_PTR = MSG_BUF.
  8705                          ; ----------------------------------------------------------------
  8706                          SIGN
  8707  86e0 08                         PHP
  8708  86e1 78                         SEI         ; IRQ off during scalar mult
  8709  86e2 207787                     JSR SIGN_R            ; -> SC_R = SCALAR = r ; CONCAT verbruikt
  8710                                  ; R = encode(r*B)
  8711  86e5 20d4a6                     JSR COMB_SCALAR_MUL     ; B: fixed-base comb (was LOAD_B+SCALAR_MUL)
  8712  86e8 205c86                     JSR ACC_TO_PXYZ
  8713  86eb 208078                     JSR ENCODE
  8714  86ee a21f                       LDX #31
  8715  86f0 bda08f9d409eca10...SG_RR   LDA ENC,X : STA SIG_R,X : DEX : BPL SG_RR
  8716                          
  8717                                  ; --- CONCAT = R(32) || A(32) || M ; len = 64+MSG_LEN ---
  8718  86f9 a21f                       LDX #31
  8719  86fb bd409e9d80c2       SG_P2   LDA SIG_R,X   : STA CONCAT,X
  8720  8701 bde09d9da0c2               LDA SK_PUB,X  : STA CONCAT+32,X
  8721  8707 ca10f1                     DEX : BPL SG_P2
  8722  870a a9c08504                   LDA #<(CONCAT+64) : STA CDST
  8723  870e a9c28505                   LDA #>(CONCAT+64) : STA CDST+1
  8724  8712 20c687                     JSR COPY_M
  8725                                  ; SHA5_MLEN = 64 + MSG_LEN (16-bit, with carry)
  8726  8715 ada29e1869408df0...        LDA MSG_LEN   : CLC : ADC #64 : STA SHA5_MLEN
  8727  871e ada39e69008df199           LDA MSG_LEN+1 : ADC #0        : STA SHA5_MLEN+1
  8728  8726 a98085f7                   LDA #<CONCAT : STA SRC
  8729  872a a9c285f8                   LDA #>CONCAT : STA SRC+1
  8730  872e 20297e                     JSR SHA512
  8731                                  ; k = MODL(digest)
  8732  8731 a23f                       LDX #63
  8733  8733 bd30939d859bca10...SG_X2   LDA SHA_DIGEST,X : STA XIN,X : DEX : BPL SG_X2
  8734  873c 20f77f                     JSR MODL
  8735  873f a21f                       LDX #31
  8736  8741 bdc59b9d209eca10...SG_K1   LDA ROUT,X : STA SC_K,X : DEX : BPL SG_K1
  8737                          
  8738                                  ; --- S = (r + k*a) mod L  via MULADD_S(RIN_S=r,KIN_S=k,AIN_S=a) ---
  8739  874a a21f                       LDX #31
  8740  874c bd009e9dc59a       SG_MS   LDA SC_R,X : STA RIN_S,X
  8741  8752 bd209e9de59a               LDA SC_K,X : STA KIN_S,X
  8742  8758 bda09d9d059b               LDA SK_A,X : STA AIN_S,X
  8743  875e ca10eb                     DEX : BPL SG_MS
  8744  8761 20d285                     JSR MULADD_S          ; -> SOUT = S
  8745                          
  8746                                  ; --- sig = R || S ---
  8747  8764 a21f                       LDX #31
  8748  8766 bd409e9d609e       SG_OUT  LDA SIG_R,X : STA SIG_OUT,X
  8749  876c bd259b9d809e               LDA SOUT,X  : STA SIG_OUT+32,X
  8750  8772 ca10f1                     DEX : BPL SG_OUT
  8751  8775 28                         PLP         ; restore I flag
  8752  8776 60                         RTS
  8753                          
  8754                          ; ----------------------------------------------------------------
  8755                          ; SIGN_R : phase 1 of SIGN + standalone debug entry.
  8756                          ;   CONCAT = prefix(32) || M ; r = MODL(SHA512(CONCAT)) -> SC_R + SCALAR
  8757                          ; No scalar mult -> fast; sim checks r cheaply over many lengths
  8758                          ; (same COPY_M + 16-bit SHA5_MLEN as phase 2, so a full proof).
  8759                          ; ----------------------------------------------------------------
  8760                          SIGN_R
  8761  8777 a21f                       LDX #31
  8762  8779 bdc09d9d80c2ca10...SG_P1   LDA SK_PREFIX,X : STA CONCAT,X : DEX : BPL SG_P1
  8763  8782 a9a08504                   LDA #<(CONCAT+32) : STA CDST
  8764  8786 a9c28505                   LDA #>(CONCAT+32) : STA CDST+1
  8765  878a 20c687                     JSR COPY_M
  8766                                  ; SHA5_MLEN = 32 + MSG_LEN (16-bit, with carry)
  8767  878d ada29e1869208df0...        LDA MSG_LEN   : CLC : ADC #32 : STA SHA5_MLEN
  8768  8796 ada39e69008df199           LDA MSG_LEN+1 : ADC #0        : STA SHA5_MLEN+1
  8769  879e a98085f7                   LDA #<CONCAT : STA SRC
  8770  87a2 a9c285f8                   LDA #>CONCAT : STA SRC+1
  8771  87a6 20297e                     JSR SHA512
  8772  87a9 a23f                       LDX #63
  8773  87ab bd30939d859bca10...SG_X1   LDA SHA_DIGEST,X : STA XIN,X : DEX : BPL SG_X1
  8774  87b4 20f77f                     JSR MODL
  8775  87b7 a21f                       LDX #31
  8776  87b9 bdc59b9d009e9ddd...SG_R1   LDA ROUT,X : STA SC_R,X : STA SCALAR,X : DEX : BPL SG_R1
  8777  87c5 60                         RTS
  8778                          
  8779                          ; ----------------------------------------------------------------
  8780                          ; COPY_M : copy (MSG_PTR)[0..MSG_LEN-1] (16-bit) to (CDST).
  8781                          ;   CDST/CDST+1 set beforehand. Clobbers A,Y,CSRC,CDST,CCNT.
  8782                          ;   16-bit down-counter: lo==0 -> hi-- ; then lo-- (wrap 0->FF).
  8783                          ; ----------------------------------------------------------------
  8784                          COPY_M
  8785  87c6 ada09e8502                 LDA MSG_PTR   : STA CSRC
  8786  87cb ada19e8503                 LDA MSG_PTR+1 : STA CSRC+1
  8787  87d0 ada29e8da49e               LDA MSG_LEN   : STA CCNT
  8788  87d6 ada39e8da59e               LDA MSG_LEN+1 : STA CCNT+1
  8789  87dc a000                       LDY #0
  8790  87de ada49e0da59ef01e   CM_LP   LDA CCNT : ORA CCNT+1 : BEQ CM_DN
  8791  87e6 b1029104                   LDA (CSRC),Y : STA (CDST),Y
  8792  87ea e602d002e603               INC CSRC : BNE CM_S1 : INC CSRC+1
  8793  87f0 e604d002e605       CM_S1   INC CDST : BNE CM_S2 : INC CDST+1
  8794  87f6 ada49ed003cea59e   CM_S2   LDA CCNT : BNE CM_D1 : DEC CCNT+1
  8795  87fe cea49e             CM_D1   DEC CCNT
  8796  8801 4cde87                     JMP CM_LP
  8797  8804 60                 CM_DN   RTS
  8798                          
  8799                          
