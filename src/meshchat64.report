     2                          ; karatsuba.inc - one-level Karatsuba 256-bit multiply (test placement $A900)
     3                          ;   FP_MUL_KARA : (FRP) = (FAP)*(FBP) mod p
     4                          ;   a = a1:a0, b = b1:b0 (16-byte halves).
     5                          ;   z0 = a0*b0 -> PROD[0:32] ; z2 = a1*b1 -> PROD[32:64]
     6                          ;   sa=a0+a1 (ca), sb=b0+b1 (cb) ; zm = sa*sb (+carry terms) ; z1 = zm-z0-z2
     7                          ;   P = z0 + z1<<128 + z2<<256 ; then FP_REDUCE.
     8                          ;   3x (16x16) = 768 mul8 vs 1024 schoolbook.
