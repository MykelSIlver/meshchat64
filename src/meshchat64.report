  7892                          ; --- set PB = SHA5_W + A*8 ; set PA = SHA5_W + A*8 ---
  7893  7d7f 8db399             SET_PB_W STA SHA_TMPI           ; A = word index (0..79)
  7894  7d82 a900                       LDA #0
  7895  7d84 8db499                     STA SHA_TMPH
  7896  7d87 0eb399                     ASL SHA_TMPI            ; index*8 as 16-bit (else overflow at index>=32)
  7897  7d8a 2eb499                     ROL SHA_TMPH
  7898  7d8d 0eb399                     ASL SHA_TMPI
  7899  7d90 2eb499                     ROL SHA_TMPH
  7900  7d93 0eb399                     ASL SHA_TMPI
  7901  7d96 2eb499                     ROL SHA_TMPH
  7902  7d99 a900                       LDA #<SHA5_W
  7903  7d9b 18                         CLC
  7904  7d9c 6db399                     ADC SHA_TMPI
  7905  7d9f 85fd                       STA PB
  7906  7da1 a9c0                       LDA #>SHA5_W
  7907  7da3 6db499                     ADC SHA_TMPH
  7908  7da6 85fe                       STA PB+1
  7909  7da8 60                         RTS
  7910  7da9 8db399             SET_PA_W STA SHA_TMPI           ; A = word index (0..79)
  7911  7dac a900                       LDA #0
  7912  7dae 8db499                     STA SHA_TMPH
  7913  7db1 0eb399                     ASL SHA_TMPI
  7914  7db4 2eb499                     ROL SHA_TMPH
  7915  7db7 0eb399                     ASL SHA_TMPI
  7916  7dba 2eb499                     ROL SHA_TMPH
  7917  7dbd 0eb399                     ASL SHA_TMPI
  7918  7dc0 2eb499                     ROL SHA_TMPH
