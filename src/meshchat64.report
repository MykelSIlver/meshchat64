  6662                          ; ED25519 SIGN CORE  (from signtest.asm; SHA_K/W/MLEN -> SHA5_*)
  6663                          ; ================================================================
  6664                          ; ================================================================
  6665                          ; ed25519test.asm  -  Edwards25519 point arithmetic (step 3 Ed25519 path)
  6666                          ; ----------------------------------------------------------------
  6667                          ; Builds on the verified Fp layer (mod p = 2^255-19) from step 2.
  6668                          ; Punt = extended twisted Edwards coords (X:Y:Z:T), a = -1.
  6669                          ;   x = X/Z , y = Y/Z , T = X*Y/Z .
  6670                          ; Elk coord = 32 bytes little-endian, canoniek in [0,p).
  6671                          ;
  6672                          ;   POINT_ADD  : (PR) = (PA) + (PB)        (HWCD add-2008-hwcd-3, a=-1)
  6673                          ;   POINT_DBL  : (PR) = 2*(PA)             (dbl-2008-hwcd, a=-1)
  6674                          ;   SCALAR_MUL : (PACC) = SCALAR * (PIN)   (double-and-add, MSB->LSB, 256 bits)
  6675                          ;
  6676                          ; A point lives in a 128-byte block: X(32) Y(32) Z(32) T(32).
  6677                          ; Pointers to such a block: PAP/PBP/PRP (24-bit not needed; coords lie
  6678                          ; contiguous, so block base + offset 0/32/64/96).
  6679                          ;
  6680                          ; Test wrappers (fixed blocks IN_P / IN_Q -> OUT_P, and SCALAR buffer):
  6681                          ;   T_PADD T_PDBL T_SMUL
  6682                          ; Getoetst byte-exact in py65 tegen ref_ed.py (Python).
  6683                          ; ================================================================
  6684                          
  6685                          ; --- zeropage pointers (Fp layer) ---
  6686                          FAP = $FB       ; arg A pointer (reused in FP_MUL as PROD pointer)
  6687                          FBP = $FD       ; arg B pointer
  6688                          FRP = $F7       ; result pointer
  6689                          ; SHA-512 zeropage aliases (same addresses; SHA and Fp never run at once)
  6690                          PA  = $FB
  6691                          PB  = $FD
  6692                          SRC = $F7
  6693                          BP  = $F9
  6694                          ; --- COPY_M (16-bit message copy) zeropage; $02-$05 free in this module ---
  6695                          ; Runs fully to completion before each SHA512 call, so no aliasing with SRC/PA/PB.
  6696                          CSRC = $02      ; copy source pointer
  6697                          CDST = $04      ; copy destination pointer
  6698                          
  6699                          
  6700                          ; ================================================================
  6701                          ; MACROS - call the Fp layer with absolute buffer labels
  6702                          ; ================================================================
  6703                          !macro fmul .r, .a, .b {
  6704                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6705                                  lda #<.b : sta FBP : lda #>.b : sta FBP+1
  6706                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6707                                  jsr FP_MUL_KARA
  6708                          }
  6709                          !macro fsq .r, .a {
  6710                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6711                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6712                                  jsr FP_SQ
  6713                          }
  6714                          !macro fadd .r, .a, .b {
  6715                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6716                                  lda #<.b : sta FBP : lda #>.b : sta FBP+1
  6717                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6718                                  jsr FP_ADD
  6719                          }
  6720                          !macro fsub .r, .a, .b {
  6721                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6722                                  lda #<.b : sta FBP : lda #>.b : sta FBP+1
  6723                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6724                                  jsr FP_SUB
  6725                          }
  6726                          ; copy 32-byte field .src -> .dst
  6727                          !macro fcopy .dst, .src {
  6728                                  ldx #31
  6729                          .cl     lda .src,x
  6730                                  sta .dst,x
  6731                                  dex
  6732                                  bpl .cl
  6733                          }
  6734                          ; --- Fp macros for FP_INV (from fp25519test) ---
  6735                          !macro mul .r, .a, .b {
  6736                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6737                                  lda #<.b : sta FBP : lda #>.b : sta FBP+1
  6738                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6739                                  jsr FP_MUL_KARA
  6740                          }
  6741                          !macro sq .r, .a {
  6742                                  lda #<.a : sta FAP : lda #>.a : sta FAP+1
  6743                                  lda #<.r : sta FRP : lda #>.r : sta FRP+1
  6744                                  jsr FP_SQ
  6745                          }
  6746                          !macro sqn .buf, .n {
  6747                                  lda #<.buf : sta SQ_PTR : lda #>.buf : sta SQ_PTR+1
  6748                                  lda #.n    : sta SQN_CNT
  6749                                  jsr SQN
  6750                          }
  6751                          
  6752                          ; ================================================================
  6753                          ; POINT_ADD : (PR) = (PA) + (PB)
  6754                          ; PA = block at PA_X (X,Y,Z,T), same for PB, result PR.
  6755                          ; Fixed work blocks here: input in A-coords / B-coords; out in R-coords.
  6756                          ; We use named buffers (no indirect block pointers) to keep the
  6757                          ; formula readable; SCALAR_MUL copies in/out of these buffers.
  6758                          ;   A = (Y1-X1)*(Y2-X2)
  6759                          ;   B = (Y1+X1)*(Y2+X2)
  6760                          ;   C = T1 * (2d) * T2
  6761                          ;   D = Z1 * 2 * Z2
  6762                          ;   E = B-A ; F = D-C ; G = D+C ; H = B+A
  6763                          ;   X3=E*F ; Y3=G*H ; T3=E*H ; Z3=F*G
  6764                          ; ================================================================
  6765                          PA_X = AX
  6766                          PA_Y = AY
  6767                          PA_Z = AZ
  6768                          PA_T = AT
  6769                          PB_X = BX_
  6770                          PB_Y = BY_
  6771                          PB_Z = BZ_
  6772                          PB_T = BT_
  6773                          PR_X = RX
  6774                          PR_Y = RY
  6775                          PR_Z = RZ
  6776                          PR_T = RT
  6777                          
  6778                          POINT_ADD
  6779                                  ; tmpA = (Y1-X1)*(Y2-X2)
  6780  6d10 a9e785fba98885fc...        +fsub PT1, PA_Y, PA_X      ; PT1 = Y1-X1
  6781  6d2b a96785fba98985fc...        +fsub PT2, PB_Y, PB_X      ; PT2 = Y2-X2
  6782  6d46 a94785fba98b85fc...        +fmul PvA, PT1, PT2        ; A
  6783                                  ; tmpB = (Y1+X1)*(Y2+X2)
  6784  6d61 a9e785fba98885fc...        +fadd PT1, PA_Y, PA_X      ; PT1 = Y1+X1
  6785  6d7c a96785fba98985fc...        +fadd PT2, PB_Y, PB_X      ; PT2 = Y2+X2
  6786  6d97 a94785fba98b85fc...        +fmul PvB, PT1, PT2        ; B
  6787                                  ; C = T1 * 2d * T2  -> PT1 = T1*2d ; C = PT1*T2
  6788  6db2 a92785fba98985fc...        +fmul PT1, PA_T, D2_CONST  ; T1*2d
  6789  6dcd a94785fba98b85fc...        +fmul PvC, PT1, PB_T       ; C
  6790                                  ; D = Z1 * 2 * Z2 -> PT1 = Z1*Z2 ; D = PT1*2  (2 as field constant)
  6791  6de8 a90785fba98985fc...        +fmul PT1, PA_Z, PB_Z      ; Z1*Z2
  6792  6e03 a94785fba98b85fc...        +fadd PvD, PT1, PT1        ; D = 2*Z1*Z2
  6793                                  ; E=B-A ; H=B+A ; F=D-C ; G=D+C
  6794  6e1e a96785fba98a85fc...        +fsub PvE, PvB, PvA
  6795  6e39 a96785fba98a85fc...        +fadd PvH, PvB, PvA
  6796  6e54 a9a785fba98a85fc...        +fsub PvF, PvD, PvC
  6797  6e6f a9a785fba98a85fc...        +fadd PvG, PvD, PvC
  6798                                  ; X3=E*F ; Y3=G*H ; T3=E*H ; Z3=F*G
  6799  6e8a a9c785fba98a85fc...        +fmul PR_X, PvE, PvF
  6800  6ea5 a90785fba98b85fc...        +fmul PR_Y, PvG, PvH
  6801  6ec0 a9c785fba98a85fc...        +fmul PR_T, PvE, PvH
  6802  6edb a9e785fba98a85fc...        +fmul PR_Z, PvF, PvG
  6803  6ef6 60                         RTS
  6804                          
  6805                          ; ================================================================
  6806                          ; POINT_DBL : (PR) = 2*(PA)
  6807                          ;   A = X1^2 ; B = Y1^2 ; C = 2*Z1^2 ; D = -A
  6808                          ;   E = (X1+Y1)^2 - A - B
  6809                          ;   G = D+B ; F = G-C ; H = D-B
  6810                          ;   X3=E*F ; Y3=G*H ; T3=E*H ; Z3=F*G
  6811                          ; ================================================================
  6812                          POINT_DBL
  6813  6ef7 a9c785fba98885fc...        +fsq  PvA, PA_X            ; A = X1^2
  6814  6f0a a9e785fba98885fc...        +fsq  PvB, PA_Y            ; B = Y1^2
  6815                                  ; C = 2*Z1^2 -> PT1=Z1^2 ; C=PT1+PT1
  6816  6f1d a90785fba98985fc...        +fsq  PT1, PA_Z
  6817  6f30 a94785fba98b85fc...        +fadd PvC, PT1, PT1
  6818                                  ; D = -A = 0 - A
  6819  6f4b a9a785fba98c85fc...        +fsub PvD, ZERO_CONST, PvA
  6820                                  ; E = (X1+Y1)^2 - A - B
  6821  6f66 a9c785fba98885fc...        +fadd PT1, PA_X, PA_Y      ; X1+Y1
  6822  6f81 a94785fba98b85fc...        +fsq  PT2, PT1             ; (X1+Y1)^2
  6823  6f94 a96785fba98b85fc...        +fsub PT1, PT2, PvA        ; -A
  6824  6faf a94785fba98b85fc...        +fsub PvE, PT1, PvB        ; -B  -> E
  6825                                  ; G=D+B ; F=G-C ; H=D-B
  6826  6fca a9a785fba98a85fc...        +fadd PvG, PvD, PvB
  6827  6fe5 a90785fba98b85fc...        +fsub PvF, PvG, PvC
  6828  7000 a9a785fba98a85fc...        +fsub PvH, PvD, PvB
  6829                                  ; X3=E*F ; Y3=G*H ; T3=E*H ; Z3=F*G
  6830  701b a9c785fba98a85fc...        +fmul PR_X, PvE, PvF
  6831  7036 a90785fba98b85fc...        +fmul PR_Y, PvG, PvH
  6832  7051 a9c785fba98a85fc...        +fmul PR_T, PvE, PvH
  6833  706c a9e785fba98a85fc...        +fmul PR_Z, PvF, PvG
  6834  7087 60                         RTS
  6835                          
  6836                          ; ================================================================
  6837                          ; SCALAR_MUL : ACC = SCALAR * PIN  (256-bit, MSB->LSB double-and-add)
  6838                          ; SCALAR = 32 bytes little-endian in SCALAR-buffer.
  6839                          ; PIN    = invoerpunt in PIN_X/Y/Z/T (extended coords).
  6840                          ; ACC    = accumulator in ACC_X/Y/Z/T.
  6841                          ; Method per bit (from bit 255 down to 0):
  6842                          ;   ACC = 2*ACC                 (POINT_DBL: A=ACC -> R=ACC)
  6843                          ;   if bit: ACC = ACC + PIN     (POINT_ADD: A=ACC, B=PIN -> R=ACC)
  6844                          ; ACC starts as the neutral element (0,1,1,0).
  6845                          ; ================================================================

