  7722  7bb6 a900                       LDA #<SHA5_K
  7723  7bb8 8d0b9a                     STA SHA_KP
  7724  7bbb a990                       LDA #>SHA5_K
  7725  7bbd 8d0c9a                     STA SHA_KP+1
  7726  7bc0 a900                       LDA #<SHA5_W
  7727  7bc2 8d0d9a                     STA SHA_WP
  7728  7bc5 a9c0                       LDA #>SHA5_W
  7729  7bc7 8d0e9a                     STA SHA_WP+1
  7730                          SB_RND
  7731                                  ; T1 = h
  7732  7bca a900                       LDA #<SHA_T1
  7733  7bcc 85fb                       STA PA
  7734  7bce a993                       LDA #>SHA_T1
  7735  7bd0 85fc                       STA PA+1
  7736  7bd2 a9f8                       LDA #<(SHA_AH+56)         ; h = word 7
  7737  7bd4 85fd                       STA PB
  7738  7bd6 a992                       LDA #>(SHA_AH+56)
  7739  7bd8 85fe                       STA PB+1
  7740  7bda 20f378                     JSR C64COPY
  7741                                  ; SHA_ACC = BIGSIG1(e)  (e = word 4)
  7742  7bdd a9e0                       LDA #<(SHA_AH+32)
  7743  7bdf 85fd                       STA PB
  7744  7be1 a992                       LDA #>(SHA_AH+32)
  7745  7be3 85fe                       STA PB+1
  7746  7be5 202e7a                     JSR BIGSIG1
  7747                                  ; T1 += SHA_ACC
  7748  7be8 a928                       LDA #<SHA_ACC
  7749  7bea 85fd                       STA PB
  7750  7bec a993                       LDA #>SHA_ACC
  7751  7bee 85fe                       STA PB+1
  7752  7bf0 20ff78                     JSR C64ADD
  7753                                  ; SHA_ACC = Ch(e,f,g) = (e&f) ^ (~e & g)
  7754  7bf3 200d7d                     JSR CH_EFG
  7755                                  ; T1 += SHA_ACC
  7756  7bf6 a928                       LDA #<SHA_ACC
  7757  7bf8 85fd                       STA PB
  7758  7bfa a993                       LDA #>SHA_ACC
  7759  7bfc 85fe                       STA PB+1
  7760  7bfe 20ff78                     JSR C64ADD
  7761                                  ; T1 += K[i]   (SHA_KP)
  7762  7c01 ad0b9a                     LDA SHA_KP
  7763  7c04 85fd                       STA PB
  7764  7c06 ad0c9a                     LDA SHA_KP+1
  7765  7c09 85fe                       STA PB+1
  7766  7c0b 20ff78                     JSR C64ADD
  7767                                  ; T1 += W[i]   (SHA_WP)
  7768  7c0e ad0d9a                     LDA SHA_WP
  7769  7c11 85fd                       STA PB
  7770  7c13 ad0e9a                     LDA SHA_WP+1
  7771  7c16 85fe                       STA PB+1
  7772  7c18 20ff78                     JSR C64ADD
  7773                                  ; T2 = BIGSIG0(a) + Maj(a,b,c)
  7774  7c1b a9c0                       LDA #<(SHA_AH+0)          ; a = word 0
  7775  7c1d 85fd                       STA PB
  7776  7c1f a992                       LDA #>(SHA_AH+0)
  7777  7c21 85fe                       STA PB+1
  7778  7c23 20037a                     JSR BIGSIG0
  7779                                  ; T2 = SHA_ACC
  7780  7c26 a908                       LDA #<SHA_T2
  7781  7c28 85fb                       STA PA
  7782  7c2a a993                       LDA #>SHA_T2
  7783  7c2c 85fc                       STA PA+1
  7784  7c2e a928                       LDA #<SHA_ACC
  7785  7c30 85fd                       STA PB
  7786  7c32 a993                       LDA #>SHA_ACC
  7787  7c34 85fe                       STA PB+1
  7788  7c36 20f378                     JSR C64COPY
  7789                                  ; SHA_ACC = Maj(a,b,c)
  7790  7c39 203a7d                     JSR MAJ_ABC
  7791                                  ; T2 += SHA_ACC
  7792  7c3c a908                       LDA #<SHA_T2
  7793  7c3e 85fb                       STA PA
  7794  7c40 a993                       LDA #>SHA_T2
  7795  7c42 85fc                       STA PA+1
  7796  7c44 a928                       LDA #<SHA_ACC
  7797  7c46 85fd                       STA PB
  7798  7c48 a993                       LDA #>SHA_ACC
  7799  7c4a 85fe                       STA PB+1
  7800  7c4c 20ff78                     JSR C64ADD
