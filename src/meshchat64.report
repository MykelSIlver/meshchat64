  7871  7d5b a207               CP_W1_W2 LDX #7
  7872  7d5d bd7292             C12     LDA SHA_AH+8,X
  7873  7d60 9d7a92                     STA SHA_AH+16,X
  7874  7d63 ca                         DEX
