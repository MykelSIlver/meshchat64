  9512  a2c5 ad5d40                     LDA B64D_V0
  9513  a2c8 0a                         ASL
  9514  a2c9 0a                         ASL
  9515  a2ca 8d6140                     STA B64D_T
  9516  a2cd ad5e40                     LDA B64D_V1
  9517  a2d0 4a                         LSR
  9518  a2d1 4a                         LSR
  9519  a2d2 4a                         LSR
  9520  a2d3 4a                         LSR
  9521  a2d4 0d6140                     ORA B64D_T
  9522  a2d7 8d5e39                     STA KEY_PEER256+30
  9523                                  ; byte31 = V1<<4 | V2>>2
  9524  a2da ad5e40                     LDA B64D_V1
  9525  a2dd 0a                         ASL
  9526  a2de 0a                         ASL
  9527  a2df 0a                         ASL
  9528  a2e0 0a                         ASL
  9529  a2e1 8d6140                     STA B64D_T
  9530  a2e4 ad5f40                     LDA B64D_V2
  9531  a2e7 4a                         LSR
  9532  a2e8 4a                         LSR
  9533  a2e9 0d6140                     ORA B64D_T
  9534  a2ec 8d5f39                     STA KEY_PEER256+31
  9535  a2ef 18                         CLC
  9536  a2f0 60                         RTS
