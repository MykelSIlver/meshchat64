  6253                          ; AES-128 CTR-MODUS
  6254                          ; ================================================================
  6255                          ; AES_CTR_CRYPT  -  AES-128 CTR-modus  (encrypt = decrypt)
  6256                          ;
  6257                          ; Input (set before JSR AES_CTR_CRYPT):
  6258                          ;   AES_NONCE+0..+11   12-byte nonce
  6259                          ;   AES_CTR_IN+0/+1    lo/hi address of source buffer (plaintext or ciphertext)
  6260                          ;   AES_CTR_OUT+0/+1   lo/hi address of destination buffer
  6261                          ;   AES_CTR_LEN        message length 1..255 bytes
  6262                          ;   AES_RK already filled via JSR AES_SETKEY
  6263                          ;
  6264                          ; Output: destination buffer filled with (de)crypted result
  6265                          ; CTR is symmetrisch: encrypt = decrypt
  6266                          ;
  6267                          ; Counter: big-endian 32-bit, starts $00000002 (GCM-compatible)
  6268                          ; Implementation: self-modifying LDA/STA abs,Y (no zero-page)
  6269                          ; AES_CTR_REM guards termination (no BOFF overflow at 241..255 bytes)
  6270                          ; ================================================================
  6271                          AES_CTR_CRYPT
  6272                                  ; -- patch source/dest base address in self-modifying abs,Y --
  6273  49f4 ad2e52                     LDA AES_CTR_IN+0
  6274  49f7 8d7d4a                     STA ACTR_SRC+1
  6275  49fa ad2f52                     LDA AES_CTR_IN+1
  6276  49fd 8d7e4a                     STA ACTR_SRC+2
  6277  4a00 ad3052                     LDA AES_CTR_OUT+0
  6278  4a03 8d834a                     STA ACTR_DST+1
  6279  4a06 ad3152                     LDA AES_CTR_OUT+1
  6280  4a09 8d844a                     STA ACTR_DST+2
  6281  4a0c a900                       LDA #$00
  6282  4a0e 8d3452                     STA AES_CTR_CNT+0
  6283  4a11 8d3552                     STA AES_CTR_CNT+1
  6284  4a14 8d3652                     STA AES_CTR_CNT+2
  6285  4a17 a902                       LDA #$02
  6286  4a19 8d3752                     STA AES_CTR_CNT+3
  6287  4a1c ad3252                     LDA AES_CTR_LEN+0
  6288  4a1f 8d3852                     STA AES_CTR_REM+0
  6289  4a22 ad3352                     LDA AES_CTR_LEN+1
  6290  4a25 8d3952                     STA AES_CTR_REM+1
  6291                          ACTR_BLK
  6292  4a28 ad3852                     LDA AES_CTR_REM+0
  6293  4a2b 0d3952                     ORA AES_CTR_REM+1
  6294  4a2e d003                       BNE ACTR_BC
  6295  4a30 4cce4a                     JMP ACTR_DN
  6296                          ACTR_BC
  6297  4a33 a20b                       LDX #11
  6298  4a35 bd2252             ACTR_NC LDA AES_NONCE,X
  6299  4a38 9df34f                     STA AES_BLOCK,X
  6300  4a3b ca                         DEX
  6301  4a3c 10f7                       BPL ACTR_NC
