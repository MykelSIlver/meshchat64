  7278                          ; --- byte right rotation of SHA_TA by SHA_BK bytes (LE: out[i]=in[(i+k)&7]) ---
  7279  78ec a200               BROT_TA LDX #0
  7280  78ee 8a                 BR_L    TXA
  7281  78ef 18                         CLC
  7282  78f0 6dab99                     ADC SHA_BK
  7283  78f3 2907                       AND #7
  7284  78f5 a8                         TAY
  7285  78f6 b9ba92                     LDA SHA_TA,Y
  7286  78f9 9dc292                     STA SHA_TB,X
  7287  78fc e8                         INX
  7288  78fd e008                       CPX #8
  7289  78ff d0ed                       BNE BR_L
  7290  7901 a207                       LDX #7                  ; SHA_TB -> SHA_TA
  7291  7903 bdc292             BR_C    LDA SHA_TB,X
  7292  7906 9dba92                     STA SHA_TA,X
  7293  7909 ca                         DEX
  7294  790a 10f7                       BPL BR_C
  7295  790c 60                         RTS
  7296                          
  7297                          ; --- ROTR_TA: rotate SHA_TA right by SHA_N bits ---
  7298  790d adaa99             ROTR_TA LDA SHA_N
  7299  7910 4a                         LSR
  7300  7911 4a                         LSR
  7301  7912 4a                         LSR                     ; A = SHA_N>>3 = bytes
  7302  7913 8dab99                     STA SHA_BK
  7303  7916 20ec78                     JSR BROT_TA
  7304  7919 adaa99                     LDA SHA_N
  7305  791c 2907                       AND #7
  7306  791e 8dac99                     STA SHA_BC              ; remaining bits
  7307  7921 adac99             RT_BL   LDA SHA_BC
  7308  7924 f009                       BEQ RT_DN
  7309  7926 20d578                     JSR ROR1_TA
  7310  7929 ceac99                     DEC SHA_BC
  7311  792c 4c2179                     JMP RT_BL
  7312  792f 60                 RT_DN   RTS
  7313                          
  7314                          ; --- SHR_TA: shift SHA_TA right by SHA_N bits (fills high with 0) ---
  7315  7930 adaa99             SHR_TA  LDA SHA_N
  7316  7933 4a                         LSR
  7317  7934 4a                         LSR
  7318  7935 4a                         LSR
  7319  7936 8dab99                     STA SHA_BK              ; bytes
  7320  7939 f033                       BEQ SH_BIT
  7321                                  ; byte shift right (LE: out[i]=in[i+k] or 0): do k times a 1-byte shift
  7322  793b a200               SH_BYL  LDX #0
  7323  793d e007               SH_BY1  CPX #7
  7324  793f f003                       BEQ SH_BYT
  7325  7941 bcbb92                     LDY SHA_TA+1,X          ; placeholder (see below) -- replaced
  7326  7944 ea                 SH_BYT  NOP
  7327                                  ; (simplified: byte shift via loop below)
  7328  7945 4c4879                     JMP SH_BYDONE
  7329                          SH_BYDONE
  7330                                  ; simple byte shift: move elements down k times
  7331  7948 adab99                     LDA SHA_BK
  7332  794b 8dad99                     STA SHA_BC2
  7333  794e adad99             SH_KL   LDA SHA_BC2
  7334  7951 f01b                       BEQ SH_BIT
  7335  7953 a200                       LDX #0
  7336  7955 e007               SH_SL   CPX #7
  7337  7957 f00a                       BEQ SH_SLT
  7338  7959 bdbb92                     LDA SHA_TA+1,X
  7339  795c 9dba92                     STA SHA_TA,X
  7340  795f e8                         INX
  7341  7960 4c5579                     JMP SH_SL
  7342  7963 a900               SH_SLT  LDA #0
  7343  7965 8dc192                     STA SHA_TA+7
  7344  7968 cead99                     DEC SHA_BC2
  7345  796b 4c4e79                     JMP SH_KL
  7346  796e adaa99             SH_BIT  LDA SHA_N
  7347  7971 2907                       AND #7
  7348  7973 8dac99                     STA SHA_BC
  7349  7976 adac99             SH_BBL  LDA SHA_BC
  7350  7979 f009                       BEQ SH_DN
  7351  797b 20e278                     JSR SHR1_TA
  7352  797e ceac99                     DEC SHA_BC
  7353  7981 4c7679                     JMP SH_BBL
  7354  7984 60                 SH_DN   RTS
