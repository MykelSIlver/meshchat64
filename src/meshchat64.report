  4899                          ; ================================================================
  4900                          ; WS_SEND_EXT  -  send WebSocket text frame (supports >125 bytes)
  4901                          ; ================================================================
  4902                          ; Input  : JOUT_BUF = payload, JOUT_LEN[0..1] = payload length
  4903                          ; Protocol: FIN=1, opcode=text(1); masking always on
  4904                          ;   <= 125 bytes : 1-byte length
  4905                          ;  126..65535 bytes : length byte $7E + 2-byte big-endian length
  4906                          ; Masking key: WS_MASK ($37,$FA,$21,$3D) - fixed for simplicity
  4907                          ; Pointer $FD/$FE used as read zero-page pointer
  4908                          ; ================================================================
  4909                          WS_SEND_EXT
  4910                                  ; FIN + text opcode
  4911  3007 a981                       LDA #$81
  4912  3009 20bb24                     JSR ACIA_SEND
  4913                          
  4914                                  ; determine length encoding
  4915  300c ad865a                     LDA JOUT_LEN+1
  4916  300f d00f                       BNE WSX_EXT             ; hi-byte != 0 -> zeker >= 256 > 125
  4917  3011 ad855a                     LDA JOUT_LEN+0
  4918  3014 c97e                       CMP #126
  4919  3016 b008                       BCS WSX_EXT             ; >= 126 -> extended 2-byte length
  4920                                  ; direct 7-bit length + mask bit ($80)
  4921  3018 0980                       ORA #$80
  4922  301a 20bb24                     JSR ACIA_SEND
  4923  301d 4c3130                     JMP WSX_MASK
  4924                          
  4925                          WSX_EXT ; length byte $7E (126) with mask bit = $FE
  4926  3020 a9fe                       LDA #$FE
  4927  3022 20bb24                     JSR ACIA_SEND
  4928  3025 ad865a                     LDA JOUT_LEN+1          ; big-endian high byte
  4929  3028 20bb24                     JSR ACIA_SEND
  4930  302b ad855a                     LDA JOUT_LEN+0          ; big-endian low byte
  4931  302e 20bb24                     JSR ACIA_SEND
  4932                          
  4933                          WSX_MASK
  4934                                  ; send fixed 4-byte masking key
  4935  3031 a937                       LDA #$37
  4936  3033 20bb24                     JSR ACIA_SEND
  4937  3036 a9fa                       LDA #$FA
  4938  3038 20bb24                     JSR ACIA_SEND
  4939  303b a921                       LDA #$21
  4940  303d 20bb24                     JSR ACIA_SEND
  4941  3040 a93d                       LDA #$3D
  4942  3042 20bb24                     JSR ACIA_SEND
  4943                          
  4944                                  ; set read pointer via zero-page $FD/$FE
  4945  3045 a983                       LDA #<JOUT_BUF
  4946  3047 85fd                       STA $FD
  4947  3049 a955                       LDA #>JOUT_BUF
  4948  304b 85fe                       STA $FE
  4949                          
  4950                                  ; resterende bytes = JOUT_LEN
  4951  304d ad855a                     LDA JOUT_LEN+0
  4952  3050 8dae6b                     STA WSX_REM+0
  4953  3053 ad865a                     LDA JOUT_LEN+1
  4954  3056 8daf6b                     STA WSX_REM+1
  4955                          
  4956                                  ; mask-byte-index: 0..3 (cyclisch)
  4957  3059 a900                       LDA #0
  4958  305b 8db06b                     STA WSX_MIDX
  4959                          
  4960  305e adae6b             WSX_LP  LDA WSX_REM+0
  4961  3061 0daf6b                     ORA WSX_REM+1
  4962  3064 f02c                       BEQ WSX_DN              ; done when REM = 0
  4963                          
  4964                                  ; read payload byte via zeropage pointer
  4965  3066 a000                       LDY #0
  4966  3068 b1fd                       LDA ($FD),Y
  4967                          
  4968                                  ; XOR with masking byte (WSX_MIDX mod 4)
  4969  306a aeb06b                     LDX WSX_MIDX
  4970  306d 5d7926                     EOR WS_MASK,X
  4971  3070 20bb24                     JSR ACIA_SEND
  4972                          
  4973                                  ; advance read pointer
  4974  3073 e6fd                       INC $FD
  4975  3075 d002                       BNE WSX_NP
  4976  3077 e6fe                       INC $FE
  4977                          WSX_NP
  4978                          
  4979                                  ; cyclisch masking-index (0->1->2->3->0)
  4980  3079 eeb06b                     INC WSX_MIDX
  4981  307c adb06b                     LDA WSX_MIDX
  4982  307f 2903                       AND #$03
  4983  3081 8db06b                     STA WSX_MIDX
  4984                          
  4985                                  ; decrement 16-bit counter
  4986  3084 adae6b                     LDA WSX_REM+0
  4987  3087 d003                       BNE WSX_DCL
  4988  3089 ceaf6b                     DEC WSX_REM+1
  4989  308c ceae6b             WSX_DCL DEC WSX_REM+0
  4990  308f 4c5e30                     JMP WSX_LP
  4991                          
  4992  3092 60                 WSX_DN  RTS
  4993                          
  4994                          ; ================================================================
  4995                          ; WS_AUTH - challenge-response authentication with server.py (HEAD)
  4996                          ;  1) send {"type":"sig:auth_init","bits":128,"enc_key":[..16..]}
  4997                          ;  2) wait for sig:auth_challenge {"iv":[12],"data":[48]}
  4998                          ;  3) GCM-decrypt with KEY_SELF -> 32-byte nonce in GCM_CTBUF
  4999                          ;  4) send {"type":"sig:auth_proof","nonce":[..32..]}
  5000                          ;  5) wait for sig:auth_ok -> C=0; auth_fail/timeout -> C=1
  5001                          ; Requires: INSTALL_RX_NMI already active (steps 2/5 receive frames).
  5002                          ; ================================================================
  5003                          ; ================================================================
  5004                          ; 128-bit WS_AUTH + WS_SEND_MSG REMOVED (AES128 cleanup).
  5005                          ; USE_256 is always 1, so these paths were unreachable. Safe
  5006                          ; stubs keep the dispatcher JMPs (WAD_128/WSD_128) valid and route
  5007                          ; to the 256-bit routines. The SHARED GCM/GHASH core after this
  5008                          ; (GCM_INIT etc.) stays fully intact and is pinned at its original
  5009                          ; address, so all live code stays byte-identical.
  5010                          ; ================================================================
  5011                          WS_AUTH
  5012  3093 4ca69e                     JMP WS_AUTH256
  5013                          WS_SEND_MSG
  5014  3096 4cb9a0                     JMP WS_SEND_MSG256
  5015                          * = $3332                       ; pin: GCM_INIT at original address
  5016                          ; ================================================================
  5017                          ; GCM_INIT -- compute hash subkey H and tag encryption block EK0
  5018                          ; ================================================================
  5019                          ; Input  : AES_RK filled, AES_NONCE[0..11] set
  5020                          ; Output: GCM_H[0..15], GCM_EK0[0..15]
  5021                          ; Clobbers: AES_BLOCK, AES_STATE (via AES_ENCRYPT_BLOCK)
  5022                          ; ================================================================
  5023                          GCM_INIT
  5024                          
  5025                                  ; H = AES_ENCRYPT(key, 0^16)
  5026  3332 a20f                       LDX #15
  5027  3334 a900                       LDA #$00
  5028  3336 9df34f             GCI_ZB  STA AES_BLOCK,X         ; clear input block
  5029  3339 ca                         DEX
  5030  333a 10fa                       BPL GCI_ZB
  5031  333c 20f546                     JSR AES_ENCRYPT_BLOCK
  5032  333f a20f                       LDX #15
  5033  3341 bdf34f             GCI_CH  LDA AES_BLOCK,X
  5034  3344 9d4152                     STA GCM_H,X
  5035  3347 ca                         DEX
  5036  3348 10f7                       BPL GCI_CH
  5037                          
  5038                                  ; EK0 = AES_ENCRYPT(key, nonce || $00000001)
  5039                                  ; This is GCM J0: counter = 1, reserved for tag masking
  5040                                  ; AES_CTR_CRYPT starts at $00000002 (counter 2+) -> spec-compliant ?
  5041  334a a20b                       LDX #11
  5042  334c bd2252             GCI_CN  LDA AES_NONCE,X
  5043  334f 9df34f                     STA AES_BLOCK,X
  5044  3352 ca                         DEX
  5045  3353 10f7                       BPL GCI_CN
  5046  3355 a900                       LDA #$00
  5047  3357 8dff4f                     STA AES_BLOCK+12
  5048  335a 8d0050                     STA AES_BLOCK+13
  5049  335d 8d0150                     STA AES_BLOCK+14
  5050  3360 a901                       LDA #$01
  5051  3362 8d0250                     STA AES_BLOCK+15
  5052  3365 20f546                     JSR AES_ENCRYPT_BLOCK
  5053  3368 a20f                       LDX #15
  5054  336a bdf34f             GCI_CE  LDA AES_BLOCK,X
  5055  336d 9d5152                     STA GCM_EK0,X
  5056  3370 ca                         DEX
  5057  3371 10f7                       BPL GCI_CE
  5058  3373 60                         RTS
  5059                          
  5060                          ; ================================================================
  5061                          ; GCM_AUTH -- compute authentication tag
  5062                          ; ================================================================
  5063                          ; Input  : GCM_CT_PTR[0/1] lo/hi address of ciphertext
  5064                          ;          GCM_CT_LEN       length of ciphertext 1..255 bytes
  5065                          ;          GCM_H, GCM_EK0 already computed via GCM_INIT
  5066                          ; Output: GCM_TAG[0..15]
  5067                          ;
  5068                          ; GHASH algorithm (empty AAD):
  5069                          ;   Y = 0
  5070                          ;   for each 16-byte CT block C_i (zero-pad the last):
  5071                          ;       Y = GF_MUL(Y XOR C_i, H)
  5072                          ;   length block = 0^8 || big-endian64(CT_LEN*8)
  5073                          ;   Y = GF_MUL(Y XOR length block, H)
  5074                          ;   TAG = Y XOR EK0
  5075                          ;
  5076                          ; Self-modifying: GCAS_SRC+1/+2 patched with GCM_CT_PTR
  5077                          ; ================================================================
  5078                          GCM_AUTH
  5079                          
  5080  3374 a20f                       LDX #15
  5081  3376 a900                       LDA #$00
  5082  3378 9d8252             GCA_ZY  STA GCM_Y,X
  5083  337b ca                         DEX
  5084  337c 10fa                       BPL GCA_ZY
  5085  337e ad3d52                     LDA GCM_CT_PTR+0
  5086  3381 8dcf33                     STA GCAS_SRC+1
  5087  3384 ad3e52                     LDA GCM_CT_PTR+1
  5088  3387 8dd033                     STA GCAS_SRC+2
  5089  338a ad3f52                     LDA GCM_CT_LEN+0
  5090  338d 8da252                     STA GCM_BREM+0
  5091  3390 ad4052                     LDA GCM_CT_LEN+1
  5092  3393 8da352                     STA GCM_BREM+1
  5093                          GCA_BLK
  5094  3396 ada252                     LDA GCM_BREM+0
  5095  3399 0da352                     ORA GCM_BREM+1
  5096  339c d003                       BNE GCA_BC
  5097  339e 4c0d34                     JMP GCA_LEND
  5098                          GCA_BC
  5099  33a1 ada352                     LDA GCM_BREM+1
  5100  33a4 d00d                       BNE GCA_F16
  5101  33a6 ada252                     LDA GCM_BREM+0
  5102  33a9 c910                       CMP #16
  5103  33ab b006                       BCS GCA_F16
  5104  33ad 8da752                     STA GCM_GBSIZ
  5105  33b0 4cb833                     JMP GCA_ZBUF
  5106  33b3 a910               GCA_F16 LDA #16
  5107  33b5 8da752                     STA GCM_GBSIZ
  5108                          GCA_ZBUF
  5109  33b8 a20f                       LDX #15
  5110  33ba a900                       LDA #$00
  5111  33bc 9d9252             GCA_ZB  STA GCM_BLK,X
  5112  33bf ca                         DEX
  5113  33c0 10fa                       BPL GCA_ZB
  5114  33c2 a200                       LDX #0
  5115  33c4 eca752             GCA_CPL CPX GCM_GBSIZ
  5116  33c7 d003                       BNE GCA_CPC
  5117  33c9 4cd833                     JMP GCA_CPD
  5118                          GCA_CPC
  5119  33cc 8a                         TXA
  5120  33cd a8                         TAY
  5121  33ce b93412             GCAS_SRC LDA $1234,Y
  5122  33d1 9d9252                     STA GCM_BLK,X
  5123  33d4 e8                         INX
  5124  33d5 4cc433                     JMP GCA_CPL
  5125                          GCA_CPD
  5126  33d8 a20f                       LDX #15
  5127  33da bd8252             GCA_XY  LDA GCM_Y,X
  5128  33dd 5d9252                     EOR GCM_BLK,X
  5129  33e0 9d8252                     STA GCM_Y,X
  5130  33e3 ca                         DEX
  5131  33e4 10f4                       BPL GCA_XY
  5132  33e6 206134                     JSR GCA_MUL
  5133  33e9 adcf33                     LDA GCAS_SRC+1
  5134  33ec 18                         CLC
  5135  33ed 6da752                     ADC GCM_GBSIZ
  5136  33f0 8dcf33                     STA GCAS_SRC+1
  5137  33f3 9003                       BCC GCA_NB
  5138  33f5 eed033                     INC GCAS_SRC+2
  5139                          GCA_NB
  5140  33f8 ada252                     LDA GCM_BREM+0
  5141  33fb 38                         SEC
  5142  33fc eda752                     SBC GCM_GBSIZ
  5143  33ff 8da252                     STA GCM_BREM+0
  5144  3402 ada352                     LDA GCM_BREM+1
  5145  3405 e900                       SBC #0
  5146  3407 8da352                     STA GCM_BREM+1
  5147  340a 4c9633                     JMP GCA_BLK
  5148                          GCA_LEND
  5149  340d a20f                       LDX #15
  5150  340f a900                       LDA #$00
  5151  3411 9d9252             GCA_ZL  STA GCM_BLK,X
  5152  3414 ca                         DEX
  5153  3415 10fa                       BPL GCA_ZL
  5154  3417 ad3f52                     LDA GCM_CT_LEN+0
  5155  341a 8da452                     STA GCA_LB0
  5156  341d ad4052                     LDA GCM_CT_LEN+1
  5157  3420 8da552                     STA GCA_LB1
  5158  3423 0ea452                     ASL GCA_LB0
  5159  3426 2ea552                     ROL GCA_LB1
  5160  3429 0ea452                     ASL GCA_LB0
  5161  342c 2ea552                     ROL GCA_LB1
  5162  342f 0ea452                     ASL GCA_LB0
  5163  3432 2ea552                     ROL GCA_LB1
  5164  3435 ada552                     LDA GCA_LB1
  5165  3438 8da052                     STA GCM_BLK+14
  5166  343b ada452                     LDA GCA_LB0
  5167  343e 8da152                     STA GCM_BLK+15
  5168  3441 a20f                       LDX #15
  5169  3443 bd8252             GCA_XL  LDA GCM_Y,X
  5170  3446 5d9252                     EOR GCM_BLK,X
  5171  3449 9d8252                     STA GCM_Y,X
  5172  344c ca                         DEX
  5173  344d 10f4                       BPL GCA_XL
  5174  344f 206134                     JSR GCA_MUL
  5175  3452 a20f                       LDX #15
  5176  3454 bd8252             GCA_TG  LDA GCM_Y,X
  5177  3457 5d5152                     EOR GCM_EK0,X
  5178  345a 9d6152                     STA GCM_TAG,X
  5179  345d ca                         DEX
  5180  345e 10f4                       BPL GCA_TG
  5181  3460 60                         RTS
  5182                          
  5183                          ; ---- hulp: Y -> GCM_GX, H -> GCM_GY, GF_MUL, GCM_GZ -> Y -------
  5184                          GCA_MUL
  5185  3461 a20f                       LDX #15
  5186  3463 bd8252             GCA_MX  LDA GCM_Y,X
  5187  3466 9da952                     STA GCM_GX,X
  5188  3469 ca                         DEX
  5189  346a 10f7                       BPL GCA_MX
  5190  346c a20f                       LDX #15
  5191  346e bd4152             GCA_MY  LDA GCM_H,X
  5192  3471 9db952                     STA GCM_GY,X
  5193  3474 ca                         DEX
  5194  3475 10f7                       BPL GCA_MY
  5195  3477 209734                     JSR GCM_GFMUL
  5196  347a a20f                       LDX #15
  5197  347c bdc952             GCA_MR  LDA GCM_GZ,X
  5198  347f 9d8252                     STA GCM_Y,X
  5199  3482 ca                         DEX
  5200  3483 10f7                       BPL GCA_MR
  5201  3485 60                         RTS
  5202                          
  5203                          ; ================================================================
  5204                          ; GCM_VERIFY -- compare GCM_TAG with GCM_RECV_TAG
  5205                          ; ================================================================
  5206                          ; Output: C=0 tag valid / C=1 tag invalid
  5207                          ; ================================================================
  5208                          GCM_VERIFY
  5209  3486 a20f                       LDX #15
  5210  3488 bd6152             GCV_LP  LDA GCM_TAG,X
  5211  348b dd7152                     CMP GCM_RECV_TAG,X
  5212  348e d005                       BNE GCV_FAIL
  5213  3490 ca                         DEX
  5214  3491 10f5                       BPL GCV_LP
  5215  3493 18                         CLC
  5216  3494 60                         RTS
  5217                          GCV_FAIL
  5218  3495 38                         SEC
  5219  3496 60                         RTS
  5220                          
  5221                          ; ================================================================
  5222                          ; GCM_GFMUL -- vermenigvuldiging in GF(2^128)
  5223                          ; ================================================================
  5224                          ; Input  : GCM_GX[0..15], GCM_GY[0..15]  (16 bytes, big-endian)
  5225                          ; Output: GCM_GZ[0..15] = GCM_GX * GCM_GY mod p
  5226                          ;
  5227                          ; Methode: MSB-first shift-and-XOR (128 iteraties)
  5228                          ;   Z = 0 ; V = X
  5229                          ;   for bit i of Y (MSB -> LSB, from byte 0 to byte 15):
  5230                          ;     if bit i = 1: Z ^= V
  5231                          ;     old_lsb = bit 0 of V[15]
  5232                          ;     V >>= 1  (shift right, big-endian, bit 127 becomes 0)
  5233                          ;     if old_lsb = 1: V[0] ^= $E1   (reduction mod p)
  5234                          ;
  5235                          ; Reductiepolynoom: x^128 + x^7 + x^2 + x + 1
  5236                          ; Reductieconstante: R = $E1 00 00 ... 00  (MSB-first, byte 0)
  5237                          ;   because x^128 = x^7 + x^2 + x + 1 -> lowest bits = 1110 0001 = $E1
  5238                          ;
  5239                          ; Backward branch GFM_BLOOP: ~82 bytes -- within 127-byte limit ?
  5240                          ; ================================================================
  5241                          GCM_GFMUL
  5242                          
  5243                                  ; Z = 0
  5244  3497 a20f                       LDX #15
  5245  3499 a900                       LDA #$00
  5246  349b 9dc952             GFM_CZ  STA GCM_GZ,X
  5247  349e ca                         DEX
  5248  349f 10fa                       BPL GFM_CZ
  5249                          
  5250                                  ; V = X
  5251  34a1 a20f                       LDX #15
  5252  34a3 bda952             GFM_CV  LDA GCM_GX,X
  5253  34a6 9dd952                     STA GCM_VBUF,X
  5254  34a9 ca                         DEX
  5255  34aa 10f7                       BPL GFM_CV
  5256                          
  5257  34ac a900                       LDA #0
  5258  34ae 8dea52                     STA GCM_GYCNT           ; Y byte index: 0..15
  5259                          
  5260                          ; ---- outer loop: per byte of Y (MSB first) ----------------
  5261                          GFM_YLOOP
  5262  34b1 adea52                     LDA GCM_GYCNT
  5263  34b4 c910                       CMP #16
  5264  34b6 d003                       BNE GFM_YC
  5265  34b8 4c1f35                     JMP GFM_DONE
  5266  34bb aa                 GFM_YC  TAX
  5267  34bc bdb952                     LDA GCM_GY,X            ; load current Y-byte
  5268  34bf 8dec52                     STA GCM_GYBYTE
  5269  34c2 a908                       LDA #8
  5270  34c4 8deb52                     STA GCM_GBIT            ; counts down 8->1
  5271                          
  5272                          ; ---- inner loop: per bit of Y-byte (MSB first via ASL) ----
  5273                          ; Bewezen backward-branch afstand ? 82 bytes (< 127 limiet):
  5274                          ;   GFM_BLOOP t/m DEC GCM_GBIT = 80 bytes; BNE offset = -82
  5275                          GFM_BLOOP
  5276  34c7 0eec52                     ASL GCM_GYBYTE          ; MSB to carry; byte shifts left
  5277  34ca 9003                       BCC GFM_NOZ
  5278  34cc 202035                     JSR GFM_ZXV             ; Z ^= V  (carry=1 -> bit was 1)
  5279                          GFM_NOZ
  5280                                  ; save LSB of V (bit 0 of byte 15) for shift
  5281  34cf ade852                     LDA GCM_VBUF+15
  5282  34d2 2901                       AND #$01
  5283  34d4 8de952                     STA GCM_GLSB
  5284                          
  5285                                  ; V >>= 1  (shift right: LSR byte[0], then ROR through)
  5286  34d7 4ed952                     LSR GCM_VBUF+0
  5287  34da 6eda52                     ROR GCM_VBUF+1
  5288  34dd 6edb52                     ROR GCM_VBUF+2
  5289  34e0 6edc52                     ROR GCM_VBUF+3
  5290  34e3 6edd52                     ROR GCM_VBUF+4
  5291  34e6 6ede52                     ROR GCM_VBUF+5
  5292  34e9 6edf52                     ROR GCM_VBUF+6
