  9495                                  ; last 3 chars (index 40/41/42) -> bytes 30,31
  9496  a29b adf542                     LDA INP_BUF+40
  9497  a29e 20880b                     JSR B64D_CHAR
  9498  a2a1 9003                       BCC *+5
  9499  a2a3 4c860b                     JMP B64D_ERR
  9500  a2a6 8d5d40                     STA B64D_V0
  9501  a2a9 adf642                     LDA INP_BUF+41
  9502  a2ac 20880b                     JSR B64D_CHAR
  9503  a2af 9003                       BCC *+5
  9504  a2b1 4c860b                     JMP B64D_ERR
  9505  a2b4 8d5e40                     STA B64D_V1
  9506  a2b7 adf742                     LDA INP_BUF+42
  9507  a2ba 20880b                     JSR B64D_CHAR
  9508  a2bd 9003                       BCC *+5
