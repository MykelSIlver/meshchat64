   306                          ; ================================================================
   307                          ; MC_CHAT_LOOP - main chat loop
   308                          ; ================================================================
   309                          MC_CHAT_LOOP
   310                          MCL_TOP
   311                                  ; show "NAME> " prompt
   312  0bda a91e                       LDA #$1E        ; green
   313  0bdc 20ba0c                     JSR PRINT_CHR
   314  0bdf a200                       LDX #0
   315  0be1 bd9541             MCL_NM  LDA KDFIN_NAME,X
   316  0be4 f006                       BEQ MCL_NME
   317  0be6 20ba0c                     JSR PRINT_CHR
   318  0be9 e8                         INX
   319  0bea d0f5                       BNE MCL_NM
   320                          MCL_NME
   321  0bec a9ca                       LDA #<STR_PFX
   322  0bee 85fb                       STA $FB
   323  0bf0 a942                       LDA #>STR_PFX
   324  0bf2 85fc                       STA $FC
   325  0bf4 20cf0c                     JSR PRINT_STR_FB
   326  0bf7 a905                       LDA #$05        ; White
   327  0bf9 20ba0c                     JSR PRINT_CHR
   328                          
   329                                  ; read message (INPUT_LINE converts PETSCII->ASCII: item 10A)
   330  0bfc 20140c                     JSR INPUT_LINE
   331                          
   332                                  ; skip empty line
   333  0bff adcd43                     LDA INP_LEN
   334  0c02 f0d6                       BEQ MCL_TOP
   335                          
   336                                  ; new line after message
   337  0c04 a90d                       LDA #$0D
   338  0c06 20ba0c                     JSR PRINT_CHR
   339                          
   340                                  ; encrypt and send via WebSocket (AES-128-GCM)
   341  0c09 20fca2                     JSR WS_SEND_DISPATCH
   342  0c0c a901                       LDA #1
   343  0c0e 8d20d0                     STA $D020           ; white = send done
   344                          
   345  0c11 4cda0b                     JMP MCL_TOP
   346                          
   347                          INPUT_LINE
   348  0c14 a200                       LDX #0
   349  0c16 8a                 IL_LOOP TXA
   350  0c17 48                         PHA             ; save X on stack
   351  0c18 20e4ff                     JSR $FFE4       ; A = toets, X/Y geclobberd
   352  0c1b a8                         TAY             ; save char in Y
   353  0c1c 68                         PLA             ; restore X from stack
   354  0c1d aa                         TAX
   355  0c1e 98                         TYA             ; A = char back
   356  0c1f d006                       BNE IL_GOTKEY
   357  0c21 2003b5                     JSR MRP_WD          ; net-zero wrapper: poll + watchdog
   358  0c24 4c160c                     JMP IL_LOOP
   359                          IL_GOTKEY
   360  0c27 c90d                       CMP #$0D
   361  0c29 f022                       BEQ IL_DONE
   362  0c2b c914                       CMP #$14
   363  0c2d f011                       BEQ IL_DEL
   364  0c2f 20940c                     JSR KEY_TO_ASCII    ; PETSCII -> ASCII (lower/upper): mixed-case name/message
   365  0c32 e0c8                       CPX #200             ; send limit 200 chars (was 40)
   366  0c34 f0e0                       BEQ IL_LOOP
   367  0c36 9dcd42                     STA INP_BUF,X
   368  0c39 e8                         INX
   369  0c3a 20ba0c                     JSR PRINT_CHR
   370  0c3d 4c160c                     JMP IL_LOOP
   371  0c40 e000               IL_DEL  CPX #0
   372  0c42 f0d2                       BEQ IL_LOOP
   373  0c44 ca                         DEX
   374  0c45 a914                       LDA #$14
   375  0c47 20ba0c                     JSR PRINT_CHR
   376  0c4a 4c160c                     JMP IL_LOOP
   377  0c4d a900               IL_DONE LDA #0
   378  0c4f 9dcd42                     STA INP_BUF,X
   379  0c52 8ecd43                     STX INP_LEN
   380  0c55 60                         RTS
   381                          
   382                          INPUT_PASS
   383  0c56 a200                       LDX #0
   384  0c58 8a                 IP_LOOP TXA
   385  0c59 48                         PHA
   386  0c5a 20e4ff                     JSR $FFE4
   387  0c5d a8                         TAY
   388  0c5e 68                         PLA
   389  0c5f aa                         TAX
   390  0c60 98                         TYA
   391  0c61 f0f5                       BEQ IP_LOOP
   392  0c63 c90d                       CMP #$0D
   393  0c65 f024                       BEQ IP_DONE
   394  0c67 c914                       CMP #$14
   395  0c69 f013                       BEQ IP_DEL
   396  0c6b 20940c                     JSR KEY_TO_ASCII    ; PETSCII -> ASCII: mixed-case passphrase (case-sensitive)
   397  0c6e e040                       CPX #64
   398  0c70 f0e6                       BEQ IP_LOOP
   399  0c72 9dcd42                     STA INP_BUF,X
   400  0c75 e8                         INX
   401  0c76 a92a                       LDA #$2A
   402  0c78 20ba0c                     JSR PRINT_CHR
   403  0c7b 4c580c                     JMP IP_LOOP
   404  0c7e e000               IP_DEL  CPX #0
   405  0c80 f0d6                       BEQ IP_LOOP
   406  0c82 ca                         DEX
   407  0c83 a914                       LDA #$14
   408  0c85 20ba0c                     JSR PRINT_CHR
   409  0c88 4c580c                     JMP IP_LOOP
   410  0c8b a900               IP_DONE LDA #0
   411  0c8d 9dcd42                     STA INP_BUF,X
   412  0c90 8ecd43                     STX INP_LEN
   413  0c93 60                         RTS
   414                          
   415                          ; ================================================================
   416                          ; KEY_TO_ASCII - C64 keyboard PETSCII -> ASCII (letters only)
   417                          ; Item 10A: allow typing/sending lowercase letters.
   418                          ; In : A = char from $FFE4 (GETIN)
   419                          ; Out: A = ASCII; X and Y are preserved
   420                          ;   $41-$5A (unshifted) -> $61-$7A  lowercase
   421                          ;   $C1-$DA (with SHIFT)  -> $41-$5A  uppercase
   422                          ; Everything else (digits, punctuation, $0D, $14, colour/control codes)
   423                          ; passes through unchanged, so control/colour codes stay intact.
   424                          ; ================================================================
   425                          KEY_TO_ASCII
   426  0c94 c985                       CMP #$85            ; F1 -> '{'  (C64 mist {}-toetsen)
   427  0c96 d003                       BNE KTA_NF3
   428  0c98 a97b                       LDA #$7B
   429  0c9a 60                         RTS
   430  0c9b c986               KTA_NF3 CMP #$86            ; F3 -> '}'
   431  0c9d d003                       BNE KTA_NCURLY
   432  0c9f a97d                       LDA #$7D
   433  0ca1 60                         RTS
   434                          KTA_NCURLY
   435  0ca2 c941                       CMP #$41
   436  0ca4 9013                       BCC KTA_DONE        ; < $41: leave untouched
   437  0ca6 c95b                       CMP #$5B
   438  0ca8 900c                       BCC KTA_LOWER       ; $41-$5A: unshifted -> lowercase
   439  0caa c9c1                       CMP #$C1
   440  0cac 900b                       BCC KTA_DONE        ; $5B-$C0: leave untouched
   441  0cae c9db                       CMP #$DB
   442  0cb0 b007                       BCS KTA_DONE        ; >= $DB: leave untouched
   443  0cb2 38                         SEC                 ; $C1-$DA: SHIFT -> uppercase
   444  0cb3 e980                       SBC #$80
   445  0cb5 60                         RTS
   446                          KTA_LOWER
   447  0cb6 18                         CLC
   448  0cb7 6920                       ADC #$20
   449                          KTA_DONE
   450  0cb9 60                         RTS
   451                          
   452                          ; ================================================================
   453                          ; PRINT_STR_FB - print null-terminated string via $FB/$FC
   454                          ; ================================================================
   455                          ; ================================================================
   456                          ; PRINT_CHR - CHROUT with ASCII->PETSCII case correction (mode 2)
   457                          ; Letters A-Z/a-z: flip bit $20 so they show with the correct case
   458                          ; in the lower/upper-case charset; control codes stay intact.
   459                          ; ================================================================
   460                          PRINT_CHR
   461  0cba c941                       CMP #$41
   462  0cbc 900e                       BCC PC_OUT          ; < 'A'
   463  0cbe c95b                       CMP #$5B
   464  0cc0 9008                       BCC PC_FLIP         ; 'A'-'Z'
   465  0cc2 c961                       CMP #$61
   466  0cc4 9006                       BCC PC_OUT          ; between 'Z' and 'a'
   467  0cc6 c97b                       CMP #$7B
   468  0cc8 b002                       BCS PC_OUT          ; > 'z'
   469  0cca 4920               PC_FLIP EOR #$20
   470  0ccc 4cd2ff             PC_OUT  JMP $FFD2
   471                          
   472                          
   473                          PRINT_STR_FB
   474  0ccf a000                       LDY #0
   475  0cd1 b1fb               PSF_LP  LDA ($FB),Y
   476  0cd3 f006                       BEQ PSF_DN
   477  0cd5 20ba0c                     JSR PRINT_CHR
   478  0cd8 c8                         INY
   479  0cd9 d0f6                       BNE PSF_LP
   480  0cdb 60                 PSF_DN  RTS
   481                          
   482                          ; 16-bit variant (>255 chars): increments $FB/$FC
   483                          PRINT_STR16
   484  0cdc a000               PS16_LP LDY #0
   485  0cde b1fb                       LDA ($FB),Y
   486  0ce0 f00c                       BEQ PS16_DN
