  9161                          ; ================================================================
  9162                          ; WS_SEND_MSG256 - 256-bit message: AES-256-GCM + Ed25519 sig (Option B)
  9163                          ;   {"type":"app:message","from":..,"to":..,"blob":{iv,data},"sig":[64]}
  9164                          ; Requires: KEY_PEER256[32]=peer encKey ; SIGN_SETUP run once
  9165                          ;          (SK_A/SK_PREFIX/SK_PUB cached with the HKDF signing seed).
  9166                          ; Input : INP_BUF/INP_LEN (like the 128-bit path).
  9167                          ; ================================================================
  9168                          WS_SEND_MSG256
  9169                                  ; -- peer 32-byte encKey -> AES_KEY --
  9170  a0b9 a21f                       LDX #31
  9171  a0bb bd4039             WSM2_K  LDA KEY_PEER256,X
  9172  a0be 9dcf4a                     STA AES_KEY,X
  9173  a0c1 ca                         DEX
  9174  a0c2 10f7                       BPL WSM2_K
  9175                          
  9176                                  ; -- inner JSON -> MSG_INNER_BUF ; GCM_PT_PTR/LEN set --
  9177  a0c4 20222f                     JSR BUILD_INNER_JSON
  9178                          
  9179                                  ; -- inner plaintext -> PTBUF (AGE256 reads PTBUF) ; PTLEN --
  9180  a0c7 adfd528da09e               LDA GCM_PT_PTR+0 : STA MSG_PTR+0
  9181  a0cd adfe528da19e               LDA GCM_PT_PTR+1 : STA MSG_PTR+1
  9182  a0d3 adff528da29e               LDA GCM_PT_LEN+0 : STA MSG_LEN+0
  9183  a0d9 ad00538da39e               LDA GCM_PT_LEN+1 : STA MSG_LEN+1
  9184  a0df a9f38504                   LDA #<PTBUF : STA CDST
  9185  a0e3 a94a8505                   LDA #>PTBUF : STA CDST+1
  9186  a0e7 207087                     JSR COPY_M
  9187  a0ea adff528df14a               LDA GCM_PT_LEN+0 : STA PTLEN+0
  9188  a0f0 ad00538df24a               LDA GCM_PT_LEN+1 : STA PTLEN+1
  9189                          
  9190                                  ; -- fresh nonce + AES-256-GCM encrypt --
  9191  a0f6 206127                     JSR GCM_NONCE_GEN
  9192  a0f9 202b48                     JSR AGE256             ; -> CTBUF, GCM_TAG
  9193                          
  9194                                  ; -- CTBUF -> GCM_CTBUF (BUILD_GCM_BLOB reads GCM_CTBUF) --
  9195  a0fc a9738da09e                 LDA #<CTBUF : STA MSG_PTR+0
  9196  a101 a94d8da19e                 LDA #>CTBUF : STA MSG_PTR+1
  9197  a106 adff528da29e               LDA GCM_PT_LEN+0 : STA MSG_LEN+0
  9198  a10c ad00538da39e               LDA GCM_PT_LEN+1 : STA MSG_LEN+1
  9199  a112 a9018504                   LDA #<GCM_CTBUF : STA CDST
  9200  a116 a9538505                   LDA #>GCM_CTBUF : STA CDST+1
  9201  a11a 207087                     JSR COPY_M
  9202                          
  9203                                  ; -- buitenste header: {"type":..,"from":"<id>","to":"<peer>","blob": --
  9204  a11d 20be26                     JSR JOUT_INIT
  9205  a120 a99e85fb                   LDA #<STR_MSG_HDR1 : STA $FB
  9206  a124 a96c85fc                   LDA #>STR_MSG_HDR1 : STA $FC
  9207  a128 20f226                     JSR JOUT_EMIT_STR
  9208  a12b a200                       LDX #0
  9209  a12d bd935a             WSM2_ID LDA C64_IDSTR,X
  9210  a130 f007                       BEQ WSM2_IDE
  9211  a132 20d126                     JSR JOUT_EMIT
  9212  a135 e8                         INX
  9213  a136 4c2da1                     JMP WSM2_ID
  9214                          WSM2_IDE
  9215  a139 a9bd85fb                   LDA #<STR_MSG_TO : STA $FB
  9216  a13d a96c85fc                   LDA #>STR_MSG_TO : STA $FC
  9217  a141 20f226                     JSR JOUT_EMIT_STR
  9218  a144 a200                       LDX #0
  9219  a146 bd3c40             WSM2_TO LDA PEER_IDSTR,X
  9220  a149 f007                       BEQ WSM2_TOE
  9221  a14b 20d126                     JSR JOUT_EMIT
  9222  a14e e8                         INX
  9223  a14f 4c46a1                     JMP WSM2_TO
  9224                          WSM2_TOE
  9225  a152 a9c685fb                   LDA #<STR_MSG_BLOB : STA $FB
  9226  a156 a96c85fc                   LDA #>STR_MSG_BLOB : STA $FC
  9227  a15a 20f226                     JSR JOUT_EMIT_STR
  9228                          
  9229                                  ; -- record blob start for the sig --
  9230  a15d ad835a8d263b               LDA JOUT_LO : STA BLOB_PTR+0
  9231  a163 ad845a8d273b               LDA JOUT_HI : STA BLOB_PTR+1
  9232  a169 ad855a8d283b               LDA JOUT_LEN+0 : STA BLOB_LEN0+0
  9233  a16f ad865a8d293b               LDA JOUT_LEN+1 : STA BLOB_LEN0+1
  9234                          
  9235  a175 208f2f                     JSR BUILD_GCM_BLOB     ; {"iv":[AES_NONCE],"data":[GCM_CTBUF..GCM_TAG]}
  9236                          
  9237                                  ; -- MAC_LEN = JOUT_LEN - BLOB_LEN0 (16-bit; no CPX between SBCs) --
  9238  a178 38                         SEC
  9239  a179 ad855aed283b8d2a...        LDA JOUT_LEN+0 : SBC BLOB_LEN0+0 : STA MAC_LEN+0
  9240  a182 ad865aed293b8d2b...        LDA JOUT_LEN+1 : SBC BLOB_LEN0+1 : STA MAC_LEN+1
  9241                          
  9242                                  ; -- sig = Ed25519 over the blob bytes (step C) --
  9243  a18b ad263b8da09e               LDA BLOB_PTR+0 : STA MSG_PTR+0
  9244  a191 ad273b8da19e               LDA BLOB_PTR+1 : STA MSG_PTR+1
  9245  a197 ad2a3b8da29e               LDA MAC_LEN+0 : STA MSG_LEN+0
  9246  a19d ad2b3b8da39e               LDA MAC_LEN+1 : STA MSG_LEN+1
  9247  a1a3 208a86                     JSR SIGN               ; -> SIG_OUT[0..63]
  9248                          
  9249                                  ; -- ,"sig":[ 64 decimalen ] --
  9250  a1a6 a9c485fb                   LDA #<STR_SIGHDR : STA $FB
  9251  a1aa a96b85fc                   LDA #>STR_SIGHDR : STA $FC
  9252  a1ae 20f226                     JSR JOUT_EMIT_STR
  9253  a1b1 a200                       LDX #0
  9254  a1b3 bd609e             WSM2_SG LDA SIG_OUT,X
  9255  a1b6 8ea65a                     STX BGB_XTMP
  9256  a1b9 200527                     JSR BYTE_TO_DEC
  9257  a1bc aea65a                     LDX BGB_XTMP
  9258  a1bf e8                         INX
  9259  a1c0 e040                       CPX #64
  9260  a1c2 f008                       BEQ WSM2_SGD
  9261  a1c4 a92c20d126                 LDA #$2C : JSR JOUT_EMIT
  9262  a1c9 4cb3a1                     JMP WSM2_SG
  9263                          WSM2_SGD
  9264  a1cc a95d20d126                 LDA #$5D : JSR JOUT_EMIT
  9265  a1d1 a97d20d126                 LDA #$7D : JSR JOUT_EMIT
  9266  a1d6 20bdb5                     JSR MSG_SEND_GATE
  9267  a1d9 60                         RTS
  9268                          
  9269                          ; ================================================================
  9270                          ; SETUP_SIGN_ID256 - cache Ed25519-signing-identiteit (item 4)
  9271                          ;   Call ONCE after DERIVE_KEYPAIR (256-bit login):
  9272                          ;     SEED = HKDF_OKM[32:64] (signing-seed) ; SIGN_SETUP -> SK_A/PREFIX/PUB
  9273                          ;   Own encKey = HKDF_OKM[0:32] (used by WS_AUTH256/receive).
  9274                          ;   Kost 1 scalar-mult (~5,7 min @1MHz, <1 min op U64-turbo).
  9275                          ; ================================================================
  9276                          SETUP_SIGN_ID256
  9277  a1da 20e1a1                     JSR COPY_SIGN_SEED
  9278  a1dd 201e86                     JSR SIGN_SETUP
  9279  a1e0 60                         RTS
  9280                          ; -- separate seed copy (quickly testable without scalar mult) --
  9281                          COPY_SIGN_SEED
  9282  a1e1 a21f                       LDX #31
  9283  a1e3 bd0039             CSS_L   LDA HKDF_OKM+32,X
  9284  a1e6 9d809d                     STA SEED,X
  9285  a1e9 ca                         DEX
  9286  a1ea 10f7                       BPL CSS_L
  9287  a1ec 60                         RTS
  9288                          
  9289                          ; ================================================================
  9290                          ; B64URL_DECODE43 - 43 base64url chars (INP_BUF) -> 32 bytes KEY_PEER256
  9291                          ;   10 groups of 4->3 bytes (30) + last 3 chars -> 2 bytes (30,31).
  9292                          ;   C=0 ok, C=1 error (length/invalid char). Reuses B64D_CHAR/_ERR.
  9293                          ; ================================================================
  9294                          B64URL_DECODE43
  9295  a1ed adcd43                     LDA INP_LEN
  9296  a1f0 c92b                       CMP #43
  9297  a1f2 f003                       BEQ B43_GO
  9298  a1f4 4c860b                     JMP B64D_ERR
  9299  a1f7 a900               B43_GO  LDA #0
  9300  a1f9 8d6240                     STA B64D_GRP
  9301                          B43_GLP
  9302  a1fc ad6240                     LDA B64D_GRP
  9303  a1ff c90a                       CMP #10
  9304  a201 d003                       BNE B43_GC
  9305  a203 4c9ba2                     JMP B43_LAST        ; trampoline: afstand > 127
  9306                          B43_GC
  9307                                  ; input offset = GRP*4
  9308  a206 0a                         ASL
  9309  a207 0a                         ASL
  9310  a208 8d6340                     STA B64D_IIX
  9311  a20b aa                         TAX
  9312  a20c bdcd42                     LDA INP_BUF,X
  9313  a20f 20880b                     JSR B64D_CHAR
  9314  a212 9003                       BCC *+5
  9315  a214 4c860b                     JMP B64D_ERR
  9316  a217 8d5d40                     STA B64D_V0
  9317  a21a ae6340                     LDX B64D_IIX
  9318  a21d bdce42                     LDA INP_BUF+1,X
  9319  a220 20880b                     JSR B64D_CHAR
  9320  a223 9003                       BCC *+5
  9321  a225 4c860b                     JMP B64D_ERR
  9322  a228 8d5e40                     STA B64D_V1
  9323  a22b ae6340                     LDX B64D_IIX
  9324  a22e bdcf42                     LDA INP_BUF+2,X
  9325  a231 20880b                     JSR B64D_CHAR
  9326  a234 9003                       BCC *+5
  9327  a236 4c860b                     JMP B64D_ERR
  9328  a239 8d5f40                     STA B64D_V2
  9329  a23c ae6340                     LDX B64D_IIX
  9330  a23f bdd042                     LDA INP_BUF+3,X
  9331  a242 20880b                     JSR B64D_CHAR
  9332  a245 9003                       BCC *+5
  9333  a247 4c860b                     JMP B64D_ERR
  9334  a24a 8d6040                     STA B64D_V3
  9335                                  ; output offset = GRP*3
  9336  a24d ad6240                     LDA B64D_GRP
  9337  a250 0a                         ASL
  9338  a251 18                         CLC
  9339  a252 6d6240                     ADC B64D_GRP
  9340  a255 aa                         TAX
  9341                                  ; byte0 = V0<<2 | V1>>4
  9342  a256 ad5d40                     LDA B64D_V0
  9343  a259 0a                         ASL
  9344  a25a 0a                         ASL
  9345  a25b 8d6140                     STA B64D_T
  9346  a25e ad5e40                     LDA B64D_V1
  9347  a261 4a                         LSR
  9348  a262 4a                         LSR
  9349  a263 4a                         LSR
  9350  a264 4a                         LSR
  9351  a265 0d6140                     ORA B64D_T
  9352  a268 9d4039                     STA KEY_PEER256+0,X
  9353                                  ; byte1 = V1<<4 | V2>>2
  9354  a26b ad5e40                     LDA B64D_V1
  9355  a26e 0a                         ASL
  9356  a26f 0a                         ASL
  9357  a270 0a                         ASL
  9358  a271 0a                         ASL
  9359  a272 8d6140                     STA B64D_T
  9360  a275 ad5f40                     LDA B64D_V2
  9361  a278 4a                         LSR
  9362  a279 4a                         LSR
  9363  a27a 0d6140                     ORA B64D_T
  9364  a27d 9d4139                     STA KEY_PEER256+1,X
  9365                                  ; byte2 = (V2 and $03)<<6 | V3
  9366  a280 ad5f40                     LDA B64D_V2
  9367  a283 0a                         ASL
  9368  a284 0a                         ASL
  9369  a285 0a                         ASL
  9370  a286 0a                         ASL
  9371  a287 0a                         ASL
  9372  a288 0a                         ASL
  9373  a289 8d6140                     STA B64D_T
  9374  a28c ad6040                     LDA B64D_V3
  9375  a28f 0d6140                     ORA B64D_T
  9376  a292 9d4239                     STA KEY_PEER256+2,X
  9377  a295 ee6240                     INC B64D_GRP
  9378  a298 4cfca1                     JMP B43_GLP
  9379                          B43_LAST
  9380                                  ; last 3 chars (index 40/41/42) -> bytes 30,31
  9381  a29b adf542                     LDA INP_BUF+40
  9382  a29e 20880b                     JSR B64D_CHAR
  9383  a2a1 9003                       BCC *+5
  9384  a2a3 4c860b                     JMP B64D_ERR
  9385  a2a6 8d5d40                     STA B64D_V0
  9386  a2a9 adf642                     LDA INP_BUF+41
  9387  a2ac 20880b                     JSR B64D_CHAR
  9388  a2af 9003                       BCC *+5
  9389  a2b1 4c860b                     JMP B64D_ERR
  9390  a2b4 8d5e40                     STA B64D_V1
  9391  a2b7 adf742                     LDA INP_BUF+42
  9392  a2ba 20880b                     JSR B64D_CHAR
  9393  a2bd 9003                       BCC *+5
  9394  a2bf 4c860b                     JMP B64D_ERR
  9395  a2c2 8d5f40                     STA B64D_V2
  9396                                  ; byte30 = V0<<2 | V1>>4
  9397  a2c5 ad5d40                     LDA B64D_V0
  9398  a2c8 0a                         ASL
  9399  a2c9 0a                         ASL
  9400  a2ca 8d6140                     STA B64D_T
  9401  a2cd ad5e40                     LDA B64D_V1
  9402  a2d0 4a                         LSR
  9403  a2d1 4a                         LSR
  9404  a2d2 4a                         LSR
  9405  a2d3 4a                         LSR
  9406  a2d4 0d6140                     ORA B64D_T
  9407  a2d7 8d5e39                     STA KEY_PEER256+30
  9408                                  ; byte31 = V1<<4 | V2>>2
  9409  a2da ad5e40                     LDA B64D_V1
  9410  a2dd 0a                         ASL
  9411  a2de 0a                         ASL
  9412  a2df 0a                         ASL
  9413  a2e0 0a                         ASL
  9414  a2e1 8d6140                     STA B64D_T
  9415  a2e4 ad5f40                     LDA B64D_V2
  9416  a2e7 4a                         LSR
  9417  a2e8 4a                         LSR
  9418  a2e9 0d6140                     ORA B64D_T
  9419  a2ec 8d5f39                     STA KEY_PEER256+31
  9420  a2ef 18                         CLC
  9421  a2f0 60                         RTS
