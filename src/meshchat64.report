  7264  78d8 4a                         LSR                     ; C = bit0 (wrap bit -> becomes MSB)
  7265  78d9 a207                       LDX #7
  7266  78db 7eba92             R1_L    ROR SHA_TA,X
  7267  78de ca                         DEX
  7268  78df 10fa                       BPL R1_L
  7269  78e1 60                         RTS
  7270                          ; --- 1-bit logical right shift of SHA_TA ---
  7271  78e2 18                 SHR1_TA CLC
