  7838  7c8f a900                       LDA #<SHA_T1
  7839  7c91 85fd                       STA PB
  7840  7c93 a993                       LDA #>SHA_T1
  7841  7c95 85fe                       STA PB+1
  7842  7c97 20f378                     JSR C64COPY
  7843  7c9a a9c0                       LDA #<(SHA_AH+0)
  7844  7c9c 85fb                       STA PA
