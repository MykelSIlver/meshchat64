  9095  a00f 9008                       BCC WA2_G2
  9096  a011 ce6440                     DEC WA_TRY
  9097  a014 d0f6                       BNE WA2_W2
  9098  a016 4c6ea0                     JMP WA2_FAIL
  9099  a019 a99e               WA2_G2  LDA #<RCV_BUF
  9100  a01b 85fb                       STA $FB
  9101  a01d a95f                       LDA #>RCV_BUF
  9102  a01f 85fc                       STA $FC
  9103  a021 a913                       LDA #<JSC_AOK
  9104  a023 8db15a                     STA JSC_PAT_LO
  9105  a026 a96c                       LDA #>JSC_AOK
  9106  a028 8db25a                     STA JSC_PAT_HI
  9107  a02b 20182d                     JSR JSON_SCAN
