  3053                          ; ACIA / 6551 ROUTINES (SwiftLink / U64 modem emulatie)
  3054                          ; Registers: $DE00=data  $DE01=status/reset  $DE02=command  $DE03=control
  3055                          ; ================================================================
  3056                          
  3057                          ACIA_INIT
  3058  247d a900                       LDA #$00
  3059  247f 8d01de                     STA $DE01       ; reset
  3060  2482 a91f                       LDA #$1F        ; was $1E - 38400 baud for C64U
  3061  2484 8d03de                     STA $DE03
  3062  2487 a909                       LDA #$09
  3063  2489 8d02de                     STA $DE02
  3064  248c 60                         RTS
