  7802                                  ; -- shift werkvars: h=g,g=f,f=e,e=d+T1,d=c,c=b,b=a,a=T1+T2 --
  7803                                  ; do back to front: word7<-6,6<-5,5<-4 ; e(4)=d(3)+T1 ; 3<-2,2<-1,1<-0 ; a(0)=T1+T2
  7804                                  ; h<-g
  7805  7c4f 20817d                     JSR CP_W6_W7
  7806                                  ; g<-f
  7807  7c52 208d7d                     JSR CP_W5_W6
  7808                                  ; f<-e
  7809  7c55 20997d                     JSR CP_W4_W5
  7810                                  ; e = d + T1  -> copy d(3) to e(4), then += T1
  7811  7c58 a9e0                       LDA #<(SHA_AH+32)
  7812  7c5a 85fb                       STA PA
  7813  7c5c a992                       LDA #>(SHA_AH+32)
  7814  7c5e 85fc                       STA PA+1
  7815  7c60 a9d8                       LDA #<(SHA_AH+24)
  7816  7c62 85fd                       STA PB
  7817  7c64 a992                       LDA #>(SHA_AH+24)
  7818  7c66 85fe                       STA PB+1
  7819  7c68 20f378                     JSR C64COPY
  7820  7c6b a9e0                       LDA #<(SHA_AH+32)
  7821  7c6d 85fb                       STA PA
  7822  7c6f a992                       LDA #>(SHA_AH+32)
  7823  7c71 85fc                       STA PA+1
  7824  7c73 a900                       LDA #<SHA_T1
  7825  7c75 85fd                       STA PB
  7826  7c77 a993                       LDA #>SHA_T1
  7827  7c79 85fe                       STA PB+1
  7828  7c7b 20ff78                     JSR C64ADD
  7829                                  ; d<-c, c<-b, b<-a
