  6654                          ; ================================================================
  6655                          ; Base64url alfabet (RFC 4648 §5: A-Z a-z 0-9 - _)
  6656                          ; ================================================================
  6657                          B64_TABLE
  6658  6cd0 4142434445464748...        !text "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
  6659  6d0e 2d5f                       !byte $2D,$5F       ; '-' (62) en '_' (63)
