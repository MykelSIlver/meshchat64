   542  0d3d a920                       LDA #$20
   543  0d3f 20ba0c                     JSR PRINT_CHR
   544  0d42 ee1d42                     INC DBG_IDX
   545  0d45 ad1d42                     LDA DBG_IDX
   546  0d48 c908                       CMP #8
   547  0d4a d0df                       BNE DBG_LP
   548  0d4c a90d                       LDA #$0D
   549  0d4e 20ba0c                     JSR PRINT_CHR
   550  0d51 60                         RTS
