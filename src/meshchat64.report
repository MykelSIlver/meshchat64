  7587  7b3d a5fb                       LDA PA
  7588  7b3f 18                         CLC
  7589  7b40 6908                       ADC #8
  7590  7b42 85fb                       STA PA
  7591  7b44 9002                       BCC SB_IH1
  7592  7b46 e6fc                       INC PA+1
  7593  7b48 a5fd               SB_IH1  LDA PB
  7594  7b4a 18                         CLC
  7595  7b4b 6908                       ADC #8
  7596  7b4d 85fd                       STA PB
  7597  7b4f 9002                       BCC SB_IH2
  7598  7b51 e6fe                       INC PB+1
  7599  7b53 aeb099             SB_IH2  LDX SHA_BTMP
  7600  7b56 e8                         INX
  7601  7b57 e008                       CPX #8
  7602  7b59 d0dc                       BNE SB_IH
