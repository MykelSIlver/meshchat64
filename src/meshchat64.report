  7928                          ; ================================================================
  7929                          ; SHA512  -  main routine: pad + loop over blocks
  7930                          ; ================================================================
  7931                          SHA512
  7932                                  ; -- H = IV --
  7933  7dd3 a23f                       LDX #63
  7934  7dd5 bd6a8f             SH_IV   LDA SHA_IV,X
  7935  7dd8 9d2a92                     STA SHA_H,X
  7936  7ddb ca                         DEX
  7937  7ddc 10f7                       BPL SH_IV
  7938                          
  7939                                  ; -- build padded message in SHA_PAD --
  7940                                  ; copy SRC[0..MLEN-1] -> SHA_PAD
  7941  7dde a5f7                       LDA SRC
  7942  7de0 85fd                       STA PB
  7943  7de2 a5f8                       LDA SRC+1
  7944  7de4 85fe                       STA PB+1
  7945  7de6 a91a                       LDA #<SHA_PAD
  7946  7de8 85fb                       STA PA
  7947  7dea a993                       LDA #>SHA_PAD
  7948  7dec 85fc                       STA PA+1
  7949                                  ; 16-bit copy of SHA5_MLEN bytes
  7950  7dee ad9a99                     LDA SHA5_MLEN
  7951  7df1 8da099                     STA SHA_CNT
  7952  7df4 ad9b99                     LDA SHA5_MLEN+1
  7953  7df7 8da199                     STA SHA_CNT+1
  7954  7dfa ada099             SH_CP   LDA SHA_CNT
  7955  7dfd 0da199                     ORA SHA_CNT+1
  7956  7e00 f020                       BEQ SH_CPD
  7957  7e02 a000                       LDY #0
  7958  7e04 b1fd                       LDA (PB),Y
  7959  7e06 91fb                       STA (PA),Y
  7960  7e08 e6fd                       INC PB
  7961  7e0a d002                       BNE SH_CP1
  7962  7e0c e6fe                       INC PB+1
  7963  7e0e e6fb               SH_CP1  INC PA
  7964  7e10 d002                       BNE SH_CP2
  7965  7e12 e6fc                       INC PA+1
  7966  7e14 ada099             SH_CP2  LDA SHA_CNT
  7967  7e17 d003                       BNE SH_CP3
  7968  7e19 cea199                     DEC SHA_CNT+1
  7969  7e1c cea099             SH_CP3  DEC SHA_CNT
  7970  7e1f 4cfa7d                     JMP SH_CP
  7971                          SH_CPD
  7972                                  ; PA now points to SHA_PAD+MLEN ; write 0x80
  7973  7e22 a980                       LDA #$80
  7974  7e24 a000                       LDY #0
  7975  7e26 91fb                       STA (PA),Y
  7976                                  ; compute total padded length (16-bit):
  7977                                  ;   m1 = MLEN+1 ; zeros so that (m1+zeros) % 128 == 112 ; +16
  7978                                  ; we keep it simple: fill from MLEN+1 with 0 until we reach a 128-multiple-112,
  7979                                  ; then 16 length bytes. Compute total first.
  7980                                  ; m1 = MLEN+1
  7981  7e28 ad9a99                     LDA SHA5_MLEN
  7982  7e2b 18                         CLC
  7983  7e2c 6901                       ADC #1
  7984  7e2e 8d9c99                     STA SHA_M1
  7985  7e31 ad9b99                     LDA SHA5_MLEN+1
  7986  7e34 6900                       ADC #0
  7987  7e36 8d9d99                     STA SHA_M1+1
  7988                                  ; r = m1 mod 128 = m1 & 127 (only low byte relevant since 128 divides 256)
  7989  7e39 ad9c99                     LDA SHA_M1
  7990  7e3c 297f                       AND #127
  7991  7e3e 8da899                     STA SHA_R
  7992                                  ; zeros = (112 - r) mod 128
  7993  7e41 a970                       LDA #112
  7994  7e43 38                         SEC
  7995  7e44 eda899                     SBC SHA_R
  7996  7e47 297f                       AND #127
  7997  7e49 8da999                     STA SHA_ZEROS
  7998                                  ; total = m1 + zeros + 16
  7999  7e4c ad9c99                     LDA SHA_M1
  8000  7e4f 18                         CLC
  8001  7e50 6da999                     ADC SHA_ZEROS
  8002  7e53 8d9e99                     STA SHA_TOTAL
  8003  7e56 ad9d99                     LDA SHA_M1+1
  8004  7e59 6900                       ADC #0
  8005  7e5b 8d9f99                     STA SHA_TOTAL+1
  8006  7e5e ad9e99                     LDA SHA_TOTAL
  8007  7e61 18                         CLC
  8008  7e62 6910                       ADC #16
  8009  7e64 8d9e99                     STA SHA_TOTAL
  8010  7e67 ad9f99                     LDA SHA_TOTAL+1
  8011  7e6a 6900                       ADC #0
  8012  7e6c 8d9f99                     STA SHA_TOTAL+1
  8013                                  ; fill SHA_PAD[m1 .. total-1] with 0 (we overwrite the length bytes later)
  8014                                  ; pointer PA = SHA_PAD + m1
  8015  7e6f a91a                       LDA #<SHA_PAD
  8016  7e71 18                         CLC
  8017  7e72 6d9c99                     ADC SHA_M1
  8018  7e75 85fb                       STA PA
  8019  7e77 a993                       LDA #>SHA_PAD
  8020  7e79 6d9d99                     ADC SHA_M1+1
  8021  7e7c 85fc                       STA PA+1
  8022                                  ; count = total - m1
  8023  7e7e ad9e99                     LDA SHA_TOTAL
  8024  7e81 38                         SEC
  8025  7e82 ed9c99                     SBC SHA_M1
  8026  7e85 8da099                     STA SHA_CNT
  8027  7e88 ad9f99                     LDA SHA_TOTAL+1
  8028  7e8b ed9d99                     SBC SHA_M1+1
  8029  7e8e 8da199                     STA SHA_CNT+1
  8030  7e91 ada099             SH_ZL   LDA SHA_CNT
  8031  7e94 0da199                     ORA SHA_CNT+1
  8032  7e97 f01a                       BEQ SH_ZD
  8033  7e99 a900                       LDA #0
  8034  7e9b a000                       LDY #0
  8035  7e9d 91fb                       STA (PA),Y
  8036  7e9f e6fb                       INC PA
  8037  7ea1 d002                       BNE SH_Z1
  8038  7ea3 e6fc                       INC PA+1
  8039  7ea5 ada099             SH_Z1   LDA SHA_CNT
  8040  7ea8 d003                       BNE SH_Z2
  8041  7eaa cea199                     DEC SHA_CNT+1
  8042  7ead cea099             SH_Z2   DEC SHA_CNT
  8043  7eb0 4c917e                     JMP SH_ZL
  8044                          SH_ZD
  8045                                  ; write bit length (MLEN*8) big-endian in the last 16 bytes:
  8046                                  ;   total-1 = LSB, total-2 = next, ...  (only 16-bit bitlen supported)
  8047                                  ; bitlen16 = MLEN << 3 (16-bit)
  8048  7eb3 ad9a99                     LDA SHA5_MLEN
  8049  7eb6 8da699                     STA SHA_BL
  8050  7eb9 ad9b99                     LDA SHA5_MLEN+1
  8051  7ebc 8da799                     STA SHA_BL+1
  8052  7ebf a202                       LDX #2                  ; 3 shifts (X=2..0) = MLEN<<3 (bytes->bits)
  8053  7ec1 0ea699             SH_SHL  ASL SHA_BL
  8054  7ec4 2ea799                     ROL SHA_BL+1
  8055  7ec7 ca                         DEX
  8056  7ec8 10f7                       BPL SH_SHL
  8057                                  ; SHA_PAD[total-1] = SHA_BL (lo) ; SHA_PAD[total-2] = SHA_BL+1 (hi)
  8058  7eca a91a                       LDA #<SHA_PAD
  8059  7ecc 18                         CLC
  8060  7ecd 6d9e99                     ADC SHA_TOTAL
  8061  7ed0 85fb                       STA PA
  8062  7ed2 a993                       LDA #>SHA_PAD
  8063  7ed4 6d9f99                     ADC SHA_TOTAL+1
  8064  7ed7 85fc                       STA PA+1                ; PA = SHA_PAD + total
  8065  7ed9 a000                       LDY #0
  8066                                  ; index total-1
  8067  7edb 38                         SEC
  8068  7edc a5fb                       LDA PA
  8069  7ede e901                       SBC #1
  8070  7ee0 85fb                       STA PA
  8071  7ee2 b002                       BCS SH_B1
  8072  7ee4 c6fc                       DEC PA+1
  8073  7ee6 ada699             SH_B1   LDA SHA_BL
  8074  7ee9 91fb                       STA (PA),Y             ; LSB
  8075  7eeb 38                         SEC
  8076  7eec a5fb                       LDA PA
  8077  7eee e901                       SBC #1
  8078  7ef0 85fb                       STA PA
  8079  7ef2 b002                       BCS SH_B2
  8080  7ef4 c6fc                       DEC PA+1
  8081  7ef6 ada799             SH_B2   LDA SHA_BL+1
  8082  7ef9 91fb                       STA (PA),Y             ; next byte
  8083                          
  8084                                  ; -- number of blocks = total / 128 --
  8085                                  ; nblk16 = total >> 7
  8086  7efb ad9f99                     LDA SHA_TOTAL+1
  8087  7efe 8da399                     STA SHA_NBLK+1
  8088  7f01 ad9e99                     LDA SHA_TOTAL
  8089  7f04 8da299                     STA SHA_NBLK
  8090                                  ; >>7 : 7x LSR over 16-bit
  8091  7f07 a206                       LDX #6                  ; 7 shifts (X=6..0), total/128
  8092  7f09 4ea399             SH_NBL  LSR SHA_NBLK+1
  8093  7f0c 6ea299                     ROR SHA_NBLK
  8094  7f0f ca                         DEX
  8095  7f10 10f7                       BPL SH_NBL
  8096                          
  8097                                  ; -- loop blocks --
  8098  7f12 a91a                       LDA #<SHA_PAD
  8099  7f14 85f9                       STA BP
  8100  7f16 a993                       LDA #>SHA_PAD
  8101  7f18 85fa                       STA BP+1
  8102  7f1a a900                       LDA #0
  8103  7f1c 8da499                     STA SHA_BI
  8104  7f1f 8da599                     STA SHA_BI+1
  8105                          SH_BLKL
  8106                                  ; done?  SHA_BI == SHA_NBLK ?
  8107  7f22 ada499                     LDA SHA_BI
  8108  7f25 cda299                     CMP SHA_NBLK
  8109  7f28 d00b                       BNE SH_DOB
  8110  7f2a ada599                     LDA SHA_BI+1
  8111  7f2d cda399                     CMP SHA_NBLK+1
  8112  7f30 d003                       BNE SH_DOB
  8113  7f32 4c4e7f                     JMP SH_FIN
  8114                          SH_DOB
  8115  7f35 20a7b5                     JSR PW_SHA
  8116                                  ; BP += 128
  8117  7f38 a5f9                       LDA BP
  8118  7f3a 18                         CLC
  8119  7f3b 6980                       ADC #128
  8120  7f3d 85f9                       STA BP
  8121  7f3f 9002                       BCC SH_BI1
  8122  7f41 e6fa                       INC BP+1
  8123  7f43 eea499             SH_BI1  INC SHA_BI
  8124  7f46 d003                       BNE SH_BI2
  8125  7f48 eea599                     INC SHA_BI+1
  8126  7f4b 4c227f             SH_BI2  JMP SH_BLKL
  8127                          SH_FIN
  8128                                  ; -- digest = H big-endian --
  8129  7f4e a900                       LDA #0
  8130  7f50 8dae99                     STA SHA_J               ; word 0..7
  8131  7f53 adae99             SH_DW   LDA SHA_J
  8132  7f56 0a                         ASL
  8133  7f57 0a                         ASL
  8134  7f58 0a                         ASL
  8135  7f59 8daf99                     STA SHA_OFF             ; J*8
  8136  7f5c a200                       LDX #0                  ; b
  8137                          SH_DB   ; DIGEST[J*8 + b] = H[J].byte(7-b)
  8138  7f5e 8a                         TXA
  8139  7f5f 4907                       EOR #7
  8140  7f61 18                         CLC
  8141  7f62 6daf99                     ADC SHA_OFF             ; source index in SHA_H
  8142  7f65 a8                         TAY
  8143  7f66 b92a92                     LDA SHA_H,Y
  8144                                  ; dest = SHA_DIGEST + J*8 + b
  8145  7f69 8a                         TXA
  8146  7f6a 18                         CLC
  8147  7f6b 6daf99                     ADC SHA_OFF
  8148  7f6e a8                         TAY
