  9384                          ; ================================================================
  9385                          ; SETUP_SIGN_ID256 - cache Ed25519-signing-identiteit (item 4)
  9386                          ;   Call ONCE after DERIVE_KEYPAIR (256-bit login):
  9387                          ;     SEED = HKDF_OKM[32:64] (signing-seed) ; SIGN_SETUP -> SK_A/PREFIX/PUB
  9388                          ;   Own encKey = HKDF_OKM[0:32] (used by WS_AUTH256/receive).
  9389                          ;   Kost 1 scalar-mult (~5,7 min @1MHz, <1 min op U64-turbo).
  9390                          ; ================================================================
  9391                          SETUP_SIGN_ID256
  9392  a1da 20e1a1                     JSR COPY_SIGN_SEED
  9393  a1dd 207486                     JSR SIGN_SETUP
  9394  a1e0 60                         RTS
  9395                          ; -- separate seed copy (quickly testable without scalar mult) --
  9396                          COPY_SIGN_SEED
  9397  a1e1 a21f                       LDX #31
  9398  a1e3 bd0039             CSS_L   LDA HKDF_OKM+32,X
  9399  a1e6 9d809d                     STA SEED,X
  9400  a1e9 ca                         DEX
  9401  a1ea 10f7                       BPL CSS_L
  9402  a1ec 60                         RTS
  9403                          
  9404                          ; ================================================================
  9405                          ; B64URL_DECODE43 - 43 base64url chars (INP_BUF) -> 32 bytes KEY_PEER256
  9406                          ;   10 groups of 4->3 bytes (30) + last 3 chars -> 2 bytes (30,31).
  9407                          ;   C=0 ok, C=1 error (length/invalid char). Reuses B64D_CHAR/_ERR.
  9408                          ; ================================================================
  9409                          B64URL_DECODE43
  9410  a1ed adcd43                     LDA INP_LEN
  9411  a1f0 c92b                       CMP #43
  9412  a1f2 f003                       BEQ B43_GO
  9413  a1f4 4c860b                     JMP B64D_ERR
  9414  a1f7 a900               B43_GO  LDA #0
  9415  a1f9 8d6240                     STA B64D_GRP
  9416                          B43_GLP
  9417  a1fc ad6240                     LDA B64D_GRP
  9418  a1ff c90a                       CMP #10
  9419  a201 d003                       BNE B43_GC
  9420  a203 4c9ba2                     JMP B43_LAST        ; trampoline: afstand > 127
  9421                          B43_GC
  9422                                  ; input offset = GRP*4
  9423  a206 0a                         ASL
  9424  a207 0a                         ASL
  9425  a208 8d6340                     STA B64D_IIX
  9426  a20b aa                         TAX
  9427  a20c bdcd42                     LDA INP_BUF,X
  9428  a20f 20880b                     JSR B64D_CHAR
  9429  a212 9003                       BCC *+5
  9430  a214 4c860b                     JMP B64D_ERR
  9431  a217 8d5d40                     STA B64D_V0
  9432  a21a ae6340                     LDX B64D_IIX
  9433  a21d bdce42                     LDA INP_BUF+1,X
  9434  a220 20880b                     JSR B64D_CHAR
  9435  a223 9003                       BCC *+5
  9436  a225 4c860b                     JMP B64D_ERR
  9437  a228 8d5e40                     STA B64D_V1
  9438  a22b ae6340                     LDX B64D_IIX
  9439  a22e bdcf42                     LDA INP_BUF+2,X
  9440  a231 20880b                     JSR B64D_CHAR
  9441  a234 9003                       BCC *+5
  9442  a236 4c860b                     JMP B64D_ERR
  9443  a239 8d5f40                     STA B64D_V2
  9444  a23c ae6340                     LDX B64D_IIX
  9445  a23f bdd042                     LDA INP_BUF+3,X
  9446  a242 20880b                     JSR B64D_CHAR
  9447  a245 9003                       BCC *+5
  9448  a247 4c860b                     JMP B64D_ERR
  9449  a24a 8d6040                     STA B64D_V3
  9450                                  ; output offset = GRP*3
  9451  a24d ad6240                     LDA B64D_GRP
  9452  a250 0a                         ASL
  9453  a251 18                         CLC
  9454  a252 6d6240                     ADC B64D_GRP
  9455  a255 aa                         TAX
  9456                                  ; byte0 = V0<<2 | V1>>4
  9457  a256 ad5d40                     LDA B64D_V0
  9458  a259 0a                         ASL
  9459  a25a 0a                         ASL
  9460  a25b 8d6140                     STA B64D_T
  9461  a25e ad5e40                     LDA B64D_V1
  9462  a261 4a                         LSR
  9463  a262 4a                         LSR
  9464  a263 4a                         LSR
  9465  a264 4a                         LSR
  9466  a265 0d6140                     ORA B64D_T
  9467  a268 9d4039                     STA KEY_PEER256+0,X
  9468                                  ; byte1 = V1<<4 | V2>>2
  9469  a26b ad5e40                     LDA B64D_V1
  9470  a26e 0a                         ASL
  9471  a26f 0a                         ASL
  9472  a270 0a                         ASL
  9473  a271 0a                         ASL
  9474  a272 8d6140                     STA B64D_T
  9475  a275 ad5f40                     LDA B64D_V2
  9476  a278 4a                         LSR
  9477  a279 4a                         LSR
  9478  a27a 0d6140                     ORA B64D_T
  9479  a27d 9d4139                     STA KEY_PEER256+1,X
  9480                                  ; byte2 = (V2 and $03)<<6 | V3
  9481  a280 ad5f40                     LDA B64D_V2
  9482  a283 0a                         ASL
  9483  a284 0a                         ASL
  9484  a285 0a                         ASL
  9485  a286 0a                         ASL
  9486  a287 0a                         ASL
  9487  a288 0a                         ASL
  9488  a289 8d6140                     STA B64D_T
  9489  a28c ad6040                     LDA B64D_V3
  9490  a28f 0d6140                     ORA B64D_T
  9491  a292 9d4239                     STA KEY_PEER256+2,X
  9492  a295 ee6240                     INC B64D_GRP
  9493  a298 4cfca1                     JMP B43_GLP
