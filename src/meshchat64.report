  9538                          ; ================================================================
  9539                          ; Mode dispatch (item 2): choose 128- or 256-bit routine on USE_256.
  9540                          ;   Identical calling convention (no args; read global state),
  9541                          ;   so the tail-JMP preserves the RTS semantics to the original caller.
  9542                          ; ================================================================
  9543                          WS_AUTH_DISPATCH
  9544  a2f1 ad6039                     LDA USE_256
  9545  a2f4 f003                       BEQ WAD_128
  9546  a2f6 4ca69e                     JMP WS_AUTH256
  9547  a2f9 4c9330             WAD_128 JMP WS_AUTH
  9548                          WS_SEND_DISPATCH
  9549  a2fc ad6039                     LDA USE_256
  9550  a2ff f003                       BEQ WSD_128
  9551  a301 4cb9a0                     JMP WS_SEND_MSG256
  9552  a304 4c9630             WSD_128 JMP WS_SEND_MSG
  9553                          
  9554                          ; ================================================================
  9555                          ; B64URL_ENCODE32 - 32 bytes (B64E_IN) -> 43 base64url chars (B64E_OUT)
  9556                          ;   10 groups of 3->4 chars (40) + last 2 bytes -> 3 chars (40,41,42).
  9557                          ;   6-bit value -> char via B64_TABLE (value = index). No padding.
  9558                          ; ================================================================
  9559                          B64URL_ENCODE32
  9560  a307 a900                       LDA #0
  9561  a309 8dad39                     STA B64E_GRP
  9562                          B64E_GLP
  9563  a30c adad39                     LDA B64E_GRP
  9564  a30f c90a                       CMP #10
  9565  a311 d003                       BNE B64E_GC
  9566  a313 4c8ca3                     JMP B64E_LAST
  9567                          B64E_GC
  9568                                  ; in-offset = GRP*3 -> load B0/B1/B2
  9569  a316 0a                         ASL
  9570  a317 18                         CLC
  9571  a318 6dad39                     ADC B64E_GRP
  9572  a31b aa                         TAX
  9573  a31c bd6139                     LDA B64E_IN,X
  9574  a31f 8dae39                     STA B64E_B0
  9575  a322 bd6239                     LDA B64E_IN+1,X
  9576  a325 8daf39                     STA B64E_B1
  9577  a328 bd6339                     LDA B64E_IN+2,X
  9578  a32b 8db039                     STA B64E_B2
  9579                                  ; out-offset = GRP*4
  9580  a32e adad39                     LDA B64E_GRP
  9581  a331 0a                         ASL
  9582  a332 0a                         ASL
  9583  a333 aa                         TAX
  9584                                  ; c0 = B0>>2
  9585  a334 adae39                     LDA B64E_B0
  9586  a337 4a                         LSR
  9587  a338 4a                         LSR
  9588  a339 a8                         TAY
  9589  a33a b9d06c                     LDA B64_TABLE,Y
  9590  a33d 9d8139                     STA B64E_OUT,X
  9591                                  ; c1 = ((B0 and 3)<<4) | (B1>>4)
  9592  a340 adae39                     LDA B64E_B0
  9593  a343 2903                       AND #$03
  9594  a345 0a                         ASL
  9595  a346 0a                         ASL
  9596  a347 0a                         ASL
  9597  a348 0a                         ASL
  9598  a349 8db139                     STA B64E_T
  9599  a34c adaf39                     LDA B64E_B1
  9600  a34f 4a                         LSR
  9601  a350 4a                         LSR
  9602  a351 4a                         LSR
  9603  a352 4a                         LSR
  9604  a353 0db139                     ORA B64E_T
  9605  a356 a8                         TAY
  9606  a357 b9d06c                     LDA B64_TABLE,Y
  9607  a35a 9d8239                     STA B64E_OUT+1,X
  9608                                  ; c2 = ((B1 and $0F)<<2) | (B2>>6)
  9609  a35d adaf39                     LDA B64E_B1
  9610  a360 290f                       AND #$0F
  9611  a362 0a                         ASL
  9612  a363 0a                         ASL
  9613  a364 8db139                     STA B64E_T
  9614  a367 adb039                     LDA B64E_B2
  9615  a36a 4a                         LSR
  9616  a36b 4a                         LSR
  9617  a36c 4a                         LSR
  9618  a36d 4a                         LSR
  9619  a36e 4a                         LSR
  9620  a36f 4a                         LSR
  9621  a370 0db139                     ORA B64E_T
  9622  a373 a8                         TAY
  9623  a374 b9d06c                     LDA B64_TABLE,Y
  9624  a377 9d8339                     STA B64E_OUT+2,X
  9625                                  ; c3 = B2 and $3F
  9626  a37a adb039                     LDA B64E_B2
  9627  a37d 293f                       AND #$3F
  9628  a37f a8                         TAY
  9629  a380 b9d06c                     LDA B64_TABLE,Y
  9630  a383 9d8439                     STA B64E_OUT+3,X
  9631  a386 eead39                     INC B64E_GRP
  9632  a389 4c0ca3                     JMP B64E_GLP
  9633                          B64E_LAST
  9634                                  ; last 2 bytes (in 30,31) -> 3 chars (out 40,41,42)
  9635  a38c ad7f39                     LDA B64E_IN+30
  9636  a38f 8dae39                     STA B64E_B0
  9637  a392 ad8039                     LDA B64E_IN+31
  9638  a395 8daf39                     STA B64E_B1
  9639                                  ; c0 = B0>>2
  9640  a398 adae39                     LDA B64E_B0
  9641  a39b 4a                         LSR
  9642  a39c 4a                         LSR
  9643  a39d a8                         TAY
  9644  a39e b9d06c                     LDA B64_TABLE,Y
  9645  a3a1 8da939                     STA B64E_OUT+40
  9646                                  ; c1 = ((B0 and 3)<<4) | (B1>>4)
  9647  a3a4 adae39                     LDA B64E_B0
  9648  a3a7 2903                       AND #$03
  9649  a3a9 0a                         ASL
  9650  a3aa 0a                         ASL
  9651  a3ab 0a                         ASL
  9652  a3ac 0a                         ASL
  9653  a3ad 8db139                     STA B64E_T
  9654  a3b0 adaf39                     LDA B64E_B1
  9655  a3b3 4a                         LSR
  9656  a3b4 4a                         LSR
  9657  a3b5 4a                         LSR
  9658  a3b6 4a                         LSR
  9659  a3b7 0db139                     ORA B64E_T
  9660  a3ba a8                         TAY
  9661  a3bb b9d06c                     LDA B64_TABLE,Y
  9662  a3be 8daa39                     STA B64E_OUT+41
  9663                                  ; c2 = (B1 and $0F)<<2
  9664  a3c1 adaf39                     LDA B64E_B1
  9665  a3c4 290f                       AND #$0F
  9666  a3c6 0a                         ASL
  9667  a3c7 0a                         ASL
  9668  a3c8 a8                         TAY
  9669  a3c9 b9d06c                     LDA B64_TABLE,Y
  9670  a3cc 8dab39                     STA B64E_OUT+42
  9671  a3cf 60                         RTS
  9672                          
  9673                          ; ================================================================
  9674                          ; COMPUTE_C64_ID256 - 256-bit publicId in C64_IDSTR (16 base64url chars)
  9675                          ;   = base64url( SHA-256(HKDF_OKM[0:32])[0:12] ).  One SHA-256 block
  9676                          ;   (32 data bytes + padding). Jumps to the shared digest/base64 tail.
  9677                          ; ================================================================
  9678                          COMPUTE_C64_ID256
  9679                                  ; encKey = HKDF_OKM[0:32] -> SHA_BLK[0:32]
  9680  a3d0 a21f                       LDX #31
  9681  a3d2 bde038             C256_CP LDA HKDF_OKM,X
  9682  a3d5 9da935                     STA SHA_BLK,X
  9683  a3d8 ca                         DEX
  9684  a3d9 10f7                       BPL C256_CP
  9685                                  ; clear SHA_BLK[32:64]
  9686  a3db a220                       LDX #32
  9687  a3dd a900               C256_CL LDA #$00
  9688  a3df 9da935                     STA SHA_BLK,X
  9689  a3e2 e8                         INX
  9690  a3e3 e040                       CPX #64
  9691  a3e5 d0f6                       BNE C256_CL
  9692                                  ; SHA-256 padding: $80 op pos 32; bitlengte = 256 = $0100
  9693  a3e7 a980                       LDA #$80
  9694  a3e9 8dc935                     STA SHA_BLK+32
  9695  a3ec a901                       LDA #$01            ; 256 bits high byte
  9696  a3ee 8de735                     STA SHA_BLK+62
  9697  a3f1 a900                       LDA #$00            ; 256 bits low byte
  9698  a3f3 8de835                     STA SHA_BLK+63
  9699  a3f6 208f17                     JSR SHA_INIT
  9700  a3f9 20ac16                     JSR SHA_EXPAND
  9701  a3fc 203018                     JSR SHA_COMPRESS
  9702  a3ff 4c4229                     JMP CC4_DIGEST_TAIL   ; gedeelde digest-copy + B64URL_12BYTES + RTS
  9703                          
  9704                          ; ================================================================
  9705                          ; SHAREABLE_BUILD256 - eigen shareable in SHARE_STR (nul-beeindigd):
  9706                          ;   base64url(HKDF_OKM[0:32]) '.' base64url(SK_PUB)
  9707                          ;   43 + 1 + 43 + null = 88 bytes. Requires SIGN_SETUP run (SK_PUB).
  9708                          ; ================================================================
  9709                          SHAREABLE_BUILD256
  9710                                  ; --- segment 1: encKey = HKDF_OKM[0:32] ---
  9711  a402 a21f                       LDX #31
  9712  a404 bde038             SB_C1   LDA HKDF_OKM,X
  9713  a407 9d6139                     STA B64E_IN,X
  9714  a40a ca                         DEX
  9715  a40b 10f7                       BPL SB_C1
  9716  a40d 2007a3                     JSR B64URL_ENCODE32
  9717  a410 a22a                       LDX #42
  9718  a412 bd8139             SB_O1   LDA B64E_OUT,X
  9719  a415 9db239                     STA SHARE_STR,X
  9720  a418 ca                         DEX
  9721  a419 10f7                       BPL SB_O1
  9722                                  ; scheider '.'
  9723  a41b a92e                       LDA #$2E
  9724  a41d 8ddd39                     STA SHARE_STR+43
  9725                                  ; --- segment 2: signPubkey = SK_PUB ---
  9726  a420 a21f                       LDX #31
  9727  a422 bde09d             SB_C2   LDA SK_PUB,X
  9728  a425 9d6139                     STA B64E_IN,X
  9729  a428 ca                         DEX
  9730  a429 10f7                       BPL SB_C2
  9731  a42b 2007a3                     JSR B64URL_ENCODE32
  9732  a42e a22a                       LDX #42
  9733  a430 bd8139             SB_O2   LDA B64E_OUT,X
  9734  a433 9dde39                     STA SHARE_STR+44,X
  9735  a436 ca                         DEX
  9736  a437 10f7                       BPL SB_O2
  9737                                  ; scheider '.' na segment 2
  9738  a439 a92e                       LDA #$2E
  9739  a43b 8d093a                     STA SHARE_STR+87
  9740                                  ; --- segment 3: relayWss = btoa(wssUrl), voorberekende base64 ---
  9741  a43e a22b                       LDX #43
  9742  a440 bd523a             SB_O3   LDA STR_RELAY_B64,X
  9743  a443 9d0a3a                     STA SHARE_STR+88,X
  9744  a446 ca                         DEX
  9745  a447 10f7                       BPL SB_O3
  9746                                  ; null-terminator
  9747  a449 a900                       LDA #$00
  9748  a44b 8d363a                     STA SHARE_STR+132
  9749  a44e 60                         RTS
  9750                          
  9751                          ; ================================================================
  9752                          ; SHOW_SHAREABLE - show own shareable (only in 256-bit mode).
  9753                          ;   Builds SHARE_STR fresh (SHAREABLE_BUILD256) and prints label + string.
  9754                          ;   Requires HKDF_OKM[0:32] + SK_PUB filled (DERIVE_KEYPAIR + SIGN_SETUP).
  9755                          ; ================================================================
  9756                          SHOW_SHAREABLE
  9757  a44f ad6039                     LDA USE_256
  9758  a452 d001                       BNE SS_GO
  9759  a454 60                         RTS                 ; 128-bit: show nothing
  9760  a455 2002a4             SS_GO   JSR SHAREABLE_BUILD256
  9761  a458 a99e                       LDA #$9E            ; yellow
  9762  a45a 20ba0c                     JSR PRINT_CHR
  9763  a45d a97e                       LDA #<STR_SHARE_LBL
  9764  a45f 85fb                       STA $FB
  9765  a461 a93a                       LDA #>STR_SHARE_LBL
  9766  a463 85fc                       STA $FC
  9767  a465 20cf0c                     JSR PRINT_STR_FB
  9768  a468 a90d                       LDA #$0D
  9769  a46a 20ba0c                     JSR PRINT_CHR
  9770  a46d a905                       LDA #$05            ; White
  9771  a46f 20ba0c                     JSR PRINT_CHR
  9772  a472 a9b2                       LDA #<SHARE_STR
  9773  a474 85fb                       STA $FB
  9774  a476 a939                       LDA #>SHARE_STR
  9775  a478 85fc                       STA $FC
  9776  a47a 20cf0c                     JSR PRINT_STR_FB
  9777  a47d a90d                       LDA #$0D
  9778  a47f 20ba0c                     JSR PRINT_CHR
  9779  a482 60                         RTS
  9780                          
  9781                          ; ================================================================
  9782                          ; MC_BOOT_MENU - choose identity path at boot.
  9783                          ;   '1' -> MC_SETUP (128-bit, paste)   '2' -> MC_LOGIN (256-bit, passphrase)
  9784                          ;   Tail-JMP to the chosen routine (which RTSes to the init).
  9785                          ; ================================================================
  9786                          ; ================================================================
  9787                          ; MC_BOOT_MENU REMOVED (AES128 cleanup) - never called,
  9788                          ; ACME itself flagged this as 'unused'. Stub + pin keeps RCV_DECRYPT_
  9789                          ; DISPATCH after this byte-identical.
  9790                          ; ================================================================
  9791                          MC_BOOT_MENU
  9792  a483 60                         RTS
  9793                          * = $A4B4                       ; pin: RCV_DECRYPT_DISPATCH at original address
  9794                          
  9795                          ; ================================================================
  9796                          ; RCV_DECRYPT_DISPATCH - decrypt received message per USE_256.
  9797                          ;   Call AFTER loading AES_NONCE (common). Input:
  9798                          ;     RCV_CT (ct||tag), RCV_PT_LEN (= CT_LEN-16, 16-bit), AES_NONCE.
  9799                          ;   Out: GCM_CTBUF = plaintext ; carry=1 on tag error (both paths).
  9800                          ; ================================================================
  9801                          RCV_DECRYPT_DISPATCH
  9802  a4b4 ad6039                     LDA USE_256
  9803  a4b7 d029                       BNE RDD_256
  9804                                  ; --- 128-bit: AES-128-GCM with KEY_SELF ---
  9805  a4b9 a20f                       LDX #15
  9806  a4bb bd2039             RDD_KL  LDA KEY_SELF,X
  9807  a4be 9ded52                     STA GCM_IN_KEY,X
  9808  a4c1 ca                         DEX
  9809  a4c2 10f7                       BPL RDD_KL
  9810  a4c4 a9de                       LDA #<RCV_CT
  9811  a4c6 8dfd52                     STA GCM_PT_PTR+0
  9812  a4c9 a95a                       LDA #>RCV_CT
  9813  a4cb 8dfe52                     STA GCM_PT_PTR+1
  9814  a4ce adbf5a                     LDA RCV_PT_LEN+0
  9815  a4d1 8dff52                     STA GCM_PT_LEN+0
  9816  a4d4 adc05a                     LDA RCV_PT_LEN+1
  9817  a4d7 8d0053                     STA GCM_PT_LEN+1
  9818  a4da a901                       LDA #1
  9819  a4dc 8d8152                     STA GCM_DO_VERIFY
  9820  a4df 4c2a2e                     JMP AES_GCM_DECRYPT     ; tail: set carry + GCM_CTBUF, RTSes to caller
  9821                          RDD_256
  9822                                  ; --- 256-bit: AES-256-GCM with HKDF_OKM[0:32] ---
  9823  a4e2 a21f                       LDX #31
  9824  a4e4 bde038             RDD_KS  LDA HKDF_OKM,X
  9825  a4e7 9dcf4a                     STA AES_KEY,X
  9826  a4ea ca                         DEX
  9827  a4eb 10f7                       BPL RDD_KS
  9828                                  ; CTBUF = RCV_CT[0:PT_LEN]
  9829  a4ed a9de8da09e                 LDA #<RCV_CT : STA MSG_PTR
  9830  a4f2 a95a8da19e                 LDA #>RCV_CT : STA MSG_PTR+1
  9831  a4f7 adbf5a8da29e               LDA RCV_PT_LEN+0 : STA MSG_LEN
  9832  a4fd adc05a8da39e               LDA RCV_PT_LEN+1 : STA MSG_LEN+1
  9833  a503 a9738504                   LDA #<CTBUF : STA CDST
  9834  a507 a94d8505                   LDA #>CTBUF : STA CDST+1
  9835  a50b 20c687                     JSR COPY_M
  9836                                  ; GCM_RECV_TAG = RCV_CT[PT_LEN : PT_LEN+16]
  9837  a50e a9de186dbf5a8da0...        LDA #<RCV_CT : CLC : ADC RCV_PT_LEN+0 : STA MSG_PTR
  9838  a517 a95a6dc05a8da19e           LDA #>RCV_CT : ADC RCV_PT_LEN+1 : STA MSG_PTR+1
  9839  a51f a9108da29e                 LDA #16 : STA MSG_LEN
  9840  a524 a9008da39e                 LDA #0  : STA MSG_LEN+1
  9841  a529 a9718504                   LDA #<GCM_RECV_TAG : STA CDST
  9842  a52d a9528505                   LDA #>GCM_RECV_TAG : STA CDST+1
  9843  a531 20c687                     JSR COPY_M
  9844                                  ; PTLEN = RCV_PT_LEN
  9845  a534 adbf5a8df14a               LDA RCV_PT_LEN+0 : STA PTLEN+0
  9846  a53a adc05a8df24a               LDA RCV_PT_LEN+1 : STA PTLEN+1
  9847  a540 206e48                     JSR AGD256              ; -> PTBUF ; VERIFY_FAIL
  9848                                  ; PTBUF -> GCM_CTBUF (so the existing parser works unchanged)
  9849  a543 a9f38da09e                 LDA #<PTBUF : STA MSG_PTR
  9850  a548 a94a8da19e                 LDA #>PTBUF : STA MSG_PTR+1
  9851  a54d adbf5a8da29e               LDA RCV_PT_LEN+0 : STA MSG_LEN
  9852  a553 adc05a8da39e               LDA RCV_PT_LEN+1 : STA MSG_LEN+1
  9853  a559 a9018504                   LDA #<GCM_CTBUF : STA CDST
  9854  a55d a9538505                   LDA #>GCM_CTBUF : STA CDST+1
  9855  a561 20c687                     JSR COPY_M
  9856                                  ; carry from VERIFY_FAIL (1=error -> C=1)
  9857  a564 adf04a                     LDA VERIFY_FAIL
  9858  a567 f002                       BEQ RDD_OK
  9859  a569 38                         SEC
  9860  a56a 60                         RTS
  9861  a56b 18                 RDD_OK  CLC
  9862  a56c 60                         RTS
  9863                          
  9864                          ; ================================================================
  9865                          ; COMPUTE_PEER_ID256 - PEER_IDSTR = base64url(SHA-256(KEY_PEER256)[0:12]).
  9866                          ;   Standalone (does not touch C64_IDSTR). Reuses B64E_* scratch.
  9867                          ; ================================================================
  9868                          COMPUTE_PEER_ID256
  9869  a56d a21f                       LDX #31
  9870  a56f bd4039             CP2_CP  LDA KEY_PEER256,X
  9871  a572 9da935                     STA SHA_BLK,X
  9872  a575 ca                         DEX
  9873  a576 10f7                       BPL CP2_CP
  9874  a578 a220                       LDX #32
  9875  a57a a900               CP2_CL  LDA #$00
  9876  a57c 9da935                     STA SHA_BLK,X
  9877  a57f e8                         INX
  9878  a580 e040                       CPX #64
  9879  a582 d0f6                       BNE CP2_CL
  9880  a584 a980                       LDA #$80
  9881  a586 8dc935                     STA SHA_BLK+32
  9882  a589 a901                       LDA #$01
  9883  a58b 8de735                     STA SHA_BLK+62
  9884  a58e a900                       LDA #$00
  9885  a590 8de835                     STA SHA_BLK+63
  9886  a593 208f17                     JSR SHA_INIT
  9887  a596 20ac16                     JSR SHA_EXPAND
  9888  a599 203018                     JSR SHA_COMPRESS
  9889                                  ; digest 12 bytes (big-endian per word) -> PEER_IDBYTES
  9890  a59c ad7e358ddf3a               LDA SHA_H0+3 : STA PEER_IDBYTES+0
  9891  a5a2 ad7d358de03a               LDA SHA_H0+2 : STA PEER_IDBYTES+1
  9892  a5a8 ad7c358de13a               LDA SHA_H0+1 : STA PEER_IDBYTES+2
  9893  a5ae ad7b358de23a               LDA SHA_H0+0 : STA PEER_IDBYTES+3
  9894  a5b4 ad82358de33a               LDA SHA_H1+3 : STA PEER_IDBYTES+4
  9895  a5ba ad81358de43a               LDA SHA_H1+2 : STA PEER_IDBYTES+5
  9896  a5c0 ad80358de53a               LDA SHA_H1+1 : STA PEER_IDBYTES+6
  9897  a5c6 ad7f358de63a               LDA SHA_H1+0 : STA PEER_IDBYTES+7
  9898  a5cc ad86358de73a               LDA SHA_H2+3 : STA PEER_IDBYTES+8
  9899  a5d2 ad85358de83a               LDA SHA_H2+2 : STA PEER_IDBYTES+9
  9900  a5d8 ad84358de93a               LDA SHA_H2+1 : STA PEER_IDBYTES+10
  9901  a5de ad83358dea3a               LDA SHA_H2+0 : STA PEER_IDBYTES+11
  9902                                  ; base64url 12 bytes -> PEER_IDSTR[16] (4 groepen 3->4)
  9903  a5e4 a900                       LDA #0
  9904  a5e6 8dad39                     STA B64E_GRP
  9905  a5e9 adad39             CP2_GLP LDA B64E_GRP
  9906  a5ec c904                       CMP #4
  9907  a5ee d003                       BNE CP2_GC
  9908  a5f0 4c69a6                     JMP CP2_DONE
  9909  a5f3 0a                 CP2_GC  ASL
  9910  a5f4 18                         CLC
  9911  a5f5 6dad39                     ADC B64E_GRP
  9912  a5f8 aa                         TAX
  9913  a5f9 bddf3a                     LDA PEER_IDBYTES,X
  9914  a5fc 8dae39                     STA B64E_B0
  9915  a5ff bde03a                     LDA PEER_IDBYTES+1,X
  9916  a602 8daf39                     STA B64E_B1
  9917  a605 bde13a                     LDA PEER_IDBYTES+2,X
  9918  a608 8db039                     STA B64E_B2
  9919  a60b adad39                     LDA B64E_GRP
  9920  a60e 0a                         ASL
  9921  a60f 0a                         ASL
  9922  a610 aa                         TAX
  9923  a611 adae39                     LDA B64E_B0
  9924  a614 4a                         LSR
  9925  a615 4a                         LSR
  9926  a616 a8                         TAY
  9927  a617 b9d06c                     LDA B64_TABLE,Y
  9928  a61a 9d3c40                     STA PEER_IDSTR,X
  9929  a61d adae39                     LDA B64E_B0
  9930  a620 2903                       AND #$03
  9931  a622 0a                         ASL
  9932  a623 0a                         ASL
  9933  a624 0a                         ASL
  9934  a625 0a                         ASL
  9935  a626 8db139                     STA B64E_T
  9936  a629 adaf39                     LDA B64E_B1
  9937  a62c 4a                         LSR
  9938  a62d 4a                         LSR
  9939  a62e 4a                         LSR
  9940  a62f 4a                         LSR
  9941  a630 0db139                     ORA B64E_T
  9942  a633 a8                         TAY
  9943  a634 b9d06c                     LDA B64_TABLE,Y
  9944  a637 9d3d40                     STA PEER_IDSTR+1,X
  9945  a63a adaf39                     LDA B64E_B1
  9946  a63d 290f                       AND #$0F
  9947  a63f 0a                         ASL
  9948  a640 0a                         ASL
  9949  a641 8db139                     STA B64E_T
  9950  a644 adb039                     LDA B64E_B2
  9951  a647 4a                         LSR
  9952  a648 4a                         LSR
  9953  a649 4a                         LSR
  9954  a64a 4a                         LSR
  9955  a64b 4a                         LSR
  9956  a64c 4a                         LSR
  9957  a64d 0db139                     ORA B64E_T
  9958  a650 a8                         TAY
  9959  a651 b9d06c                     LDA B64_TABLE,Y
  9960  a654 9d3e40                     STA PEER_IDSTR+2,X
  9961  a657 adb039                     LDA B64E_B2
  9962  a65a 293f                       AND #$3F
  9963  a65c a8                         TAY
  9964  a65d b9d06c                     LDA B64_TABLE,Y
  9965  a660 9d3f40                     STA PEER_IDSTR+3,X
  9966  a663 eead39                     INC B64E_GRP
  9967  a666 4ce9a5                     JMP CP2_GLP
  9968                          CP2_DONE
  9969  a669 a900                       LDA #0
  9970  a66b 8d4c40                     STA PEER_IDSTR+16
  9971  a66e 60                         RTS
  9972                          
  9973                          ; ================================================================
  9974                          ; MC_PEER_SETUP256 - ask for contact shareable; empty = to yourself.
  9975                          ;   Fills KEY_PEER256 (encrypt outgoing) + PEER_IDSTR ('to' field).
  9976                          ; ================================================================
  9977                          MC_PEER_SETUP256
  9978  a66f a90d                       LDA #$0D
  9979  a671 20ba0c                     JSR PRINT_CHR
  9980  a674 a99e                       LDA #$9E            ; yellow
  9981  a676 20ba0c                     JSR PRINT_CHR
  9982  a679 a9eb                       LDA #<STR_PEER_P
  9983  a67b 85fb                       STA $FB
  9984  a67d a93a                       LDA #>STR_PEER_P
  9985  a67f 85fc                       STA $FC
  9986  a681 20cf0c                     JSR PRINT_STR_FB
  9987  a684 a905                       LDA #$05            ; White
  9988  a686 20ba0c                     JSR PRINT_CHR
  9989  a689 20140c                     JSR INPUT_LINE      ; -> INP_BUF, INP_LEN
  9990  a68c adcd43                     LDA INP_LEN
  9991  a68f d017                       BNE MPS_PEER
  9992                                  ; --- empty: self ---
  9993  a691 a21f                       LDX #31
  9994  a693 bde038             MPS_SK  LDA HKDF_OKM,X
  9995  a696 9d4039                     STA KEY_PEER256,X
  9996  a699 ca                         DEX
  9997  a69a 10f7                       BPL MPS_SK
  9998  a69c a210                       LDX #16
  9999  a69e bd935a             MPS_SI  LDA C64_IDSTR,X
 10000  a6a1 9d3c40                     STA PEER_IDSTR,X
 10001  a6a4 ca                         DEX
 10002  a6a5 10f7                       BPL MPS_SI
 10003  a6a7 60                         RTS
 10004                          MPS_PEER
 10005                                  ; isolate 1st segment (up to '.') -> INP_LEN
 10006  a6a8 a200                       LDX #0
 10007  a6aa bdcd42             MPS_DOT LDA INP_BUF,X
 10008  a6ad c92e                       CMP #$2E            ; '.'
 10009  a6af f009                       BEQ MPS_CUT
 10010  a6b1 e8                         INX
 10011  a6b2 eccd43                     CPX INP_LEN
 10012  a6b5 d0f3                       BNE MPS_DOT
 10013  a6b7 4cbda6                     JMP MPS_DEC
 10014  a6ba 8ecd43             MPS_CUT STX INP_LEN
 10015  a6bd 20eda1             MPS_DEC JSR B64URL_DECODE43 ; INP_BUF[0:43] -> KEY_PEER256 ; C=1 error
 10016  a6c0 900e                       BCC MPS_OK
 10017  a6c2 a907                       LDA #<STR_PEER_ERR
 10018  a6c4 85fb                       STA $FB
 10019  a6c6 a93b                       LDA #>STR_PEER_ERR
 10020  a6c8 85fc                       STA $FC
 10021  a6ca 20cf0c                     JSR PRINT_STR_FB
 10022  a6cd 4c6fa6                     JMP MC_PEER_SETUP256
 10023  a6d0 206da5             MPS_OK  JSR COMPUTE_PEER_ID256
 10024  a6d3 60                         RTS
 10025                          

; ******** Source: comb_keepalive.inc
     1                          ; ================================================================
     2                          ; B: vaste-basis comb scalar-mult (h=4).  ACC = SCALAR * B
     3                          ;   Replaces LOAD_B + SCALAR_MUL for R=r*B (and A=a*B).
     4                          ;   Per step k=63..0: ACC=2*ACC ; idx from 4 bits (k,k+64,k+128,k+192)
     5                          ;   via SM_TESTBIT ; if idx: ACC += COMB_TABLE[idx].
