  7788                          ; --- Ch(e,f,g) = (e & f) ^ (~e & g) -> SHA_ACC ---
  7789                          CH_EFG  ; SHA_ACC = e & f
  7790  7cb7 a207                       LDX #7
  7791  7cb9 bd8a92             CH_CE   LDA SHA_AH+32,X        ; e
  7792  7cbc 3d9292                     AND SHA_AH+40,X        ; f
  7793  7cbf 9dd292                     STA SHA_ACC,X
  7794  7cc2 ca                         DEX
  7795  7cc3 10f4                       BPL CH_CE
  7796                                  ; SHA_TC = (~e) & g
  7797  7cc5 a207                       LDX #7
  7798  7cc7 bd8a92             CH_NE   LDA SHA_AH+32,X        ; e
  7799  7cca 49ff                       EOR #$FF               ; ~e
  7800  7ccc 3d9a92                     AND SHA_AH+48,X        ; g
  7801  7ccf 9dca92                     STA SHA_TC,X
  7802  7cd2 ca                         DEX
  7803  7cd3 10f2                       BPL CH_NE
  7804                                  ; SHA_ACC ^= SHA_TC
  7805  7cd5 a207                       LDX #7
  7806  7cd7 bdd292             CH_XR   LDA SHA_ACC,X
  7807  7cda 5dca92                     EOR SHA_TC,X
  7808  7cdd 9dd292                     STA SHA_ACC,X
  7809  7ce0 ca                         DEX
  7810  7ce1 10f4                       BPL CH_XR
  7811  7ce3 60                         RTS
  7812                          
  7813                          ; --- Maj(a,b,c) = (a&b)^(a&c)^(b&c) -> SHA_ACC ---
  7814  7ce4 a207               MAJ_ABC LDX #7
  7815  7ce6 bd6a92             MJ_AB   LDA SHA_AH+0,X         ; a
  7816  7ce9 3d7292                     AND SHA_AH+8,X         ; b
  7817  7cec 9dd292                     STA SHA_ACC,X
  7818  7cef ca                         DEX
  7819  7cf0 10f4                       BPL MJ_AB
  7820  7cf2 a207                       LDX #7
  7821  7cf4 bd6a92             MJ_AC   LDA SHA_AH+0,X         ; a
  7822  7cf7 3d7a92                     AND SHA_AH+16,X        ; c
  7823  7cfa 9dca92                     STA SHA_TC,X
  7824  7cfd ca                         DEX
  7825  7cfe 10f4                       BPL MJ_AC
  7826  7d00 a207                       LDX #7
  7827  7d02 bdd292             MJ_X1   LDA SHA_ACC,X
  7828  7d05 5dca92                     EOR SHA_TC,X
  7829  7d08 9dd292                     STA SHA_ACC,X
  7830  7d0b ca                         DEX
  7831  7d0c 10f4                       BPL MJ_X1
  7832  7d0e a207                       LDX #7
  7833  7d10 bd7292             MJ_BC   LDA SHA_AH+8,X         ; b
  7834  7d13 3d7a92                     AND SHA_AH+16,X        ; c
  7835  7d16 9dca92                     STA SHA_TC,X
  7836  7d19 ca                         DEX
  7837  7d1a 10f4                       BPL MJ_BC
  7838  7d1c a207                       LDX #7
  7839  7d1e bdd292             MJ_X2   LDA SHA_ACC,X
  7840  7d21 5dca92                     EOR SHA_TC,X
  7841  7d24 9dd292                     STA SHA_ACC,X
  7842  7d27 ca                         DEX
  7843  7d28 10f4                       BPL MJ_X2
  7844  7d2a 60                         RTS
  7845                          
  7846                          ; --- word-copy helpers within SHA_AH (from source to target) ---
  7847  7d2b a207               CP_W6_W7 LDX #7
  7848  7d2d bd9a92             C67     LDA SHA_AH+48,X
  7849  7d30 9da292                     STA SHA_AH+56,X
  7850  7d33 ca                         DEX
  7851  7d34 10f7                       BPL C67
  7852  7d36 60                         RTS
  7853  7d37 a207               CP_W5_W6 LDX #7
  7854  7d39 bd9292             C56     LDA SHA_AH+40,X
  7855  7d3c 9d9a92                     STA SHA_AH+48,X
  7856  7d3f ca                         DEX
  7857  7d40 10f7                       BPL C56
  7858  7d42 60                         RTS
  7859  7d43 a207               CP_W4_W5 LDX #7
  7860  7d45 bd8a92             C45     LDA SHA_AH+32,X
  7861  7d48 9d9292                     STA SHA_AH+40,X
  7862  7d4b ca                         DEX
  7863  7d4c 10f7                       BPL C45
  7864  7d4e 60                         RTS
  7865  7d4f a207               CP_W2_W3 LDX #7
  7866  7d51 bd7a92             C23     LDA SHA_AH+16,X
  7867  7d54 9d8292                     STA SHA_AH+24,X
  7868  7d57 ca                         DEX
  7869  7d58 10f7                       BPL C23
