  8509                          ; CLAMP : Ed25519-scalarklem op CLBUF(32) in-place
  8510                          ;   a[0]  &= 0xF8 ; a[31] &= 0x7F ; a[31] |= 0x40
  8511                          ; ================================================================
  8512                          CLAMP
  8513  85d5 adef9a29f88def9a           lda CLBUF+0  : and #$F8 : sta CLBUF+0
  8514  85dd ad0e9b297f09408d...        lda CLBUF+31 : and #$7F : ora #$40 : sta CLBUF+31
  8515  85e7 60                         rts
  8516                          
  8517                          
  8518                          ; ================================================================
  8519                          ; SIGN-FLOW  (RFC 8032 / pynacl seed-variant)
  8520                          ; ================================================================
  8521                          ; B -> PIN (load base point)
  8522                          LOAD_B
  8523  85e8 a21f                       LDX #31
  8524  85ea bd009d9d078c       LB_L    LDA BX_CONST,X : STA PIN_X,X
  8525  85f0 bd209d9d278c               LDA BY_CONST,X : STA PIN_Y,X
  8526  85f6 bd409d9d478c               LDA BZ_CONST,X : STA PIN_Z,X
  8527  85fc bd609d9d678c               LDA BT_CONST,X : STA PIN_T,X
  8528  8602 ca                         DEX
  8529  8603 10e5                       BPL LB_L
  8530  8605 60                         RTS
  8531                          
  8532                          ; ACC (extended) -> PX/PY/PZ (for ENCODE)
  8533                          ACC_TO_PXYZ
  8534  8606 a21f                       LDX #31
  8535  8608 bd878b9d8a8e       AP_L    LDA ACC_X,X : STA PX,X
  8536  860e bda78b9daa8e               LDA ACC_Y,X : STA PY,X
  8537  8614 bdc78b9dca8e               LDA ACC_Z,X : STA PZ,X
  8538  861a ca                         DEX
  8539  861b 10eb                       BPL AP_L
  8540  861d 60                         RTS
  8541                          
  8542                          ; ----------------------------------------------------------------
  8543                          ; SIGN_SETUP : SEED(32) -> SK_A (geklemde scalar a), SK_PREFIX, SK_PUB(A)
  8544                          ;   h = SHA512(seed) ; a = CLAMP(h[0:32]) ; prefix = h[32:64]
  8545                          ;   A = ENCODE(a*B)   (1 scalar mult, the expensive step)
  8546                          ; ----------------------------------------------------------------
  8547                          SIGN_SETUP
  8548  861e 08                         PHP
  8549  861f 78                         SEI         ; IRQ off during scalar mult
  8550                                  ; --- NMI sources OFF during scalar mult --------------------
  8551                                  ; SIGN_SETUP runs BEFORE INSTALL_RX_NMI; $0318 here still points
  8552                                  ; to the KERNAL default NMI handler, which on an ACIA-NMI does
  8553                                  ; RS232 processing and clobbers zeropage $F7-$FA (the scalar-mult
  8554                                  ; pointers). SEI does not mask NMI -> turn the sources off themselves.
  8555  8620 a90b8d02de                 LDA #$0B : STA $DE02        ; ACIA: RX-IRQ OFF
  8556  8625 a97f8d0ddd                 LDA #$7F : STA $DD0D        ; CIA2: clear all NMI enables
  8557  862a ad0ddd                     LDA $DD0D                   ; clear pending CIA2-NMI
  8558  862d ad01de                     LDA $DE01                   ; ACIA-status lezen
  8559  8630 ad00de                     LDA $DE00                   ; ACIA-data lezen -> RDRF/NMI weg
  8560  8633 a98085f7                   LDA #<SEED : STA SRC
  8561  8637 a99d85f8                   LDA #>SEED : STA SRC+1
  8562  863b a9208d9a99                 LDA #32 : STA SHA5_MLEN
  8563  8640 a9008d9b99                 LDA #0  : STA SHA5_MLEN+1
  8564  8645 20d37d                     JSR SHA512
  8565                                  ; a = CLAMP(h[0:32])
  8566  8648 a21f                       LDX #31
  8567  864a bdda929def9aca10...SS_CA   LDA SHA_DIGEST,X : STA CLBUF,X : DEX : BPL SS_CA
  8568  8653 20d585                     JSR CLAMP
  8569  8656 a21f                       LDX #31
  8570  8658 bdef9a9da09d9d87...SS_CB   LDA CLBUF,X : STA SK_A,X : STA SCALAR,X : DEX : BPL SS_CB
  8571                                  ; prefix = h[32:64]
  8572  8664 a21f                       LDX #31
  8573  8666 bdfa929dc09dca10...SS_CP   LDA SHA_DIGEST+32,X : STA SK_PREFIX,X : DEX : BPL SS_CP
  8574                                  ; A = encode(a*B)
  8575  866f 20d4a6                     JSR COMB_SCALAR_MUL     ; B: fixed-base comb (was LOAD_B+SCALAR_MUL)
  8576  8672 200686                     JSR ACC_TO_PXYZ
  8577  8675 202a78                     JSR ENCODE
  8578  8678 a21f                       LDX #31
  8579  867a bd4a8f9de09dca10...SS_CK   LDA ENC,X : STA SK_PUB,X : DEX : BPL SS_CK
  8580  8683 a9098d02de                 LDA #$09 : STA $DE02        ; ACIA: RX-IRQ weer AAN
  8581  8688 28                         PLP         ; restore I flag
  8582  8689 60                         RTS
  8583                          
  8584                          ; ----------------------------------------------------------------
  8585                          ; SIGN : signs (MSG_PTR)[0..MSG_LEN-1] with cached SK_A/SK_PREFIX/SK_PUB
  8586                          ;   r = MODL(SHA512(prefix||M)) ; R = encode(r*B)
  8587                          ;   k = MODL(SHA512(R||A||M))   ; S = (r + k*a) mod L ; sig = R||S
  8588                          ; MSG_LEN is 16-bit (lo,hi); M up to 1280 bytes (wire blob ~1KB).
  8589                          ; M read via MSG_PTR; standalone test sets MSG_PTR = MSG_BUF.
  8590                          ; ----------------------------------------------------------------
  8591                          SIGN
  8592  868a 08                         PHP
  8593  868b 78                         SEI         ; IRQ off during scalar mult
  8594  868c 202187                     JSR SIGN_R            ; -> SC_R = SCALAR = r ; CONCAT verbruikt
  8595                                  ; R = encode(r*B)
  8596  868f 20d4a6                     JSR COMB_SCALAR_MUL     ; B: fixed-base comb (was LOAD_B+SCALAR_MUL)
  8597  8692 200686                     JSR ACC_TO_PXYZ
  8598  8695 202a78                     JSR ENCODE
  8599  8698 a21f                       LDX #31
  8600  869a bd4a8f9d409eca10...SG_RR   LDA ENC,X : STA SIG_R,X : DEX : BPL SG_RR
  8601                          
  8602                                  ; --- CONCAT = R(32) || A(32) || M ; len = 64+MSG_LEN ---
  8603  86a3 a21f                       LDX #31
  8604  86a5 bd409e9d80c2       SG_P2   LDA SIG_R,X   : STA CONCAT,X
  8605  86ab bde09d9da0c2               LDA SK_PUB,X  : STA CONCAT+32,X
  8606  86b1 ca10f1                     DEX : BPL SG_P2
  8607  86b4 a9c08504                   LDA #<(CONCAT+64) : STA CDST
  8608  86b8 a9c28505                   LDA #>(CONCAT+64) : STA CDST+1
  8609  86bc 207087                     JSR COPY_M
  8610                                  ; SHA5_MLEN = 64 + MSG_LEN (16-bit, with carry)
  8611  86bf ada29e1869408d9a...        LDA MSG_LEN   : CLC : ADC #64 : STA SHA5_MLEN
  8612  86c8 ada39e69008d9b99           LDA MSG_LEN+1 : ADC #0        : STA SHA5_MLEN+1
  8613  86d0 a98085f7                   LDA #<CONCAT : STA SRC
  8614  86d4 a9c285f8                   LDA #>CONCAT : STA SRC+1
  8615  86d8 20d37d                     JSR SHA512
  8616                                  ; k = MODL(digest)
  8617  86db a23f                       LDX #63
  8618  86dd bdda929d2f9bca10...SG_X2   LDA SHA_DIGEST,X : STA XIN,X : DEX : BPL SG_X2
  8619  86e6 20a17f                     JSR MODL
  8620  86e9 a21f                       LDX #31
  8621  86eb bd6f9b9d209eca10...SG_K1   LDA ROUT,X : STA SC_K,X : DEX : BPL SG_K1
  8622                          
  8623                                  ; --- S = (r + k*a) mod L  via MULADD_S(RIN_S=r,KIN_S=k,AIN_S=a) ---
  8624  86f4 a21f                       LDX #31
  8625  86f6 bd009e9d6f9a       SG_MS   LDA SC_R,X : STA RIN_S,X
  8626  86fc bd209e9d8f9a               LDA SC_K,X : STA KIN_S,X
  8627  8702 bda09d9daf9a               LDA SK_A,X : STA AIN_S,X
  8628  8708 ca10eb                     DEX : BPL SG_MS
  8629  870b 207c85                     JSR MULADD_S          ; -> SOUT = S
  8630                          
  8631                                  ; --- sig = R || S ---
  8632  870e a21f                       LDX #31
  8633  8710 bd409e9d609e       SG_OUT  LDA SIG_R,X : STA SIG_OUT,X
  8634  8716 bdcf9a9d809e               LDA SOUT,X  : STA SIG_OUT+32,X
  8635  871c ca10f1                     DEX : BPL SG_OUT
  8636  871f 28                         PLP         ; restore I flag
  8637  8720 60                         RTS
  8638                          
  8639                          ; ----------------------------------------------------------------
  8640                          ; SIGN_R : phase 1 of SIGN + standalone debug entry.
  8641                          ;   CONCAT = prefix(32) || M ; r = MODL(SHA512(CONCAT)) -> SC_R + SCALAR
  8642                          ; No scalar mult -> fast; sim checks r cheaply over many lengths
  8643                          ; (same COPY_M + 16-bit SHA5_MLEN as phase 2, so a full proof).
  8644                          ; ----------------------------------------------------------------
  8645                          SIGN_R
  8646  8721 a21f                       LDX #31
  8647  8723 bdc09d9d80c2ca10...SG_P1   LDA SK_PREFIX,X : STA CONCAT,X : DEX : BPL SG_P1
  8648  872c a9a08504                   LDA #<(CONCAT+32) : STA CDST
  8649  8730 a9c28505                   LDA #>(CONCAT+32) : STA CDST+1
  8650  8734 207087                     JSR COPY_M
  8651                                  ; SHA5_MLEN = 32 + MSG_LEN (16-bit, with carry)
  8652  8737 ada29e1869208d9a...        LDA MSG_LEN   : CLC : ADC #32 : STA SHA5_MLEN
  8653  8740 ada39e69008d9b99           LDA MSG_LEN+1 : ADC #0        : STA SHA5_MLEN+1
  8654  8748 a98085f7                   LDA #<CONCAT : STA SRC
  8655  874c a9c285f8                   LDA #>CONCAT : STA SRC+1
  8656  8750 20d37d                     JSR SHA512
  8657  8753 a23f                       LDX #63
  8658  8755 bdda929d2f9bca10...SG_X1   LDA SHA_DIGEST,X : STA XIN,X : DEX : BPL SG_X1
  8659  875e 20a17f                     JSR MODL
  8660  8761 a21f                       LDX #31
  8661  8763 bd6f9b9d009e9d87...SG_R1   LDA ROUT,X : STA SC_R,X : STA SCALAR,X : DEX : BPL SG_R1
  8662  876f 60                         RTS
  8663                          
  8664                          ; ----------------------------------------------------------------
  8665                          ; COPY_M : copy (MSG_PTR)[0..MSG_LEN-1] (16-bit) to (CDST).
  8666                          ;   CDST/CDST+1 set beforehand. Clobbers A,Y,CSRC,CDST,CCNT.
  8667                          ;   16-bit down-counter: lo==0 -> hi-- ; then lo-- (wrap 0->FF).
  8668                          ; ----------------------------------------------------------------
  8669                          COPY_M
  8670  8770 ada09e8502                 LDA MSG_PTR   : STA CSRC
  8671  8775 ada19e8503                 LDA MSG_PTR+1 : STA CSRC+1
  8672  877a ada29e8da49e               LDA MSG_LEN   : STA CCNT
  8673  8780 ada39e8da59e               LDA MSG_LEN+1 : STA CCNT+1
  8674  8786 a000                       LDY #0
  8675  8788 ada49e0da59ef01e   CM_LP   LDA CCNT : ORA CCNT+1 : BEQ CM_DN
  8676  8790 b1029104                   LDA (CSRC),Y : STA (CDST),Y
  8677  8794 e602d002e603               INC CSRC : BNE CM_S1 : INC CSRC+1
  8678  879a e604d002e605       CM_S1   INC CDST : BNE CM_S2 : INC CDST+1
  8679  87a0 ada49ed003cea59e   CM_S2   LDA CCNT : BNE CM_D1 : DEC CCNT+1
  8680  87a8 cea49e             CM_D1   DEC CCNT
  8681  87ab 4c8887                     JMP CM_LP
  8682  87ae 60                 CM_DN   RTS
  8683                          
  8684                          
