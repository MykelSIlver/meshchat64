  7831  7c81 20b17d                     JSR CP_W1_W2
  7832  7c84 20bd7d                     JSR CP_W0_W1
  7833                                  ; a = T1 + T2
  7834  7c87 a9c0                       LDA #<(SHA_AH+0)
  7835  7c89 85fb                       STA PA
  7836  7c8b a992                       LDA #>(SHA_AH+0)
