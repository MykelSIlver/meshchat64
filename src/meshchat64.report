  6152                          ; ================================================================
  6153                          ; AES_MIXCOLS  -  GF(2^8) column mixing, all 4 columns
  6154                          ;
  6155                          ;   For each column [c0,c1,c2,c3]  (c0 = row 0):
  6156                          ;     r0 = 2*c0  ^  3*c1  ^   c2  ^   c3
  6157                          ;     r1 =   c0  ^  2*c1  ^  3*c2 ^   c3
  6158                          ;     r2 =   c0  ^   c1   ^  2*c2 ^ 3*c3
  6159                          ;     r3 = 3*c0  ^   c1   ^   c2  ^ 2*c3
  6160                          ;   waarbij  2*x = xtime(x),   3*x = xtime(x) ^ x
  6161                          ;
  6162                          ;   X register is set to AES_COLOFF (0/4/8/12) at TAX,
  6163                          ;   and stays unchanged through XTIME and the EOR sequences.
  6164                          ;   So the write can also use X - no reload needed.
  6165                          ; ================================================================
  6166                          AES_MIXCOLS
  6167  493b a900                       LDA #0
  6168  493d 8d0a51                     STA AES_COLOFF
  6169                          
  6170  4940 ad0a51             AMC_LP  LDA AES_COLOFF
  6171  4943 c910                       CMP #16
  6172  4945 d003                       BNE AMC_CONT
  6173  4947 4cf349                     JMP AMC_DN
  6174                          AMC_CONT
  6175                          
  6176                                  ; --- load column bytes into c0..c3  (X = column offset) ------
  6177  494a aa                         TAX
  6178  494b bd0350                     LDA AES_STATE+0,X
  6179  494e 8d0c51                     STA AES_C0
  6180  4951 bd0450                     LDA AES_STATE+1,X
  6181  4954 8d0d51                     STA AES_C1
  6182  4957 bd0550                     LDA AES_STATE+2,X
  6183  495a 8d0e51                     STA AES_C2
  6184  495d bd0650                     LDA AES_STATE+3,X
  6185  4960 8d0f51                     STA AES_C3
  6186                          
  6187                                  ; --- compute xtime of each byte  (does not touch X) ------
  6188  4963 ad0c51                     LDA AES_C0
  6189  4966 200e46                     JSR XTIME
  6190  4969 8d1051                     STA AES_XC0
  6191  496c ad0d51                     LDA AES_C1
  6192  496f 200e46                     JSR XTIME
  6193  4972 8d1151                     STA AES_XC1
  6194  4975 ad0e51                     LDA AES_C2
  6195  4978 200e46                     JSR XTIME
  6196  497b 8d1251                     STA AES_XC2
  6197  497e ad0f51                     LDA AES_C3
  6198  4981 200e46                     JSR XTIME
  6199  4984 8d1351                     STA AES_XC3
  6200                          
  6201                                  ; --- r0 = 2*c0 ^ 3*c1 ^ c2 ^ c3 -------------------------
  6202  4987 ad1051                     LDA AES_XC0
  6203  498a 4d1151                     EOR AES_XC1
  6204  498d 4d0d51                     EOR AES_C1
  6205  4990 4d0e51                     EOR AES_C2
  6206  4993 4d0f51                     EOR AES_C3
  6207  4996 8d1451                     STA AES_R0
  6208                          
  6209                                  ; --- r1 = c0 ^ 2*c1 ^ 3*c2 ^ c3 -------------------------
  6210  4999 ad0c51                     LDA AES_C0
  6211  499c 4d1151                     EOR AES_XC1
  6212  499f 4d1251                     EOR AES_XC2
  6213  49a2 4d0e51                     EOR AES_C2
  6214  49a5 4d0f51                     EOR AES_C3
  6215  49a8 8d1551                     STA AES_R1
  6216                          
  6217                                  ; --- r2 = c0 ^ c1 ^ 2*c2 ^ 3*c3 -------------------------
  6218  49ab ad0c51                     LDA AES_C0
  6219  49ae 4d0d51                     EOR AES_C1
  6220  49b1 4d1251                     EOR AES_XC2
  6221  49b4 4d1351                     EOR AES_XC3
  6222  49b7 4d0f51                     EOR AES_C3
  6223  49ba 8d1651                     STA AES_R2
  6224                          
  6225                                  ; --- r3 = 3*c0 ^ c1 ^ c2 ^ 2*c3 -------------------------
  6226  49bd ad1051                     LDA AES_XC0
  6227  49c0 4d0c51                     EOR AES_C0
  6228  49c3 4d0d51                     EOR AES_C1
  6229  49c6 4d0e51                     EOR AES_C2
  6230  49c9 4d1351                     EOR AES_XC3
  6231  49cc 8d1751                     STA AES_R3
  6232                          
  6233                                  ; --- write back  (X = AES_COLOFF, still valid) --
  6234  49cf ad1451                     LDA AES_R0
  6235  49d2 9d0350                     STA AES_STATE+0,X
  6236  49d5 ad1551                     LDA AES_R1
  6237  49d8 9d0450                     STA AES_STATE+1,X
  6238  49db ad1651                     LDA AES_R2
  6239  49de 9d0550                     STA AES_STATE+2,X
  6240  49e1 ad1751                     LDA AES_R3
  6241  49e4 9d0650                     STA AES_STATE+3,X
  6242                          
  6243                                  ; --- next column --------------------------------------
  6244  49e7 ad0a51                     LDA AES_COLOFF
  6245  49ea 18                         CLC
  6246  49eb 6904                       ADC #4
  6247  49ed 8d0a51                     STA AES_COLOFF
  6248  49f0 4c4049                     JMP AMC_LP
  6249                          
  6250  49f3 60                 AMC_DN  RTS
